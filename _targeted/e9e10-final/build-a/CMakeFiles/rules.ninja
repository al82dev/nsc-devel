rule CUSTOM_COMMAND
  command = $COMMAND
  description = $DESC


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = A:\apps\cmake\bin\cmake.exe --regenerate-during-build -SA:\nsc-devel -BA:\nsc-devel\_targeted\e9e10-final\build-a
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = A:\apps\cmake\bin\cmake.exe -P A:\nsc-devel\_targeted\e9e10-final\build-a\CMakeFiles\VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = A:\apps\ninja\bin\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = A:\apps\ninja\bin\ninja.exe -t targets
  description = All primary targets available:

