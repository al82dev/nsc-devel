namespace NativeSharp.Core
{
    // NativeSharp.Core.TimeSpan -- Stage 53.1 "Time".
    //
    // Un intervalo de tiempo, representado exactamente igual que en C# real: un unico entero
    // de 64 bits con signo, Ticks, en unidades de 100 nanosegundos. Es un struct (tipo valor,
    // 8 bytes) a proposito -- cabe exacto en el limite del ABI de valor de Stage 40 (Windows
    // x64 solo pasa/devuelve por valor agregados de 1/2/4/8 bytes), asi que TimeSpan viaja
    // como parametro y como retorno sin ningun truco de arreglo-de-salida, igual que cualquier
    // entero nativo.
    //
    // No hay propiedades get-only en este archivo a proposito (a diferencia de
    // NativeSharp.Core.Diagnostics.Stopwatch, que si las usa): la sintaxis
    // "public int X { get { ... } }" esta confirmada funcionando en CLASES (Stage 38, ver
    // examples/project_stage38/App/PropertiesIndexersOperators.ns), pero ningun ejemplo ni
    // test existente la ejercita sobre un STRUCT -- en vez de asumir que tambien funciona ahi
    // y arriesgar un fallo de compilacion tardio, TotalSeconds/TotalMilliseconds/etc. son
    // metodos comunes (), exactamente el mismo patron que examples/project_stage40's
    // "public struct Word { public int Sum() {...} }" ya prueba que funciona sobre structs.
    public struct TimeSpan
    {
        public long Ticks;

        // ---- Fabricas estaticas ---------------------------------------------------------

        public static TimeSpan FromTicks(long ticks)
        {
            TimeSpan result;
            result.Ticks = ticks;
            return result;
        }

        public static TimeSpan Zero()
        {
            return FromTicks(0);
        }

        // 1 tick = 100 ns => 10,000 ticks = 1 ms => 10,000,000 ticks = 1 s.
        public static TimeSpan FromMilliseconds(double milliseconds)
        {
            return FromTicks((long)(milliseconds * 10000.0));
        }

        public static TimeSpan FromSeconds(double seconds)
        {
            return FromTicks((long)(seconds * 10000000.0));
        }

        public static TimeSpan FromMinutes(double minutes)
        {
            return FromSeconds(minutes * 60.0);
        }

        public static TimeSpan FromHours(double hours)
        {
            return FromMinutes(hours * 60.0);
        }

        public static TimeSpan FromDays(double days)
        {
            return FromHours(days * 24.0);
        }

        // ---- Conversion a unidades de coma flotante --------------------------------------

        public double TotalMilliseconds()
        {
            return (double)Ticks / 10000.0;
        }

        public double TotalSeconds()
        {
            return (double)Ticks / 10000000.0;
        }

        public double TotalMinutes()
        {
            return TotalSeconds() / 60.0;
        }

        public double TotalHours()
        {
            return TotalMinutes() / 60.0;
        }

        public double TotalDays()
        {
            return TotalHours() / 24.0;
        }

        // ---- Aritmetica / comparacion ------------------------------------------------------

        public TimeSpan Add(TimeSpan other)
        {
            return FromTicks(Ticks + other.Ticks);
        }

        public TimeSpan Subtract(TimeSpan other)
        {
            return FromTicks(Ticks - other.Ticks);
        }

        public TimeSpan Negate()
        {
            return FromTicks(-Ticks);
        }

        public bool Equals(TimeSpan other)
        {
            return Ticks == other.Ticks;
        }

        // -1 / 0 / 1, igual que TimeSpan.CompareTo en C# real (magnitud no especificada).
        public int CompareTo(TimeSpan other)
        {
            if (Ticks < other.Ticks)
            {
                return -1;
            }
            if (Ticks > other.Ticks)
            {
                return 1;
            }
            return 0;
        }
    }
}
