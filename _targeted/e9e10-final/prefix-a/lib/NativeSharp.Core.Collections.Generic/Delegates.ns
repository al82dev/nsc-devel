namespace NativeSharp.Core.Collections.Generic
{
    // Stage 52 -- delegate contracts shared by every collection in this package.
    //
    // NativeSharp generics are structural/unconstrained (there is no `where T : ...` syntax at
    // all -- see claude/04_restricciones_arquitectonicas.md and the Stage 44 generics work), and
    // there is no universal `object` base type: a plain value type such as `int` has NO member
    // access whatsoever (`x.Equals(...)` fails to resolve for `x : int`; verified against the
    // real compiler). That combination means a generic collection can never assume T exposes
    // `GetHashCode()`/`Equals()`/`CompareTo()` the way real C#'s `EqualityComparer<T>.Default`/
    // `Comparer<T>.Default` can. This package resolves that the same way an unconstrained C++
    // template or a Rust generic without trait bounds would: equality and ordering are expressed
    // with NativeSharp's structural `==`/`<`/`>` operators directly inside each collection's
    // generic method bodies (built-in value comparison for primitives, reference identity or a
    // user `operator ==`/`operator <` overload for classes/structs -- both already monomorphize
    // correctly per type argument), and hashing -- which has no structural operator at all -- is
    // supplied explicitly by the caller as a plain function, exactly like a hasher/comparator
    // passed to `std::unordered_map` or `HashMap::with_hasher`. See Hashing.ns for ready-made
    // hash functions for every built-in key type.
    public delegate int HashFunc<T>(T value);

    // Mirrors System.Comparison<T>: negative if `a` sorts before `b`, zero if equal, positive if
    // `a` sorts after `b`. Used by the explicit-comparer overloads (List<T>.Sort(Comparison<T>),
    // SortedList<TKey,TValue>'s comparer constructor, ...) for element/key types that do not
    // define `operator <`/`operator >`, or that need an ordering other than their natural one.
    public delegate int Comparison<T>(T a, T b);

    // Mirrors System.Predicate<T>: used by List<T>.Find/FindAll/RemoveAll/Exists/TrueForAll.
    public delegate bool Predicate<T>(T value);

    // Mirrors System.Action<T>: used by List<T>.ForEach and the other collections' ForEach.
    public delegate void Action<T>(T value);

    // Used by Dictionary<TKey,TValue>.ForEach (and any other paired-key/value iteration in this
    // package) in place of `Action<KeyValuePair<TKey,TValue>>`: two plain parameters instead of
    // one struct parameter sidesteps Stage 40's Windows x64 struct-value ABI limitation (a struct
    // type over 8 bytes cannot be used as a local, a call argument, or a return value at all --
    // see Dictionary.ns's class comment), which a `KeyValuePair<TKey,TValue>` argument would hit
    // the moment TKey and TValue together exceed 8 bytes.
    public delegate void KeyValueAction<TKey, TValue>(TKey key, TValue value);
}
