using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.SortedList<TKey,TValue> -- two parallel arrays
    // (`keys`/`values`), kept sorted by key at all times, looked up with binary search and
    // written with a shift (exactly like List<T>.Insert/RemoveAt, just keyed and index-located
    // via BinarySearch instead of always at a caller-given position). This is precisely what real
    // C#'s SortedList<TKey,TValue> itself is internally, so no simplification is needed here --
    // O(log n) lookup, O(n) insert/remove (the shift), O(1) by-index access via KeyAt/ValueAt,
    // in-order iteration for free. Contrast with SortedDictionary<TKey,TValue>.ns's comment.
    //
    // Ordering: TKey needs only `operator <` (never `==`/`GetHashCode()`) -- exactly List<T>.Sort/
    // BinarySearch's own requirement, and the same reasoning as Delegates.ns's class comment:
    // NativeSharp generics are unconstrained, so a two-element `<` comparison (`a < b` / `b < a`
    // / neither, i.e. `a == b`) is used everywhere an equality check on TKey is needed, rather
    // than assuming TKey also defines `operator ==`. A TKey with no natural `<` (or needing a
    // different order) fails to compile at the instantiation site -- the expected, honest
    // outcome given there is no `where T : IComparable<T>` constraint to enforce it earlier.
    //
    // Ownership: identical story to Dictionary.ns -- `keys`/`values` are `owned TKey[]`/
    // `owned TValue[]`, `Add`/`AddOrUpdate` mirror Dictionary<TKey,TValue>'s own (see its class
    // comment for exactly why `AddOrUpdate` exists instead of an owned indexer setter), and
    // `Keys()`/`Values()`/`ToArray()` return plain (non-owned) snapshots. `ToArray()` and
    // `ForEach` carry the same Stage 40 over-8-byte-struct caveat Dictionary.ns's class comment
    // documents (see there for the full explanation) -- `ToArray()`'s elements must be consumed
    // via `result[i].Key`/`result[i].Value` field access, never copied into a standalone
    // `KeyValuePair<TKey,TValue>` local, and `ForEach` takes a two-parameter
    // `KeyValueAction<TKey,TValue>` rather than a one-parameter `Action<KeyValuePair<...>>`.
    //
    // P1.2 of STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md: deliberately no GetEnumerator()
    // here either, for the same reason as Dictionary<TKey,TValue> (see its class comment) --
    // real C#'s SortedList<TKey,TValue> also implements IDictionary, so its foreach would yield
    // KeyValuePair<TKey,TValue>, hitting the identical struct-ABI landmine. `Keys()`/`Values()`
    // below (already ABI-safe, single-type-parameter arrays) are already foreach-compatible today
    // via the array-mode candidate: `foreach (var key in sortedList.Keys())`.
    public class SortedList<TKey, TValue>
    {
        private owned TKey[] keys;
        private owned TValue[] values;
        private int count;
        // Null (the default, natural-`<`-order constructors) or an explicit comparer supplied by
        // the `Comparison<TKey>` constructor overload below -- see the two constructors for why
        // this exists (P1 gap flagged in the Stage 52 closure notes: earlier this class only ever
        // used TKey's own `<`, with no way to order by a different key or a TKey with no natural
        // order at all).
        private Comparison<TKey> comparer;

        public SortedList()
        {
            keys = new TKey[4];
            values = new TValue[4];
            count = 0;
            comparer = null;
        }

        public SortedList(int capacity)
        {
            int actual = capacity;
            if (actual < 1) { actual = 1; }
            keys = new TKey[actual];
            values = new TValue[actual];
            count = 0;
            comparer = null;
        }

        // Mirrors real C#'s SortedList<TKey,TValue>(IComparer<TKey>) -- NativeSharp has no
        // IComparer<T> yet (see Delegates.ns), so a `Comparison<TKey>` delegate is the ownership-
        // and-generics-safe equivalent already used by List<T>.Sort(Comparison<T>).
        public SortedList(Comparison<TKey> comparerFunc)
        {
            keys = new TKey[4];
            values = new TValue[4];
            count = 0;
            comparer = comparerFunc;
        }

        public SortedList(Comparison<TKey> comparerFunc, int capacity)
        {
            int actual = capacity;
            if (actual < 1) { actual = 1; }
            keys = new TKey[actual];
            values = new TValue[actual];
            count = 0;
            comparer = comparerFunc;
        }

        public int Count()
        {
            return count;
        }

        public int Capacity()
        {
            return keys.Length;
        }

        private bool KeyEquals(TKey a, TKey b)
        {
            if (comparer != null)
            {
                return comparer(a, b) == 0;
            }
            if (a < b) { return false; }
            if (b < a) { return false; }
            return true;
        }

        // Returns the first index whose key is NOT less than `key` -- the sorted insertion point
        // for `key`, and (if that slot's key actually equals `key`) the lookup index too. Needs
        // only `<` (or the explicit comparer, when one was supplied at construction), exactly
        // like List<T>.BinarySearch/Sort(Comparison<T>).
        private int LowerBound(TKey key)
        {
            int low = 0;
            int high = count;
            while (low < high)
            {
                int mid = low + (high - low) / 2;
                bool less;
                if (comparer != null)
                {
                    less = comparer(keys[mid], key) < 0;
                }
                else
                {
                    less = keys[mid] < key;
                }
                if (less)
                {
                    low = mid + 1;
                }
                else
                {
                    high = mid;
                }
            }
            return low;
        }

        private int FindIndex(TKey key)
        {
            int index = LowerBound(key);
            if (index < count && KeyEquals(keys[index], key)) { return index; }
            return -1;
        }

        public int IndexOfKey(TKey key)
        {
            return FindIndex(key);
        }

        public bool ContainsKey(TKey key)
        {
            return FindIndex(key) >= 0;
        }

        public bool ContainsValue(TValue value)
        {
            int i = 0;
            while (i < count)
            {
                if (values[i] == value) { return true; }
                i = i + 1;
            }
            return false;
        }

        // Mirrors SortedList<TKey,TValue>.IndexOfValue -- unlike IndexOfKey, this is a linear scan
        // (the array is only sorted by key, not by value).
        public int IndexOfValue(TValue value)
        {
            int i = 0;
            while (i < count)
            {
                if (values[i] == value) { return i; }
                i = i + 1;
            }
            return -1;
        }

        // See Dictionary.ns's class comment for why this is a caller-supplied single-element
        // array rather than a real `out TValue` parameter (NativeSharp has no `ref`/`out`
        // parameters) or a returned `{bool, TValue}` struct (Stage 40's struct-value ABI limit).
        public bool TryGetValue(TKey key, TValue[] result)
        {
            int index = FindIndex(key);
            if (index < 0) { return false; }
            result[0] = values[index];
            return true;
        }

        public TValue this[TKey key]
        {
            get
            {
                int index = FindIndex(key);
                if (index < 0)
                {
                    throw new KeyNotFoundException();
                }
                return values[index];
            }
        }

        public TKey KeyAt(int index)
        {
            return keys[index];
        }

        public TValue ValueAt(int index)
        {
            return values[index];
        }

        // Public so callers can pre-size before a known-size batch of Add()s. Returns the
        // resulting capacity, mirroring List<T>.EnsureCapacity.
        public int EnsureCapacity(int capacity)
        {
            if (keys.Length >= capacity) { return keys.Length; }
            int newCapacity = keys.Length * 2;
            if (newCapacity < capacity) { newCapacity = capacity; }
            const TKey[] grownKeys = new TKey[newCapacity];
            const TValue[] grownValues = new TValue[newCapacity];
            int i = 0;
            while (i < count)
            {
                grownKeys[i] = move(keys[i]);
                grownValues[i] = move(values[i]);
                i = i + 1;
            }
            delete[] keys;
            delete[] values;
            keys = grownKeys;
            values = grownValues;
            return keys.Length;
        }

        // Mirrors SortedList<TKey,TValue>.TrimExcess -- same 90% threshold as List<T>.TrimExcess.
        public void TrimExcess()
        {
            int threshold = (keys.Length * 9) / 10;
            if (count >= threshold) { return; }
            int newCapacity = count;
            if (newCapacity < 1) { newCapacity = 1; }
            if (newCapacity == keys.Length) { return; }
            const TKey[] shrunkKeys = new TKey[newCapacity];
            const TValue[] shrunkValues = new TValue[newCapacity];
            int i = 0;
            while (i < count)
            {
                shrunkKeys[i] = move(keys[i]);
                shrunkValues[i] = move(values[i]);
                i = i + 1;
            }
            delete[] keys;
            delete[] values;
            keys = shrunkKeys;
            values = shrunkValues;
        }

        private void InsertAt(int index, owned TKey key, owned TValue value)
        {
            EnsureCapacity(count + 1);
            int i = count;
            while (i > index)
            {
                keys[i] = keys[i - 1];
                values[i] = values[i - 1];
                i = i - 1;
            }
            // move(key)/move(value): see List.ns's Add() for the full explanation -- InsertAt's
            // own owned `key`/`value` parameters need move() when stored, or their end-of-scope
            // cleanup double-frees them.
            keys[index] = move(key);
            values[index] = move(value);
            count = count + 1;
        }

        // Mirrors real C#'s SortedList<TKey,TValue>.Add: throws ArgumentException on a duplicate
        // key, exactly like the CLR's SortedList<TKey,TValue>.
        public void Add(owned TKey key, owned TValue value)
        {
            int insertAt = LowerBound(key);
            if (insertAt < count && KeyEquals(keys[insertAt], key))
            {
                throw new ArgumentException();
            }
            InsertAt(insertAt, move(key), move(value));
        }

        // The `owned`-argument-friendly stand-in for real C#'s indexer setter (`sl[key] =
        // value;`) -- see Dictionary.ns's class comment for why NativeSharp's indexer setters
        // cannot take an owned parameter.
        public void AddOrUpdate(owned TKey key, owned TValue value)
        {
            int insertAt = LowerBound(key);
            if (insertAt < count && KeyEquals(keys[insertAt], key))
            {
                delete values[insertAt];
                // move(value): see List.ns's Add() for the full explanation.
                values[insertAt] = move(value);
                delete key;
                return;
            }
            InsertAt(insertAt, move(key), move(value));
        }

        // Replaces the value of an ALREADY-PRESENT key (throws KeyNotFoundException otherwise) --
        // needs no ownership of the key at all, since the container already owns the one stored.
        public void SetValue(TKey key, owned TValue value)
        {
            int index = FindIndex(key);
            if (index < 0)
            {
                throw new KeyNotFoundException();
            }
            delete values[index];
            // move(value): see List.ns's Add() for the full explanation.
            values[index] = move(value);
        }

        public void RemoveAt(int index)
        {
            delete keys[index];
            delete values[index];
            int i = index;
            while (i < count - 1)
            {
                keys[i] = keys[i + 1];
                values[i] = values[i + 1];
                i = i + 1;
            }
            count = count - 1;
        }

        public bool Remove(TKey key)
        {
            int index = FindIndex(key);
            if (index < 0) { return false; }
            RemoveAt(index);
            return true;
        }

        public void Clear()
        {
            int i = 0;
            while (i < count)
            {
                delete keys[i];
                delete values[i];
                i = i + 1;
            }
            count = 0;
        }

        public TKey[] Keys()
        {
            const TKey[] result = new TKey[count];
            int i = 0;
            while (i < count)
            {
                result[i] = keys[i];
                i = i + 1;
            }
            return result;
        }

        public TValue[] Values()
        {
            const TValue[] result = new TValue[count];
            int i = 0;
            while (i < count)
            {
                result[i] = values[i];
                i = i + 1;
            }
            return result;
        }

        // See the class comment: consumed via `result[i].Key`/`result[i].Value` field access,
        // never by copying an element into a standalone `KeyValuePair<TKey, TValue>` local.
        public KeyValuePair<TKey, TValue>[] ToArray()
        {
            const KeyValuePair<TKey, TValue>[] result = new KeyValuePair<TKey, TValue>[count];
            int i = 0;
            while (i < count)
            {
                result[i].Key = keys[i];
                result[i].Value = values[i];
                i = i + 1;
            }
            return result;
        }

        public void ForEach(KeyValueAction<TKey, TValue> action)
        {
            int i = 0;
            while (i < count)
            {
                action(keys[i], values[i]);
                i = i + 1;
            }
        }

        ~SortedList()
        {
            int i = 0;
            while (i < count)
            {
                delete keys[i];
                delete values[i];
                i = i + 1;
            }
            delete[] keys;
            delete[] values;
        }
    }
}
