using NativeSharp.Core;

namespace NativeSharp.Core
{
    // NativeSharp.Core.ByteBuffer -- Bloque 4, fase B. SHR-025.
    //
    // QUE ES. Un arreglo de bytes que crece, dueno de su memoria. Es el destino de BinaryWriter y
    // el origen de BinaryReader, y la unica de las tres piezas de la fase B que ASIGNA.
    //
    // POR QUE NO ES List<byte>. Podria serlo, y esa fue la primera idea. Se descarto por una razon
    // concreta y no por gusto: `List<T>` guarda `owned T[]` y hace `move(items[i])` elemento a
    // elemento al crecer, porque un `T` cualquiera puede tener destructor. Un `byte` no tiene
    // nada que mover, asi que ese bucle es una copia byte a byte donde deberia haber un bloque.
    // Sobre un .obj de cien mil bytes esa diferencia se nota, y la E/S binaria de un compilador es
    // exactamente el sitio donde se nota.
    //
    // Y hay una segunda razon, que es la que de verdad decide: lo que BinaryReader necesita es un
    // `Span<byte>` sobre los bytes VIVOS, y `List<T>` no lo expone -- su `ToArray()` copia. Aqui
    // `AsSpan()` no copia nada.
    //
    // QUE NO HACE. No inserta en medio, no borra en medio, no busca. No es un contenedor de
    // proposito general: es un buffer de salida que crece por el final, que es la unica forma en
    // que un formato binario se escribe. Si algun dia hace falta otra cosa, se anade con su motivo.
    //
    // ERRORES: NINGUNO. Escribir en un buffer que crece no puede fallar salvo por falta de
    // memoria, y eso en este compilador es una trampa, no un valor de retorno. Los `Optional<T>`
    // de esta fase estan en BinaryReader, que es quien lee datos que pueden estar mal.
    public class ByteBuffer
    {
        private owned byte[] items;
        private int count;

        // La capacidad inicial no es 0 a proposito: un buffer que arranca vacio hace su primer
        // crecimiento en el primer byte, y el caso comun --escribir una cabecera de unas decenas
        // de bytes-- se lo comeria entero en reasignaciones. 16 cubre una cabecera COFF sin
        // crecer ni una vez.
        public ByteBuffer()
        {
            items = new byte[16];
            count = 0;
        }

        public ByteBuffer(int capacity)
        {
            int initial = capacity;
            if (initial < 1) { initial = 1; }
            items = new byte[initial];
            count = 0;
        }

        ~ByteBuffer()
        {
            delete[] items;
        }

        public int Count() { return count; }

        public int Capacity() { return items.Length; }

        public bool IsEmpty() { return count == 0; }

        // Vacia el buffer SIN soltar la memoria. Es lo que permite reutilizarlo entre archivos:
        // escribir un .obj, volcarlo, limpiar, escribir el siguiente -- y ni una asignacion
        // despues del primero. Es el mismo motivo por el que existe File.ReadBytes.
        public void Clear() { count = 0; }

        // Crece por duplicacion, igual que List<T>, pero copiando por Span en vez de elemento a
        // elemento: un byte no tiene nada que mover.
        public int EnsureCapacity(int capacity)
        {
            if (items.Length >= capacity) { return items.Length; }
            int newCapacity = items.Length * 2;
            if (newCapacity < capacity) { newCapacity = capacity; }
            const byte[] grown = new byte[newCapacity];
            Span<byte> origen = Spans.OfRange<byte>(items, 0, count);
            Span<byte> destino = Spans.OfRange<byte>(grown, 0, count);
            origen.CopyTo(destino);
            delete[] items;
            items = grown;
            return items.Length;
        }

        public void Add(byte value)
        {
            EnsureCapacity(count + 1);
            items[count] = value;
            count = count + 1;
        }

        // Anade `length` bytes desde `source`. Devuelve cuantos anadio, que es siempre `length`
        // salvo que se pida algo imposible -- un length negativo o mas de lo que `source` tiene.
        // Recortar en vez de fallar es lo mismo que hace File.WriteAllBytes, y por el mismo
        // motivo: pedir mas de lo que hay es pedir que se lea memoria ajena.
        public int AddRange(byte[] source, int start, int length)
        {
            if (source.Length == 0) { return 0; }
            int from = start;
            if (from < 0) { from = 0; }
            if (from >= source.Length) { return 0; }
            int available = source.Length - from;
            int take = length;
            if (take < 0) { take = 0; }
            if (take > available) { take = available; }
            if (take == 0) { return 0; }

            EnsureCapacity(count + take);
            Span<byte> origen = Spans.OfRange<byte>(source, from, take);
            Span<byte> destino = Spans.OfRange<byte>(items, count, take);
            origen.CopyTo(destino);
            count = count + take;
            return take;
        }

        public int AddAll(byte[] source)
        {
            return AddRange(source, 0, source.Length);
        }

        // Los bytes VIVOS, sin copiar. Es lo que BinaryReader consume y lo que se le pasa a
        // File.WriteAllBytes.
        //
        // OJO, Y ESTA ES LA PARTE QUE EL COMPILADOR SUJETA: lo devuelto es una VISTA. Sobrevive
        // solo mientras el buffer no crezca -- un Add posterior puede reasignar y dejarla
        // apuntando a memoria liberada. El chequeo de escape del Bloque 3 (SHR-013) impide
        // guardarla en un campo o devolverla desde un metodo que la construya sobre un local, que
        // son las dos formas en que ese error se comete de verdad. Lo que NO puede impedir es
        // usarla despues de un Add en el mismo ambito, y por eso queda dicho aqui.
        public Span<byte> AsSpan()
        {
            return Spans.OfRange<byte>(items, 0, count);
        }

        // Una COPIA de los bytes vivos, que el llamador posee. Existe para cuando el buffer se va
        // a seguir usando y los bytes tienen que sobrevivirle -- exactamente lo que AsSpan no
        // permite.
        public byte[] ToArray()
        {
            const byte[] copia = new byte[count];
            if (count > 0)
            {
                Span<byte> origen = Spans.OfRange<byte>(items, 0, count);
                Span<byte> destino = Spans.OfRange<byte>(copia, 0, count);
                origen.CopyTo(destino);
            }
            return copia;
        }

        public byte this[int index]
        {
            get { return items[index]; }
            set { items[index] = value; }
        }
    }
}
