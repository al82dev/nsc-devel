namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.LinkedListNode<T>. Ownership design (the doubly-linked
    // analogue of List.ns's class comment): a node OWNS its own Value and its own `Next` node --
    // freeing a node recursively frees the rest of the chain after it, exactly like a classic
    // C/C++ singly-recursive destructor chain. `Previous` is a deliberately NON-owning
    // back-reference (a node's own destructor never touches it) so the list stays a simple
    // forward ownership chain with O(1) backward traversal, not a reference cycle.
    //
    // Both Value and Next are stored in a single-element OWNED array (`T[1]`, `LinkedListNode<T>
    // [1]`) rather than a bare field, for the same reason List.ns's backing storage is `owned T
    // []`: it is the one array-element assignment shape this compiler currently accepts
    // ownership transfer THROUGH without extra ceremony (see List.ns's class comment on the
    // known indexer-setter/field-assignment ownership-checking gap) -- a bare `owned T value;`
    // field has the identical gap but with no equivalent "SetAt-style method" workaround, so the
    // array-of-one shape is used uniformly instead.
    public class LinkedListNode<T>
    {
        private owned T[] slot;
        private owned LinkedListNode<T>[] nextSlot;
        private LinkedListNode<T> previous;

        public LinkedListNode()
        {
            slot = new T[1];
            nextSlot = new LinkedListNode<T>[1];
            previous = null;
        }

        public T Value()
        {
            return slot[0];
        }

        public void SetValue(owned T value)
        {
            delete slot[0];
            // move(value): see List.ns's Add() for the full explanation.
            slot[0] = move(value);
        }

        // Hands back ownership of this node's Value, nulling this node's own slot -- used by
        // LinkedList<T>.RemoveFirst()/RemoveLast() to return the removed value to the caller
        // right before the (now value-less) node is discarded.
        public owned T TakeValue()
        {
            return move(slot[0]);
        }

        public LinkedListNode<T> Next()
        {
            return nextSlot[0];
        }

        // Hands back ownership of this node's current Next (nulling this node's own slot), the
        // way LinkedList<T>.Clear() unlinks the chain one node at a time without ever letting a
        // node's destructor cascade into the rest of the list (see LinkedList.ns).
        public owned LinkedListNode<T> TakeNext()
        {
            return move(nextSlot[0]);
        }

        // Replaces this node's Next, returning whatever was previously stored there (null if
        // this was the tail) so the caller can decide what to do with it -- mirrors
        // List<T>.SetAt's "hand back the displaced owner" shape, just via return instead of an
        // implicit delete, since a displaced Next is usually being RE-linked, not discarded.
        public owned LinkedListNode<T> SetNext(owned LinkedListNode<T> node)
        {
            raii LinkedListNode<T> previousNext = move(nextSlot[0]);
            // move(node): see List.ns's Add() for the full explanation.
            nextSlot[0] = move(node);
            return move(previousNext);
        }

        public LinkedListNode<T> Previous()
        {
            return previous;
        }

        // Non-owning: never deletes the previous `previous`, just repoints the raw back-reference.
        public void SetPrevious(LinkedListNode<T> node)
        {
            previous = node;
        }

        // Recursively frees Value and the rest of the chain after this node. LinkedList<T> only
        // ever lets this run on a node whose Next has ALREADY been evacuated via TakeNext() (see
        // LinkedList<T>.Clear()) -- so in practice this destructor only ever frees ONE node, but
        // it stays correct (if slower, via real recursion) even if a node is deleted directly
        // while still holding a live Next chain.
        ~LinkedListNode()
        {
            delete slot[0];
            delete[] slot;
            delete nextSlot[0];
            delete[] nextSlot;
        }
    }
}
