namespace NativeSharp.Core.Diagnostics
{
    // NativeSharp.Core.Diagnostics.SystemInfo -- Stage 55.2 "Hardware / System Info".
    //
    // Informacion de hardware/memoria de la MAQUINA (no de este proceso en particular -- para
    // eso ver NativeSharp.Core.Diagnostics.Process, Stage 55.1). Sigue exactamente la misma
    // disciplina de "operacion nucleo" que el resto de Stage 53/54/55 -- ver el comentario de
    // cabecera de Process.ns para la explicacion completa del mecanismo; los cuerpos *Raw de
    // abajo nunca se ejecutan.
    //
    // Por que esta clase NO expone ProcessorCount: NativeSharp.Core.Environment.ProcessorCount()
    // (Stage 53.2, via GetActiveProcessorCount) ya responde exactamente esa pregunta -- se
    // verifico esto por grep contra el codigo existente antes de disenar esta ronda, no se
    // asumio. Duplicarla aca como SystemInfo.ProcessorCount() hubiera sido una API redundante
    // con dos nombres para la misma cosa, exactamente el tipo de superficie que este proyecto
    // evita a proposito (ver claude/04_restricciones_arquitectonicas.md).
    //
    // Dos fuentes Win32 distintas detras de estos seis metodos: GetSystemInfo (PageSize,
    // ProcessorArchitecture, AllocationGranularity -- informacion ESTATICA de la maquina, no
    // cambia mientras el proceso corre) y GlobalMemoryStatusEx (TotalPhysicalMemoryBytes,
    // AvailablePhysicalMemoryBytes, MemoryLoadPercent -- una FOTO instantanea del estado de
    // memoria en el momento exacto de la llamada, cambia constantemente en una maquina real).
    public class SystemInfo
    {
        // Tamanio de una pagina de memoria de esta maquina, en bytes (SYSTEM_INFO.dwPageSize) --
        // tipicamente 4096 en x86_64. Uso tipico: alinear alojamientos grandes a limites de
        // pagina para el sistema de memoria de un motor de juego.
        public static long PageSize()
        {
            return GetPageSizeRaw();
        }

        // Arquitectura del procesador (SYSTEM_INFO.wProcessorArchitecture), como el entero crudo
        // de Win32. El unico valor real esperable en un sistema x86_64-pc-windows-msvc (el UNICO
        // target de este compilador -- ver claude/04_restricciones_arquitectonicas.md) es 9
        // (PROCESSOR_ARCHITECTURE_AMD64); se expone igual, sin traducir a un enum, por la misma
        // razon documentada en Process.PriorityClass() -- un solo entero crudo bien documentado
        // no justifica un tipo nuevo.
        public static long ProcessorArchitecture()
        {
            return GetProcessorArchitectureRaw();
        }

        // Granularidad de asignacion de memoria virtual de esta maquina, en bytes (SYSTEM_INFO.
        // dwAllocationGranularity) -- tipicamente 65536 (64 KB) en Windows real, distinto de
        // PageSize(): es el alineamiento minimo que VirtualAlloc exige para la DIRECCION BASE de
        // una reserva, no el tamanio de cada pagina individual dentro de ella.
        public static long AllocationGranularity()
        {
            return GetAllocationGranularityRaw();
        }

        // Memoria fisica TOTAL instalada en esta maquina, en bytes (MEMORYSTATUSEX.ullTotalPhys).
        public static long TotalPhysicalMemoryBytes()
        {
            return GetTotalPhysicalMemoryBytesRaw();
        }

        // Memoria fisica actualmente DISPONIBLE en esta maquina, en bytes (MEMORYSTATUSEX.
        // ullAvailPhys) -- una foto instantanea, cambia constantemente mientras otros procesos
        // del sistema alojan/liberan memoria.
        public static long AvailablePhysicalMemoryBytes()
        {
            return GetAvailablePhysicalMemoryBytesRaw();
        }

        // Porcentaje aproximado de uso de memoria fisica de todo el sistema, 0-100
        // (MEMORYSTATUSEX.dwMemoryLoad) -- calculado por el propio Windows, no derivado a mano
        // de TotalPhysicalMemoryBytes()/AvailablePhysicalMemoryBytes() (Windows aplica su propia
        // logica interna, que puede no ser una simple resta/division).
        public static long MemoryLoadPercent()
        {
            return GetMemoryLoadPercentRaw();
        }

        // Las seis "core operations" de Stage 55.2 -- ver el comentario de cabecera de la clase.
        // Placeholders: nunca se ejecutan, el compilador reemplaza cada llamada por lowering
        // nativo directo a LLVM.
        private static long GetPageSizeRaw()
        {
            return 0;
        }

        private static long GetProcessorArchitectureRaw()
        {
            return 0;
        }

        private static long GetAllocationGranularityRaw()
        {
            return 0;
        }

        private static long GetTotalPhysicalMemoryBytesRaw()
        {
            return 0;
        }

        private static long GetAvailablePhysicalMemoryBytesRaw()
        {
            return 0;
        }

        private static long GetMemoryLoadPercentRaw()
        {
            return 0;
        }
    }
}
