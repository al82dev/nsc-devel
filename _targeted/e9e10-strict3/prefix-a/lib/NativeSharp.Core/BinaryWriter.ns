using NativeSharp.Core;

namespace NativeSharp.Core
{
    // NativeSharp.Core.BinaryWriter -- Bloque 4, fase B. SHR-027.
    //
    // QUE ES. Escribe enteros y bloques de bytes en un ByteBuffer, en LITTLE-ENDIAN.
    //
    // POR QUE LITTLE-ENDIAN Y SIN OPCION. Porque COFF y PE lo son, y este compilador emite COFF y
    // PE. Un parametro de orden de bytes seria una opcion que nadie usaria nunca con el otro
    // valor, y cada campo escrito pagaria una rama por ella. El dia que haga falta big-endian
    // --un formato de red, un target de otra arquitectura-- se anade un tipo aparte con ese
    // nombre, no un booleano aqui.
    //
    // POR QUE NO POSEE EL BUFFER. Escribe en uno que le prestan. Un writer que fuera dueno del
    // buffer obligaria a sacarlo al final --devolverlo, o exponerlo-- y eso es justo la clase de
    // API en la que alguien acaba guardando una vista de algo que el writer va a liberar. Aqui el
    // buffer lo tiene quien lo va a volcar a disco, y el writer es una herramienta que se apunta
    // a el.
    //
    // ERRORES: NINGUNO, y esto no es un descuido. El destino crece, asi que escribir no puede
    // fallar salvo por falta de memoria, que en este compilador es una trampa. La asimetria con
    // BinaryReader --que si devuelve Optional<T>-- es deliberada y es la correcta: leer consume
    // datos que pueden estar mal o acabarse, escribir no.
    //
    // LO QUE SABE ESCRIBIR es exactamente lo que COFF y PE necesitan, y no es una lista abierta:
    // byte, ushort, uint, ulong (y sus variantes con signo), un bloque de bytes, y una cadena de
    // longitud fija rellenada con ceros. Nada mas, hasta que algo lo pida por su nombre.
    public class BinaryWriter
    {
        private ByteBuffer target;

        public BinaryWriter(ByteBuffer buffer)
        {
            target = buffer;
        }

        // Cuantos bytes lleva escritos el buffer de destino. No es "la posicion del writer": el
        // writer no tiene posicion propia, siempre escribe por el final. Tener dos nociones de
        // posicion sobre el mismo buffer es como se construye una que miente.
        public int Count() { return target.Count(); }

        public void WriteByte(byte value)
        {
            target.Add(value);
        }

        public void WriteSByte(sbyte value)
        {
            target.Add((byte)value);
        }

        // Little-endian: el byte menos significativo primero. Se escribe con desplazamientos y no
        // reinterpretando memoria a proposito -- un `*(ushort*)p = v` daria el orden del anfitrion,
        // que hoy coincide y manana en otra arquitectura no, y el fallo seria un .obj corrupto que
        // nadie relaciona con esta linea.
        public void WriteUInt16(ushort value)
        {
            target.Add((byte)(value & 255));
            target.Add((byte)((value >> 8) & 255));
        }

        public void WriteInt16(short value)
        {
            WriteUInt16((ushort)value);
        }

        public void WriteUInt32(uint value)
        {
            target.Add((byte)(value & 255u));
            target.Add((byte)((value >> 8) & 255u));
            target.Add((byte)((value >> 16) & 255u));
            target.Add((byte)((value >> 24) & 255u));
        }

        public void WriteInt32(int value)
        {
            WriteUInt32((uint)value);
        }

        public void WriteUInt64(ulong value)
        {
            target.Add((byte)(value & 255ul));
            target.Add((byte)((value >> 8) & 255ul));
            target.Add((byte)((value >> 16) & 255ul));
            target.Add((byte)((value >> 24) & 255ul));
            target.Add((byte)((value >> 32) & 255ul));
            target.Add((byte)((value >> 40) & 255ul));
            target.Add((byte)((value >> 48) & 255ul));
            target.Add((byte)((value >> 56) & 255ul));
        }

        public void WriteInt64(long value)
        {
            WriteUInt64((ulong)value);
        }

        public int WriteBytes(byte[] source, int start, int length)
        {
            return target.AddRange(source, start, length);
        }

        public int WriteAllBytes(byte[] source)
        {
            return target.AddAll(source);
        }

        // Rellena con ceros hasta completar `count` bytes. Es lo que un formato binario pide en
        // dos sitios distintos: los campos reservados y el relleno de alineacion.
        public void WriteZeros(int count)
        {
            int i = 0;
            while (i < count)
            {
                target.Add(0);
                i = i + 1;
            }
        }

        // Una cadena en un campo de ANCHO FIJO, que es como COFF guarda los nombres cortos de
        // seccion: hasta `width` bytes, y ceros hasta el final. Si el texto es mas largo se
        // TRUNCA, sin fallar -- y eso es lo que hace el formato, no una comodidad nuestra: un
        // nombre de seccion de mas de ocho caracteres no cabe en la cabecera y va a la tabla de
        // cadenas, decision que toma quien escribe la seccion, no este metodo.
        //
        // Devuelve cuantos caracteres del texto entraron, para que el llamador pueda darse cuenta
        // de que hubo truncamiento sin tener que medirlo antes.
        public int WriteFixedAscii(string text, int width)
        {
            int written = 0;
            int i = 0;
            while (i < text.Length && written < width)
            {
                target.Add((byte)text[i]);
                written = written + 1;
                i = i + 1;
            }
            WriteZeros(width - written);
            return written;
        }
    }
}
