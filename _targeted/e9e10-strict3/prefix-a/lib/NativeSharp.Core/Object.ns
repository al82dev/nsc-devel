namespace NativeSharp.Core
{
    // Stage 56 / C8 "Raiz de tipos" -- la raiz de la jerarquia de clases.
    //
    // QUE ES. Toda clase declarada SIN base explicita deriva implicitamente de esta, siempre que
    // el proyecto tenga a la vista `NativeSharp.Core.Object` (por referencia a esta biblioteca o
    // por declaracion propia). Es la misma convencion, deliberadamente, que ya seguia
    // `NativeSharp.Core.Exception` para `catch`/`throw` tipados: la raiz es opcional y explicita,
    // de modo que un proyecto que no la tiene a la vista compila exactamente igual que antes.
    //
    // QUE NO ES, Y POR QUE. Esto NO es `System.Object` de C#: no hay boxing, en ninguna parte del
    // lenguaje. `object o = 5;` y `object o = miStruct;` son errores de compilacion, no una
    // conversion implicita silenciosa. La razon no es esfuerzo, es coherencia: boxear implicaria
    // una asignacion en heap oculta y, en un lenguaje sin GC y explicito con la propiedad en todo
    // lo demas, una pregunta de ownership sin respuesta buena -- quien libera la caja de
    // `x.GetHashCode()`. NativeSharp resuelve el mismo problema sin cajas: un struct recibe sus
    // tres miembros SINTETIZADOS por el compilador y resueltos estaticamente (sin vtable, sin
    // caja, sin cambiar un byte de su layout), y un primitivo recibe `ToString()` enrutado a los
    // overloads de `NativeSharp.Core.String`. Una sola clase de struct, como probo C6.
    //
    // COSTO. Tres slots virtuales en la vtable de cada clase, y un puntero por descriptor de tipo
    // hacia el nombre del tipo (una constante, no una asignacion). Nada mas: los objetos no
    // crecen ni un byte, porque Object no declara campos.
    public class Object
    {
        // El nombre del tipo EN TIEMPO DE EJECUCION, no el estatico: se lee del descriptor del
        // objeto, asi que una referencia `Object` a un `Dictionary` responde "Dictionary". La
        // cadena vive en el binario como constante -- devolverla no asigna memoria.
        public virtual string ToString()
        {
            return RuntimeHelpers.TypeName(this);
        }

        // Identidad de referencia, que es la unica igualdad que la raiz puede conocer. Una clase
        // que tenga una nocion propia de igualdad la sobrescribe; el contrato es el de siempre --
        // si sobrescribis Equals, sobrescribi GetHashCode con el.
        public virtual bool Equals(Object other)
        {
            return this == other;
        }

        public virtual int GetHashCode()
        {
            return RuntimeHelpers.ReferenceHash(this);
        }
    }

    // Las dos primitivas que la raiz necesita y que no se pueden escribir en NativeSharp: leer el
    // nombre del tipo del descriptor, y convertir una referencia en un entero. Ambas son
    // "operaciones nucleo" -- el compilador las reconoce por nombre completo y las baja el, igual
    // que hace con NativeClock.QueryCounterRaw y compania. Los cuerpos de abajo son marcadores de
    // posicion; nunca se ejecutan.
    public class RuntimeHelpers
    {
        // Core operation: ObjectTypeName.
        public static string TypeName(Object value)
        {
            return "";
        }

        // Core operation: ObjectReferenceHash. Mezcla la direccion de la referencia hasta un int;
        // `null` da 0. No es estable entre ejecuciones (ASLR), exactamente como el
        // RuntimeHelpers.GetHashCode de C# real -- sirve para tablas hash dentro de un proceso, no
        // para persistir.
        public static int ReferenceHash(Object value)
        {
            return 0;
        }
    }
}
