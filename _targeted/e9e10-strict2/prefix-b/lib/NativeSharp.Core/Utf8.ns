// Utf8 -- lo que hace usable la decision de que `string` son BYTES.
//
// LA DECISION, y no se reabre aqui (mkdown/114_decisiones_pendientes.md, ID 125): un `string` de
// NativeSharp es una secuencia de BYTES. `Length` cuenta bytes y es O(1); `s[i]` da el byte i-esimo,
// de tipo `char`, que mide ocho bits y no tiene signo (CC1-100, fijado con un static_assert en
// include/nativesharp/Frontend/BuiltinIntegerTypes.h). Cortar, concatenar, comparar e indexar
// trabajan sobre bytes y no miran el contenido.
//
// POR QUE ASI, en una linea: hacer que `Length` cuente caracteres obligaria a DECODIFICAR en cada
// indexacion --O(n) donde hoy es O(1)-- y en un compilador que lexa ficheros y en un juego que arma
// texto por cuadro eso no es un detalle. Es lo que hacen Go y Rust. C# hizo lo contrario, UTF-16
// con `Length` en unidades de codigo, y el resultado es que `Length` TAMPOCO da caracteres: se paga
// el coste sin obtener la garantia.
//
// LO QUE ESTA CLASE ES: la otra mitad de esa decision. "Bytes opacos" sin nada mas seria un callejon
// sin salida -- no habria forma de contar caracteres, de recorrerlos, ni de saber si una cadena que
// viene de fuera es UTF-8 valido. Aqui esta eso, y SOLO eso, con dos propiedades:
//
//   * NO ES EL COMPORTAMIENTO POR OMISION. Hay que llamarlo. Quien paga el O(n) sabe que lo paga,
//     porque lo escribio.
//   * LOS NOMBRES DICEN LO QUE CUESTAN. `CodePointCount` no se llama `Length`.
//
// LA VALIDACION ES ESTRICTA, y esto importa mas de lo que parece. Un decodificador permisivo que
// acepta secuencias sobrelargas es un agujero de seguridad clasico: `"\xC0\xAF"` decodifica a `/`
// en un decodificador flojo, y asi se han saltado comprobaciones de rutas durante veinte anos. Aqui
// se rechazan:
//
//   * las SOBRELARGAS (un punto de codigo escrito con mas bytes de los necesarios);
//   * los SUSTITUTOS D800-DFFF, que no son puntos de codigo escalares y no se pueden codificar;
//   * todo lo que pase de 10FFFF, que es el tope de Unicode;
//   * los bytes de continuacion sueltos y las secuencias cortadas.
//
// NO HAY NADA DE CULTURAS AQUI. Ni comparacion sin distinguir mayusculas, ni normalizacion, ni
// orden lexicografico por idioma. Eso es una tabla de datos Unicode entera y es otro problema.
using NativeSharp.Core;

namespace NativeSharp.Core
{
    public class Utf8
    {
        // El valor que devuelven las funciones de decodificacion cuando la secuencia es invalida.
        // -1 y no U+FFFD a proposito: el reemplazo BORRA la diferencia entre "aqui habia un
        // caracter raro" y "esto no es UTF-8", y esa diferencia es justo la que hay que ver.
        public static int Invalid()
        {
            return -1;
        }

        // Cuantos BYTES anuncia un byte inicial: 1, 2, 3 o 4. Cero si no puede empezar una
        // secuencia -- o sea si es un byte de continuacion (10xxxxxx) o uno de los que UTF-8 no
        // usa nunca (F8-FF).
        public static int SequenceLength(byte lead)
        {
            if (lead < 128) { return 1; }              // 0xxxxxxx
            if (lead < 192) { return 0; }              // 10xxxxxx: continuacion, no puede empezar
            if (lead < 224) { return 2; }              // 110xxxxx
            if (lead < 240) { return 3; }              // 1110xxxx
            if (lead < 248) { return 4; }              // 11110xxx
            return 0;                                  // F8-FF: no existen en UTF-8
        }

        private static bool IsContinuation(byte value)
        {
            return value >= 128 && value < 192;
        }

        // Decodifica el punto de codigo que empieza en `index`.
        //
        // Devuelve el punto de codigo, o Invalid() si la secuencia no es valida. `usados` sale con
        // cuantos bytes consumio -- 1 en el caso invalido, para que un bucle que decide seguir
        // avance y no se quede girando.
        public static int DecodeAt(string texto, int index, out int usados)
        {
            usados = 1;
            if (index < 0 || index >= texto.Length) { return -1; }

            byte lead = (byte)texto[index];
            int longitud = SequenceLength(lead);
            if (longitud == 0) { return -1; }
            if (index + longitud > texto.Length) { return -1; }

            if (longitud == 1)
            {
                usados = 1;
                return (int)lead;
            }

            int punto = 0;
            if (longitud == 2) { punto = (int)(lead & 31); }
            else if (longitud == 3) { punto = (int)(lead & 15); }
            else { punto = (int)(lead & 7); }

            int i = 1;
            while (i < longitud)
            {
                byte siguiente = (byte)texto[index + i];
                if (!IsContinuation(siguiente)) { return -1; }
                punto = (punto << 6) | (int)(siguiente & 63);
                i = i + 1;
            }

            // SOBRELARGAS. Cada longitud tiene un minimo, y escribir un punto de codigo con mas
            // bytes de los necesarios es la forma clasica de colar un caracter por delante de una
            // comprobacion que mira los bytes.
            if (longitud == 2 && punto < 128) { return -1; }
            if (longitud == 3 && punto < 2048) { return -1; }
            if (longitud == 4 && punto < 65536) { return -1; }

            // SUSTITUTOS. D800-DFFF son la mitad de un par sustituto de UTF-16 y no son puntos de
            // codigo escalares: en UTF-8 no se codifican nunca.
            if (punto >= 55296 && punto <= 57343) { return -1; }

            // El tope de Unicode.
            if (punto > 1114111) { return -1; }

            usados = longitud;
            return punto;
        }

        // El indice del siguiente punto de codigo. Avanza uno aunque la secuencia sea invalida,
        // para que un bucle termine siempre.
        public static int NextIndex(string texto, int index)
        {
            int usados = 0;
            DecodeAt(texto, index, out usados);
            return index + usados;
        }

        // Cuantos PUNTOS DE CODIGO tiene la cadena. Es O(n) y por eso no se llama Length: quien
        // paga el recorrido lo escribe.
        //
        // Una secuencia invalida cuenta como UNO. Contar y validar son dos preguntas distintas, y
        // mezclarlas daria una funcion que no sirve para ninguna de las dos: usa IsValid si lo que
        // quieres saber es si la cadena esta bien formada.
        public static int CodePointCount(string texto)
        {
            int cuantos = 0;
            int i = 0;
            while (i < texto.Length)
            {
                i = NextIndex(texto, i);
                cuantos = cuantos + 1;
            }
            return cuantos;
        }

        // ¿Es UTF-8 bien formado de punta a punta? Estricto: sobrelargas, sustitutos y todo lo que
        // pase de 10FFFF son invalidos.
        public static bool IsValid(string texto)
        {
            int i = 0;
            while (i < texto.Length)
            {
                int usados = 0;
                int punto = DecodeAt(texto, i, out usados);
                if (punto < 0) { return false; }
                i = i + usados;
            }
            return true;
        }

        // ¿El byte en `index` empieza un punto de codigo? Es lo que hace falta para cortar una
        // cadena sin partir un caracter por la mitad: `Substring` trabaja en bytes, asi que quien
        // corta tiene que elegir un limite.
        public static bool IsBoundary(string texto, int index)
        {
            if (index <= 0) { return true; }
            if (index >= texto.Length) { return true; }
            return !IsContinuation((byte)texto[index]);
        }

        // El limite de punto de codigo en `index` o antes. Con esto, cortar por bytes deja de poder
        // partir un caracter: `Substring(t, 0, Utf8.BoundaryAtOrBefore(t, n))`.
        public static int BoundaryAtOrBefore(string texto, int index)
        {
            int i = index;
            if (i > texto.Length) { i = texto.Length; }
            if (i < 0) { return 0; }
            while (i > 0 && !IsBoundary(texto, i))
            {
                i = i - 1;
            }
            return i;
        }

        // Cuantos bytes ocupa un punto de codigo en UTF-8. Cero si no es codificable.
        public static int EncodedLength(int punto)
        {
            if (punto < 0) { return 0; }
            if (punto >= 55296 && punto <= 57343) { return 0; }   // sustitutos
            if (punto > 1114111) { return 0; }
            if (punto < 128) { return 1; }
            if (punto < 2048) { return 2; }
            if (punto < 65536) { return 3; }
            return 4;
        }

        // Escribe `punto` en `destino` a partir de `desde`. Devuelve cuantos bytes escribio, o 0 si
        // el punto no es codificable o no cabe -- y en ese caso NO escribe nada, para que un fallo
        // no deje medio caracter en el buffer.
        public static int Encode(int punto, byte[] destino, int desde)
        {
            int longitud = EncodedLength(punto);
            if (longitud == 0) { return 0; }
            if (desde < 0) { return 0; }
            // LA COMPROBACION SE ESCRIBE RESTANDO, NO SUMANDO. `desde + longitud` DESBORDA para un
            // `desde` cercano al maximo de `int`: la suma da negativo, la comparacion pasa, y la
            // funcion escribe -- o mas bien, la comprobacion de rangos del arreglo dispara una
            // trampa. Las dos cosas contradicen el contrato de esta funcion, que promete devolver
            // 0 SIN escribir cuando no cabe.
            //
            // `destino.Length - longitud` no puede desbordar: `Length` no es negativo y `longitud`
            // vale como mucho 4. Si queda negativo --un buffer mas corto que la secuencia-- el
            // `desde >= 0` de arriba hace que la comparacion sea cierta y se devuelva 0, que es
            // justo lo que toca.
            if (desde > destino.Length - longitud) { return 0; }

            if (longitud == 1)
            {
                destino[desde] = (byte)punto;
                return 1;
            }
            if (longitud == 2)
            {
                destino[desde] = (byte)(192 | (punto >> 6));
                destino[desde + 1] = (byte)(128 | (punto & 63));
                return 2;
            }
            if (longitud == 3)
            {
                destino[desde] = (byte)(224 | (punto >> 12));
                destino[desde + 1] = (byte)(128 | ((punto >> 6) & 63));
                destino[desde + 2] = (byte)(128 | (punto & 63));
                return 3;
            }
            destino[desde] = (byte)(240 | (punto >> 18));
            destino[desde + 1] = (byte)(128 | ((punto >> 12) & 63));
            destino[desde + 2] = (byte)(128 | ((punto >> 6) & 63));
            destino[desde + 3] = (byte)(128 | (punto & 63));
            return 4;
        }
    }
}
