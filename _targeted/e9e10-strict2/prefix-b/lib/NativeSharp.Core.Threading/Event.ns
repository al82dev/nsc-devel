namespace NativeSharp.Core.Threading
{
    // NativeSharp.Core.Threading.Event -- Stage 54.5 "Otras primitivas de sincronizacion".
    //
    // Envoltorio sobre un evento de KERNEL real de Win32 (CreateEventA/SetEvent/ResetEvent/
    // WaitForSingleObject/CloseHandle) -- una señal binaria "algo paso" que uno o mas hilos pueden
    // esperar (Wait). El caso de uso que ni Mutex (exclusion mutua) ni Semaphore (contador con
    // limite) cubren directamente: "avisale a quien este esperando que un trabajo esta listo",
    // sin proteger ningun dato compartido en el proceso -- la señal ES el dato.
    //
    // == Una sola clase con un parametro `manualReset`, no dos clases separadas ==
    //
    // El C# real (System.Threading) expone ManualResetEvent y AutoResetEvent como dos clases
    // distintas (ambas heredando de EventWaitHandle). Esta ronda las unifica en una sola clase
    // `Event` con un parametro `manualReset` explicito en el constructor -- mas cerca de como
    // Win32 mismo lo modela (CreateEventA recibe `bManualReset` como un simple BOOL, no dos
    // funciones de creacion distintas), y evita duplicar las cinco core operations enteras en dos
    // clases que serian identicas salvo por un flag. La diferencia de comportamiento entre los dos
    // modos es real y esta documentada en Set()/Reset() abajo, solo la forma de pedirla cambia.
    //
    // == manualReset=true (equivalente a ManualResetEvent) ==
    //
    // Una vez señalado via Set(), el evento se queda señalado HASTA que alguien llame Reset()
    // explicitamente -- CUALQUIER cantidad de hilos que llamen Wait() mientras esta señalado
    // retornan de inmediato (true), todos a la vez. Util para "avisar una vez, que se enteren
    // todos" (por ejemplo, una señal de apagado del programa).
    //
    // == manualReset=false (equivalente a AutoResetEvent) ==
    //
    // Win32 vuelve el evento a no-señalado AUTOMATICAMENTE en el instante en que UN SOLO hilo
    // esperando en Wait() es liberado -- cada Set() libera EXACTAMENTE un hilo (si hay varios
    // esperando, solo uno gana; si no hay ninguno esperando en ese instante, el evento queda
    // señalado hasta que el PROXIMO Wait() lo consuma). Util para "avisar una vez, que se entere
    // solo uno" (por ejemplo, señalizar "hay un item nuevo en la cola" a un pool de workers).
    // Reset() sobre un evento auto-reset es un no-op inofensivo (Win32 lo permite explicitamente),
    // documentado aca porque no es evidente sin leer la documentacion de Win32 directamente.
    //
    // == Wait() con timeout real: comparte runtime hook con Semaphore.Wait() ==
    //
    // Misma convencion de `millisecondsTimeout` que Semaphore.Wait() (ver su comentario de
    // cabecera): -1 significa esperar indefinidamente, cualquier valor >= 0 es un timeout real.
    // Devuelve true si el evento estaba (o se volvio) señalado antes de que expirara el timeout,
    // false si expiro sin que nadie lo señalara.
    //
    // == Mismo patron estructural que Mutex/Semaphore, EXACTO: HANDLE de kernel ==
    //
    // Cero mecanismo de compilador nuevo. Un HANDLE de 0 (CreateEventA fallo) es un no-op seguro
    // en todos lados, mismo idioma que Mutex/Semaphore.
    //
    // == Es una clase (tipo referencia), no un struct -- mismo razonamiento que Mutex/Thread ==
    public class Event
    {
        // El HANDLE de Win32 devuelto por CreateEventA, guardado como nint. Un valor de 0
        // significa "esto nunca fue un handle real".
        private nint handle_;

        // El constructor crea el evento de inmediato. `manualReset`: ver el comentario de
        // cabecera de la clase para la diferencia de comportamiento completa. `initialState`: true
        // si el evento nace YA señalado (un hilo que llama Wait() antes de que nadie llame Set()
        // retorna true de inmediato), false si nace no-señalado (el caso comun -- "todavia no paso
        // nada").
        public Event(bool manualReset, bool initialState)
        {
            handle_ = EventCreate(manualReset, initialState);
        }

        // Señala el evento -- ver el comentario de cabecera de la clase para el efecto exacto
        // segun `manualReset`. BOOL de Win32 descartado, mismo "unchecked failure" que
        // Mutex.Unlock()/Semaphore.Release().
        public void Set()
        {
            EventSet(handle_);
        }

        // Vuelve el evento a no-señalado explicitamente. Sobre un evento manual-reset, la unica
        // forma de "apagar" la señal despues de un Set(); sobre un evento auto-reset, un no-op
        // inofensivo (ver el comentario de cabecera de la clase).
        public void Reset()
        {
            EventReset(handle_);
        }

        // Bloquea el hilo llamante hasta que el evento este señalado o hasta que expire
        // `millisecondsTimeout` (misma convencion que Semaphore.Wait(), ver su comentario).
        // Devuelve true si el evento estaba señalado, false si el timeout expiro.
        public bool Wait(int millisecondsTimeout)
        {
            return EventWait(handle_, millisecondsTimeout);
        }

        // Libera el HANDLE de Win32 de este evento.
        ~Event()
        {
            EventClose(handle_);
        }

        // Las cinco "core operations" de Stage 54.5 -- reconocidas por el compilador por clase +
        // nombre + firma EXACTOS (ver MethodCoreOperationKind::EventCreate/Set/Reset/Wait/Close en
        // ProjectMethodBodyModel.h), mismo mecanismo "helpers privados y estaticos" que Mutex/
        // Semaphore ya establecen. Los cuerpos de abajo son placeholders -- nunca se ejecutan.
        private static nint EventCreate(bool manualReset, bool initialState)
        {
            return 0;
        }

        private static void EventSet(nint handle)
        {
        }

        private static void EventReset(nint handle)
        {
        }

        private static bool EventWait(nint handle, int millisecondsTimeout)
        {
            return false;
        }

        private static void EventClose(nint handle)
        {
        }
    }
}
