using NativeSharp.Core;

namespace NativeSharp.Core.Diagnostics
{
    // NativeSharp.Core.Diagnostics.Stopwatch -- Stage 53.1 "Time".
    //
    // Cronometro de alta resolucion sobre QueryPerformanceCounter/QueryPerformanceFrequency
    // (via NativeClock, en este mismo namespace -- no hace falta "using" para eso, ver
    // NativeClock.ns). Es la pieza mas importante de todo Stage 53.1 para el proposito real de
    // NativeSharp (juegos): delta time por frame, medir cuanto tarda una fase de carga, etc.
    // DateTime/TimeSpan sirven para otras cosas, pero un motor de juego vive y muere por esto.
    //
    // Es una clase (tipo referencia), no un struct: igual que System.Diagnostics.Stopwatch en
    // C# real. Ademas evita una trampa real de semantica valor: si fuera struct, cada copia
    // (paso por valor a una funcion, asignacion a otra variable) tendria SU PROPIA cuenta
    // independiente -- exactamente lo opuesto de lo que se espera de "el cronometro que le
    // pase a esta funcion para que lo pare cuando termine".
    //
    // Disciplina de ownership: sigue la misma regla que toda la libreria (ver el comentario de
    // cabecera de NativeSharp.Core.String) -- un local que va a nombrarse y despues devolverse
    // se declara "raii" y se devuelve con "move(...)"; el metodo que hace eso declara su tipo
    // de retorno como "owned Stopwatch", no "Stopwatch" a secas (ver StartNew() abajo).
    public class Stopwatch
    {
        // Ticks crudos de QueryPerformanceCounter -- SIN unidad fija todavia, unicamente
        // comparables entre si dividiendolos por frequency_ (ticks/segundo en esta maquina).
        private long frequency_;
        private long startRawTicks_;
        private long accumulatedRawTicks_;
        private bool running_;

        // Se consulta QueryFrequencyRaw() una unica vez aca, no en cada Elapsed(): Microsoft
        // documenta que la frecuencia es constante durante toda la vida del proceso, asi que
        // consultarla de nuevo en cada lectura seria trabajo repetido sin ningun beneficio (ver
        // el comentario correspondiente en NativeClock.ns).
        public Stopwatch()
        {
            frequency_ = NativeClock.QueryFrequencyRaw();
            startRawTicks_ = 0;
            accumulatedRawTicks_ = 0;
            running_ = false;
        }

        public void Start()
        {
            if (running_)
            {
                return;
            }
            startRawTicks_ = NativeClock.QueryCounterRaw();
            running_ = true;
        }

        public void Stop()
        {
            if (!running_)
            {
                return;
            }
            accumulatedRawTicks_ = accumulatedRawTicks_ + (NativeClock.QueryCounterRaw() - startRawTicks_);
            running_ = false;
        }

        public void Reset()
        {
            accumulatedRawTicks_ = 0;
            running_ = false;
        }

        public void Restart()
        {
            Reset();
            Start();
        }

        public bool IsRunning()
        {
            return running_;
        }

        // Ticks crudos de QueryPerformanceCounter acumulados -- si esta corriendo ahora mismo,
        // incluye el tramo abierto desde el ultimo Start() sin necesidad de un Stop() previo
        // (igual que Stopwatch.ElapsedTicks en C# real: leer mientras corre es valido).
        private long elapsedRawTicks()
        {
            if (!running_)
            {
                return accumulatedRawTicks_;
            }
            return accumulatedRawTicks_ + (NativeClock.QueryCounterRaw() - startRawTicks_);
        }

        // Conversion a NativeSharp.Core.TimeSpan real, dividiendo por la frecuencia de esta
        // maquina. Nota de precision, dicha con toda honestidad: esto pasa por double (en vez
        // de aritmetica entera exacta de ida y vuelta), igual que el camino general de .NET
        // real cuando Frequency no divide entero a TicksPerSecond -- para medir un frame de
        // juego (microsegundos a segundos) el error de redondeo de un double es completamente
        // insignificante; para acumular millones de mediciones y sumarlas una por una, mejor
        // sumar ElapsedRawTicks()/Frequency() en enteros y convertir a TimeSpan solo al final.
        public TimeSpan Elapsed()
        {
            double seconds = (double)elapsedRawTicks() / (double)frequency_;
            return TimeSpan.FromSeconds(seconds);
        }

        // Nota Stage 40: un struct devuelto por una llamada es un valor TEMPORAL, y un temporal
        // no es "direccionable" (no tiene una direccion de memoria estable a la que apuntar) --
        // por eso "Elapsed().TotalMilliseconds()" no compila directo (receptor de metodo de
        // struct debe ser un local/parametro/campo direccionable, Stage 40). Nombrar el
        // resultado en un local primero (`TimeSpan elapsed = Elapsed();`) lo vuelve
        // direccionable, y de ahi si se puede llamar TotalMilliseconds() sobre el.
        public double ElapsedMilliseconds()
        {
            TimeSpan elapsed = Elapsed();
            return elapsed.TotalMilliseconds();
        }

        public double ElapsedSeconds()
        {
            TimeSpan elapsed = Elapsed();
            return elapsed.TotalSeconds();
        }

        // Frecuencia cruda de esta maquina (ticks de QueryPerformanceCounter por segundo) --
        // expuesta por si el caller quiere hacer su propia aritmetica entera de precision
        // completa en vez de pasar por Elapsed()/TimeSpan.
        public long Frequency()
        {
            return frequency_;
        }

        public static owned Stopwatch StartNew()
        {
            raii Stopwatch watch = new Stopwatch();
            watch.Start();
            return move(watch);
        }
    }
}
