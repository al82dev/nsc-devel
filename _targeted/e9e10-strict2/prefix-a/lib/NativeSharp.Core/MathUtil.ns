namespace NativeSharp.Core
{
    // NativeSharp.Core.MathUtil -- Pre-Stage-56 "utilidades basicas" round (Alberto, 2026-08-29).
    //
    // Clamp/Lerp/Min/Max escalares, sobrecargados para cada tipo numerico principal (int/long/
    // float/double) -- el tipo de utilidad chiquita que casi cualquier programa NativeSharp no
    // trivial termina reescribiendo a mano si no esta en alguna parte de la biblioteca estandar.
    // Pura aritmetica NativeSharp, cero core operation, cero cambio de compilador, mismo espiritu
    // que Random.ns/NumericLimits.ns de esta misma ronda.
    //
    // == Por que se llama "MathUtil" y no "Math" ==
    //
    // El roadmap de este proyecto (ver claude/01_roadmap_nativesharp_0_2.md, candidatos post-0.3)
    // ya reserva el nombre "Math" para una futura Stage 59 dedicada a vectores/matrices (Vector2/
    // Vector3/Matrix4x4 y ese estilo de API, pensando en el dominio de juegos/graficos que este
    // proyecto tiene en la mira a mediano plazo -- ver claude/03_posicionamiento.md). Llamar
    // "Math" a esta clase escalar y chiquita de HOY chocaria de frente contra ese nombre el dia
    // que Stage 59 llegue -- "MathUtil" deja "Math" libre para esa ronda futura sin necesitar una
    // migracion incomoda de renombrar esta clase mas adelante.
    //
    // == Simplificacion deliberada: sin Abs() ==
    //
    // Esta ronda deliberadamente NO agrega `Abs()` -- calcular el valor absoluto de `int.MinValue`
    // (o `long.MinValue`) DESBORDA (no existe un `int` positivo que represente
    // `-(-2147483648)`, exactamente el mismo caso limite documentado en Dictionary.ns para su
    // propio hash de claves negativas), y decidir COMO manejar ese desborde (saturar, envolver,
    // lanzar una excepcion NativeSharp) es una decision de diseño real que merece su propio
    // analisis, no una entrada mas en esta lista. Min/Max/Clamp/Lerp no tienen ese problema (Clamp
    // nunca desborda: siempre devuelve uno de sus tres argumentos de entrada, tal cual).
    public class MathUtil
    {
        public static int Min(int a, int b)
        {
            if (a < b)
            {
                return a;
            }
            return b;
        }

        public static int Max(int a, int b)
        {
            if (a > b)
            {
                return a;
            }
            return b;
        }

        // Sujeta "value" al rango cerrado [min, max]. Simplificacion deliberada, misma disciplina
        // de siempre: si min > max (un rango invertido por error del caller), esta implementacion
        // NO lo detecta ni lo corrige -- el orden de las dos comparaciones de abajo (primero
        // min, despues max) hace que el resultado en ese caso sea "max" siempre, un
        // comportamiento definido y determinista aunque no necesariamente el que el caller
        // esperaba, no un crash ni una excepcion.
        public static int Clamp(int value, int min, int max)
        {
            if (value < min)
            {
                return min;
            }
            if (value > max)
            {
                return max;
            }
            return value;
        }

        public static long Min(long a, long b)
        {
            if (a < b)
            {
                return a;
            }
            return b;
        }

        public static long Max(long a, long b)
        {
            if (a > b)
            {
                return a;
            }
            return b;
        }

        public static long Clamp(long value, long min, long max)
        {
            if (value < min)
            {
                return min;
            }
            if (value > max)
            {
                return max;
            }
            return value;
        }

        public static float Min(float a, float b)
        {
            if (a < b)
            {
                return a;
            }
            return b;
        }

        public static float Max(float a, float b)
        {
            if (a > b)
            {
                return a;
            }
            return b;
        }

        public static float Clamp(float value, float min, float max)
        {
            if (value < min)
            {
                return min;
            }
            if (value > max)
            {
                return max;
            }
            return value;
        }

        // Interpolacion lineal entre "a" y "b" segun "t". Simplificacion deliberada: "t" NO se
        // sujeta a [0, 1] aca -- un "t" fuera de ese rango extrapola en vez de interpolar (mismo
        // comportamiento que Vector2.Lerp/MathF.Lerp de .NET real cuando "t" sale de [0,1]); si un
        // caller especifico necesita el resultado sujeto, puede envolver esta llamada con
        // Clamp(t, 0.0F, 1.0F) el mismo antes de pasarlo.
        public static float Lerp(float a, float b, float t)
        {
            return a + (b - a) * t;
        }

        public static double Min(double a, double b)
        {
            if (a < b)
            {
                return a;
            }
            return b;
        }

        public static double Max(double a, double b)
        {
            if (a > b)
            {
                return a;
            }
            return b;
        }

        public static double Clamp(double value, double min, double max)
        {
            if (value < min)
            {
                return min;
            }
            if (value > max)
            {
                return max;
            }
            return value;
        }

        public static double Lerp(double a, double b, double t)
        {
            return a + (b - a) * t;
        }
    }
}
