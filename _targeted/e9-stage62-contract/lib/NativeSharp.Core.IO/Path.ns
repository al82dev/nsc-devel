using NativeSharp.Core;

namespace NativeSharp.Core.IO
{
    // NativeSharp.Core.IO.Path -- Stage 53.3 "Filesystem/Paths", ronda 1. Stage 53.4
    // "Filesystem/Paths (cierre)" agrego GetFullPath (ver mas abajo).
    //
    // A diferencia de TODAS las clases con "operacion nucleo" que este proyecto viene agregando
    // desde Stage 53.1 (NativeClock, Environment, y File/Directory en Stage 53.3), Path se
    // mantuvo 100% NativeSharp puro hasta Stage 53.4: el compilador no reconocia esta clase por
    // nombre en absoluto, se compilaba exactamente igual que cualquier clase que un usuario
    // final de NativeSharp escribiria.
    //
    // El motivo seguia siendo simple: manipular un string de path (encontrar el separador,
    // cortar la extension, etc.) es pura manipulacion de texto -- y NativeSharp.Core.String YA
    // tiene todo lo necesario desde Stage 51 (Substring/Concat/EndsWith/LastIndexOf). Win32 recien
    // entraba en juego para preguntas que Windows tiene que responder de verdad -- "existe este
    // archivo" -- eso era File/Directory, no Path.
    //
    // Stage 53.4 rompe esa pureza UNA vez, con GetFullPath: a diferencia de Combine/GetFileName/
    // GetDirectoryName/GetExtension (que son manipulacion de TEXTO -- el path de entrada nunca se
    // consulta contra el sistema operativo), "convertir un path relativo en absoluto" requiere
    // el directorio de trabajo actual del PROCESO -- un dato que solo el sistema operativo tiene
    // (GetCurrentDirectory es parte implicita de como GetFullPathNameA resuelve un path relativo;
    // ver el comentario de cabecera de GetFullPath mas abajo y
    // `54_stage53_4_filesystem_paths_cierre.md` para el detalle completo). Por eso GetFullPath SI
    // es una operacion nucleo -- las demas siguen siendo NativeSharp puro, sin cambios.
    //
    // Espejo deliberado de System.IO.Path de .NET real, pero con la MISMA simplificacion que ya
    // se aplico en otros lados de este proyecto (ver Environment.GetEnvironmentVariable): un
    // path "sin separador" para GetDirectoryName devuelve "" (string vacio), no null -- este
    // compilador no tiene un tipo string nullable, asi que "" es la unica opcion honesta.
    //
    // Windows-only por diseño (igual que el resto del compilador: ver
    // claude/04_restricciones_arquitectonicas.md): el separador principal es '\' (backslash),
    // pero '/' tambien se acepta como separador alternativo en cualquier posicion -- exactamente
    // como Windows mismo lo permite (AltDirectorySeparatorChar en .NET real). Cuando ambos
    // aparecen en el mismo path ("C:/Users\alberto/archivo.txt", un caso raro pero valido en
    // Windows), se usa el que este MAS A LA DERECHA -- ver LastSeparatorIndex mas abajo.
    public class Path
    {
        // Separador de directorio primario en Windows.
        public static char DirectorySeparatorChar()
        {
            return '\\';
        }

        // Separador de directorio alternativo -- Windows lo acepta en cualquier posicion mezclado
        // con el primario.
        public static char AltDirectorySeparatorChar()
        {
            return '/';
        }

        // Helper privado: indice del ULTIMO separador (cualquiera de los dos) en el path, o -1 si
        // no hay ninguno. Implementado como dos LastIndexOf(string, string) independientes en vez
        // de un LastIndexOfAny(string, char[]) porque LastIndexOfAny necesita un char[] alocado
        // con "new char[]" y liberado con "delete[]" (ver examples/project_stage51/Main.ns) -- para
        // dos caracteres fijos, dos LastIndexOf(path, "\\")/LastIndexOf(path, "/") es mas simple y
        // no aloca nada.
        private static int LastSeparatorIndex(string path)
        {
            int backslash = String.LastIndexOf(path, "\\");
            int slash = String.LastIndexOf(path, "/");
            if (backslash > slash)
            {
                return backslash;
            }
            return slash;
        }

        // Combina dos segmentos de path con el separador primario, salvo que:
        //   - path1 sea "" -> devuelve una copia de path2 tal cual (nada que combinar).
        //   - path2 sea "" -> devuelve una copia de path1 tal cual (mismo caso, al reves).
        //   - path1 YA termine en un separador (cualquiera de los dos) -> no se agrega uno extra
        //     ("C:\Users\" + "alberto" no debe dar "C:\Users\\alberto").
        // Simplificacion deliberada frente a System.IO.Path.Combine real: esta version solo
        // combina DOS segmentos (no params string[]), y no tiene la regla especial de .NET real
        // donde un path2 "absoluto" (empieza con "C:\" o "\") descarta path1 por completo -- si
        // algun caller necesita esa regla, es candidata natural para una ronda futura.
        public static owned string Combine(string path1, string path2)
        {
            if (path1.Length == 0)
            {
                return String.Substring(path2, 0, path2.Length);
            }
            if (path2.Length == 0)
            {
                return String.Substring(path1, 0, path1.Length);
            }
            if (String.EndsWith(path1, "\\") || String.EndsWith(path1, "/"))
            {
                return String.Concat(path1, path2);
            }
            raii string withSeparator = String.Concat(path1, "\\");
            return String.Concat(withSeparator, path2);
        }

        // Devuelve la porcion del path despues del ultimo separador -- el nombre de archivo (con
        // extension) o el ultimo componente del path si no hay archivo. Si no hay ningun
        // separador, devuelve una copia del path completo (todo el path ES el "nombre").
        public static owned string GetFileName(string path)
        {
            int index = LastSeparatorIndex(path);
            return String.Substring(path, index + 1, path.Length - index - 1);
        }

        // Devuelve la porcion del path ANTES del ultimo separador -- el directorio contenedor.
        // Si no hay ningun separador, devuelve "" (no hay directorio que reportar; ver el
        // comentario de cabecera de esta clase sobre por que "" y no null).
        public static owned string GetDirectoryName(string path)
        {
            int index = LastSeparatorIndex(path);
            if (index < 0)
            {
                return String.Substring(path, 0, 0);
            }
            return String.Substring(path, 0, index);
        }

        // Devuelve la extension del archivo INCLUYENDO el punto (".txt", no "txt") -- igual que
        // System.IO.Path.GetExtension real. Si no hay ningun punto DESPUES del ultimo separador,
        // devuelve "" (un path como "C:\Users\alberto" o un nombre de directorio con puntos en el
        // medio de un componente anterior, como "C:\v1.2\archivo", no cuenta: el punto tiene que
        // estar en el ULTIMO componente del path).
        public static owned string GetExtension(string path)
        {
            int separatorIndex = LastSeparatorIndex(path);
            int dotIndex = String.LastIndexOf(path, ".");
            if (dotIndex < 0 || dotIndex < separatorIndex)
            {
                return String.Substring(path, 0, 0);
            }
            return String.Substring(path, dotIndex, path.Length - dotIndex);
        }

        // GetFileName() sin la extension -- "archivo.txt" -> "archivo". Si el nombre de archivo
        // no tiene punto, devuelve una copia completa de GetFileName() sin modificar.
        public static owned string GetFileNameWithoutExtension(string path)
        {
            raii string fileName = GetFileName(path);
            int dotIndex = String.LastIndexOf(fileName, ".");
            if (dotIndex < 0)
            {
                return String.Substring(fileName, 0, fileName.Length);
            }
            return String.Substring(fileName, 0, dotIndex);
        }

        // Core operation: GetFullPathNameA. Convierte "path" en un path ABSOLUTO, resolviendo
        // "." y ".." y anteponiendo el directorio de trabajo actual del proceso si "path" era
        // relativo -- exactamente lo que System.IO.Path.GetFullPath hace en .NET real. Si "path"
        // ya es absoluto, lo normaliza (resuelve "." y ".." igual) pero no cambia su raiz.
        //
        // NO esta declarado "owned string" -- exactamente el mismo patron que
        // Environment.GetEnvironmentVariable (53.2b) y File.ReadAllText (53.3b) establecieron: el
        // tipo de retorno declarado es "string" a secas, asi que un caller NativeSharp guarda el
        // resultado en una variable "string" comun, nunca "raii string" (a diferencia de
        // Combine/GetFileName/GetDirectoryName/GetExtension/GetFileNameWithoutExtension de esta
        // misma clase, que SI son "owned string" por ser NativeSharp puro siguiendo la disciplina
        // de String.ns -- ver el comentario de cabecera de esta clase).
        //
        // Simplificacion deliberada: si GetFullPathNameA falla, devuelve "" (string vacio) -- la
        // misma simplificacion ya aplicada a Environment.GetEnvironmentVariable ante cualquier
        // fallo. IMPORTANTE, verificado bajo Wine (no una suposicion): un path VACIO ("") es uno
        // de esos casos de fallo -- GetFullPathNameA("") devuelve 0, asi que GetFullPath("")
        // devuelve "" tambien. La intuicion inicial al diseñar esta ronda (que "" se resolveria
        // como el directorio de trabajo actual, igual que ".") resulto ser INCORRECTA y se
        // corrigio ANTES de empaquetar esta ronda -- usar "." (no "") para pedir el directorio de
        // trabajo actual. Ver `54_stage53_4_filesystem_paths_cierre_implementacion_paso_a_paso.md`
        // para el detalle completo de como se detecto.
        public static string GetFullPath(string path)
        {
            return "";
        }
    }
}
