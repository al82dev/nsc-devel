// CString -- un `string` de NativeSharp convertido a cadena C terminada en NUL.
//
// POR QUE EXISTE, y el consumidor que lo pidio. Un `string` de NativeSharp es
// `{ i64 longitud; bytes }` y NO promete un cero al final; toda la API `A` de Win32 lo exige. Las
// operaciones nucleo del runtime (`File.Exists` y compania) resuelven esa conversion por dentro,
// pero eso no esta expuesto, asi que CUALQUIER programa que llame a una API de Windows por
// `extern C` tenia que escribirla a mano.
//
// El primer programa real del proyecto --examples/project_demo_ventana-- la escribio a mano, byte
// a byte, y ese fue el hallazgo que justifica esta clase (doc 112 §C.3). No es una pieza que se
// anadio por completar una lista: es la que faltaba para que el lenguaje pueda hablar con el
// sistema operativo sin que cada programa reinvente lo mismo.
//
// POR QUE UNA CLASE Y NO UNA FUNCION SUELTA. La cadena C necesita memoria que sobreviva a la
// llamada, y esa memoria tiene que morir cuando alguien lo decida. Una funcion que devolviera un
// `byte*` recien reservado obligaria a cada llamador a acordarse de liberarlo -- y "acordarse" es
// exactamente lo que el modelo de este lenguaje existe para no necesitar. Como clase, un
// `raii CString` se limpia solo al salir del ambito.
//
// EL PUNTERO ES VALIDO MIENTRAS VIVA EL CString, Y NI UN INSTANTE MAS. Es la misma regla que
// `StringView` y `Span<T>`: la vista no es duena de nada. Guardar el `byte*` y usarlo despues de
// que el CString muera es un uso-despues-de-liberar, igual que en C.
//
// QUE HACE CON LOS BYTES: NADA. Copia byte a byte. Un `string` de NativeSharp ya es una secuencia
// de bytes --`char` mide ocho bits y no tiene signo, CC1-100-- asi que si el texto venia en UTF-8,
// lo que sale es UTF-8, y las APIs `A` de Windows lo interpretaran segun la pagina de codigos del
// sistema. Convertir a UTF-16 para las APIs `W` es otra pieza y va en su propio sitio; esta clase
// no adivina codificaciones (ver mkdown/114_decisiones_pendientes.md, ID 125).
//
// EL NUL INTERIOR NO SE INVENTA UN ERROR. Si el texto trae un cero en medio, la cadena C que el
// sistema lee acaba ahi. No se rechaza ni se sustituye: es lo que significa una cadena C, y
// `Length()` sigue devolviendo la longitud completa del texto para que el llamador pueda notarlo
// si le importa.
using NativeSharp.Core;

namespace NativeSharp.Core
{
    public class CString
    {
        // Un byte mas que el texto: el ultimo es el NUL, y siempre esta escrito.
        private owned byte[] bytes;
        private int longitud;

        public CString(string texto)
        {
            longitud = texto.Length;
            // `new byte[0]` no daria donde poner el NUL, y la cadena vacia tiene que producir un
            // puntero valido a un solo cero -- que es lo que Win32 espera de "".
            bytes = new byte[longitud + 1];
            int i = 0;
            while (i < longitud)
            {
                bytes[i] = (byte)texto[i];
                i = i + 1;
            }
            bytes[longitud] = 0;
        }

        ~CString()
        {
            delete[] bytes;
        }

        // El puntero que se le pasa a la API de C. Valido mientras viva este objeto.
        public byte* Pointer()
        {
            return &bytes[0];
        }

        // Los bytes del TEXTO, sin contar el NUL.
        public int Length()
        {
            return longitud;
        }

        // Los bytes que ocupa en memoria, NUL incluido. Es lo que hay que pasarle a una API que
        // pide un tamano de buffer.
        public int SizeWithNul()
        {
            return longitud + 1;
        }

        // El byte en `index`, sin el NUL. Fuera de rango devuelve 0, la misma convencion que usa
        // el resto de la biblioteca para no obligar a comprobar dos veces.
        public byte At(int index)
        {
            if (index < 0) { return 0; }
            if (index >= longitud) { return 0; }
            return bytes[index];
        }
    }
}
