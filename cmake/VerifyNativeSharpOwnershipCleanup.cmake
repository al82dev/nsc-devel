if(NOT DEFINED NSC_EXECUTABLE OR NOT DEFINED PYTHON_EXECUTABLE OR NOT DEFINED SOURCE_ROOT OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED NSLINK_EXECUTABLE)
 message(FATAL_ERROR "SH35 requires compiler, Python, roots and NSLink")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(adapter "${OUTPUT_DIR}/adapter.exe")
execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${SOURCE_ROOT}/selfhost/tests/llvm/LinkerAdapterSmoke/LinkerAdapterSmoke.nsproj" -O0 -g0 -o "${adapter}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH35 adapter failed")
endif()
set(import "${OUTPUT_DIR}/kernel32.lib")
execute_process(COMMAND "${NSLINK_EXECUTABLE}" --link --make-implib KERNEL32.dll:ExitProcess,GetProcessHeap,HeapAlloc,HeapFree "${import}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH35 implib failed")
endif()
set(project "${SOURCE_ROOT}/selfhost/tests/ownership-cleanup/OwnershipCleanup.nsproj")
foreach(profile IN ITEMS O0 O1 O2 O3)
 string(TOLOWER "${profile}" lower)
 set(candidate "${OUTPUT_DIR}/nsc-next-${lower}.exe")
 execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${SOURCE_ROOT}/selfhost/nsc/NativeSharp.Compiler.nsproj" "-${profile}" -g0 -o "${candidate}" RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SH35 compiler failed")
 endif()
 execute_process(COMMAND "${candidate}" --dump-project-ir "${project}" mir OUTPUT_FILE "${OUTPUT_DIR}/mir-${lower}.txt" RESULT_VARIABLE result)
 set(object "${OUTPUT_DIR}/ownership-${lower}.obj")
 execute_process(COMMAND "${candidate}" --emit-project-object "${project}" "-${profile}" -o "${object}" RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SH35 object failed")
 endif()
 foreach(route IN ITEMS nslink)
  set(tool "${NSLINK_EXECUTABLE}")
  set(exe "${OUTPUT_DIR}/${route}-${lower}.exe")
  execute_process(COMMAND "${adapter}" "${route}" "${tool}" "${object}" "${import}" "${OUTPUT_DIR}/${route}-${lower}.rsp" "${exe}" "${OUTPUT_DIR}/${route}-${lower}.log" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "SH35 ${profile}/${route} link failed")
  endif()
  execute_process(COMMAND "${exe}" RESULT_VARIABLE run TIMEOUT 5)
  file(WRITE "${OUTPUT_DIR}/${route}-${lower}.result.txt" "${run}\n")
 endforeach()
endforeach()
execute_process(COMMAND "${PYTHON_EXECUTABLE}" -B "${SOURCE_ROOT}/selfhost/bootstrap/verify_ownership_cleanup.py" --output-dir "${OUTPUT_DIR}" --report "${OUTPUT_DIR}/sh35-report.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH35 verifier failed: ${out}${err}")
endif()
message(STATUS "${out}")
