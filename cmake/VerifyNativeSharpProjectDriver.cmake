if(NOT DEFINED NSC_EXECUTABLE OR NOT DEFINED PYTHON_EXECUTABLE OR NOT DEFINED SOURCE_ROOT OR
   NOT DEFINED OUTPUT_DIR OR NOT DEFINED LINKER_EXECUTABLE OR NOT DEFINED ENV{NS_ROOT})
    message(FATAL_ERROR "SH09 requires nsc, Python, roots and linker")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(prefix "$ENV{NS_ROOT}")
set(nslink "${prefix}/bin/nslink.exe")
set(project "${SOURCE_ROOT}/selfhost/tests/projects/Sh09App/Sh09App.nsproj")
set(compiler_project "${SOURCE_ROOT}/selfhost/nsc/NativeSharp.Compiler.nsproj")
set(adapter_project "${SOURCE_ROOT}/selfhost/tests/llvm/LinkerAdapterSmoke/LinkerAdapterSmoke.nsproj")
set(adapter "${OUTPUT_DIR}/adapter.exe")
execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${adapter_project}" -O0 -g0 -o "${adapter}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SH09 adapter build failed: ${out}${err}")
endif()
set(import_library "${OUTPUT_DIR}/kernel32.lib")
execute_process(COMMAND "${nslink}" --link --make-implib KERNEL32.dll:ExitProcess "${import_library}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SH09 implib failed: ${out}${err}")
endif()

foreach(profile IN ITEMS O0 O1 O2 O3)
    string(TOLOWER "${profile}" lower)
    set(candidate "${OUTPUT_DIR}/nsc-next-${lower}.exe")
    execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${compiler_project}" "-${profile}" -g0 -o "${candidate}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} compiler failed: ${out}${err}")
    endif()
    execute_process(COMMAND "${candidate}" --verify-project "${project}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} rejected project")
    endif()
    execute_process(COMMAND "${candidate}" --dump-project "${project}" OUTPUT_FILE "${OUTPUT_DIR}/project-${lower}.txt" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} project dump failed")
    endif()
    set(object "${OUTPUT_DIR}/project-${lower}.obj")
    execute_process(COMMAND "${candidate}" --emit-project-object "${project}" "-${profile}" -o "${object}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} object failed: ${out}${err}")
    endif()
    execute_process(COMMAND "${candidate}" --emit-nsmeta "${project}" "${OUTPUT_DIR}/project-${lower}.nsmeta" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} metadata failed")
    endif()
    execute_process(COMMAND "${candidate}" --verify-nsmeta "${OUTPUT_DIR}/project-${lower}.nsmeta" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} metadata read failed")
    endif()
    execute_process(COMMAND "${candidate}" --emit-toolchain-manifest "${project}" "${OUTPUT_DIR}/project-${lower}.manifest" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SH09 ${profile} manifest failed")
    endif()
    foreach(route IN ITEMS lld nslink)
        if(route STREQUAL "lld")
            set(tool "${LINKER_EXECUTABLE}")
        else()
            set(tool "${nslink}")
        endif()
        execute_process(COMMAND "${adapter}" "${route}" "${tool}" "${object}" "${import_library}"
            "${OUTPUT_DIR}/${route}-${lower}.rsp" "${OUTPUT_DIR}/${route}-${lower}.exe" "${OUTPUT_DIR}/${route}-${lower}.log"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "SH09 ${profile}/${route} link failed: ${out}${err}")
        endif()
        execute_process(COMMAND "${OUTPUT_DIR}/${route}-${lower}.exe" RESULT_VARIABLE run)
        if(NOT run EQUAL 42)
            message(FATAL_ERROR "SH09 ${profile}/${route} exit ${run}")
        endif()
    endforeach()
endforeach()

file(WRITE "${OUTPUT_DIR}/driver.rsp" "--dump-project\n${project}\n")
execute_process(COMMAND "${OUTPUT_DIR}/nsc-next-o0.exe" "@${OUTPUT_DIR}/driver.rsp"
    OUTPUT_FILE "${OUTPUT_DIR}/response-project.txt" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SH09 response file failed")
endif()
execute_process(COMMAND "${PYTHON_EXECUTABLE}" -B "${SOURCE_ROOT}/selfhost/bootstrap/verify_project_driver.py"
    --contract "${SOURCE_ROOT}/selfhost/contracts/project-driver.contract.json" --output-dir "${OUTPUT_DIR}"
    --report "${OUTPUT_DIR}/sh09-report.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SH09 verifier failed: ${out}${err}")
endif()
message(STATUS "${out}")
