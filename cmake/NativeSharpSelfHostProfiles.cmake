function(nsc_select_selfhost_profiles output_variable)
    set(available_profiles O0 O1 O2 O3)
    set(selected_profiles ${available_profiles})
    if(DEFINED ENV{NSC_SELFHOST_PROFILES} AND NOT "$ENV{NSC_SELFHOST_PROFILES}" STREQUAL "")
        set(raw_profiles "$ENV{NSC_SELFHOST_PROFILES}")
        string(REGEX REPLACE "[, \t\r\n]+" ";" requested_profiles "${raw_profiles}")
        set(selected_profiles)
        foreach(profile IN LISTS requested_profiles)
            string(TOUPPER "${profile}" normalized_profile)
            list(FIND available_profiles "${normalized_profile}" profile_index)
            if(profile_index EQUAL -1)
                message(FATAL_ERROR "invalid self-host optimization profile: ${profile}")
            endif()
            if(NOT normalized_profile IN_LIST selected_profiles)
                list(APPEND selected_profiles "${normalized_profile}")
            endif()
        endforeach()
        if(NOT selected_profiles)
            message(FATAL_ERROR "self-host optimization profile selection is empty")
        endif()
    endif()
    set(${output_variable} "${selected_profiles}" PARENT_SCOPE)
endfunction()
