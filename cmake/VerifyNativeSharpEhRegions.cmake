if(NOT DEFINED NSC_EXECUTABLE OR NOT DEFINED PYTHON_EXECUTABLE OR NOT DEFINED SOURCE_ROOT OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED LINKER_EXECUTABLE OR NOT DEFINED NSLINK_EXECUTABLE)
 message(FATAL_ERROR "SH38 requires compiler, Python, roots and linkers")
endif()
get_filename_component(llvm_bin "${LINKER_EXECUTABLE}" DIRECTORY)
set(readobj "${llvm_bin}/llvm-readobj.exe")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${SOURCE_ROOT}/selfhost/tests/llvm/LinkerAdapterSmoke/LinkerAdapterSmoke.nsproj" -O0 -g0 -o "${OUTPUT_DIR}/adapter.exe" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH38 adapter failed: ${out}${err}")
endif()
execute_process(COMMAND "${NSLINK_EXECUTABLE}" --link --make-implib KERNEL32.dll:ExitProcess "${OUTPUT_DIR}/kernel32.lib" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH38 implib failed: ${out}${err}")
endif()
set(project "${SOURCE_ROOT}/selfhost/tests/eh-regions/EhRegions.nsproj")
foreach(profile IN ITEMS O0 O1 O2 O3)
 string(TOLOWER "${profile}" lower)
 set(candidate "${OUTPUT_DIR}/nsc-next-${lower}.exe")
 execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${SOURCE_ROOT}/selfhost/nsc/NativeSharp.Compiler.nsproj" "-${profile}" -g0 -o "${candidate}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SH38 compiler failed: ${out}${err}")
 endif()
 execute_process(COMMAND "${candidate}" --dump-project-eh "${project}" OUTPUT_FILE "${OUTPUT_DIR}/eh-${lower}.txt" RESULT_VARIABLE result)
 set(object "${OUTPUT_DIR}/eh-${lower}.obj")
 execute_process(COMMAND "${candidate}" --emit-project-object "${project}" "-${profile}" -o "${object}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SH38 object failed: ${out}${err}")
 endif()
 execute_process(COMMAND "${readobj}" --unwind "${object}" OUTPUT_FILE "${OUTPUT_DIR}/unwind-${lower}.txt" RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SH38 unwind inspection failed")
 endif()
 foreach(route IN ITEMS nslink)
  set(tool "${NSLINK_EXECUTABLE}")
  set(exe "${OUTPUT_DIR}/${route}-${lower}.exe")
  execute_process(COMMAND "${OUTPUT_DIR}/adapter.exe" "${route}" "${tool}" "${object}" "${OUTPUT_DIR}/kernel32.lib" "${OUTPUT_DIR}/${route}-${lower}.rsp" "${exe}" "${OUTPUT_DIR}/${route}-${lower}.log" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "SH38 ${profile}/${route} link failed: ${out}${err}")
  endif()
  execute_process(COMMAND "${exe}" RESULT_VARIABLE run TIMEOUT 5)
  file(WRITE "${OUTPUT_DIR}/${route}-${lower}.result.txt" "${run}\n")
 endforeach()
endforeach()
execute_process(COMMAND "${PYTHON_EXECUTABLE}" -B "${SOURCE_ROOT}/selfhost/bootstrap/verify_eh_regions.py" --output-dir "${OUTPUT_DIR}" --report "${OUTPUT_DIR}/sh38-report.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH38 verifier failed: ${out}${err}")
endif()
message(STATUS "${out}")
