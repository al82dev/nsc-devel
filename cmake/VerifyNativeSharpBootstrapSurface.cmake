if(NOT DEFINED NSC_EXECUTABLE OR NOT DEFINED PYTHON_EXECUTABLE OR NOT DEFINED SOURCE_ROOT OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED LINKER_EXECUTABLE OR NOT DEFINED NSLINK_EXECUTABLE)
 message(FATAL_ERROR "SH37 requires compiler, Python, roots and linkers")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${SOURCE_ROOT}/selfhost/tests/llvm/LinkerAdapterSmoke/LinkerAdapterSmoke.nsproj" -O0 -g0 -o "${OUTPUT_DIR}/adapter.exe" RESULT_VARIABLE result)
execute_process(COMMAND "${NSLINK_EXECUTABLE}" --link --make-implib KERNEL32.dll:ExitProcess "${OUTPUT_DIR}/kernel32.lib" RESULT_VARIABLE result)
set(project "${SOURCE_ROOT}/selfhost/tests/bootstrap-surface/BootstrapSurface.nsproj")
foreach(profile IN ITEMS O0 O1 O2 O3)
 string(TOLOWER "${profile}" lower)
 execute_process(COMMAND "${NSC_EXECUTABLE}" --emit-project-oop-exe "${SOURCE_ROOT}/selfhost/nsc/NativeSharp.Compiler.nsproj" "-${profile}" -g0 -o "${OUTPUT_DIR}/nsc-next-${lower}.exe" RESULT_VARIABLE result)
 execute_process(COMMAND "${OUTPUT_DIR}/nsc-next-${lower}.exe" --dump-ast "${SOURCE_ROOT}/selfhost/tests/bootstrap-surface/Program.ns" OUTPUT_FILE "${OUTPUT_DIR}/ast-${lower}.txt" RESULT_VARIABLE result)
 execute_process(COMMAND "${OUTPUT_DIR}/nsc-next-${lower}.exe" --emit-project-object "${project}" "-${profile}" -o "${OUTPUT_DIR}/surface-${lower}.obj" RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SH37 ${profile} compile failed")
 endif()
 foreach(route IN ITEMS lld nslink)
  set(tool "${NSLINK_EXECUTABLE}")
  if(route STREQUAL "lld")
   set(tool "${LINKER_EXECUTABLE}")
  endif()
  execute_process(COMMAND "${OUTPUT_DIR}/adapter.exe" "${route}" "${tool}" "${OUTPUT_DIR}/surface-${lower}.obj" "${OUTPUT_DIR}/kernel32.lib" "${OUTPUT_DIR}/${route}-${lower}.rsp" "${OUTPUT_DIR}/${route}-${lower}.exe" "${OUTPUT_DIR}/${route}-${lower}.log" RESULT_VARIABLE result)
  execute_process(COMMAND "${OUTPUT_DIR}/${route}-${lower}.exe" RESULT_VARIABLE run TIMEOUT 5)
  file(WRITE "${OUTPUT_DIR}/${route}-${lower}.result.txt" "${run}\n")
 endforeach()
endforeach()
execute_process(COMMAND "${PYTHON_EXECUTABLE}" -B "${SOURCE_ROOT}/selfhost/bootstrap/verify_bootstrap_surface.py" --output-dir "${OUTPUT_DIR}" --report "${OUTPUT_DIR}/sh37-report.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "SH37 verifier failed: ${out}${err}")
endif()
message(STATUS "${out}")
