// CC1 fase 4B -- `stackalloc T[n]`, ejecutando.
//
// DE DONDE VIENE. `stackalloc` parseaba, tipaba `T*` sin validar nada, y moria en el `default` del
// HIR. La misma forma que `sizeof` en la 4A: mitad delantera presente, feature ausente. Esta
// fixture es lo primero que EJECUTA un stackalloc en este compilador.
//
// QUE FIJA:
//   * el buffer existe, se escribe por indice y se lee de vuelta;
//   * el paso entre elementos es el del TIPO, no el de un puntero -- por eso hay un caso con
//     `byte` (paso 1) y otro con `double` (paso 8): si el paso fuera fijo, uno de los dos daria
//     basura;
//   * un struct como elemento se coloca con su tamano real, relleno incluido;
//   * dentro de un bucle, cada vuelta reserva su propio buffer -- que es lo que `stackalloc`
//     significa, y la razon por la que el alloca se emite donde esta la expresion y no en el
//     bloque de entrada.
//
// Codigo de salida esperado cuando el compilador esta sano: 42.
using NativeSharp.Core;

namespace cc1stackalloc
{
    // 4 + 1 + (3 de relleno) + 8 = 16. El mismo struct que mide la fixture c9_sizeof, a proposito:
    // si el paso de `stackalloc` y el `sizeof` se separaran alguna vez, las dos lo verian.
    public struct Padded
    {
        public int First;
        public byte Middle;
        public double Last;
    }

    class Program
    {
        public static int Main()
        {
            // --- paso 4: int ---------------------------------------------------------------
            int* numbers = stackalloc int[8];
            int index = 0;
            while (index < 8)
            {
                numbers[index] = index * 10;
                index = index + 1;
            }
            if (numbers[0] != 0) { return 1; }
            if (numbers[3] != 30) { return 2; }
            if (numbers[7] != 70) { return 3; }

            int sum = 0;
            index = 0;
            while (index < 8)
            {
                sum = sum + numbers[index];
                index = index + 1;
            }
            // 0+10+20+...+70
            if (sum != 280) { return 4; }

            // --- paso 1: byte ---------------------------------------------------------------
            // Si el paso fuera el de un puntero en vez del del elemento, escribir 4 bytes
            // consecutivos pisaria posiciones distintas y esto no cuadraria.
            byte* bytes = stackalloc byte[4];
            bytes[0] = 1;
            bytes[1] = 2;
            bytes[2] = 3;
            bytes[3] = 4;
            int byteSum = bytes[0] + bytes[1] + bytes[2] + bytes[3];
            if (byteSum != 10) { return 5; }

            // --- paso 8: double, que ademas exige alineacion --------------------------------
            // Un alloca de i8 sale alineado a 1. Si no se corrigiera la alineacion, esto seria un
            // acceso desalineado.
            double* reals = stackalloc double[3];
            reals[0] = 1.5;
            reals[1] = 2.5;
            reals[2] = 4.0;
            double total = reals[0] + reals[1] + reals[2];
            if (total != 8.0) { return 6; }

            // --- elemento struct, con relleno ------------------------------------------------
            Padded* records = stackalloc Padded[2];
            records[0].First = 7;
            records[0].Middle = 8;
            records[0].Last = 9.0;
            records[1].First = 70;
            records[1].Middle = 80;
            records[1].Last = 90.0;
            // Si el paso fuera 13 (la suma de los campos) en vez de 16 (el tamano real), el
            // segundo elemento pisaria el primero y este par no cuadraria.
            if (records[0].First != 7) { return 7; }
            if (records[1].First != 70) { return 8; }
            if (records[0].Middle != 8) { return 9; }
            if (records[1].Middle != 80) { return 10; }
            if (records[0].Last != 9.0) { return 11; }
            if (records[1].Last != 90.0) { return 12; }

            // --- el contador puede ser una expresion, no solo un literal ---------------------
            int wanted = 2 + 3;
            int* sized = stackalloc int[wanted];
            sized[0] = 100;
            sized[4] = 500;
            if (sized[0] != 100) { return 13; }
            if (sized[4] != 500) { return 14; }

            // --- dentro de un bucle ----------------------------------------------------------
            // Cada vuelta reserva lo suyo. Lo que se comprueba es que el buffer de cada vuelta
            // esta recien reservado y se comporta igual, no que las direcciones difieran.
            int rounds = 0;
            int checksum = 0;
            while (rounds < 3)
            {
                int* scratch = stackalloc int[2];
                scratch[0] = rounds;
                scratch[1] = rounds * 2;
                checksum = checksum + scratch[0] + scratch[1];
                rounds = rounds + 1;
            }
            // (0+0) + (1+2) + (2+4)
            if (checksum != 9) { return 15; }

            return 42;
        }
    }
}
