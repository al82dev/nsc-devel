// NativeSharp 3.0 / T05-F01 productive witness.
//
// A trait is a storage-free nominal behavior contract. The first vertical deliberately reuses the
// proven interface representation: constrained generic calls monomorphize to static dispatch and
// a trait-typed view uses the existing explicit interface dispatch table.
namespace c62ns3traitsdispatch
{
    public trait IScore
    {
        int Score();
    }

    public trait IDoubled : IScore
    {
        int Doubled();
    }

    public trait IMapper<T>
    {
        T Map(T value);
    }

    public class Number : IDoubled, IMapper<int>
    {
        private int value;
        public Number(int source) { value = source; }
        public int Score() { return value; }
        public int Doubled() { return value + value; }
        public int Map(int source) { return source + 1; }
    }

    public class Program
    {
        private static int StaticScore<T>(T value) where T : class, IScore
        {
            return value.Score();
        }

        public static int Main()
        {
            Number number = new Number(14);
            dyn IScore dynamicView = number;
            dyn IDoubled inheritedView = number;
            dyn IMapper<int> genericView = number;
            return StaticScore(number) + dynamicView.Score() +
                inheritedView.Doubled() + genericView.Map(14) - 29;
        }
    }
}
