struct Record
{
    public int Count;
    public long Balance;
    public static int Ignored;
}

static class Inspector
{
    public static int Format(int value) { return value; }
    public static int Format(long value) { return (int)value; }
    public static T Identity<T>(T value) { return value; }

    public static int Fold<T>(T value)
    {
        int result = 0;
        static foreach (field in Fields(T))
        {
            field.Type item = field.Get(value);
            if (field.Name == "Count") result = result + 100;
            if (field.Name == "Balance") result = result + 1000;
            result = result + Format(Identity<field.Type>(item));
        }
        return result;
    }
}

int Main()
{
    Record value = default(Record);
    value.Count = 3;
    value.Balance = 30L;
    return Inspector.Fold<Record>(value) == 1133 ? 0 : 1;
}
