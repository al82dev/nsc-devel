struct Empty { }

static class Inspector
{
    public static int Count<T>(T value)
    {
        int result = 0;
        static foreach (field in Fields(T))
        {
            result = result + 1;
        }
        return result;
    }
}

int Main()
{
    Empty value = default(Empty);
    return Inspector.Count<Empty>(value) == 0 ? 0 : 1;
}
