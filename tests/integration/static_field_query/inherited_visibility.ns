class Base
{
    public int Same;
    private int Secret;
    public Base() { this.Same = 3; this.Secret = 90; }
}

class Derived : Base
{
    public int Same;
    public Derived() { this.Same = 7; }
}

static class Inspector
{
    public static int Inspect<T>(T value)
    {
        int result = 0;
        static foreach (field in Fields(T))
        {
            result = result * 10 + field.Get(value);
        }
        return result;
    }
}

int Main()
{
    owned Derived value = new Derived();
    return Inspector.Inspect<Derived>(value) == 37 ? 0 : 1;
}
