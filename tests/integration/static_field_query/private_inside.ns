class Record
{
    private int Hidden;
    public int Visible;
    public Record() { this.Hidden = 3; this.Visible = 7; }
    public int Sum()
    {
        int sum = 0;
        static foreach (field in Fields(Record)) { sum = sum + field.Get(this); }
        return sum;
    }
}
int Main() { owned Record value = new Record(); return value.Sum() == 10 ? 0 : 1; }
