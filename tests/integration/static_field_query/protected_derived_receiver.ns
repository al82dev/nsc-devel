class Base { protected int Hidden; public int Visible; }
class Derived : Base
{
    public Derived() { this.Hidden = 3; this.Visible = 7; }
    public int Inspect(Derived other)
    {
        int sum = 0;
        static foreach (field in Fields(Derived)) { sum = sum + field.Get(other); }
        return sum;
    }
}
int Main() { owned Derived value = new Derived(); return value.Inspect(value) == 10 ? 0 : 1; }
