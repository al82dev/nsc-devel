class Record
{
    private int Hidden;
    public int Visible;
    public Record() { this.Hidden = 3; this.Visible = 7; }
}
int Main()
{
    owned Record value = new Record();
    int sum = 0;
    static foreach (field in Fields(Record)) { sum = sum + field.Get(value); }
    return sum == 7 ? 0 : 1;
}
