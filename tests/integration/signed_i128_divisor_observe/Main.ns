i128 Div(i128 a, i128 b) { return a / b; }
int Main()
{
    i128 a = (i128)1 << 63;
    i128 b = ((i128)1 << 64) - (i128)1;
    if (Div(a, b) != (i128)0) return 1;
    i128 minimum = (i128)1 << 127;
    if (Div(minimum, (i128)-1) != minimum) return 2;
    if (Div((i128)14, (i128)7) != (i128)2) return 3;
    return 0;
}
