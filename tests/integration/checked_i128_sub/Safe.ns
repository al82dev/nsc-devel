int Main()
{
    i128 half = (i128)1 << 126;
    i128 maximum = (half - (i128)1) * (i128)2 + (i128)1;
    i128 minimum = -maximum - (i128)1;
    i128 one = (i128)1;
    if (checked(maximum - one) != maximum - one) return 1;
    if (checked(minimum - (i128)-1) != minimum + one) return 2;
    if (checked(minimum - minimum) != (i128)0) return 3;
    if (minimum - one != maximum) return 4;
    if (maximum - (i128)-1 != minimum) return 5;
    return 0;
}
