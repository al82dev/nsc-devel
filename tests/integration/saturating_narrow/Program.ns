/// <summary>Checks the reported int-to-short and int-to-byte saturated casts.</summary>
int Main()
{
    int high = 40000;
    int low = -40000;
    int color = 290;
    int negative = -1;
    int ordinary = 123;
    if (saturating((short)high) != 32767 || saturating((short)low) != -32768)
    {
        return 1;
    }
    if (saturating((byte)color) != 255 || saturating((byte)negative) != 0)
    {
        return 2;
    }
    if (saturating((short)ordinary) != 123 || saturating((byte)ordinary) != 123)
    {
        return 3;
    }
    if ((byte)color != 34)
    {
        return 4;
    }
    int shortMinimum = -32768;
    int belowShortMinimum = -32769;
    int shortMaximum = 32767;
    int aboveShortMaximum = 32768;
    if (saturating((short)shortMinimum) != -32768 ||
        saturating((short)belowShortMinimum) != -32768 ||
        saturating((short)shortMaximum) != 32767 ||
        saturating((short)aboveShortMaximum) != 32767)
    {
        return 5;
    }
    int byteMinimum = 0;
    int belowByteMinimum = -1;
    int byteMaximum = 255;
    int aboveByteMaximum = 256;
    if (saturating((byte)byteMinimum) != 0 ||
        saturating((byte)belowByteMinimum) != 0 ||
        saturating((byte)byteMaximum) != 255 ||
        saturating((byte)aboveByteMaximum) != 255)
    {
        return 6;
    }
    return 0;
}
