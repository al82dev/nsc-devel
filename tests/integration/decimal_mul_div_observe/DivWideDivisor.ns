noinline decimal Divide(decimal a, decimal b) { return checked(a / b); }
int Main()
{
    unsafe("inspect 96-bit decimal divisor")
    {
        i128 bits = (i128)1 << 64;
        decimal value = *((decimal*)&bits);
        decimal result = Divide(value, value);
        return result == 1m ? 0 : 1;
    }
}
