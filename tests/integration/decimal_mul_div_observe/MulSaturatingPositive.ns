noinline decimal Multiply(decimal a, decimal b) { return saturating(a * b); }
int Main()
{
    unsafe("inspect saturated decimal coefficient")
    {
        i128 bits = ((i128)1 << 96) - (i128)1;
        decimal value = *((decimal*)&bits);
        decimal result = Multiply(value, 2m);
        return *((i128*)&result) == bits ? 0 : 1;
    }
}
