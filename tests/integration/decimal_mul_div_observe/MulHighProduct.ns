noinline decimal Multiply(decimal a, decimal b) { return checked(a * b); }
int Main()
{
    unsafe("inspect product above 128 bits")
    {
        i128 bits = (i128)1 << 80;
        decimal value = *((decimal*)&bits);
        decimal result = Multiply(value, value);
        return result == 0m ? 1 : 2;
    }
}
