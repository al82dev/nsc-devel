noinline decimal Multiply(decimal a, decimal b) { return checked(a * b); }
int Main()
{
    unsafe("inspect 96-bit decimal coefficient")
    {
        i128 bits = (i128)1 << 64;
        decimal value = *((decimal*)&bits);
        decimal result = Multiply(value, 1m);
        return *((i128*)&result) == bits ? 0 : 1;
    }
}
