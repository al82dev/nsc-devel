noinline decimal Divide(decimal a, decimal b) { return checked(a / b); }
int Main()
{
    unsafe("inspect decimal division overflow")
    {
        i128 bits = ((i128)1 << 96) - (i128)1;
        decimal value = *((decimal*)&bits);
        decimal result = Divide(value, 0.1m);
        return result == 0m ? 1 : 2;
    }
}
