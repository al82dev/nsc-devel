noinline decimal Divide(decimal a, decimal b) { return saturating(a / b); }

int Main()
{
    unsafe("test negative inexact saturating decimal quotient")
    {
        i128 minimumBits = (((i128)1 << 96) - (i128)1) | ((i128)1 << 127);
        decimal minimum = *((decimal*)&minimumBits);
        decimal value = Divide(minimum, 2.0m);
        return value == 0m ? 1 : 2;
    }
}
