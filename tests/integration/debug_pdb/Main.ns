namespace NativeSharp.Core
{
    public class Exception { }
}

namespace DebugFixture
{
    using NativeSharp.Core;

    extern C delegate int Transform(int value);
    delegate int Reader();

    public class DebugProblem : Exception { }

    public class GeneratedState
    {
        public static int Seed = 42;
    }

    public class Resource
    {
        public int Value;

        ~Resource()
        {
            Value = 0;
        }
    }

    public struct Pair
    {
        public int Left;
        public int Right;

        public int Total()
        {
            return this.Left + this.Right;
        }
    }

    public static class Program
    {
        public static int Compute(int left, int right)
        {
            int total = left + right;
            return total;
        }

        public static int Sum(Pair pair)
        {
            return pair.Left + pair.Right;
        }

        public static int Increment(int value)
        {
            return value + 1;
        }

        public static int Read(Reader reader)
        {
            return reader();
        }

        public static int MaybeThrow(bool fail)
        {
            if (fail)
            {
                throw new DebugProblem();
            }
            return GeneratedState.Seed;
        }

        public static export extern C int ExportedIdentity(int value)
        {
            return value;
        }

        public static int Main()
        {
            int answer = Compute(40, 2);
            Transform transform = Increment;
            answer = transform(answer - 1);
            Pair pair;
            pair.Left = answer;
            pair.Right = 0;
            if (answer == 42)
            {
                int scoped = pair.Total();
                answer = scoped;
            }
            int captured = answer;
            raii Reader reader = () => captured;
            answer = Read(reader);
            raii Resource resource = new Resource();
            resource.Value = answer;
            try
            {
                answer = MaybeThrow(false);
            }
            catch (DebugProblem problem)
            {
                answer = 0;
            }
            answer = resource.Value;
            return answer;
        }
    }
}
