namespace NativeSharp.Core
{
    public class Exception { }
}

namespace DebugFixture
{
    using NativeSharp.Core;

    extern C delegate int Transform(int value);
    delegate int Reader();
    delegate void Changed(int value);

    public class DebugProblem : Exception { }
    public class OtherProblem : Exception { }

    public class GeneratedState
    {
        public static int Seed = 42;
    }

    public class Resource
    {
        public int Value;

        ~Resource()
        {
            Value = 0;
        }
    }

    public class EhState
    {
        public static int Destructions = 0;
    }

    public class UnwindResource
    {
        ~UnwindResource()
        {
            EhState.Destructions = EhState.Destructions + 1;
        }
    }

    public interface IValueSource
    {
        int ReadValue();
    }

    public abstract class ValueSource
    {
        public abstract int ReadValue();
    }

    public class DispatchSource : ValueSource, IValueSource
    {
        public int Value;

        public DispatchSource(int value)
        {
            Value = value;
        }

        public override int ReadValue()
        {
            return Value;
        }
    }

    public class HandlerHost
    {
        public int Last;

        public void OnChanged(int value)
        {
            Last = value;
        }

        public int Read()
        {
            return Last;
        }
    }

    public struct Pair
    {
        public int Left;
        public int Right;

        public int Total()
        {
            return this.Left + this.Right;
        }
    }

    public struct WideValue
    {
        public int First;
        public int Second;
        public int Third;
    }

    public static class Program
    {
        public static event Changed StaticChanged;

        public static int Compute(int left, int right)
        {
            int total = left + right;
            return total;
        }

        public static int Sum(Pair pair)
        {
            return pair.Left + pair.Right;
        }

        public static WideValue MakeWide(int first, int second, int third)
        {
            WideValue value;
            value.First = first;
            value.Second = second;
            value.Third = third;
            return value;
        }

        public static int SumWide(WideValue value)
        {
            return value.First + value.Second + value.Third;
        }

        public static int Increment(int value)
        {
            return value + 1;
        }

        public static int Read(Reader reader)
        {
            return reader();
        }

        public static void OnStaticChanged(int value)
        {
            GeneratedState.Seed = value;
        }

        public static int MaybeThrow(bool fail)
        {
            if (fail)
            {
                throw new DebugProblem();
            }
            return GeneratedState.Seed;
        }

        public static int ExerciseEh()
        {
            EhState.Destructions = 0;
            int value = 0;
            try
            {
                raii UnwindResource guard = new UnwindResource();
                value = MaybeThrow(true);
            }
            catch (DebugProblem problem)
            {
                value = 40;
            }
            finally
            {
                value = value + 1;
            }
            try
            {
                OtherProblem problem = new OtherProblem();
                throw problem;
            }
            catch
            {
                value = value + 0;
            }
            return value + EhState.Destructions;
        }

        public static export extern C int ExportedIdentity(int value)
        {
            return value;
        }

        public static int Main()
        {
            int answer = Compute(40, 2);
            Transform transform = Increment;
            answer = transform(answer - 1);
            Pair pair;
            pair.Left = answer;
            pair.Right = 0;
            if (answer == 42)
            {
                int scoped = pair.Total();
                answer = scoped;
            }
            int captured = answer;
            raii Reader reader = () => captured;
            answer = Read(reader);
            DispatchSource dispatch = new DispatchSource(answer);
            ValueSource virtualView = dispatch;
            IValueSource interfaceView = dispatch;
            answer = virtualView.ReadValue();
            answer = interfaceView.ReadValue();
            HandlerHost handler = new HandlerHost();
            StaticChanged += OnStaticChanged;
            StaticChanged += handler.OnChanged;
            StaticChanged(answer);
            StaticChanged -= handler.OnChanged;
            StaticChanged -= OnStaticChanged;
            Reader instanceReader = handler.Read;
            answer = Read(instanceReader);
            WideValue wide = MakeWide(answer, 0, 0);
            answer = SumWide(wide);
            raii Resource resource = new Resource();
            resource.Value = answer;
            answer = ExerciseEh();
            answer = resource.Value;
            delete handler;
            delete dispatch;
            return answer;
        }
    }
}
