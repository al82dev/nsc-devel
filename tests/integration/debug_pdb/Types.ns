namespace DebugFixture
{
    public enum DebugMode : byte
    {
        Empty = 0,
        Answer = 42
    }

    public class BaseRecord
    {
        public int BaseValue;
    }

    public class DerivedRecord : BaseRecord
    {
        public int DerivedValue;
    }

    public class Box<T>
    {
        public T Value;
    }

    public size(8) union NumberBits
    {
        public at(0) long Whole;
        public at(0) double Real;
    }

    public static class TypeSurface
    {
        public static int LabelLength(string label)
        {
            return label.Length;
        }

        public static int ExerciseTypes(int input)
        {
            DebugMode mode = DebugMode.Answer;
            int[] values = new int[2];
            values[0] = input;
            values[1] = 0;
            string label = "PDB";
            raii DerivedRecord derived = new DerivedRecord();
            derived.BaseValue = values[0];
            derived.DerivedValue = LabelLength(label);
            raii Box<int> box = new Box<int>();
            box.Value = derived.BaseValue;
            NumberBits bits;
            bits.Whole = 42;
            int capturedTypeValue = box.Value;
            raii Reader typedReader = () => capturedTypeValue;
            int result = typedReader();
            if (mode != DebugMode.Answer) { result = 0; }


            delete[] values;
            return result;
        }
    }
}
