int Main()
{
    i128 half = (i128)1 << 126;
    i128 maximum = (half - (i128)1) * (i128)2 + (i128)1;
    i128 minimum = -maximum - (i128)1;
    if (checked(maximum + (i128)0) != maximum) return 1;
    if (checked(minimum + (i128)0) != minimum) return 2;
    if (checked(maximum + (i128)-1) != maximum - (i128)1) return 3;
    if (checked(minimum + (i128)1) != minimum + (i128)1) return 4;
    if (maximum + (i128)1 != minimum) return 5;
    return 0;
}
