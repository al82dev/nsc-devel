/// <summary>Checks the reported decimal literals through arithmetic and narrowing.</summary>
int Main()
{
    decimal net = 19.95m;
    decimal tax = checked(net * 0.16m);
    decimal gross = checked(net + tax);
    if (!(checked(0.1m + 0.2m) == 0.3m))
    {
        return 1;
    }
    if (RoundCents(gross) != 2314 || RoundCents(1.005m) != 101)
    {
        return 2;
    }
    if ((long)(0.3m * 100.0m) != 30 || (long)(19.95m * 100.0m) != 1995)
    {
        return 3;
    }
    if ((long)(3e-1m * 100.0m) != 30 || (long)3e+1m != 30)
    {
        return 4;
    }
    return 0;
}

/// <summary>Rounds a non-negative amount to cents using the reported expression.</summary>
long RoundCents(decimal amount)
{
    return (long)checked(amount * 100.0m + 0.5m);
}
