public class CompoundIndexCounter
{
    public static int calls;
    public static int Index() { calls = calls + 1; return 0; }
    public static int IndexOther() { calls = calls + 1; return 1; }
    public static PairIn MutateAndReturn(PairIn[] values)
    {
        values[0] = new PairIn(100.0, 200.0);
        return new PairIn(3.0, 4.0);
    }
}

int Main()
{
    PairIn a = new PairIn(1.0, 2.0);
