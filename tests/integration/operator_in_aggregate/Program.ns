    PairIn aliasResult = a + a;
    if (aliasResult.x != 2.0 || aliasResult.y != 4.0 || a.x != 1.0 || a.y != 2.0) return 14;
    PairIn equal = new PairIn(1.0, 2.0);
    PairIn different = new PairIn(1.0, 3.0);
    if (!(a == equal) || !(a != different) || a == different) return 13;
    PairIn scaleLeft = a * 2.0;
    PairIn scaleRight = 2.0 * a;
    if (scaleLeft.x != 2.0 || scaleLeft.y != 4.0) return 11;
    if (scaleRight.x != 2.0 || scaleRight.y != 4.0) return 12;
    scaleLeft *= 2.0;
    if (scaleLeft.x != 4.0 || scaleLeft.y != 8.0) return 18;
    raii PairInHolder holder = new PairInHolder();
    holder.left = new PairIn(1.0, 2.0);
    holder.right = new PairIn(3.0, 4.0);
    PairIn fieldResult = holder.left + holder.right;
    if (fieldResult.x != 4.0 || fieldResult.y != 6.0) return 9;
    PairIn[] values = new PairIn[2];
    values[0] = new PairIn(1.0, 2.0);
    values[1] = new PairIn(3.0, 4.0);
    PairIn arrayResult = values[0] + values[1];
    bool arrayOk = arrayResult.x == 4.0 && arrayResult.y == 6.0;
    values[CompoundIndexCounter.Index()] += values[1];
    if (CompoundIndexCounter.calls != 1 || values[0].x != 4.0 || values[0].y != 6.0) return 16;
    values[0] += values[0];
    if (values[0].x != 8.0 || values[0].y != 12.0) return 17;
    values[0] = new PairIn(1.0, 2.0);
    values[CompoundIndexCounter.Index()] += CompoundIndexCounter.MutateAndReturn(values);
    if (CompoundIndexCounter.calls != 2 || values[0].x != 103.0 || values[0].y != 204.0) return 19;
    RefAddition[] refs = new RefAddition[2];
    refs[0] = new RefAddition(1);
    refs[1] = new RefAddition(2);
    refs[CompoundIndexCounter.Index()] += refs[CompoundIndexCounter.IndexOther()];
    if (CompoundIndexCounter.calls != 4 || refs[0].value != 113 || refs[1].value != 102) return 20;
    refs[0] = new RefAddition(1);
    refs[0] += refs[0];
    if (refs[0].value != 222) return 21;
    delete[] refs;
    InRefAddition inRef = new InRefAddition(1);
    InRefAddition inRefExpected = inRef + inRef;
    inRef = new InRefAddition(1);
    inRef += inRef;
    if (inRef.value != inRefExpected.value || inRef.value != 4) return 22;
    RefInAddition refIn = new RefInAddition(1);
    RefInAddition refInExpected = refIn + refIn;
    refIn = new RefInAddition(1);
    refIn += refIn;
