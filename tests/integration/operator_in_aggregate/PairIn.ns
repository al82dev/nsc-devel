public struct PairIn
{
    public double x;
    public double y;
    public PairIn(double a, double b) { x = a; y = b; }
    public static PairIn operator +(in PairIn a, in PairIn b) { return new PairIn(a.x + b.x, a.y + b.y); }
    public static PairIn operator *(in PairIn a, double scalar) { return new PairIn(a.x * scalar, a.y * scalar); }
    public static PairIn operator *(double scalar, in PairIn a) { return new PairIn(a.x * scalar, a.y * scalar); }
    public static bool operator ==(in PairIn a, in PairIn b) { return a.x == b.x && a.y == b.y; }
    public static bool operator !=(in PairIn a, in PairIn b) { return a.x != b.x || a.y != b.y; }
    public static double Read(in PairIn a) { return a.x + a.y; }
    public static double Named(in PairIn first, in PairIn second)
    {
        return first.x * 1000.0 + first.y * 100.0 + second.x * 10.0 + second.y;
    }
    public static void Mutate(ref PairIn p) { p.x = p.x + 10.0; p.y = p.y + 20.0; }
    public static void Fill(out PairIn p) { p = new PairIn(7.0, 8.0); }
    public static double MutateCopy(PairIn p) { p.x = 9.0; return p.x * 10.0 + p.y; }
}
