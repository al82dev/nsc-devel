using NativeSharp.Examples.Chapter16.GenericVectorAndMatrix;

/// <summary>Exercises allocation, stores and loads for decimal in a generic array.</summary>
int Main()
{
    raii Matrix<decimal> matrix = new Matrix<decimal>(2, 2);
    matrix.Set(0, 0, 1.0m);
    matrix.Set(1, 1, 2.0m);
    if ((int)matrix.Get(0, 0) != 1 || (int)matrix.Get(1, 1) != 2)
    {
        return 1;
    }
    matrix.Set(0, 0, 0.1m);
    matrix.Set(0, 1, 2.50m);
    matrix.Set(1, 0, -0.3m);
    matrix.Set(1, 1, 7.125m);
    if (matrix.Get(0, 0) != 0.1m || matrix.Get(0, 1) != 2.50m ||
        matrix.Get(1, 0) != -0.3m || matrix.Get(1, 1) != 7.125m)
    {
        return 2;
    }
    matrix.Set(0, 1, 0.75m);
    if (matrix.Get(0, 1) != 0.75m || matrix.Get(1, 1) != 7.125m)
    {
        return 3;
    }
    return 0;
}
