namespace NativeSharp.Core
{
    public class Exception { }
    public static class Environment
    {
        public static void Exit(int exitCode) { }
    }
}

namespace DebugValuesT37
{
    using NativeSharp.Core;

    public int GlobalCount = 5;

    public class SpecificError : Exception { }

    public class Widget
    {
        public static int Created = 4;
        public static int Destroyed = 4;
    }

    public static class Program
    {
        public static int Capture(int literal, int fromCaller, out int produced)
        {
            produced = literal + fromCaller;
            return produced;
        }

        public static int CatchValue()
        {
            try
            {
                throw new SpecificError();
            }
            catch (SpecificError specific)
            {
                return 1;
            }
        }

        public static int Main()
        {
            int callerValue = 2;
            int outValue;
            int captured = Capture(26, callerValue, out outValue);
            return captured + DebugValuesT37.GlobalCount + Widget.Created + Widget.Destroyed + CatchValue();
        }
    }

    public static class ProcessEntry
    {
        public static export extern C void DebugValuesT37Start()
        {
            Environment.Exit(Program.Main());
        }
    }
}
