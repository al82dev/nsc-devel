extern C int puts(char* text);

struct Pair
{
    int A;
    int B;
}

enum Mode
{
    Off = 0,
    On = 1,
}

Pair MakePair()
{
    Pair p;
    p.A = 1;
    p.B = 2;
    return p;
}

long Promote(int value)
{
    return value;
}

int Main()
{
    byte small = 1;
    ++small;
    small++;
    small += 3;

    int value = 10;
    int* pointer = &value;
    *pointer = 20;
    pointer += 1;
    pointer -= 1;
    nint difference = pointer - pointer;

    int[4] values;
    for (int i = 0; i < 4; i++)
    {
        values[i] = i;
    }

    int index = 0;
    while (index < 4)
    {
        if (index == 2)
        {
            index++;
            continue;
        }
        else if (index == 3)
        {
            break;
        }
        index++;
    }

    Pair pair = MakePair();
    Pair* pairPointer = &pair;
    int extracted = MakePair().B;
    pairPointer->A += extracted;

    void* raw = pointer;
    int* restored = (int*)raw;
    nuint address = (nuint)restored;
    restored = (int*)address;

    int* scalar = new int;
    delete scalar;
    int* heap = new int[4];
    heap[0] = values[0];
    delete[] heap;
    delete null;
    delete[] null;

    int* temporary = stackalloc int[4];
    temporary[0] = pair.A;

    nuint pairSize = sizeof(Pair);
    nuint unevaluated = sizeof(index++);

    Mode mode = Mode.On;
    int modeValue = (int)mode;

    double floating = 2.0f + 3;
    int narrowed = (int)floating;

    bool positive = pairSize > 0u && true;
    if (positive || false)
    {
        puts("HIR stage 11");
    }

    long promoted = Promote(narrowed);
    return (int)(difference + temporary[0] + pairPointer->A + modeValue + (nint)promoted + (nint)unevaluated);
}
