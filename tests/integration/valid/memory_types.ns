struct Pair
{
    int X;
    int Y;
}

enum Mode
{
    First,
    Second = First + 2,
}

int Main()
{
    Pair value;
    value.X = 1;
    value.Y = 2;
    Pair* pointer = &value;
    int[3] values;
    values[0] = pointer->X;
    values[1] = value.Y;
    int* heap = new int[3];
    int* local = stackalloc int[3];
    heap[0] = values[0];
    local[0] = heap[0];
    delete[] heap;
    return local[0] + (int)Mode.Second + (int)sizeof(Pair);
}
