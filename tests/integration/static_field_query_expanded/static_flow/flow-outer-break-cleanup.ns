class State { public static int Drops=0; public static int Defers=0; public static int Finals=0; } class Resource { ~Resource() { State.Drops=State.Drops+1; } } struct A { public int X; public int Y; } struct B { public int P; public int Q; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; int ignored=loop outer { static foreach (field in Fields(A)) { owned Resource r=new Resource(); defer [] { State.Defers=State.Defers+1; } try { sum=sum+field.Get(a); break outer: 0; } finally { State.Finals=State.Finals+1; } } break outer: 9; }; return ignored==0 && sum==1 && State.Drops==1 && State.Defers==1 && State.Finals==1 ? 0 : 1; }