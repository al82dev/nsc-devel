struct A { public int X; public int Y; } struct B { public int P; public int Q; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; int i=0; while(i<2) { i=i+1; static foreach (field in Fields(A)) { sum=sum+field.Get(a); break; } sum=sum+10; } return sum==22 ? 0 : 1; }