struct A { public int X; public int Y; } struct B { public int P; public int Q; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; static foreach (field in Fields(A)) { switch(field.Get(a)) { case 1: sum=sum+10; break; default: sum=sum+20; } } return sum==30 ? 0 : 1; }