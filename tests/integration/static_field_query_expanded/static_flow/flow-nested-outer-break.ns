struct A { public int X; public int Y; } struct B { public int P; public int Q; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; int ignored=loop outside { static foreach (outer in Fields(A)) { static foreach (inner in Fields(B)) { sum=sum+outer.Get(a)+inner.Get(b); break outside: 0; } } break outside: 9; }; return ignored==0 && sum==4 ? 0 : 1; }