int Main()
{
    owned GenericInheritance.Box<int> value = new GenericInheritance.Box<int>();
    value.SetBase(3);
    value.Value = 7;
    int sum = 0;
    static foreach (field in Fields(GenericInheritance.Box<int>)) { sum = sum + field.Get(value); }
    return value.ReadBase() == 3 && value.Value == 7 && sum == 10 ? 0 : 1;
}
