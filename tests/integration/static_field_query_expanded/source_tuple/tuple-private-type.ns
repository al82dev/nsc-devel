class Outer { private struct P { public int X; } public struct Record { public (int,P) Pair; } public static int Run() { Record value=default(Record); int count=0; static foreach (field in Fields(Record)) { field.Type item=field.Get(value); count=count+1; } return count==1 ? 0 : 1; } } int Main() { return Outer.Run(); }