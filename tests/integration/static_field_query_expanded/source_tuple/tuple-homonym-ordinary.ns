namespace Alpha { public struct P { public int X; } } namespace Beta { public struct P { public int X; } } struct Record { public (int,Alpha.P) Left; public (int,Beta.P) Right; } class Check { public static int Tag((int,Alpha.P) x) { return 1; } public static int Tag((int,Beta.P) x) { return 2; } } int Main() { Record value=default(Record); return Check.Tag(value.Left)+Check.Tag(value.Right)==3 ? 0 : 1; }