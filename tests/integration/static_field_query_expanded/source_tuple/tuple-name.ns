struct Record { public (int, long) Pair; public int X; } struct Other { public (int, long) Pair; public int X; } int Main() { Record value=default(Record); value.X=7; int count=0; static foreach (field in Fields(Record)) { if(field.Name=="Pair") count=count+1; if(field.Name=="X") count=count+1; } return count==2 ? 0 : 1; }