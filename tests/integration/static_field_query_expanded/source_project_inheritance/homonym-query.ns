class Box : Alpha.Base<int> { public int Tail; } int Main() { owned Box value=new Box(); value.Set(3); value.Tail=7; owned Beta.Base<int> other=new Beta.Base<int>(); other.Set(9); int sum=0; static foreach (field in Fields(Box)) { sum=sum+field.Get(value); } return sum==10 && other.Read()==9 && other.Extra==5 ? 0 : 1; }