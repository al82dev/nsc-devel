class Base { public int Same; public void SetBase() { Same=3; } public int ReadBase() { return Same; } } class Derived : Base { public int Same; } struct B { public int P; public int Q; } int Main() { owned Derived a=new Derived(); a.SetBase(); a.Same=7; B b=default(B); b.P=3; b.Q=4; int sum=0; static foreach (outer in Fields(Derived)) { static foreach (inner in Fields(B)) { sum=sum+outer.Get(a)*inner.Get(b); } } return sum==70 && a.ReadBase()==3 ? 0 : 1; }