struct A { public int X; public int Y; } struct B { public int P; public int Q; } struct C { public int R; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; C c=default(C); c.R=2; static foreach (outer in Fields(A)) { static foreach (middle in Fields(B)) { static foreach (inner in Fields(C)) { sum=sum+outer.Get(c)+middle.Get(b)+inner.Get(c); } } } return sum; }