static class Inspector
{
    public static int Fold<T>(T value)
    {
        int sum = 0;
        static foreach (field in Fields(T)) { sum = sum + field.Get(value); }
        return sum;
    }
}
int Main()
{
    owned MetadataFields.Record value = new MetadataFields.Record();
    value.First = 7;
    value.Last = 3;
    value.Automatic = 100;
    MetadataFields.Extra extra = default(MetadataFields.Extra);
    extra.Value = 1L;
    MetadataFields.Other other = default(MetadataFields.Other);
    other.Unused = 2;
    return Inspector.Fold<MetadataFields.Record>(value) == 10 && extra.Value == 1L && other.Unused == 2 ? 0 : 1;
}
