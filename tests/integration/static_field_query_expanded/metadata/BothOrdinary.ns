int Main()
{
    owned MetadataFields.Record value = new MetadataFields.Record();
    value.First = 7;
    value.Last = 3;
    value.Automatic = 100;
    MetadataFields.Extra extra = default(MetadataFields.Extra);
    extra.Value = 1L;
    MetadataFields.Other other = default(MetadataFields.Other);
    other.Unused = 2;
    return value.First + value.Last == 10 && value.Automatic == 100 && value.ReadHidden() == 40 && extra.Value == 1L && other.Unused == 2 ? 0 : 1;
}
