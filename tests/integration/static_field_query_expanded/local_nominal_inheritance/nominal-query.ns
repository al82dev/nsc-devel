class Base { private int Hidden; public int Same; public void SetBase(int value) { Same=value; Hidden=4; } public int ReadBase() { return Same; } public int ReadHidden() { return Hidden; } } class Box<T> : Base { public T Same; } int Main() { owned Box<int> value=new Box<int>(); value.SetBase(3); value.Same=7; int sum=0; static foreach (field in Fields(Box<int>)) { sum=sum+field.Get(value); } return sum==10 && value.ReadHidden()==4 ? 0 : 1; }