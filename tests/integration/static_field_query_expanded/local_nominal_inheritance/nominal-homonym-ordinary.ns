namespace Alpha { class Base { public int Value; public void Set(int value) { Value=value; } public int Read() { return Value; } } class Box<T> : Base { public T Tail; } } namespace Beta { class Base { public int Value; public void Set(int value) { Value=value; } public int Read() { return Value; } } class Box<T> : Base { public T Tail; public int Extra; } } int Main() { owned Alpha.Box<int> a=new Alpha.Box<int>(); a.Set(3); a.Tail=7; owned Beta.Box<int> b=new Beta.Box<int>(); b.Set(5); b.Tail=8; b.Extra=2; return a.Read()==3 && a.Tail==7 && b.Read()==5 && b.Tail==8 && b.Extra==2 ? 0 : 1; }