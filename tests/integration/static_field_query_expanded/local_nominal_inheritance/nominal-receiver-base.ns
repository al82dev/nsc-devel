class Base { private int Hidden; public int Same; public void SetBase(int value) { Same=value; Hidden=4; } public int ReadBase() { return Same; } public int ReadHidden() { return Hidden; } } class Box<T> : Base { public T Same; } int Main() { owned Base value=new Base(); int sum=0; static foreach (field in Fields(Box<int>)) { sum=sum+field.Get(value); } return sum; }