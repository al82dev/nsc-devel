namespace Alpha { class Base { public int Value; public void Set(int value) { Value=value; } public int Read() { return Value; } } class Box<T> : Base { public T Tail; } } namespace Beta { class Base { public int Value; public void Set(int value) { Value=value; } public int Read() { return Value; } } class Box<T> : Base { public T Tail; public int Extra; } } int Main() { owned Beta.Box<int> a=new Beta.Box<int>(); int x=0; static foreach (field in Fields(Alpha.Box<int>)) { x=x+field.Get(a); } return x; }