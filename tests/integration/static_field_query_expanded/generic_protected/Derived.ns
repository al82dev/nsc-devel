class Box<T>
{
    protected int Hidden;
    public int Visible;
    public Box() { this.Hidden = 3; this.Visible = 7; }
}
class Derived : Box<int>
{
    public int Sum()
    {
        int sum = 0;
        static foreach (field in Fields(Box<int>)) { sum = sum + field.Get(this); }
        return sum;
    }
}
int Main() { owned Derived value = new Derived(); return value.Sum() == 10 ? 0 : 1; }
