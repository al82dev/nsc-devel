class Box<T>
{
    protected int Hidden;
    public int Visible;
    public Box() { this.Hidden = 3; this.Visible = 7; }
}
int Main()
{
    owned Box<int> value = new Box<int>();
    int sum = 0;
    static foreach (field in Fields(Box<int>)) { sum = sum + field.Get(value); }
    return sum == 7 ? 0 : 1;
}
