class Box<T>
{
    protected int Hidden;
    public int Visible;
    public Box() { this.Hidden = 3; this.Visible = 7; }
    public int Sum()
    {
        int sum = 0;
        static foreach (field in Fields(Box<T>)) { sum = sum + field.Get(this); }
        return sum;
    }
}
int Main() { owned Box<int> value = new Box<int>(); return value.Sum() == 10 ? 0 : 1; }
