delegate int Read(); struct A { public int X; public int Y; } struct B { public int P; public int Q; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; static foreach (field in Fields(A)) { raii Read read=[copy a] () => field.Get(a); sum=sum+read(); } return sum==3 ? 0 : 1; }