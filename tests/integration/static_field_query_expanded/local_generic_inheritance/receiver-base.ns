class Base<T> { private int Hidden; public T Same; public void SetBase(T value) { Same=value; Hidden=4; } public T ReadBase() { return Same; } public int ReadHidden() { return Hidden; } } class Box<T> : Base<T> { public T Same; } int Main() { owned Base<int> value=new Base<int>(); int sum=0; static foreach (field in Fields(Box<int>)) { sum=sum+field.Get(value); } return sum; }