namespace Alpha { class Base<T> { public T Value; public void Set(T value) { Value=value; } public T Read() { return Value; } } class Box<T> : Base<T> { public T Tail; } } namespace Beta { class Base<T> { public T Value; public void Set(T value) { Value=value; } public T Read() { return Value; } } class Box<T> : Base<T> { public T Tail; public int Extra; } } int Main() { owned Alpha.Box<int> a=new Alpha.Box<int>(); a.Set(3); a.Tail=7; owned Beta.Box<int> b=new Beta.Box<int>(); b.Set(5); b.Tail=8; b.Extra=2; int y=0; static foreach (field in Fields(Beta.Box<int>)) { y=y+field.Get(b); } int x=0; static foreach (field in Fields(Alpha.Box<int>)) { x=x+field.Get(a); } return x==10 && y==15 ? 0 : 1; }