namespace Alpha { class Base<T> { public T Value; public void Set(T value) { Value=value; } public T Read() { return Value; } } class Box<T> : Base<T> { public T Tail; } } namespace Beta { class Base<T> { public T Value; public void Set(T value) { Value=value; } public T Read() { return Value; } } class Box<T> : Base<T> { public T Tail; public int Extra; } } int Main() { owned Beta.Box<int> a=new Beta.Box<int>(); int x=0; static foreach (field in Fields(Alpha.Box<int>)) { x=x+field.Get(a); } return x; }