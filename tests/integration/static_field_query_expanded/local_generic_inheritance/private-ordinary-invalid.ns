class Base<T> { private int Hidden; public T Same; public void SetBase(T value) { Same=value; Hidden=4; } public T ReadBase() { return Same; } public int ReadHidden() { return Hidden; } } class Box<T> : Base<T> { public T Same; } int Main() { owned Box<int> value=new Box<int>(); value.SetBase(3); value.Same=7; return value.Hidden; }