struct A { public int X; public int Y; } struct B { public int P; public int Q; } int Main() { A a=default(A); B b=default(B); a.X=1; a.Y=2; b.P=3; b.Q=4; int sum=0; int mask=0; static foreach (field in Fields(A)) { if(nameof(field.Name)!="Name") return 1; if(field.Name=="X") mask=mask+1; if(field.Name=="Y") mask=mask+2; static foreach (field in Fields(B)) { if(nameof(field)!="field" || nameof(field.Name)!="Name" || nameof(field.Get(b))!="Get") return 1; if(field.Name=="P") mask=mask+4; if(field.Name=="Q") mask=mask+8; } } return mask==27 ? 0 : 1; }