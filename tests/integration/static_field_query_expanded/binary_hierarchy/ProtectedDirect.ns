class Inspector : BinaryHierarchy.Base
{
    public int Inspect()
    {
        int result = 0;
        static foreach (field in Fields(BinaryHierarchy.Base)) { result = result * 10 + field.Get(this); }
        return result;
    }
}
int Main() { owned Inspector value = new Inspector(); return value.Inspect() == 34 ? 0 : 1; }
