u128 Rem(u128 a, u128 b) { return a % b; }
int Main()
{
    u128 big = ((u128)1 << 80) + (u128)19;
    if (Rem(big, (u128)7) != (u128)2) return 1;
    u128 maximum = ~((u128)0);
    if (Rem(maximum, (u128)1) != (u128)0) return 2;
    if (Rem(maximum, maximum) != (u128)0) return 3;
    if (Rem(maximum, (u128)2) != (u128)1) return 4;
    u128 top = (u128)1 << 127;
    if (Rem(top, (u128)2) != (u128)0) return 5;
    if (Rem((u128)1, maximum) != (u128)1) return 6;
    if (Rem(maximum, top) != top - (u128)1) return 7;
    return 0;
}
