i128 Rem(i128 a, i128 b) { return a % b; }
int Main()
{
    i128 big = ((i128)1 << 80) + (i128)19;
    i128 divisor = (i128)7;
    if (Rem(big, divisor) != (i128)2) return 1;
    if (Rem(-big, divisor) != (i128)-2) return 2;
    if (Rem(big, -divisor) != (i128)2) return 3;
    if (Rem(-big, -divisor) != (i128)-2) return 4;
    i128 minimum = (i128)1 << 127;
    if (Rem(minimum, (i128)-1) != (i128)0) return 5;
    if (Rem(minimum, (i128)3) != (i128)-2) return 6;
    if (Rem((i128)1, big) != (i128)1) return 7;
    if (Rem((i128)-1, big) != (i128)-1) return 8;
    if (Rem(big, (i128)1) != (i128)0) return 9;
    i128 nearHalf = (i128)1 << 63;
    i128 nearWord = ((i128)1 << 64) - (i128)1;
    if (Rem(nearHalf, nearWord) != nearHalf) return 10;
    if (Rem(minimum, minimum) != (i128)0) return 11;
    if (Rem(minimum, minimum + (i128)1) != (i128)-1) return 12;
    return 0;
}
