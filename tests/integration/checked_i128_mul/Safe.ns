i128 Multiply(i128 a, i128 b) { return checked(a * b); }
int Main()
{
    i128 half = (i128)1 << 126;
    i128 maximum = (half - (i128)1) * (i128)2 + (i128)1;
    i128 minimum = -maximum - (i128)1;
    if (Multiply(half, (i128)-1) != -half) return 1;
    if (Multiply(minimum, (i128)1) != minimum) return 2;
    if (Multiply(maximum, (i128)1) != maximum) return 3;
    if (Multiply(minimum, (i128)0) != (i128)0) return 4;
    if (minimum * (i128)-1 != minimum) return 5;
    return 0;
}
