bool Lt(decimal a, decimal b) { return a < b; }
bool Le(decimal a, decimal b) { return a <= b; }
bool Gt(decimal a, decimal b) { return a > b; }
bool Ge(decimal a, decimal b) { return a >= b; }
bool Eq(decimal a, decimal b) { return a == b; }
bool Ne(decimal a, decimal b) { return a != b; }
int Main()
{
    if (!Gt(-0.1m, -1.0m) || !Lt(-1.0m, -0.1m)) return 1;
    if (!Le(0.10m, 0.1m) || !Ge(0.1m, 0.10m)) return 2;
    if (Lt(0.10m, 0.1m) || Gt(0.1m, 0.10m)) return 3;
    if (!Lt(-1.0m, 0.0m) || !Gt(1.00m, 0.9m)) return 4;
    if (!Le(-0.0m, 0.000m) || !Ge(-0.0m, 0.000m)) return 5;
    if (Lt(-0.0m, 0.000m) || Gt(-0.0m, 0.000m)) return 6;
    if (!Gt(0.0000000000000000000000000001m, 0m)) return 7;
    if (!Lt(-0.0000000000000000000000000001m, 0m)) return 8;
    decimal large = 18446744073709551615m;
    decimal scaled = checked(large * 1.0m);
    if (!Le(large, scaled) || !Ge(large, scaled) || Lt(large, scaled) || Gt(large, scaled)) return 9;
    if (!Eq(0.30m, 0.300m) || Ne(0.30m, 0.300m)) return 10;
    if (!(1 < 2) || !(2 > 1) || !(2 >= 2) || !(1 <= 1)) return 11;
    return 0;
}
