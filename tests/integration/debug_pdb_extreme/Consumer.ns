namespace DebugExtremeConsumer
{
    using DebugExtreme;

    public static class Program
    {
        public static int Main()
        {
            int seed = 40;
            Transform transform = ProducerApi.Increment;
            int delegated = ProducerApi.Invoke(transform, seed);
            Pair pair = ProducerApi.MakePair(delegated, 1);
            int aggregate = pair.Sum();
            raii Counter concrete = new Counter(aggregate);
            int dispatched;
            {
                borrowed ICounter interfaceView = concrete;
                dispatched = ProducerApi.ReadInterface(interfaceView);
            }
            int consumed = ProducerApi.Consume(move(concrete));
            Box<int> box = new Box<int>(consumed);
            int answer = ProducerApi.ReadBox(box);
            delete box;
            return answer + dispatched - consumed;
        }
    }
}
