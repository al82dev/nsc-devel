namespace DebugExtremeConsumer
{
    using DebugExtreme;
    using NativeSharp.Core.Diagnostics;

    public static class Program
    {
        public static int Main()
        {
            int seed = 40;
            Transform transform = ProducerApi.Increment;
            int delegated = ProducerApi.Invoke(transform, seed);
            Pair pair = ProducerApi.MakePair(delegated, 1);
            int aggregate = pair.Sum();
            raii Counter concrete = new Counter(aggregate);
            int dispatched;
            {
                borrowed ICounter interfaceView = concrete;
                dispatched = ProducerApi.ReadInterface(interfaceView);
            }
            int consumed = ProducerApi.Consume(move(concrete));
            int simd = ProducerApi.InspectSimd();
            int callable = ProducerApi.InspectCallables();
            int storage = ProducerApi.InspectStorage(2, 2);
            int baselineFrames = Debug.CaptureStackFrameCount();
            int callbackWalk = ProducerApi.InspectCallbackStack(baselineFrames);
            int sehWalk = ProducerApi.InspectSehStack(baselineFrames);
            int comWalk = ProducerApi.InspectComStack(baselineFrames);
            raii StackCounter stackConcrete = new StackCounter();
            int interfaceWalk;
            {
                borrowed IStackCounter stackInterface = stackConcrete;
                interfaceWalk = ProducerApi.InspectInterfaceStack(stackInterface, baselineFrames);
            }
            int closureWalk = ProducerApi.InspectClosureStack(baselineFrames);
            Box<int> box = new Box<int>(consumed);
            int answer = ProducerApi.ReadBox(box);
            delete box;
            return answer + dispatched - consumed + simd + callable + storage + callbackWalk + sehWalk +
                comWalk + interfaceWalk + closureWalk;
        }
    }
}
