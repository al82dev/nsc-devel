namespace DebugExtreme
{
    using NativeSharp.Core.Numerics;
    public delegate int Transform(int value);
    public extern C delegate int NativeTransform(int value);

    public interface ICounter
    {
        int Read();
    }

    public struct Pair
    {
        public int Left;
        public int Right;

        public int Sum()
        {
            return this.Left + this.Right;
        }
    }

    public struct PlacementCell
    {
        public int Value;

        public PlacementCell(int value)
        {
            Value = value;
        }
    }

    public class Box<T>
    {
        public T Value;

        public Box(T value)
        {
            Value = value;
        }

        public T Read()
        {
            return Value;
        }
    }

    public class Counter : ICounter
    {
        private int Value;

        public Counter(int value)
        {
            Value = value;
        }

        public int Read()
        {
            return Value;
        }

        ~Counter()
        {
            Value = 0;
        }
    }

    public static class ProducerApi
    {
        public static int Increment(int value)
        {
            return value + 1;
        }

        public static int Invoke(Transform transform, int value)
        {
            int transformed = transform(value);
            return transformed;
        }

        public static Pair MakePair(int left, int right)
        {
            Pair pair;
            pair.Left = left;
            pair.Right = right;
            return pair;
        }

        public static int ReadInterface(borrowed ICounter counter)
        {
            return counter.Read();
        }

        public static int ReadBox(Box<int> box)
        {
            return box.Read();
        }

        public static int Consume(owned Counter counter)
        {
            return counter.Read();
        }

        public static int InspectSimd()
        {
            Float32x4 simdVector = new Float32x4(1.0F, 2.0F, 3.0F, 4.0F);
            Float32x4x4 simdMatrix;
            simdMatrix.C0 = simdVector;
            simdMatrix.C1 = simdVector;
            simdMatrix.C2 = simdVector;
            simdMatrix.C3 = simdVector;
            return (int)simdMatrix.C3.X - 1;
        }

        public static int InspectCallables()
        {
            Transform managedDelegate = Increment;
            NativeTransform functionPointer = Increment;
            nint nativeHandle = 0;
            int managedResult = managedDelegate(20);
            int nativeResult = functionPointer(20);
            delete managedDelegate;
            return managedResult - nativeResult + (int)nativeHandle;
        }

        public static int InspectStorage(int rows, int columns)
        {
            int[rows, columns] vlaValues;
            vlaValues[1, 1] = 21;
            PlacementCell* cellStorage = stackalloc PlacementCell[1];
            PlacementCell* placedCell = new (cellStorage) PlacementCell(21);
            return vlaValues[1, 1] - placedCell->Value;
        }
    }
}
