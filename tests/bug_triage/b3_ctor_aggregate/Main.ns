// BUG TRIAGE 3 -- a class constructor cannot receive a struct larger than 8 bytes by value.
//
// Reported 2026-08-30 from the Saru.Framework port (`BoundingFrustum(Matrix)`, 64 bytes).
// Noisy: the LLVM verifier rejects the module and nothing is emitted.
//
//   nsc: error: Stage 34 LLVM verifier rejected OOP module:
//        Call parameter type does not match function signature!
//
// The call site passes the aggregate by value ([16 x i8]) while the constructor's own
// signature declares that parameter as `ptr`. Measured scope: 8 bytes passes; 12, 16, 20 and
// 64 fail -- anything that does not fit in a register. It is SPECIFIC TO CONSTRUCTORS: the
// same value into a static method, an instance method and a property setter all lower fine,
// and all three are controls below.
//
// Impact is not cosmetic: it deforms the public API of every type naturally built from a
// Matrix or a Vector4, which in a game framework is most of the interesting constructors.
//
// Expected exit code when healthy: 42.
namespace bugtriage
{
    public struct Big16
    {
        public float a;
        public float b;
        public float c;
        public float d;
    }

    public class Controls
    {
        public static float StaticTakes(Big16 value) { return value.a; }

        public float InstanceTakes(Big16 value) { return value.a; }
    }

    public class TakesBigInConstructor
    {
        public float seen;

        public TakesBigInConstructor(Big16 value) { seen = value.a; }
    }

    class Program
    {
        public static int Main()
        {
            Big16 v = { 42.0f, 1.0f, 2.0f, 3.0f };

            // Controls: the two shapes that are known to lower correctly.
            if (Controls.StaticTakes(v) != 42.0f) { return 1; }

            raii Controls ctrl = new Controls();
            if (ctrl.InstanceTakes(v) != 42.0f) { return 2; }

            // The bug.
            raii TakesBigInConstructor sut = new TakesBigInConstructor(v);
            if (sut.seen != 42.0f) { return 3; }

            return 42;
        }
    }
}
