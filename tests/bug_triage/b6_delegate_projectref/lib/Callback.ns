// BUG TRIAGE 6 -- referenced project half: declares the `extern C delegate` type.
//
// The delegate is declared `public` here, and that turned out to be the whole story -- see
// ../app/Main.ns. The originally reported version had no accessibility modifier at all.
namespace bugtriage.raw
{
    public extern C delegate int Adder(int left, int right);

    public struct Pair
    {
        public int left;
        public int right;
    }

    public class Ops
    {
        public static int AddImpl(int left, int right) { return left + right; }
    }
}
