// BUG TRIAGE 6 -- referenced project half: declares the `extern C delegate` type.
//
// The delegate is declared `public` here. The originally reported version had no accessibility
// modifier -- and, until the parser fix, could not have had one: `public extern C delegate` was
// rejected outright. See ../app/Main.ns.
namespace bugtriage.raw
{
    public extern C delegate int Adder(int left, int right);

    public struct Pair
    {
        public int left;
        public int right;
    }

    public class Ops
    {
        public static int AddImpl(int left, int right) { return left + right; }
    }
}
