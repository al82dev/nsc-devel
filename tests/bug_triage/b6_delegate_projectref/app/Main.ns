// BUG TRIAGE 6 -- an `extern C delegate` is not visible across a `ProjectReference`.
//
// Reported 2026-08-29 while building the NativeSharp.Win32 wrapper over the generated
// NativeSharp.Win32.Raw binding. The wrapper needed to name `WNDPROC`, declared by the
// binding:
//
//   error: unknown type name 'WNDPROC' in module 'NativeSharpWin32'
//
// Fully qualifying gives the same error. CLASSES and STRUCTS of the referenced project
// resolve without trouble (User32, MSG, RECT, WNDCLASSEXW are all used across the boundary):
// it is specifically the delegate type that does not cross. Within a SINGLE project, a
// delegate declared in one namespace is usable from another with `using`.
//
// MEDIDO, en dos pasos, y el primer diagnostico estuvo equivocado.
//
// Only PUBLIC types cross a module boundary -- the same rule as C#, and correct. The reported
// delegate had no accessibility modifier, so it was internal, while the classes and structs
// beside it were written `public` and crossed fine. That looked like the whole story, and it was
// not: adding `public` to the delegate did not compile either.
//
//   error: top-level accessibility supports only public/internal class, interface, struct,
//          enum, and delegate declarations
//
// The parser handled `extern` in a branch that sat AFTER the accessibility error in the same
// else-if chain, so an `extern C delegate` could not carry an accessibility modifier at all and
// could only ever be internal. It genuinely could not cross the boundary. THAT is the bug, and
// it is one missing branch in Parser.cpp -- not the type system, and not the module boundary.
//
// A second, separate defect made it hard to see: the diagnostic said "unknown type name" for a
// type that exists and is simply not public, which sends the reader hunting for a typo. It now
// names the type and says it is not public.
//
// Consequence for the bindings tree: it was restructured into one project per library to work
// around this. That restructuring is no longer required.
//
// Controls below (struct and class across the same boundary) run first, so a broken fixture
// is distinguishable from the bug.
//
// Expected exit code when healthy: 42.
using bugtriage.raw;

namespace bugtriage
{
    class Program
    {
        // The bug: naming a delegate type declared in the referenced project.
        public static int Invoke(Adder callback) { return callback(20, 22); }

        public static int Main()
        {
            // Control: a struct from the referenced project.
            Pair p = { 20, 22 };
            if (p.left + p.right != 42) { return 1; }

            // Control: a class from the referenced project.
            if (Ops.AddImpl(20, 22) != 42) { return 2; }

            // The bug.
            Adder callback = Ops.AddImpl;
            if (Invoke(callback) != 42) { return 3; }

            return 42;
        }
    }
}
