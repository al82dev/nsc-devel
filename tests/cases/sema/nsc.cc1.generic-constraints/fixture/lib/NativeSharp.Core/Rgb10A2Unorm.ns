namespace NativeSharp.Core.Numerics
{
    // Formato GPU RGB10_A2_UNORM. Pack enmascara entradas para que ningun canal invada al siguiente.
    public copy struct Rgb10A2Unorm
    {
        public uint Packed;

        public static Rgb10A2Unorm Pack(ushort r, ushort g, ushort b, byte a)
        {
            Rgb10A2Unorm result;
            result.Packed = ((uint)r & 1023u) | (((uint)g & 1023u) << 10) |
                (((uint)b & 1023u) << 20) | (((uint)a & 3u) << 30);
            return result;
        }

        public static ushort Red(Rgb10A2Unorm value) { return (ushort)(value.Packed & 1023u); }
        public static ushort Green(Rgb10A2Unorm value) { return (ushort)((value.Packed >> 10) & 1023u); }
        public static ushort Blue(Rgb10A2Unorm value) { return (ushort)((value.Packed >> 20) & 1023u); }
        public static byte Alpha(Rgb10A2Unorm value) { return (byte)((value.Packed >> 30) & 3u); }
    }
}
