int Analyze(int x)
{
    int value = 0;

    if (x > 0)
    {
        value = 1;
    }
    else
    {
        value = 2;
    }

    while (value < 6)
    {
        if (value == 3)
        {
            value++;
            continue;
        }

        if (value == 5)
        {
            break;
        }

        value++;
    }

    return value;
}

int Main()
{
    return Analyze(1);
}
