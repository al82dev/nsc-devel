using NativeSharp.Core;

class Native
{
    extern C from "kernel32.dll" { public uint GetCurrentProcessId(); }
}

struct Point
{
    public int X;
    public int Y;
}

enum Color
{
    Red,
    Green = Red + 1,
    Blue,
}

namespace Frontend
{
    const int GlobalAnswer = 40 + 2;
    int Counter;
}

int Add(int a, int b)
{
    return a + b;
}

int Main()
{
    Point p;
    p.X = 20;
    p.Y = 22;

    Point* pp = &p;
    pp->X += 1;

    int[4] values;
    values[0] = p.X;
    values[1] = p.Y;

    owned int[] heap = new int[4];
    heap[0] = Add(values[0], values[1]);
    int* temp = stackalloc int[4];
    temp[0] = heap[0];

    nuint pointSize = sizeof(Point);
    if (pointSize == 0u)
    {
        return 2;
    }

    uint process = Native.GetCurrentProcessId();
    Console.WriteLine("NativeSharp frontend");
    int result = temp[0];
    return process == 0u ? 1 : result;
}
