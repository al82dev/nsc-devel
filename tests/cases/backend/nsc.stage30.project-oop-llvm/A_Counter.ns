namespace Demo;

public partial class Counter
{
    byte Tag;
    int Value;

    public Counter(int start)
    {
        this.Value = start;
    }

    public int Add(int delta)
    {
        this.Value = this.Value + delta;
        return this.Value;
    }

    public int SumTo(int n)
    {
        int i = 0;
        int total = 0;
        while (i < n)
        {
            total = total + i;
            i = i + 1;
        }
        return total;
    }
}
