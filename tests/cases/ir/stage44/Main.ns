namespace Stage44.Sample
{
    public struct Box<T>
    {
        public T Value;

        public T Get()
        {
            return Value;
        }
    }

    public struct Pair<TLeft, TRight>
    {
        public TLeft Left;
        public TRight Right;
    }

    public class Holder<T>
    {
        public T Value;

        public Holder(T value)
        {
            Value = value;
        }

        public T Get()
        {
            return Value;
        }
    }

    public class Algorithms
    {
        public static T Identity<T>(T value)
        {
            return value;
        }

        public static T First<T>(T[] values)
        {
            return values[0];
        }

        public static int Run()
        {
            Box<int> first;
            first.Value = 7;

            Box<int> repeated;
            repeated.Value = 8;

            Box<long> wide;
            wide.Value = 9;

            Pair<int, int> pair;
            pair.Left = first.Get();
            pair.Right = first.Get();

            Holder<int> holder = new Holder<int>(pair.Left);

            int[] values = new int[2];
            values[0] = holder.Get();
            values[1] = 4;

            int a = Identity<int>(values[0]);
            int b = Identity<int>(values[1]);
            long c = Identity<long>(wide.Get());
            int d = First<int>(values);

            delete[] values;
            return a + b + d + (int)c + repeated.Get();
        }
    }
}
