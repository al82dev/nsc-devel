using NativeSharp.Core.Collections.Generic;
public class Tracker
{
    public static int Calls = 0;
    public static bool Match(int value) { Calls = Calls + 1; return Calls <= 3 && value != 2; }
    public static bool MatchIn(in int value) { Calls = Calls + 1; return Calls <= 3 && value != 2; }
    public static List<int> Target;
    public static List<int> Other;
    public static bool ChangeOther(int value) { Other.Add(value); return true; }
    public static bool Nested(int value)
    {
        Predicate<int> inner = (int item) => item == 2;
        int[] found = Target.FindAll(inner);
        int n = found.Length;
        delete[] found;
        return n == 1 && value == 1;
    }
}
public class Box
{
    public static int Destroyed = 0;
    public int Value;
    public Box(int value) { Value = value; }
    ~Box() { Destroyed = Destroyed + 1; }
}
public class Program
{
    public static int CheckReferences()
    {
        {
            raii List<Box> boxes = new List<Box>();
            boxes.Add(new Box(7));
            Predicate<Box> match = (Box value) => true;
            Box[] found = boxes.FindAll(match);
            if (Box.Destroyed != 0 || found.Length != 1 || found[0].Value != 7) { return 1; }
            delete[] found;
            if (Box.Destroyed != 0) { return 2; }
        }
        if (Box.Destroyed != 1) { return 3; }
        return 0;
    }

    public static int Main()
    {
        raii List<int> list = new List<int>();
        list.Add(1); list.Add(2); list.Add(3);
        Predicate<int> p = (int value) => Tracker.Match(value);
        int[] first = list.FindAll(p);
        int failure = 0;
        if (Tracker.Calls != 3 || first.Length != 2 || first[0] != 1 || first[1] != 3) { failure = failure + 1; }
        delete[] first;
        Tracker.Calls = 0;
        InPredicate<int> q = (in int value) => Tracker.MatchIn(in value);
        int[] second = list.FindAll(q);
        if (Tracker.Calls != 3 || second.Length != 2 || second[0] != 1 || second[1] != 3) { failure = failure + 2; }
        delete[] second;
        Predicate<int> all = (int value) => true;
        int[] allItems = list.FindAll(all);
        if (allItems.Length != 3 || allItems[0] != 1 || allItems[1] != 2 || allItems[2] != 3) { failure = failure + 4; }
        delete[] allItems;
        Predicate<int> none = (int value) => false;
        int[] noItems = list.FindAll(none);
        if (noItems.Length != 0) { failure = failure + 8; }
        delete[] noItems;
        raii List<int> empty = new List<int>();
        Tracker.Calls = 0;
        int[] emptyResult = empty.FindAll(p);
        if (Tracker.Calls != 0 || emptyResult.Length != 0) { failure = failure + 16; }
        delete[] emptyResult;
        if (CheckReferences() != 0) { failure = failure + 32; }
        Tracker.Target = new List<int>();
        Tracker.Target.Add(1); Tracker.Target.Add(2);
        Predicate<int> nested = (int value) => Tracker.Nested(value);
        int[] nestedItems = Tracker.Target.FindAll(nested);
        if (nestedItems.Length != 1 || nestedItems[0] != 1) { failure = failure + 64; }
        delete[] nestedItems;
        Tracker.Target.Add(3);
        if (Tracker.Target.Count() != 3) { failure = failure + 128; }
        Tracker.Other = new List<int>();
        Predicate<int> changeOther = (int value) => Tracker.ChangeOther(value);
        int[] otherItems = Tracker.Target.FindAll(changeOther);
        delete[] otherItems;
        if (Tracker.Other.Count() != 3) { failure = failure + 1; }
        delete Tracker.Other;
        delete Tracker.Target;
        return failure;
    }
}
