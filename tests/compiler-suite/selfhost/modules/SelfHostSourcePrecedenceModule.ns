using NativeSharp.Core;

namespace NativeSharp.CompilerSuite.SelfHost.Source
{
    // CSH-SRC-003 exercises every public precedence level and an iterative wide expression.
    public class SelfHostSourcePrecedenceModule
    {
        public static int Run(string caseId)
        {
            if (caseId == "TSH-00864")
            {
                return SelfHostSourceTestSupport.Expression("1 + 2 * 3", true, 7) ? 0 : 20;
            }
            if (caseId == "TSH-00865")
            {
                return SelfHostSourceTestSupport.Expression("((1 + 2) * 3 << 1) | 1", true, 19) ? 0 : 21;
            }
            if (caseId == "TSH-00866")
            {
                return SelfHostSourceTestSupport.Expression("   ", false, 0) ? 0 : 22;
            }
            if (caseId == "TSH-00867")
            {
                bool valid = SelfHostSourceTestSupport.Expression("9 / 0", false, 0) &&
                    SelfHostSourceTestSupport.Expression("9 % 0", false, 0) &&
                    SelfHostSourceTestSupport.Expression("1 +", false, 0);
                return valid ? 0 : 23;
            }
            if (caseId == "TSH-00868")
            {
                bool valid = SelfHostSourceTestSupport.Expression("0", true, 0) &&
                    SelfHostSourceTestSupport.Expression("1 << 0", true, 1) &&
                    SelfHostSourceTestSupport.Expression("0xffffffffffffffff >> 63", true, 1);
                return valid ? 0 : 24;
            }
            if (caseId == "TSH-00869")
            {
                bool valid = SelfHostSourceTestSupport.Expression("8 / 2", true, 4) &&
                    SelfHostSourceTestSupport.Expression("8 % 3", true, 2) &&
                    SelfHostSourceTestSupport.Expression("1 << 3", true, 8) &&
                    SelfHostSourceTestSupport.Expression("12 & 10", true, 8) &&
                    SelfHostSourceTestSupport.Expression("12 ^ 10", true, 6) &&
                    SelfHostSourceTestSupport.Expression("12 | 3", true, 15);
                return valid ? 0 : 25;
            }
            if (caseId == "TSH-00871")
            {
                raii StringBuilder text = new StringBuilder(8192);
                text.Append('1');
                int index = 1;
                while (index < 4096) { text.Append("+1"); index = index + 1; }
                raii string value = text.ToOwnedString();
                return SelfHostSourceTestSupport.Expression(value, true, 4096) ? 0 : 26;
            }
            return -1;
        }
    }
}
