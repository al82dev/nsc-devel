using NativeSharp.Compiler.Basic;

namespace NativeSharp.CompilerSuite.SelfHost.Basic
{
    public class SelfHostBasicIdentifiersModule
    {
        public static int Run(string caseId)
        {
            if (caseId == "TSH-00001") { return MinimalContract(); }
            if (caseId == "TSH-00002") { return RepresentativeContract(); }
            if (caseId == "TSH-00003") { return MissingIdentity(); }
            if (caseId == "TSH-00004") { return MalformedRange(); }
            if (caseId == "TSH-00005") { return BoundaryValues(); }
            if (caseId == "TSH-00006") { return NamedVariants(); }
            if (caseId == "TSH-00007") { return Repeatability(); }
            if (caseId == "TSH-00008") { return ScaleBoundary(); }
            return -1;
        }

        private static int MinimalContract()
        {
            FileId invalid = FileId.Invalid();
            CompilerResult success = CompilerResult.Success();
            return invalid.Value() == 0 && !invalid.IsValid() && success.Succeeded() &&
                success.ExitCode() == 0 ? 0 : 1;
        }

        private static int RepresentativeContract()
        {
            FileId file = new FileId(7);
            SourcePosition begin = new SourcePosition(file, 4);
            SourcePosition end = new SourcePosition(file, 11);
            SourceRange range = new SourceRange(begin, end);
            CompilerResult failure = CompilerResult.Failure(17);
            return file.Value() == 7 && file.IsValid() && begin.File().Value() == 7 &&
                begin.Offset() == 4 && range.IsValid() && range.Length() == 7 &&
                !failure.Succeeded() && failure.ExitCode() == 17 ? 0 : 2;
        }

        private static int MissingIdentity()
        {
            SourcePosition position = new SourcePosition(FileId.Invalid(), 0);
            SourceRange range = new SourceRange(position, position);
            return !position.IsValid() && !range.IsValid() ? 0 : 3;
        }

        private static int MalformedRange()
        {
            SourceRange reversed = new SourceRange(new SourcePosition(new FileId(2), 9),
                new SourcePosition(new FileId(2), 3));
            SourceRange crossFile = new SourceRange(new SourcePosition(new FileId(2), 1),
                new SourcePosition(new FileId(3), 2));
            return !reversed.IsValid() && reversed.Length() == -6 && !crossFile.IsValid() ? 0 : 4;
        }

        private static int BoundaryValues()
        {
            FileId one = new FileId(1);
            SourceRange empty = new SourceRange(new SourcePosition(one, 0),
                new SourcePosition(one, 0));
            FileId maximum = new FileId(2147483647);
            return empty.IsValid() && empty.Length() == 0 && maximum.IsValid() &&
                maximum.Value() == 2147483647 ? 0 : 5;
        }

        private static int NamedVariants()
        {
            FileId invalid = FileId.Invalid();
            FileId valid = new FileId(1);
            CompilerResult success = CompilerResult.Success();
            CompilerResult zeroFailure = CompilerResult.Failure(0);
            return !invalid.IsValid() && valid.IsValid() && !FileId.Equals(invalid, valid) &&
                FileId.Equals(valid, new FileId(1)) && success.Succeeded() &&
                !zeroFailure.Succeeded() && zeroFailure.ExitCode() == 0 ? 0 : 6;
        }

        private static int Repeatability()
        {
            SourceRange first = new SourceRange(new SourcePosition(new FileId(9), 2),
                new SourcePosition(new FileId(9), 8));
            SourceRange second = new SourceRange(new SourcePosition(new FileId(9), 2),
                new SourcePosition(new FileId(9), 8));
            return first.IsValid() && second.IsValid() && first.Length() == second.Length() &&
                FileId.Equals(first.Begin().File(), second.Begin().File()) ? 0 : 7;
        }

        private static int ScaleBoundary()
        {
            int index = 1;
            while (index <= 10000)
            {
                FileId file = new FileId(index);
                SourceRange range = new SourceRange(new SourcePosition(file, index - 1),
                    new SourcePosition(file, index));
                if (!file.IsValid() || !range.IsValid() || range.Length() != 1) { return 8; }
                index = index + 1;
            }
            return 0;
        }
    }
}
