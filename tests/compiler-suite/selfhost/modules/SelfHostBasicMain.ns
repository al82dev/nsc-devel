using NativeSharp.Core;

namespace NativeSharp.CompilerSuite.SelfHost.Basic
{
    public class Program
    {
        public static int Main()
        {
            string[] arguments = new string[3];
            int count = Environment.GetCommandLineArgs(arguments);
            if (count != 2) { return 250; }

            string caseId = arguments[1];
            int result = SelfHostBasicIdentifiersModule.Run(caseId);
            if (result != -1) { return result; }
            result = SelfHostBasicArenaModule.Run(caseId);
            if (result != -1) { return result; }
            result = SelfHostBasicStableHashModule.Run(caseId);
            if (result != -1) { return result; }
            result = SelfHostBasicLifetimeModule.Run(caseId);
            if (result != -1) { return result; }
            return 251;
        }
    }
}
