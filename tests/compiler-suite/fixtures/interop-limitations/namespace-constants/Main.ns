// Compiler-suite fixture namespace-constants (L-022, L-001, L-002): signed float constant and C string pointer from concatenated literals
namespace Fixture
{
    const float NEGATIVE = -2.5f;
    sbyte const* TEXT = "ab"
        + "cd";

    // Exit code 42: strlen("abcd") * 8 + (int)(-2.5f * -4.0f).
    int Main()
    {
        return (int)lim_strlen(TEXT) * 8 + (int)(NEGATIVE * -4.0f);
    }
}
