<Project>
  <PropertyGroup><Name>InteropLimitation</Name></PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.ns" />
    <CppLibraryReference Header="@FIXTURE@/lim_a.h" Language="C" Standard="c17" Implementation="LIM_COMMON_IMPLEMENTATION">
      <IncludeDirectory Path="@FIXTURE@" Kind="User" />
      <IncludeDirectory Path="@FIXTURE@/sys" Kind="System" />
    </CppLibraryReference>
    <CppLibraryReference Header="@FIXTURE@/sys/lim_common.h" Language="C" Standard="c17">
      <IncludeDirectory Path="@FIXTURE@" Kind="User" />
      <IncludeDirectory Path="@FIXTURE@/sys" Kind="System" />
    </CppLibraryReference>
  </ItemGroup>
</Project>
