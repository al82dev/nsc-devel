using NativeSharp.Core;
using NativeSharp.Core.Collections.Generic;

// ============================================================================================
// Tutorial 15 -- Tour de las colecciones genericas
// Fuente de inspiracion: Learn C# Programming chapter_06 (RestrictedDictionary.cs) y el propio
// examples/project_stage52/Main.ns de este repo (la entrega original de Stage 52, mucho mas
// extensa -- este tutorial es la version corta y didactica).
// ============================================================================================
//
// NativeSharp.Core.Collections.Generic trae 10 contenedores genericos. Este tour toca cada uno
// con lo minimo indispensable -- para el detalle completo de cada API, ver
// 08_estado_stage52.md / TEST_MATRIX_52.md en la raiz del repo.
namespace Tutorial.GenericCollectionsTour
{
    class Program
    {
        // Dictionary/HashSet no tienen "where T : IHashable" al que colgarse (no hay generic
        // constraints, ver tutorial_14) -- reciben el hash explicito como delegado.
        public static int HashInt(int value)
        {
            return Hashing.Int32(value);
        }

        public static int Main()
        {
            // List<T> -- arreglo dinamico, la coleccion mas usada.
            raii List<int> list = new List<int>();
            list.Add(10);
            list.Add(20);
            list.Add(30);
            int listCount = list.Count(); // 3
            int listFirst = list[0];      // 10

            // Queue<T> -- FIFO.
            Queue<int> queue = new Queue<int>();
            queue.Enqueue(1);
            queue.Enqueue(2);
            queue.Enqueue(3);
            int dequeued = queue.Dequeue(); // 1 -- el primero en entrar

            // Stack<T> -- LIFO.
            Stack<int> stack = new Stack<int>();
            stack.Push(1);
            stack.Push(2);
            stack.Push(3);
            int popped = stack.Pop(); // 3 -- el ultimo en entrar

            // LinkedList<T> -- lista doblemente enlazada real (nodos, no arreglo).
            LinkedList<int> chain = new LinkedList<int>();
            chain.AddLast(2);
            chain.AddLast(3);
            chain.AddFirst(1);
            int chainCount = chain.Count(); // 3

            // HashSet<T> -- elementos unicos, sin orden garantizado; requiere HashFunc<T>
            // explicito (ver el comentario de cabecera).
            HashFunc<int> intHash = HashInt;
            HashSet<int> unique = new HashSet<int>(intHash);
            unique.Add(5);
            unique.Add(5); // duplicado, se ignora
            unique.Add(7);
            int uniqueCount = unique.Count(); // 2

            // SortedSet<T> -- como HashSet, pero mantiene orden; usa comparacion natural de int,
            // no necesita HashFunc.
            SortedSet<int> sorted = new SortedSet<int>();
            sorted.Add(30);
            sorted.Add(10);
            sorted.Add(20);
            int[] sortedArray = sorted.ToArray(); // [10, 20, 30] -- ya viene ordenado
            int sortedFirst = sortedArray[0];
            delete[] sortedArray;

            // Dictionary<TKey,TValue> -- tabla hash clave/valor; tambien requiere HashFunc<TKey>.
            Dictionary<int, string> ages = new Dictionary<int, string>(intHash);
            raii string aliceName = String.Copy("Alice");
            ages.Add(1, move(aliceName));
            bool hasKey1 = ages.ContainsKey(1); // true

            // SortedDictionary<TKey,TValue> -- como Dictionary, pero recorrible en orden de
            // clave; no necesita HashFunc (usa comparacion natural).
            SortedDictionary<int, int> scoreByRank = new SortedDictionary<int, int>();
            scoreByRank.Add(2, 200);
            scoreByRank.Add(1, 100);
            int rankOneScore = scoreByRank[1]; // 100

            // SortedList<TKey,TValue> -- almacenamiento por arreglos paralelos ordenados por
            // clave (mas eficiente en memoria que SortedDictionary para colecciones chicas).
            SortedList<int, int> sortedPairs = new SortedList<int, int>();
            sortedPairs.Add(3, 300);
            sortedPairs.Add(1, 100);
            sortedPairs.Add(2, 200);
            int indexOfKey2 = sortedPairs.IndexOfKey(2); // 1 -- posicion 1 tras ordenar por clave

            // PriorityQueue<TElement,TPriority> -- binary min-heap; Dequeue/Peek siempre dan el
            // elemento de MENOR prioridad numerica primero (ver tutorial_23 para un uso real:
            // codificacion de Huffman).
            PriorityQueue<int, int> tasks = new PriorityQueue<int, int>();
            tasks.Enqueue(100, 5); // elemento 100, prioridad 5
            tasks.Enqueue(200, 1); // elemento 200, prioridad 1 -- la mas urgente
            tasks.Enqueue(300, 3);
            int mostUrgent = tasks.Dequeue(); // 200

            delete chain;
            delete unique;
            delete sorted;
            delete ages;
            delete scoreByRank;
            delete sortedPairs;
            delete tasks;

            raii string label = String.Copy("list/queue/stack/chain = ");
            raii string sep = String.Copy(" / ");
            raii string d1 = String.ToString(listCount);
            raii string d2 = String.ToString(dequeued);
            raii string d3 = String.ToString(popped);
            raii string d4 = String.ToString(chainCount);
            raii string s1 = String.Concat(label, d1);
            raii string s2 = String.Concat(s1, sep);
            raii string s3 = String.Concat(s2, d2);
            raii string s4 = String.Concat(s3, sep);
            raii string s5 = String.Concat(s4, d3);
            raii string s6 = String.Concat(s5, sep);
            raii string line = String.Concat(s6, d4);
            Console.WriteLine(line);

            // listCount=3,listFirst=10,dequeued=1,popped=3,chainCount=3,uniqueCount=2,
            // sortedFirst=10,rankOneScore=100,indexOfKey2=1,mostUrgent=200
            int result = listCount + listFirst + dequeued + popped + chainCount + uniqueCount +
                sortedFirst + rankOneScore + indexOfKey2 + mostUrgent;
            if (hasKey1) { result = result + 1; }
            return result % 250;
        }
    }
}
