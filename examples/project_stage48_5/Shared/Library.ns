namespace NativeSharp.Stage48_5
{
    extern C delegate int IntCallback(int value);
    extern C delegate int BufferCallback(int* values, int count);

    public enum HostMode
    {
        First = 1,
        Second = 2
    }

    public struct Pair
    {
        public int Left;
        public int Right;
    }

    public struct LayoutProbe
    {
        public byte Tag;
        public int Value;
    }

    public class Counter
    {
        public int Value;
        public Counter(int value) { Value = value; }
    }

    public class HostApi
    {
        private static IntCallback StoredCallback;

        public static export extern C int NS485_Add(int left, int right) { return left + right; }
        public static export extern C bool NS485_EchoBool(bool value) { return value; }
        public static export extern C byte NS485_EchoByte(byte value) { return value; }
        public static export extern C uint NS485_EchoUInt(uint value) { return value; }
        public static export extern C long NS485_EchoLong(long value) { return value; }
        public static export extern C ulong NS485_EchoULong(ulong value) { return value; }
        public static export extern C float NS485_EchoFloat(float value) { return value; }
        public static export extern C double NS485_EchoDouble(double value) { return value; }
        public static export extern C int* NS485_EchoIntPointer(int* values) { return values; }
        public static export extern C int NS485_InvokeBuffer(BufferCallback callback, int* values, int count)
        {
            return callback(values, count);
        }
        public static export extern C void* NS485_EchoPointer(void* value) { return value; }
        public static export extern C Pair NS485_EchoPair(Pair value) { return value; }
        public static export extern C HostMode NS485_EchoMode(HostMode value) { return value; }
        public static export extern C LayoutProbe NS485_EchoLayout(LayoutProbe value) { return value; }
        public static export extern C int NS485_Invoke(IntCallback callback, int value) { return callback(value); }
        public static export extern C void NS485_SetCallback(IntCallback callback) { StoredCallback = callback; }
        public static export extern C int NS485_CallCallback(int value) { return StoredCallback(value); }
        public static export extern C Counter NS485_Counter_Create(int value) { return new Counter(value); }
        public static export extern C int NS485_Counter_Get(Counter counter) { return counter.Value; }
        public static export extern C void NS485_Counter_Add(Counter counter, int delta)
        {
            counter.Value = counter.Value + delta;
        }
        public static export extern C void NS485_Counter_Destroy(Counter counter) { delete counter; }
    }
}
