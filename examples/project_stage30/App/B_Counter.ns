namespace Demo;

public partial class Counter
{
    public int AddTwice(int delta)
    {
        return Add(delta) + Add(delta);
    }

    public owned Counter Make(int start)
    {
        return new Counter(start);
    }

    public void Release(Counter value)
    {
        delete value;
    }
}

public class Empty
{
}

public class Factory
{
    public owned Empty MakeEmpty()
    {
        return new Empty();
    }
}
