using NativeSharp.Core;
using NativeSharp.Core.Collections.Generic;

// Stage 52 -- Generic Collections: a tour of every container this stage ships, instantiated with
// both a value-typed T (int) and a reference-typed T (Payload) wherever that distinction matters,
// exercising the real ownership rules end to end. See claude/08_estado_stage52.md and
// claude/09_stage52_paso_a_paso.md (Spanish, per this project's documentation convention) for the
// full conceptual writeup and the reproducible build/verify steps behind this example.
namespace Stage52Collections
{
    public class Payload
    {
        public int Value;
    }

    public class Runner
    {
        public static bool IsPositive(int value)
        {
            return value > 0;
        }

        public static int HashInt(int value)
        {
            return Hashing.Int32(value);
        }

        public static int HashPayload(Payload p)
        {
            return Hashing.Int32(p.Value);
        }

        // List<T> -- a growable array. Add/Insert/SetAt transfer ownership with move() for a
        // reference-typed T; a value-typed T needs none of that ceremony at all.
        public static int RunList()
        {
            raii List<int> numbers = new List<int>();
            numbers.Add(3);
            numbers.Add(1);
            numbers.Add(2);
            numbers.Sort();
            int total = 0;
            int i = 0;
            while (i < numbers.Count())
            {
                total = total + numbers[i];
                i = i + 1;
            }

            raii List<Payload> people = new List<Payload>();
            raii Payload alice = new Payload();
            alice.Value = 30;
            people.Add(move(alice));
            raii Payload bob = new Payload();
            bob.Value = 25;
            people.Add(move(bob));
            people.Reverse();
            raii Payload carol = new Payload();
            carol.Value = 20;
            people.Insert(1, move(carol));
            people.RemoveAt(1);

            Payload[] transferred = new Payload[1];
            transferred[0] = new Payload();
            transferred[0].Value = 40;
            people.AddRange(transferred);
            delete[] transferred;

            Predicate<int> positive = IsPositive;
            bool anyPositive = numbers.Exists(positive);
            if (anyPositive) { total = total + 1; }

            return total + people.Count();
        }

        // List<T> -- Stage 52.x additions: range operations, Find family, capacity management.
        public static int RunListAdditions()
        {
            raii List<int> numbers = new List<int>();
            numbers.Add(5);
            numbers.Add(1);
            numbers.Add(2);
            numbers.EnsureCapacity(16);
            numbers.TrimExcess();

            int[] batch = new int[3];
            batch[0] = 10;
            batch[1] = 20;
            batch[2] = 30;
            numbers.AddRange(batch);

            int[] batch2 = new int[1];
            batch2[0] = 99;
            numbers.InsertRange(0, batch2);

            numbers.RemoveRange(0, 1);
            int[] range = numbers.GetRange(0, 2);

            Predicate<int> positive = IsPositive;
            int[] allPositive = numbers.FindAll(positive);
            int lastIndex = numbers.FindLastIndex(positive);
            int lastMatch = numbers.FindLast(positive);

            return numbers.Count() + range.Length + allPositive.Length + lastIndex + lastMatch;
        }

        // Queue<T>/Stack<T> -- FIFO and LIFO over a circular/dynamic backing array.
        public static int RunQueueAndStack()
        {
            Queue<int> queue = new Queue<int>();
            queue.Enqueue(1);
            queue.Enqueue(2);
            queue.Enqueue(3);
            int fifo = queue.Dequeue() + queue.Dequeue();
            delete queue;

            Stack<int> stack = new Stack<int>();
            stack.Push(1);
            stack.Push(2);
            stack.Push(3);
            int lifo = stack.Pop();
            delete stack;

            return fifo + lifo;
        }

        // Queue<T>/Stack<T> -- Stage 52.x additions: Try*/capacity management/CopyTo.
        public static int RunQueueAndStackAdditions()
        {
            Queue<int> queue = new Queue<int>(2);
            queue.Enqueue(1);
            queue.Enqueue(2);
            queue.Enqueue(3);
            queue.EnsureCapacity(10);
            queue.TrimExcess();
            int[] dequeued = new int[1];
            bool gotOne = queue.TryDequeue(dequeued);
            bool peeked = queue.TryPeek(dequeued);
            int[] queueCopy = new int[queue.Count()];
            queue.CopyTo(queueCopy, 0);
            delete queue;

            Stack<int> stack = new Stack<int>(2);
            stack.Push(1);
            stack.Push(2);
            stack.EnsureCapacity(10);
            stack.TrimExcess();
            int[] popped = new int[1];
            bool gotTop = stack.TryPop(popped);
            bool peekedTop = stack.TryPeek(popped);
            int[] stackCopy = new int[stack.Count()];
            stack.CopyTo(stackCopy, 0);
            delete stack;

            return dequeued[0] + popped[0] + queueCopy.Length + stackCopy.Length;
        }

        // LinkedList<T> -- a doubly-linked list; each node owns its Value and its Next node.
        public static int RunLinkedList()
        {
            LinkedList<int> chain = new LinkedList<int>();
            chain.AddLast(2);
            chain.AddLast(3);
            chain.AddFirst(1);
            int first = chain.RemoveFirst();
            int last = chain.RemoveLast();
            int remaining = chain.Count();
            delete chain;
            return first + last + remaining;
        }

        // LinkedList<T> -- Stage 52.x additions: AddAfter/AddBefore/Find/FindLast/Remove(node).
        public static int RunLinkedListAdditions()
        {
            LinkedList<int> chain = new LinkedList<int>();
            LinkedListNode<int> one = chain.AddLast(1);
            LinkedListNode<int> three = chain.AddLast(3);
            LinkedListNode<int> two = chain.AddAfter(one, 2);
            LinkedListNode<int> zero = chain.AddBefore(one, 0);
            LinkedListNode<int> found = chain.Find(2);
            LinkedListNode<int> foundLast = chain.FindLast(2);
            chain.Remove(three);
            int remaining = chain.Count();
            delete chain;
            return remaining;
        }

        // Dictionary<TKey,TValue> -- a hash table with explicit hashing (HashFunc<TKey>, since
        // NativeSharp generics are unconstrained and there is no object.GetHashCode() to fall
        // back on). AddOrUpdate is the owned-argument-friendly stand-in for a real indexer
        // setter; the indexer itself is read-only and throws KeyNotFoundException.
        public static int RunDictionary()
        {
            HashFunc<int> intHash = HashInt;
            Dictionary<int, string> ages = new Dictionary<int, string>(intHash);
            // A string literal cannot initialize a `raii string` directly (NativeSharp's RAII
            // locals only accept `new`, `null`, `move(other)`, or an owned-returning call) --
            // String.Copy is the owned-returning call that turns a literal into a real owned
            // string, which move() can then hand to the owned `TValue value` parameter.
            raii string aliceName = String.Copy("Alice");
            ages.Add(1, move(aliceName));
            raii string bobName = String.Copy("Bob");
            ages.Add(2, move(bobName));
            raii string bobbyName = String.Copy("Bobby");
            ages.AddOrUpdate(2, move(bobbyName));

            bool hasTwo = ages.ContainsKey(2);
            string[] outSlot = new string[1];
            bool found = ages.TryGetValue(1, outSlot);
            delete[] outSlot;

            int count = ages.Count();
            delete ages;

            int result = count;
            if (hasTwo) { result = result + 1; }
            if (found) { result = result + 1; }
            return result;
        }

        // Dictionary<TKey,TValue> -- Stage 52.x additions: TryAdd/capacity management.
        public static int RunDictionaryAdditions()
        {
            HashFunc<int> intHash = HashInt;
            Dictionary<int, int> counts = new Dictionary<int, int>(intHash);
            bool added = counts.TryAdd(1, 100);
            bool dupAdded = counts.TryAdd(1, 999);
            counts.EnsureCapacity(32);
            counts.TrimExcess();
            int count = counts.Count();
            delete counts;

            int result = count;
            if (added) { result = result + 1; }
            if (dupAdded) { result = result + 1; }
            return result;
        }

        // HashSet<T> -- a thin wrapper over Dictionary<T, bool>; see HashSet.ns's class comment.
        public static int RunHashSet()
        {
            HashFunc<int> intHash = HashInt;
            HashSet<int> unique = new HashSet<int>(intHash);
            unique.Add(1);
            unique.Add(2);
            unique.Add(1);
            int count = unique.Count();
            delete unique;
            return count;
        }

        // HashSet<T> -- Stage 52.x additions: full set-theory operations, TryGetValue,
        // capacity management.
        public static int RunHashSetAdditions()
        {
            HashFunc<int> intHash = HashInt;
            HashSet<int> a = new HashSet<int>(intHash);
            a.Add(1);
            a.Add(2);
            a.Add(3);
            a.EnsureCapacity(16);
            a.TrimExcess();

            HashSet<int> b = new HashSet<int>(intHash);
            b.Add(2);
            b.Add(3);
            b.Add(4);

            bool overlaps = a.Overlaps(b);
            bool isSubset = a.IsSubsetOf(b);
            bool isSuperset = a.IsSupersetOf(b);
            bool setsEqual = a.SetEquals(b);

            HashSet<int> merged = new HashSet<int>(intHash);
            merged.Add(1);
            merged.UnionWith(a);
            merged.IntersectWith(b);
            merged.ExceptWith(b);
            merged.SymmetricExceptWith(a);

            Predicate<int> positive = IsPositive;
            int removed = a.RemoveWhere(positive);

            int[] got = new int[1];
            bool foundIt = a.TryGetValue(1, got);

            delete a;
            delete b;
            delete merged;

            int result = removed;
            if (overlaps) { result = result + 1; }
            if (isSubset) { result = result + 1; }
            if (isSuperset) { result = result + 1; }
            if (setsEqual) { result = result + 1; }
            if (foundIt) { result = result + 1; }
            return result;
        }

        // SortedList<TKey,TValue>/SortedDictionary<TKey,TValue>/SortedSet<T> -- kept sorted by
        // key at all times (binary search lookup, shift-on-insert), only needing TKey's
        // `operator <`. See SortedDictionary.ns's class comment for why this package's
        // SortedDictionary/SortedSet deliberately share SortedList's array representation
        // instead of a balanced tree.
        public static int RunSortedCollections()
        {
            SortedList<int, string> ranked = new SortedList<int, string>();
            raii string third = String.Copy("third");
            ranked.Add(3, move(third));
            raii string firstPlace = String.Copy("first");
            ranked.Add(1, move(firstPlace));
            raii string second = String.Copy("second");
            ranked.Add(2, move(second));
            string best = ranked.ValueAt(0);
            int bestKey = ranked.KeyAt(0);
            delete ranked;

            SortedSet<int> unique = new SortedSet<int>();
            unique.Add(5);
            unique.Add(1);
            unique.Add(3);
            int min = unique.Min();
            int max = unique.Max();
            delete unique;

            int score = bestKey + min + max;
            if (best == "first") { score = score + 1; }
            return score;
        }

        public static int DescendingOrder(int a, int b)
        {
            return b - a;
        }

        // SortedList/SortedDictionary/SortedSet -- Stage 52.x additions: an explicit
        // `Comparison<TKey>`/`Comparison<T>` constructor (P1 gap: previously these containers
        // only ever used TKey/T's own natural `<`), plus SortedSet<T>'s full set-theory surface,
        // GetViewBetween, Reverse, and capacity management.
        public static int RunSortedCollectionsAdditions()
        {
            Comparison<int> descending = DescendingOrder;

            SortedList<int, int> descList = new SortedList<int, int>(descending);
            descList.Add(1, 10);
            descList.Add(3, 30);
            descList.Add(2, 20);
            // Under a descending comparer, index 0 holds the LARGEST key.
            int highestKey = descList.KeyAt(0);
            int valueIndex = descList.IndexOfValue(20);
            descList.EnsureCapacity(16);
            descList.TrimExcess();
            delete descList;

            SortedDictionary<int, int> descDict = new SortedDictionary<int, int>(descending);
            descDict.Add(1, 100);
            descDict.EnsureCapacity(8);
            descDict.TrimExcess();
            delete descDict;

            SortedSet<int> setA = new SortedSet<int>();
            setA.Add(1);
            setA.Add(2);
            setA.Add(3);
            setA.EnsureCapacity(16);
            setA.TrimExcess();

            SortedSet<int> setB = new SortedSet<int>();
            setB.Add(2);
            setB.Add(3);
            setB.Add(4);

            bool overlaps = setA.Overlaps(setB);
            bool isSubset = setA.IsSubsetOf(setB);
            bool setsEqual = setA.SetEquals(setB);

            SortedSet<int> merged = new SortedSet<int>();
            merged.Add(1);
            merged.UnionWith(setA);
            merged.IntersectWith(setB);
            merged.ExceptWith(setB);
            merged.SymmetricExceptWith(setA);

            int[] reversed = setA.Reverse();
            SortedSet<int> view = setA.GetViewBetween(1, 2);
            Predicate<int> positive = IsPositive;
            int removedCount = setA.RemoveWhere(positive);

            delete setA;
            delete setB;
            delete merged;
            delete view;
            delete[] reversed;

            int result = highestKey + valueIndex + removedCount;
            if (overlaps) { result = result + 1; }
            if (isSubset) { result = result + 1; }
            if (setsEqual) { result = result + 1; }
            return result;
        }

        // PriorityQueue<TElement,TPriority> -- a binary min-heap (Section 16 of the closure
        // review: "tipos genéricos adicionales"), plus Comparer<T>/EqualityComparer<T> as
        // reusable first-class wrappers around Comparison<T>/HashFunc<T>.
        public static int RunPriorityQueueAndComparers()
        {
            PriorityQueue<int, int> tasks = new PriorityQueue<int, int>();
            tasks.Enqueue(100, 5);
            tasks.Enqueue(200, 1);
            tasks.Enqueue(300, 3);
            tasks.EnsureCapacity(16);
            tasks.TrimExcess();
            int highestPriorityTask = tasks.Peek();
            int[] elementOut = new int[1];
            int[] priorityOut = new int[1];
            bool got = tasks.TryDequeue(elementOut, priorityOut);
            bool peeked = tasks.TryPeek(elementOut, priorityOut);
            int nextTask = tasks.Dequeue();
            delete tasks;

            raii List<Payload> owners = new List<Payload>();
            PriorityQueue<Payload, int> payloadQueue = new PriorityQueue<Payload, int>();
            raii Payload urgent = new Payload();
            urgent.Value = 1;
            payloadQueue.Enqueue(move(urgent), 0);
            raii Payload dequeuedPayload = payloadQueue.Dequeue();
            int payloadValue = dequeuedPayload.Value;
            delete payloadQueue;

            Comparer<int> naturalOrder = new Comparer<int>();
            int compared = naturalOrder.Compare(1, 2);
            delete naturalOrder;

            HashFunc<int> intHash = HashInt;
            EqualityComparer<int> equality = new EqualityComparer<int>(intHash);
            bool areEqual = equality.Equals(5, 5);
            int computedHash = equality.GetHashCode(5);
            delete equality;

            int result = highestPriorityTask + nextTask + elementOut[0] + priorityOut[0] +
                payloadValue + compared + computedHash;
            if (got) { result = result + 1; }
            if (peeked) { result = result + 1; }
            if (areEqual) { result = result + 1; }
            return result;
        }

        public static int Main()
        {
            return RunList() + RunListAdditions() + RunQueueAndStack() +
                RunQueueAndStackAdditions() + RunLinkedList() + RunLinkedListAdditions() +
                RunDictionary() + RunDictionaryAdditions() + RunHashSet() +
                RunHashSetAdditions() + RunSortedCollections() + RunSortedCollectionsAdditions() +
                RunPriorityQueueAndComparers();
        }
    }
}
