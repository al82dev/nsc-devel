using NativeSharp.Core;

// ============================================================================================
// Tutorial 03 -- Control de flujo
// Fuente de inspiracion: K&R cap. 3 "Control Flow".
// ============================================================================================
//
// K&R cap. 3 cubre: bloques/statements, if-else, else-if, switch, while/for, do-while,
// break/continue, y goto+labels. De todo eso, NativeSharp hoy soporta if/else, while, for y
// break/continue -- NO switch, NO do-while, y NO goto (ver TokenKind.h: no hay KwSwitch/KwCase/
// KwDo/KwGoto en absoluto, a diferencia de ++/compound-assignment que si tokenizan pero fallan en
// el lowering OOP). Es una decision de superficie de lenguaje, no un bug: donde C usaria switch
// se usa una cadena de if/else-if (exactamente lo que un switch ES por debajo de todas formas).
namespace Tutorial.ControlDeFlujo
{
    class Program
    {
        // if / else-if / else (K&R S3.2-3.3), clasificando un numero como en el ejemplo clasico.
        public static int Classify(int value)
        {
            if (value < 0)
            {
                return -1;
            }
            else if (value == 0)
            {
                return 0;
            }
            else
            {
                return 1;
            }
        }

        public static int Main()
        {
            int negatives = 0;
            int zeros = 0;
            int positives = 0;

            // for (K&R S1.3/S3.5): inicializador, condicion, paso -- el paso se escribe
            // "i = i + 1" en vez de "i++" (ver tutorial_02: ++ no baja a codigo en el lowering
            // OOP todavia, aunque el for en si mismo si funciona bien).
            int[] samples = new int[7];
            samples[0] = -3;
            samples[1] = 0;
            samples[2] = 5;
            samples[3] = -1;
            samples[4] = 0;
            samples[5] = 8;
            samples[6] = -9;

            for (int i = 0; i < samples.Length; i = i + 1)
            {
                int kind = Classify(samples[i]);
                if (kind < 0)
                {
                    negatives = negatives + 1;
                }
                else if (kind == 0)
                {
                    zeros = zeros + 1;
                }
                else
                {
                    positives = positives + 1;
                }
            }

            // while (K&R S3.5): la otra forma de loop, condicion al inicio.
            int factorial = 1;
            int n = 5;
            while (n > 1)
            {
                factorial = factorial * n;
                n = n - 1;
            }
            // factorial == 120

            // break/continue (K&R S3.7): buscar el primer positivo saltandose los negativos con
            // continue, y cortando con break apenas se encuentra.
            int firstPositive = -1;
            int j = 0;
            while (j < samples.Length)
            {
                if (samples[j] < 0)
                {
                    j = j + 1;
                    continue;
                }
                if (samples[j] > 0)
                {
                    firstPositive = samples[j];
                    break;
                }
                j = j + 1;
            }
            // firstPositive == 5 (indice 2)

            // Nota: K&R S3.4 (switch) y S3.6 (do-while) no tienen equivalente hoy -- ver el
            // comentario de cabecera. Donde K&R usaria "switch (kind) { case ...: ...; break; }"
            // se usa la cadena if/else-if de Classify() de arriba.

            delete[] samples;

            raii string summary = String.Copy("negativos/ceros/positivos = ");
            raii string negDigits = String.ToString(negatives);
            raii string zeroDigits = String.ToString(zeros);
            raii string posDigits = String.ToString(positives);
            raii string sep = String.Copy(" / ");
            raii string step1 = String.Concat(summary, negDigits);
            raii string step2 = String.Concat(step1, sep);
            raii string step3 = String.Concat(step2, zeroDigits);
            raii string step4 = String.Concat(step3, sep);
            raii string line = String.Concat(step4, posDigits);
            Console.WriteLine(line);

            raii string factLabel = String.Copy("5! = ");
            raii string factDigits = String.ToString(factorial);
            raii string factLine = String.Concat(factLabel, factDigits);
            Console.WriteLine(factLine);

            // negatives==3, zeros==2, positives==2, factorial==120, firstPositive==5
            return negatives + zeros * 10 + positives * 100 + factorial + firstPositive;
        }
    }
}
