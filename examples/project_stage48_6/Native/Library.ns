namespace NativeSharp.Stage48_6
{
    extern C delegate int IntCallback(int value);

    public enum HostMode
    {
        First = 1,
        Second = 2
    }

    public struct Pair
    {
        public int Left;
        public int Right;
    }

    public struct LayoutProbe
    {
        public byte Tag;
        public int Value;
    }

    public class Counter
    {
        public int Value;
        public Counter(int value) { Value = value; }
    }

    public class HostApi
    {
        private static IntCallback StoredCallback;

        public static export extern C int NS486_Add(int left, int right) { return left + right; }
        public static export extern C bool NS486_EchoBool(bool value) { return value; }
        public static export extern C byte NS486_EchoByte(byte value) { return value; }
        public static export extern C uint NS486_EchoUInt(uint value) { return value; }
        public static export extern C long NS486_EchoLong(long value) { return value; }
        public static export extern C ulong NS486_EchoULong(ulong value) { return value; }
        public static export extern C float NS486_EchoFloat(float value) { return value; }
        public static export extern C double NS486_EchoDouble(double value) { return value; }
        public static export extern C int* NS486_EchoIntPointer(int* values) { return values; }
        public static export extern C void* NS486_EchoPointer(void* value) { return value; }
        public static export extern C Pair NS486_EchoPair(Pair value) { return value; }
        public static export extern C HostMode NS486_EchoMode(HostMode value) { return value; }
        public static export extern C LayoutProbe NS486_EchoLayout(LayoutProbe value) { return value; }
        public static export extern C int NS486_BufferCount(int* values, int count)
        {
            return count;
        }
        public static export extern C int NS486_Invoke(IntCallback callback, int value) { return callback(value); }
        public static export extern C void NS486_SetCallback(IntCallback callback) { StoredCallback = callback; }
        public static export extern C int NS486_CallCallback(int value) { return StoredCallback(value); }
        public static export extern C Counter NS486_Counter_Create(int value) { return new Counter(value); }
        public static export extern C int NS486_Counter_Get(Counter counter) { return counter.Value; }
        public static export extern C void NS486_Counter_Add(Counter counter, int delta)
        {
            counter.Value = counter.Value + delta;
        }
        public static export extern C void NS486_Counter_Destroy(Counter counter) { delete counter; }
    }
}
