namespace Demo;

public partial class Widget
{
    public Widget(float value)
    {
        this.Value = 0;
    }

    public owned Widget MakeInt()
    {
        raii Widget result = new Widget(1);
        return move(result);
    }

    public owned Widget MakeFloat()
    {
        raii Widget result = new Widget(1.0f);
        return move(result);
    }

    public owned Empty MakeEmpty()
    {
        raii Empty result = new Empty();
        return move(result);
    }
}
