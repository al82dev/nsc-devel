(* NativeSharp 1.0.1 development grammar. Semantic restrictions live in the main specification. *)

compilation-unit = { using-directive | namespace-declaration | declaration }, EOF ;

using-directive = "using", [ identifier, "=" ], qualified-name, ";" ;
namespace-declaration = "namespace", qualified-name,
                        ( ";", { declaration } | "{", { using-directive | declaration }, "}" ) ;
qualified-name = identifier, { ".", identifier } ;

declaration = { type-declaration-modifier },
              ( class-declaration | struct-declaration | interface-declaration |
                enum-declaration | delegate-declaration ) |
              extern-c-declaration | function-or-global ;
type-declaration-modifier = "public" | "internal" | "partial" | "abstract" | "sealed" |
                            "static" | "borrowed" | layout-modifier ;
layout-modifier = ( "pack" | "align" | "size" ), "(", integer-literal, ")" ;

class-declaration = "class", identifier, [ type-parameters ], [ base-list ],
                    { constraint-clause }, type-body ;
struct-declaration = ( "struct" | "union" ), identifier,
                     [ type-parameters ], { constraint-clause }, type-body ;
interface-declaration = "interface", identifier, [ type-parameters ], [ base-list ],
                        { constraint-clause }, interface-body ;
enum-declaration = "enum", identifier, [ ":", integral-type ],
                   "{", [ enum-member, { ",", enum-member }, [ "," ] ], "}" ;
enum-member = identifier, [ "=", expression ] ;
delegate-declaration = "delegate", [ ownership ], type, identifier, [ type-parameters ],
                       "(", [ parameter-list ], ")", { constraint-clause }, ";" ;
extern-c-declaration = [ "public" | "internal" ], "extern", "C",
                       ( delegate-declaration | function-declaration |
                         "{", { function-declaration }, "}" ) ;

type-body = "{", { type-member | declaration }, "}" ;
interface-body = "{", { interface-member }, "}" ;
type-member = { member-modifier },
              ( field-declaration | method-declaration | constructor-declaration |
                destructor-declaration | property-declaration | indexer-declaration |
                operator-declaration | conversion-declaration | event-declaration ) ;
interface-member = [ ownership ], type,
                   ( identifier, "(", [ parameter-list ], ")", ";" |
                     identifier, accessor-body | "this", "[", parameter-list, "]", accessor-body ) ;
member-modifier = declaration-modifier | "virtual" | "override" | "new" | "extern" ;

field-declaration = [ ownership ], type, identifier, [ "at", integer-literal ],
                    [ "=", expression | aggregate-initializer ], ";" ;
method-declaration = [ ownership ], type, identifier, [ type-parameters ],
                     "(", [ parameter-list ], ")", { constraint-clause },
                     ( block | "=>", expression, ";" | ";" ) ;
function-declaration = [ ownership ], type, identifier, [ type-parameters ],
                       "(", [ parameter-list ], ")", { constraint-clause },
                       ( block | ";" ) ;
function-or-global = [ ownership ], type, identifier,
                     ( "(", [ parameter-list ], ")", { constraint-clause }, block |
                       [ "=", expression ], ";" ) ;
constructor-declaration = identifier, "(", [ parameter-list ], ")",
                          [ ":", ( "this" | "base" ), "(", [ argument-list ], ")" ], block ;
destructor-declaration = "~", identifier, "(", ")", block ;
property-declaration = [ ownership ], type, identifier, accessor-body,
                       [ "=", expression | aggregate-initializer ], ";" ;
indexer-declaration = [ ownership ], type, "this", "[", parameter-list, "]", accessor-body ;
accessor-body = "{", accessor, [ accessor ], "}" ;
accessor = ( "get" | "set" ), ( block | ";" ) ;
operator-declaration = type, "operator", operator-token,
                       "(", parameter-list, ")", ( block | "=>", expression, ";" ) ;
conversion-declaration = ( "implicit" | "explicit" ), "operator", type,
                         "(", parameter, ")", ( block | "=>", expression, ";" ) ;
event-declaration = "event", type, identifier, ";" ;

type-parameters = "<", identifier, { ",", identifier }, ">" ;
type-arguments = "<", type, { ",", type }, ">" ;
constraint-clause = "where", identifier, ":", constraint, { ",", constraint } ;
constraint = "class" | type ;
base-list = ":", type, { ",", type } ;
parameter-list = parameter, { ",", parameter } ;
parameter = [ ownership ], [ "ref" | "out" | "in" ], type, identifier,
            [ "=", literal | "null" | "default" ] ;
argument-list = argument, { ",", argument } ;
argument = [ "ref" | "out" | "in" ], expression ;

type = [ ownership ], type-primary, { "*" | array-rank } ;
ownership = "owned" | "borrowed" | "raii" ;
type-primary = builtin-type | qualified-name, [ type-arguments ] ;
builtin-type = "void" | "bool" | integral-type | "float" | "double" | "string" ;
integral-type = "sbyte" | "byte" | "char" | "short" | "ushort" | "int" | "uint" |
                "long" | "ulong" | "nint" | "nuint" ;
array-rank = "[", { "," }, "]" | "[", expression, "]" ;

block = "{", { statement }, "}" ;
statement = block | variable-declaration | expression-statement | if-statement |
            while-statement | do-statement | for-statement | foreach-statement |
            switch-statement | "break", ";" | "continue", ";" | return-statement |
            try-statement | throw-statement | using-statement | static-assert-statement | ";" ;
static-assert-statement = "static_assert", "(", expression,
                          [ ",", string-literal ], ")", ";" ;
variable-declaration = [ "const" ], ( "var" | type ), identifier,
                       [ "=", expression | aggregate-initializer ], ";" ;
expression-statement = expression, ";" ;
if-statement = "if", "(", expression, ")", block, [ "else", ( block | if-statement ) ] ;
while-statement = "while", "(", expression, ")", block ;
do-statement = "do", block, "while", "(", expression, ")", ";" ;
for-statement = "for", "(", [ variable-declaration-no-semi | expression ], ";",
                [ expression ], ";", [ expression ], ")", block ;
variable-declaration-no-semi = [ "const" ], ( "var" | type ), identifier, [ "=", expression ] ;
foreach-statement = "foreach", "(", [ "const" ], ( "var" | type ), identifier,
                    "in", expression, ")", block ;
switch-statement = "switch", "(", expression, ")", "{", { switch-section }, "}" ;
switch-section = ( "case", expression | "default" ), ":", { statement } ;
return-statement = "return", [ expression ], ";" ;
try-statement = "try", block, ( catch-clause, { catch-clause }, [ "finally", block ] |
                               "finally", block ) ;
catch-clause = "catch", [ "(", type, identifier, ")" ], block ;
throw-statement = "throw", [ expression ], ";" ;
using-statement = "using", "(", variable-declaration-no-semi, ")", block ;
aggregate-initializer = "{", [ expression-or-initializer,
                        { ",", expression-or-initializer }, [ "," ] ], "}" ;
expression-or-initializer = expression | aggregate-initializer ;

expression = assignment-expression | lambda-expression ;
lambda-expression = ( identifier | "(", [ lambda-parameter-list ], ")" ),
                    "=>", ( expression | block ) ;
lambda-parameter-list = lambda-parameter, { ",", lambda-parameter } ;
lambda-parameter = identifier | parameter ;
assignment-expression = conditional-expression,
                        [ assignment-operator, assignment-expression ] ;
conditional-expression = logical-or-expression,
                         [ "?", expression, ":", conditional-expression ] ;
logical-or-expression = logical-and-expression, { "||", logical-and-expression } ;
logical-and-expression = bitwise-or-expression, { "&&", bitwise-or-expression } ;
bitwise-or-expression = bitwise-xor-expression, { "|", bitwise-xor-expression } ;
bitwise-xor-expression = bitwise-and-expression, { "^", bitwise-and-expression } ;
bitwise-and-expression = equality-expression, { "&", equality-expression } ;
equality-expression = relational-expression, { ( "==" | "!=" ), relational-expression } ;
relational-expression = shift-expression,
                        { ( "<" | "<=" | ">" | ">=" | "is" | "as" ), shift-expression } ;
shift-expression = additive-expression, { ( "<<" | ">>" ), additive-expression } ;
additive-expression = multiplicative-expression, { ( "+" | "-" ), multiplicative-expression } ;
multiplicative-expression = unary-expression, { ( "*" | "/" | "%" ), unary-expression } ;
unary-expression = postfix-expression | ( "+" | "-" | "!" | "~" | "++" | "--" | "move" ),
                   unary-expression | cast-expression | allocation-expression |
                   ( "sizeof" | "alignof" ), "(", type, ")" |
                   "default", [ "(", type, ")" ] |
                   "delete", [ "[", "]" ], unary-expression |
                   "stackalloc", type, "[", expression, "]" ;
cast-expression = "(", type, ")", unary-expression ;
postfix-expression = primary-expression,
                     { "(", [ argument-list ], ")" | "[", argument-list, "]" |
                       ( "." | "->" ), identifier, [ type-arguments ] | "++" | "--" } ;
allocation-expression = "new", type-primary,
                        ( "(", [ argument-list ], ")" |
                          "[", [ expression ], "]", [ aggregate-initializer ] ) ;
primary-expression = literal | identifier, [ type-arguments ] | "this" | "base" | "null" |
                     "true" | "false" | "(", expression, ")" ;

assignment-operator = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" |
                      "^=" | "<<=" | ">>=" ;
operator-token = "+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | "<=" |
                 ">" | ">=" | "!" | "~" | "&" | "|" | "^" | "<<" | ">>" |
                 "++" | "--" ;
literal = integer-literal | floating-literal | character-literal | string-literal |
          "true" | "false" | "null" ;

identifier = identifier-start, { identifier-part } ;
identifier-start = "A" ... "Z" | "a" ... "z" | "_" ;
identifier-part = identifier-start | decimal-digit ;
integer-literal = ( decimal-digit, { decimal-digit } |
                    "0", ( "x" | "X" ), hex-digit, { hex-digit } |
                    "0", ( "b" | "B" ), binary-digit, { binary-digit } ),
                  [ integer-suffix ] ;
integer-suffix = "u" | "U" | "l" | "L" | "ul" | "uL" | "Ul" | "UL" |
                 "lu" | "lU" | "Lu" | "LU" ;
floating-literal = decimal-digit, { decimal-digit },
                   ( ".", decimal-digit, { decimal-digit }, [ exponent ], [ "f" | "F" ] |
                     exponent, [ "f" | "F" ] | "f" | "F" ) ;
exponent = ( "e" | "E" ), [ "+" | "-" ], decimal-digit, { decimal-digit } ;
character-literal = "'", ( printable-ascii-except-quote-and-backslash | escape ), "'" ;
string-literal = '"', { string-byte | escape | well-formed-utf8-sequence }, '"' ;
escape = "\\", ( "\\" | "'" | '"' | "0" | "a" | "b" | "f" | "n" | "r" | "t" |
                        "v" | "x", hex-digit, hex-digit ) ;
decimal-digit = "0" ... "9" ;
hex-digit = decimal-digit | "A" ... "F" | "a" ... "f" ;
binary-digit = "0" | "1" ;
