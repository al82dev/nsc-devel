int Main() {
    T09Box box; box.x=2;
    T09Nested a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    T09Array b; b.values[0]=(float)10; b.values[1]=(float)20; b.values[2]=(float)30;
    T09NestedFn fa=t09_get_nested(); T09ArrayFn fb=t09_get_array();
    T09Nested c=t09_nested(a,&box); T09Nested d=fa(a,&box); T09Array e=t09_array(b,&box); T09Array f=fb(b,&box);
    return box.x==6 && a.pair.x==(float)10 && a.z==(float)30 && b.values[0]==(float)10 && b.values[2]==(float)30 &&
           c.pair.x==(float)12 && c.pair.y==(float)22 && c.z==(float)33 && d.pair.x==(float)13 && d.pair.y==(float)22 && d.z==(float)33 &&
           e.values[0]==(float)14 && e.values[1]==(float)22 && e.values[2]==(float)33 &&
           f.values[0]==(float)15 && f.values[1]==(float)22 && f.values[2]==(float)33 ? 0 : 1;
}
