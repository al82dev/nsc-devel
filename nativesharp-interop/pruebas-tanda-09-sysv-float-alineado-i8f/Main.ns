int Main() { T09Byte first; first.x=1.5; first.y=2; T09Wide wide; wide.x=11; wide.y=13; wide.z=17; wide.w=19; T09Out probe; probe.a=(byte)3; probe.b=2.5f; T09Out result=sysv_float_aligned_i8f(1.5f,first,probe,wide,7); T09Out named=sysv_float_aligned_i8f(n: 7, wide: wide, probe: probe, first: first, factor: 1.5f); if (first.x!=1.5 || first.y!=2 || wide.x!=11 || wide.y!=13 || wide.z!=17 || wide.w!=19 || probe.a!=3 || probe.b!=2.5f || result.a!=5 || result.b!=3.5f || named.a!=5 || named.b!=3.5f) return 1; return 0; }
