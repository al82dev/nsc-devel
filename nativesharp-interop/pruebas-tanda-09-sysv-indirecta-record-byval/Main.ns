int Main() {
    T09IndirectLarge value; value.a = 1; value.b = 2; value.c = 3; value.d = 4; value.e = 5;
    T09LargeCallback callback = t09_get_large_callback();
    if (callback(value) != 55 || value.a != 1 || value.b != 2 || value.c != 3 || value.d != 4 || value.e != 5) return 1;
    return 0;
}
