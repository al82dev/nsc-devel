int Main() {
    T09MixedArgs value; value.x = 1.5; value.y = 7;
    T09MixedArgsCallback callback = t09_get_mixed_args_callback();
    if (callback(4, value, 8) != 42 || value.x != 1.5 || value.y != 7) return 1;
    if (callback(t09_mixed_args_next(), value, t09_mixed_args_next()) != 21) return 2;
    return 0;
}
