int Main()
{
    var item = PublishedRecordCallback.Bridge.GetPayload();
    var callback = PublishedRecordCallback.Bridge.Get();
    if (callback(item) != 42) return 1;
    var holder = PublishedRecordCallback.Bridge.GetHolder();
    if (holder->run(item) != 42) return 2;
    var global = PublishedRecordCallback.Bridge.GetGlobal();
    if (global(item) != 42) return 3;
    return 0;
}
