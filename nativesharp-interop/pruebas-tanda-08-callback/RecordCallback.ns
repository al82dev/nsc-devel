int Main()
{
    CallbackPayload item;
    item.value = 39;
    RecordCallback returned = get_record_callback();
    if (returned(&item) != 42) return 1;
    RecordCallbackHolder* holder = get_record_callback_holder();
    RecordCallback member = holder->run;
    if (member(&item) != 42) return 2;
    RecordCallback global = record_callback_global;
    if (global(&item) != 42) return 3;
    if (holder->run(&item) != 42) return 4;
    if (record_callback_global(&item) != 42) return 5;
    return 0;
}
