int Main()
{
    CColor color = COLOR_RED;
    CColorArray colors;
    colors[0] = COLOR_RED;
    colors[1] = COLOR_BLUE;
    if (c_echo_color(COLOR_BLUE) != COLOR_BLUE) return 1;
    int raw = COLOR_BLUE;
    if (raw != 2 || color != COLOR_RED) return 2;
    if (c_colors_sum(&colors) != 3) return 3;
    int dynamicValue = 2;
    CColor dynamicColor = dynamicValue;
    if (c_echo_color(dynamicColor) != COLOR_BLUE) return 4;
    int negative = -1;
    CUnsigned unsignedColor = negative;
    if (c_unsigned_verify(unsignedColor) != 1) return 5;
    long wide = 4294967297L;
    CColor narrowed = wide;
    if (c_echo_color(narrowed) != COLOR_RED) return 6;
    sbyte small = -1;
    CUnsigned extended = small;
    if (c_unsigned_verify(extended) != 1) return 7;
    return 0;
}
