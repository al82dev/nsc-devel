int Main()
{
    CColor color = COLOR_BLUE;
    int numeric = color;
    if (numeric != 2) return 1;
    CUnsigned other = color;
    if (other != 2) return 2;
    CUnsigned high = U_HIGH;
    long widened = high;
    if (widened != 4294967295L) return 3;
    CColor signedColor = -1;
    long signedWide = signedColor;
    if (signedWide != -1) return 4;
    return 0;
}
