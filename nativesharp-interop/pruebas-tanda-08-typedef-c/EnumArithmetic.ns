int Main()
{
    CColor color = COLOR_BLUE;
    int sum = color + 3;
    if (sum != 5) return 1;
    CUnsigned high = U_HIGH;
    uint wrapped = high + 1U;
    if (wrapped != c_unsigned_plus_one()) return 2;
    uint half = high / 2U;
    uint remainder = high % 2U;
    if (half != c_unsigned_half() || remainder != c_unsigned_remainder()) return 3;
    uint top = high >> 31;
    uint mask = high & 255U;
    int negative = -color;
    if (top != 1 || mask != 255 || negative != -2) return 4;
    return 0;
}
