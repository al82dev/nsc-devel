int Main()
{
    CColor color = COLOR_BLUE;
    int sum = color + 3;
    if (sum != 5) return 1;
    CUnsigned high = U_HIGH;
    uint wrapped = high + 1U;
    if (wrapped != c_unsigned_plus_one()) return 2;
    uint half = high / 2U;
    uint remainder = high % 2U;
    if (half != c_unsigned_half() || remainder != c_unsigned_remainder()) return 3;
    uint top = high >> 31;
    uint mask = high & 255U;
    int negative = -color;
    if (top != 1 || mask != 255 || negative != -2) return 4;
    CTiny tiny = TINY_MAX;
    int tinyNegative = -tiny;
    int tinyShift = tiny >> 1;
    int tinyMask = tiny & 15;
    if (tinyNegative != -255 || tinyShift != 127 || tinyMask != 15) return 5;
    int tinyComplement = ~tiny;
    int tinyCombined = tiny | tiny;
    int shiftByEnum = 8 >> color;
    if (tinyComplement != -256 || tinyCombined != 255 || shiftByEnum != 2) return 6;
    int signedNegative = -1;
    int signedTwo = 2;
    if ((high == signedNegative) != (c_unsigned_eq_negative() == 1)) return 7;
    long mixedSum = high + signedTwo;
    if (mixedSum != c_unsigned_add_two()) return 8;
    return 0;
}
