namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    T09Wide.PairDouble value; value.x=(float)10.25; value.y=(double)20.5;
    short direct=T09Wide.sum(value,7); T09Wide.SumFn fn=T09Wide.fetch(); short indirect=fn(value,7);
    return direct==(short)-1234 && indirect==(short)-1234 && value.x==(float)10.25 ? 0 : 1;
} } }
