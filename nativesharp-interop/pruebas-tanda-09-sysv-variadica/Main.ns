int Main() {
    int value = 123;
    if (sysv_varargs(3, (sbyte)-2, 2.25f, -5000000000L) != 1) return 1;
    if (sysv_many(9, (sbyte)-7, (byte)250, (short)-1000, (ushort)65000,
                  -5000000000L, (uint)4000000000, &value, 2.25f, 3.5) != 1) return 2;
    short s = -1234; T09VarRecord record; record.x = 42; record.y = 0; sbyte b = -12;
    if (sysv_ptrs(3, &s, &record, &b) != 1 || s != 1234 || record.x != 43 || b != 12) return 3;
    if (sysv_empty(0) != 1) return 4;
    if (sysv_floatspill(9, 2.25f, 2.25f, 2.25f, 2.25f, 2.25f, 2.25f, 2.25f, 2.25f, 3.5) != 1) return 5;
    s = -1234; record.x = 42;
    if (sysv_fixed_ptrs(&record, &s, (sbyte)-7, 2.25f) != 1 || s != 1234 || record.x != 43) return 6;
    if (sysv_return_ptr(&record, 7) != &record || record.x != 44) return 7;
    return 0;
}
