    T09Nested d=fa(a,++k,++k,++k,++k,++k,++k,++k,++k); int k1=k; k=0; T09Array f=fb(b,++k,++k,++k,++k,++k,++k,++k,++k);
    return k1==8 && k==8 && a.pair.x==(float)10 && a.z==(float)30 && b.values[0]==(float)10 && b.values[2]==(float)30 &&
