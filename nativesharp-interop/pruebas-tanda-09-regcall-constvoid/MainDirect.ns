int Main() {
    float input=(float)14; int out=0;
    T09Nested a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    T09Array b; b.values[0]=(float)10; b.values[1]=(float)20; b.values[2]=(float)30;
    T09Nested c=t09_nested(a,&input,&out);
    T09Array e=t09_array(b,&input,&out);
    return input==14 && out==2 &&
           c.pair.x==(float)24 && e.values[0]==(float)24 ? 0 : 1;
}
