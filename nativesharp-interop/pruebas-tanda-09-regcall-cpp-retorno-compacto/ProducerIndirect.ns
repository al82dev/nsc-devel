namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    T09Compact.Triple value; value.pair.x=(float)10; value.pair.y=(float)20; value.z=(float)30;
    T09Compact.CombineFn fn=T09Compact.fetch(); T09Compact.Result indirect=fn(value,7);
    return indirect.x==17 && indirect.y==50 && value.pair.x==(float)10 ? 0 : 1;
} } }
