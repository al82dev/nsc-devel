int Inspect(Published.Wrapper* wrapper) { return wrapper->value->value; }
int Main()
{
    var value = Published.Bridge.Get();
    if (value->value != 17) return 1;
    if (value->kind != Published.Bridge.GetKind()) return 2;
    if (CGlobalChoice != 21) return 3;
    var copy = Published.Bridge.GetValue();
    if (copy.value != 17 || copy.kind != Published.Bridge.GetKind()) return 4;
    var big = Published.Bridge.GetBig();
    if (big.first != 11 || big.second != 27 || big.third != 33) return 5;
    return 0;
}
