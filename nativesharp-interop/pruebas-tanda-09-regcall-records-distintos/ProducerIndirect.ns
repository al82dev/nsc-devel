namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    Triple a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    Other b; b.pair.x=(float)1; b.pair.y=(float)2; b.z=(float)3;
    CombineFn f=get_combine();
    Triple d=f(a,b,7);
    return d.pair.x==(float)18 && d.pair.y==(float)22 && d.z==(float)33 &&
           a.pair.x==(float)10 && b.pair.x==(float)1 ? 0 : 1;
} } }
