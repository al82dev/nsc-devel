int Main()
{
    H4Anon* a = h4_get_anon();
    H4NamedRecord* n = h4_get_named();
    if (a->raw != 7 || (int)a->level != H4Low || (int)a->other != H4High ||
        (int)a->fixed != H4Fixed || (int)a->changing != H4Changing) return 1;
    H4Named current = n->kind;
    if ((int)current != H4NamedA) return 2;
    a->level = H4High;
    a->other = H4Low;
    a->changing = H4Changed;
    n->kind = h4_named_b();
    return h4_check() == 1 ? 0 : 3;
}
