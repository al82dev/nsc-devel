int Main() {
    T09SysvAlignedMix first; T09SysvAlignedMix second; first.x=1; first.y=2; first.z=3; second.x=31; second.y=32; second.z=33;
    T09SysvAlignedMix result=sysv_aligned_mix(1.5f,first,7,second); T09SysvAlignedMix named=sysv_aligned_mix(n: 7, second: second, factor: 1.5f, first: first);
