    T09HfaCpp.Array e=T09HfaCpp.array(b); T09HfaCpp.Array f=fb(b);
    return a.pair.x==(float)10 && a.z==(float)30 && b.values[0]==(float)10 && b.values[2]==(float)30 &&
           c.pair.x==(float)11 && c.pair.y==(float)22 && c.z==(float)33 && d.pair.x==(float)11 && d.pair.y==(float)22 && d.z==(float)33 &&
           e.values[0]==(float)11 && e.values[1]==(float)22 && e.values[2]==(float)33 &&
