int Main() {
    Triple a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    Other b; b.pair.x=(float)1; b.pair.y=(float)2;
    Triple c=combine(a,7,b);
    return c.pair.x==(float)18 && c.pair.y==(float)22 && c.z==(float)31 &&
           a.pair.x==(float)10 && b.pair.x==(float)1 ? 0 : 1;
}
