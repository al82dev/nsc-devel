int Main() {
    T09IndirectVarRecord value; value.x = 2.25; value.y = 7;
    T09OtherVarRecord second; second.a = 3.5;
    T09IndirectVarCallback callback = t09_get_var_record_callback();
    if (callback(value, second) != 1 || value.x != 2.25 || value.y != 7 || second.a != 3.5) return 1;
    return 0;
}
