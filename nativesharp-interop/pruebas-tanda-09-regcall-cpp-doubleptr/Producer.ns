namespace T09 { public class NestedCppBridge { public static int Run<T>(T unused) {
    byte p=(byte)2; short q=(short)3; double r=(double)4; byte* pp=&p; short* qq=&q; double* rr=&r;
    T09HfaCpp.Nested a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    T09HfaCpp.Array b; b.values[0]=(float)10; b.values[1]=(float)20; b.values[2]=(float)30;
    T09HfaCpp.NestedFn fa=T09HfaCpp.fetchNested(); T09HfaCpp.ArrayFn fb=T09HfaCpp.fetchArray();
    T09HfaCpp.Nested c=T09HfaCpp.nested(a,&pp,&qq,&rr); T09HfaCpp.Nested d=fa(a,&pp,&qq,&rr);
    T09HfaCpp.Array e=T09HfaCpp.array(b,&pp,&qq,&rr); T09HfaCpp.Array f=fb(b,&pp,&qq,&rr);
    return pp==&p && qq==&q && rr==&r && p==(byte)6 && q==(short)7 && r==(double)8 && c.pair.x==(float)20 && d.pair.x==(float)23 && e.values[0]==(float)26 && f.values[0]==(float)29 && a.pair.x==(float)10 && b.values[0]==(float)10 ? 0 : 1;
} } }
