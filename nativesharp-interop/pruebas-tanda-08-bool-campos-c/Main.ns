    BoolAccess.SetValue(fields, 2, true);
    if (!(BoolAccess.GetValue(fields, 2))) return 119;
    bool_reset();
    BoolAccess.SetPacked(packed, true);
    if (bool_raw(5) != 1 || bool_c_load(5) != 1 || bool_neighbors_intact() == 0) return 120;
