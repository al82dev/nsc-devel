    bool_reset();
    bool_c_store(3, true);
    if (!(BoolAccess.GetValue(fields, 1))) return 112;
    bool_reset();
    bool_c_store(3, false);
    if (!(!BoolAccess.GetValue(fields, 1))) return 113;
    bool_reset();
    BoolAccess.SetValue(fields, 1, true);
