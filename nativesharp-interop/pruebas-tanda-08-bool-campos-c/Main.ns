    BoolAccess.SetValue(fields, 2, true);
    if (bool_raw(4) != 1 || bool_c_load(4) != 1 || bool_neighbors_intact() == 0) return 115;
    bool_reset();
    bool_c_store(4, true);
    BoolAccess.SetValue(fields, 2, false);
