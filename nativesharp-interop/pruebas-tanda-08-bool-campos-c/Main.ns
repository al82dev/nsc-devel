    bool_c_store(2, true);
    if (!(BoolAccess.GetValue(fields, 0))) return 107;
    bool_reset();
    bool_c_store(2, false);
    if (!(!BoolAccess.GetValue(fields, 0))) return 108;
    bool_reset();
    BoolAccess.SetValue(fields, 0, true);
