int Main() { T09Cpp.Small s; s.x=10; s.y=20; s.z=30; s.w=40; s.u=50; s.v=60; T09Cpp.Callback callback=T09Cpp.fetchCallback();
T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s); T09Cpp.Small b=callback(s);
return callback==direct && s.x==10 && s.y==20 && s.z==30 && s.w==40 && s.u==50 && s.v==60 && a.x==11 && a.y==20 && a.z==30 && a.w==40 && a.u==50 && a.v==62 && b.x==11 && b.y==20 && b.z==30 && b.w==40 && b.u==50 && b.v==62 ? 0 : 1; }
