int Main() { T09Cpp.Other s; s.x[0]=10; s.x[1]=20; s.x[2]=30; s.y=40; T09Cpp.Callback callback=T09Cpp.fetchCallback(); T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s); T09Cpp.Small b=callback(s); return callback==direct && s.x[0]==10 && s.x[1]==20 && s.x[2]==30 && s.y==40 && a.x==11 && a.y==20 && a.z==33 && b.x==11 && b.y==20 && b.z==33 ? 0 : 1; }
