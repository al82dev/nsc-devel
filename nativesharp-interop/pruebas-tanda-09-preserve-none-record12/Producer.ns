namespace T09 { public class RegBridge { public static int Run<T>(T unused) { T09Cpp.Small s; s.x=10; s.y=20; s.z=30; T09Cpp.Callback callback=T09Cpp.fetchCallback();
T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s); T09Cpp.Small b=callback(s);
return callback==direct && s.x==10 && s.y==20 && s.z==30 && a.x==11 && a.y==20 && a.z==32 && b.x==11 && b.y==20 && b.z==32 ? 0 : 1; } } }
