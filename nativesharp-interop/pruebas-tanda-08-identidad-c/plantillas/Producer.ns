namespace PublishedGen
{
    public class Bridge
    {
        public static int Number() { return gen_c_number(); }
        public static int Counter() { return gen_c_counter; }
        public static T Echo<T>(T value) { gen_c_number(); return value; }
        public static int CounterOf<T>(T value) { return gen_c_counter; }
        public static GenCount Count() { return 3; }
        public static int AliasOf<T>(T value) { GenCount count = 2; return count; }
        public static GenRecord* Record() { return gen_c_record(); }
        public static int RecordOf<T>(T value) { var record = gen_c_record(); return record->value; }
        public static int FieldOf<T>(GenRecord* record, T value) { return record->value; }
        public static int SetCounterOf<T>(T value) { gen_c_counter = 7; return gen_c_counter; }
        public static int Twice() { return gen_c_twice(4); }
    }
}
