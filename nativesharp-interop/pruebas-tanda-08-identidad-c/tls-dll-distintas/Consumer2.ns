int ThreadAccess(int value) {
    if (value == 0 && TlsLib2.Bridge.Access<int>(0, 0) != 7) return -1;
    int first = TlsLib.Bridge.Access<int>(0, value);
    if (value != 0 && TlsLib2.Bridge.Access<int>(0, 93) != 93) return -1;
    return first;
}
int Main() {
    if (TlsLib.Bridge.Access<int>(0, 0) != 3 || TlsLib2.Bridge.Access<int>(0, 0) != 7) return 1;
    if (TlsLib.Bridge.Access<int>(0, 41) != 41 || TlsLib2.Bridge.Access<int>(0, 51) != 51) return 2;
    TlsThreadCallback callback = (int value) => ThreadAccess(value);
    if (tls_call_native_thread(callback) != 0) return 3;
    if (TlsLib.Bridge.Access<int>(0, 0) != 41 || TlsLib2.Bridge.Access<int>(0, 0) != 51) return 4;
    return 0;
}
