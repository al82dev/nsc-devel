namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    byte p=(byte)2; short q=(short)3; double r=(double)4; byte* pp=&p; short* qq=&q; double* rr=&r;
    T09Nested a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    T09Array b; b.values[0]=(float)10; b.values[1]=(float)20; b.values[2]=(float)30;
    T09NestedFn fa=t09_get_nested(); T09ArrayFn fb=t09_get_array();
    T09Nested c=t09_nested(a,&pp,&qq,&rr); T09Nested d=fa(a,&pp,&qq,&rr);
    T09Array e=t09_array(b,&pp,&qq,&rr); T09Array f=fb(b,&pp,&qq,&rr);
    return pp==&p && qq==&q && rr==&r && p==(byte)6 && q==(short)7 && r==(double)8 && c.pair.x==(float)20 && d.pair.x==(float)23 && e.values[0]==(float)26 && f.values[0]==(float)29 && a.pair.x==(float)10 && b.values[0]==(float)10 ? 0 : 1;
} } }
