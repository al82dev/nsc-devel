int Main() {
    byte p=(byte)2; short q=(short)3; double r=(double)4; byte* pp=&p; short* qq=&q; double* rr=&r;
    T09Nested a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    T09Array b; b.values[0]=(float)10; b.values[1]=(float)20; b.values[2]=(float)30;
    T09Nested c=t09_nested(a,&pp,&qq,&rr);
    T09Array e=t09_array(b,&pp,&qq,&rr);
    return pp==&p && qq==&q && rr==&r && p==(byte)4 && q==(short)5 && r==(double)6 &&
           c.pair.x==(float)20 && e.values[0]==(float)23 ? 0 : 1;
}
