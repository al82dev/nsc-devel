int Main() {
    Triple a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    Triple b; b.pair.x=(float)1; b.pair.y=(float)2; b.z=(float)3;
    Triple c=combine(a,b,7);
    return c.pair.x==(float)18 && c.pair.y==(float)22 && c.z==(float)33 &&
           a.pair.x==(float)10 && b.pair.x==(float)1 ? 0 : 1;
}
