int Main() { T09Cpp.Other s; s.x=true; s.y=20; s.z=30; T09Cpp.Callback callback=T09Cpp.fetchCallback(); T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s); T09Cpp.Small b=callback(s); bool kept=s.x; s.x=false; T09Cpp.Small c=T09Cpp.most(s); T09Cpp.Small d=callback(s); return callback==direct && kept && !s.x && s.y==20 && s.z==30 && a.x==11 && b.x==11 && c.x==12 && d.x==12 && a.y==20 && b.y==20 && c.y==20 && d.y==20 && a.z==33 && b.z==33 && c.z==33 && d.z==33 ? 0 : 1; }
