namespace T09 { public class NestedCppBridge { public static int Run<T>(T unused) {
    T09HfaCpp.Nested a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    T09HfaCpp.OtherNested n; n.pair.x=(float)1; n.pair.y=(float)2;
    T09HfaCpp.Array b; b.values[0]=(float)10; b.values[1]=(float)20; b.values[2]=(float)30;
    T09HfaCpp.OtherArray q; q.values[0]=(float)1; q.values[1]=(float)2;
    T09HfaCpp.NestedFn fa=T09HfaCpp.fetchNested(); T09HfaCpp.ArrayFn fb=T09HfaCpp.fetchArray();
    int c=0; int e=0; T09HfaCpp.nested(a,7,n,&c); T09HfaCpp.array(b,7,q,&e);
    int d=0; int f=0; fa(a,7,n,&d); fb(b,7,q,&f);
    return c==166 && e==166 && d==166 && f==166 && a.pair.x==(float)10 && b.values[0]==(float)10 ? 0 : 1;
} } }
