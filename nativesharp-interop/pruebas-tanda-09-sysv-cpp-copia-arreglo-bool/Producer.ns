namespace T09 { public class RegBridge { public static int Run<T>(T unused) { T09Cpp.Other s; s.x[0]=true; s.x[1]=false; s.x[2]=true; s.y=40; s.z=30; T09Cpp.Callback callback=T09Cpp.fetchCallback(); T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s); T09Cpp.Small b=callback(s); bool kept=s.x[0]; s.x[0]=false; s.x[1]=true; T09Cpp.Small c=T09Cpp.most(s); T09Cpp.Small d=callback(s); return callback==direct && kept && !s.x[0] && s.x[1] && s.x[2] && s.y==40 && s.z==30 && a.x==11 && a.y==20 && a.z==33 && b.x==11 && b.y==20 && b.z==33 && c.x==12 && c.y==21 && c.z==33 && d.x==12 && d.y==21 && d.z==33 ? 0 : 1; } } }
