int ReadFirst(VolatileBits* value) { return (int)value->first; }
void WriteFirst(VolatileBits* value, uint number) { value->first = number; }
int ReadPackedFirst(PackedVolatileBits* value) { return (int)value->first; }
void WritePackedFirst(PackedVolatileBits* value, uint number) { value->first = number; }
int ReadUnionFirst(VolatileUnionBits* value) { return (int)value->first; }
void WriteUnionFirst(VolatileUnionBits* value, uint number) { value->first = number; }

int Main()
{
    var value = get_volatile_bits();
    var packed = get_packed_volatile_bits();
    init_volatile_bits(value, packed);
    if (value->first != 5 || value->delta != -3) return 1;
    if (packed->prefix != 11 || packed->first != 12 || packed->delta != -4) return 2;
    value->first = 6; value->delta = -7;
    packed->first = 7; packed->delta = -2;
    if (check_volatile_bits(value, packed) != 1) return 3;
    var unionValue = get_volatile_union_bits();
    init_volatile_union_bits(unionValue);
    if (unionValue->first != 5 || unionValue->delta != -3) return 4;
    unionValue->delta = -7; unionValue->first = 3;
    if (unionValue->delta != -5 || check_volatile_union_bits(unionValue) != 1) return 5;
    return 0;
}
