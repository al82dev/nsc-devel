int ReadSmall(VolatileMatrix* value) { return (int)value->small; }
int ReadMedium(VolatileMatrix* value) { return (int)value->medium; }
int ReadWord(VolatileMatrix* value) { return (int)value->word; }
int ReadWide(VolatileMatrix* value) { return (int)value->wide; }
void IncrementSmall(VolatileMatrix* value) { value->small++; }
void IncrementMedium(VolatileMatrix* value) { value->medium++; }
void IncrementWord(VolatileMatrix* value) { value->word++; }
void IncrementWide(VolatileMatrix* value) { value->wide++; }
int PostWord(VolatileMatrix* value) { return (int)(value->word++); }
int PreWord(VolatileMatrix* value) { return (int)(++value->word); }
void AddWord(VolatileMatrix* value) { value->word += 2; }
int Main()
{
    var value = matrix_get();
    matrix_init(value);
    if (ReadSmall(value) != 5 || ReadMedium(value) != -4 || ReadWord(value) != 21 || ReadWide(value) != 300) return 1;
    IncrementSmall(value); IncrementMedium(value); IncrementWord(value); IncrementWide(value);
    if (matrix_check(value) != 1) return 2;
    if (PostWord(value) != 22 || PreWord(value) != 24) return 3;
    AddWord(value);
    if (ReadWord(value) != 26) return 4;
    return 0;
}
