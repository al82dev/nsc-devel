int Main()
{
    if (sizeof(FlexInts) != (nuint)flex_layout(1)) return 1;
    if (alignof(FlexInts) != (nuint)flex_layout(2)) return 2;
    if (offsetof(FlexInts, data) != (nuint)flex_layout(3)) return 3;
    if (sizeof(FlexDoubles) != (nuint)flex_layout(4)) return 4;
    if (alignof(FlexDoubles) != (nuint)flex_layout(5)) return 5;
    if (offsetof(FlexDoubles, values) != (nuint)flex_layout(6)) return 6;
    if (sizeof(FlexRecords) != (nuint)flex_layout(7)) return 7;
    if (alignof(FlexRecords) != (nuint)flex_layout(8)) return 8;
    if (offsetof(FlexRecords, items) != (nuint)flex_layout(9)) return 9;
    if (sizeof(FlexEnums) != (nuint)flex_layout(10)) return 10;
    if (alignof(FlexEnums) != (nuint)flex_layout(11)) return 11;
    if (offsetof(FlexEnums, moods) != (nuint)flex_layout(12)) return 12;
    if (sizeof(FlexBools) != (nuint)flex_layout(13)) return 13;
    if (alignof(FlexBools) != (nuint)flex_layout(14)) return 14;
    if (offsetof(FlexBools, flags) != (nuint)flex_layout(15)) return 15;
    FlexInts* ints = flex_ints();
    FlexAccess.SetInts(ints, 0, 11);
    FlexAccess.SetInts(ints, 2, 33);
    if (flex_ints_check(0, 11) == 0 || flex_ints_check(2, 33) == 0) return 20;
    flex_ints_store(1, -22);
    if (FlexAccess.GetInts(ints, 1) != -22) return 21;
    int* element = &ints->data[2];
    *element = 44;
    if (flex_ints_check(2, 44) == 0) return 22;
    FlexDoubles* doubles = flex_doubles();
    FlexAccess.SetDoubles(doubles, 0, 1.5);
    FlexAccess.SetDoubles(doubles, 3, -2.25);
    if (flex_doubles_check(0, 1.5) == 0 || flex_doubles_check(3, -2.25) == 0) return 30;
