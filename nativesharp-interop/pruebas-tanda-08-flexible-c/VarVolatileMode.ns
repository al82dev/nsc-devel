int DirectVolatileRead(FlexVolatile* value) { return value->data[0]; }
void DirectVolatileWrite(FlexVolatile* value, int item) { value->data[0] = item; }

int VarVolatileRead(FlexVolatile* value)
{
    var data = value->data;
    return data[0];
}

void VarVolatileWrite(FlexVolatile* value, int item)
{
    var data = value->data;
    data[0] = item;
}

int Main() { return 0; }
