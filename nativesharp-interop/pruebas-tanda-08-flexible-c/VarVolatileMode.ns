int DirectVolatileRead(FlexVolatile* value) { return value->data[0]; }
void DirectVolatileWrite(FlexVolatile* value, int item) { value->data[0] = item; }

int VarVolatileRead(FlexVolatile* value)
{
    var data = value->data;
    return data[0];
}

void VarVolatileWrite(FlexVolatile* value, int item)
{
    var data = value->data;
    data[0] = item;
}

int ArithmeticVolatileRead(FlexVolatile* value, int index)
{
    var data = value->data;
    return *(data + index);
}

void ArithmeticVolatileWrite(FlexVolatile* value, int index, int item)
{
    var data = value->data;
    *(data + index) = item;
}

int ReassignVolatileRead(FlexVolatile* first, FlexVolatile* second)
{
    var data = first->data;
    data = second->data;
    return data[0];
}

void ReassignVolatileWrite(FlexVolatile* first, FlexVolatile* second, int item)
{
    var data = first->data;
    data = second->data;
    data[0] = item;
}

int Main() { return 0; }
