int Main()
{
    var c = Published.PackedBridge.Const();
    int const* values = c->data;
    if (values[0] != 123 || values[1] != 456) return 1;
    var inferredReadOnly = c->data;
    if (inferredReadOnly[0] != 123 || inferredReadOnly[1] != 456) return 4;
    var v = Published.PackedBridge.Volatile();
    Published.PackedBridge.VolatileSet(v, 1, 333);
    if (Published.PackedBridge.VolatilePointer(v) != 333) return 2;
    if (Published.PackedBridge.VolatileGet(v, 0) != 900) return 3;
    var inferredVolatile = v->data;
    inferredVolatile[0] = 901;
    return inferredVolatile[0] == 901 && Published.PackedBridge.VolatileGet(v, 0) == 901 ? 0 : 5;
}
