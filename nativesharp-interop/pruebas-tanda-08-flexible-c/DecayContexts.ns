int* First(FlexInts* value)
{
    return value->data;
}

int ReadFirst(int* value)
{
    return value[0];
}

int Main()
{
    FlexInts* value = flex_ints();
    flex_ints_store(0, 41);
    flex_ints_store(1, 42);
    int* first = value->data;
    if (first[0] != 41 || first[1] != 42) return 1;
    first[1] = 72;
    if (flex_ints_check(1, 72) == 0) return 2;
    int* assigned = null;
    assigned = value->data;
    if (assigned[1] != 72) return 3;
    if (ReadFirst(value->data) != 41) return 4;
    if (First(value)[1] != 72) return 5;
    return 0;
}
