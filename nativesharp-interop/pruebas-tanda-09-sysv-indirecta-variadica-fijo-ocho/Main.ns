int Main() {
    T09IndirectVarRecord value; value.x = 2.25; value.y = 7;
    T09OtherVarRecord second; second.a = 2; second.b = 3;
    T09IndirectVarCallback callback = t09_get_var_record_callback();
    if (callback(second, value) != 1 || value.x != 2.25 || value.y != 7 || second.a != 2 || second.b != 3) return 1;
    return 0;
}
