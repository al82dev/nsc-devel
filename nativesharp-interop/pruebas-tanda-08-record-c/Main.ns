int Main()
{
    Pair* item = make_pair();
    item->value = 23;
    if (read_pair(item) != 23) return 1;
    Parent* parent = make_parent();
    parent->child.value = 19;
    parent->children[1].value = 23;
    if (read_parent(parent) != 42) return 2;
    int destination = 19;
    int source = 23;
    add_distinct(&destination, &source);
    if (destination != 42) return 3;
    Device* device = get_device();
    device->counter = 42;
    if (device->counter != 42 || read_device(device) != 42) return 4;
    shared_value = 42;
    if (shared_value != 42 || read_shared_value() != 42) return 5;
    shared_volatile = 42;
    if (shared_volatile != 42 || read_shared_volatile() != 42) return 6;
    shared_array[1] = 19;
    shared_matrix[1][2] = 23;
    if (shared_array[1] != 19 || shared_matrix[1][2] != 23 || read_shared_arrays() != 42) return 7;
    if (readonly_array[1] != 17 || read_readonly_array() != 17) return 8;
    volatile_array[1] = 19;
    volatile_matrix[1][1] = 23;
    if (volatile_array[1] != 19 || volatile_matrix[1][1] != 23 || read_volatile_arrays() != 42) return 9;
    return 0;
}
