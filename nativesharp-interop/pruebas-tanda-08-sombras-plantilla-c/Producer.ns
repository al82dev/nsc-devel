namespace PublishedShadow
{
    public class Bridge
    {
        public static int Local<T>(T value)
        {
            int shadow_value = 13;
            int shadow_function = 17;
            return shadow_value + shadow_function;
        }

        public static int Parameter<T>(int shadow_value)
        {
            return shadow_value;
        }

        public static int Loop<T>(T value)
        {
            int sum = 0;
            for (int shadow_value = 0; shadow_value < 3; shadow_value++)
            {
                sum += shadow_value;
            }
            return sum;
        }

        public static int Lambda<T>(T value)
        {
            ShadowCallback callback = (int shadow_value) => shadow_value;
            return callback(23);
        }

        public static int Deconstruction<T>(T value)
        {
            var (shadow_value, other) = (13, 17);
            return shadow_value + other;
        }

        public static int NestedDeconstruction<T>(T value)
        {
            var (_, (shadow_value, shadow_function)) = (1, (13, 17));
            return shadow_value + shadow_function;
        }
    }
}
