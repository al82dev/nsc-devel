int Main() { T09Byte first; first.x=1.5; first.y=2; T09Wide wide; wide.x=11; wide.y=13; wide.z=17; wide.w=19; T09Out probe; probe.a=1.5f; probe.b=5000000000L; T09Out result=sysv_float_aligned_fi64(1.5f,first,probe,wide,7); T09Out named=sysv_float_aligned_fi64(n: 7, wide: wide, probe: probe, first: first, factor: 1.5f); if (first.x!=1.5 || first.y!=2 || wide.x!=11 || wide.y!=13 || wide.z!=17 || wide.w!=19 || probe.a!=1.5f || probe.b!=5000000000L || result.a!=2.5f || result.b!=5000000002L || named.a!=2.5f || named.b!=5000000002L) return 1; return 0; }
