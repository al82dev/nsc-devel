namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    PairDouble value; value.x=(float)10.25; value.y=(double)20.5; value.z=(double)3.5;
    short direct=sum_pair(value,7); SumFn fn=get_sum(); short indirect=fn(value,7);
    return direct==(short)-1224 && indirect==(short)-1224 && value.x==(float)10.25 ? 0 : 1;
} } }
