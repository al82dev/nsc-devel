int Main() {
    T09MixedPair first; first.x = 1.5; first.y = 3;
    T09MixedPair second; second.x = 2.5; second.y = 4;
    T09MixedPairCallback callback = t09_get_mixed_pair_callback();
    if (callback(first, second, 5) != 26 || first.x != 1.5 || first.y != 3 || second.x != 2.5 || second.y != 4) return 1;
    return 0;
}
