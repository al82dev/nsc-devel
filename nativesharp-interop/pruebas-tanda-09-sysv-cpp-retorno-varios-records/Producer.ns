namespace T09 { public class RegBridge { public static int Run<T>(T unused) { T09Cpp.Small s; s.x=10; s.y=20; s.z=30; T09Cpp.Small q; q.x=2; q.y=3; q.z=4; T09Cpp.Callback callback=T09Cpp.fetchCallback();
T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s,5,q); T09Cpp.Small b=callback(s,5,q);
return callback==direct && s.x==10 && s.y==20 && s.z==30 && q.x==2 && q.y==3 && q.z==4 && a.x==12 && a.y==20 && a.z==39 && b.x==12 && b.y==20 && b.z==39 ? 0 : 1; } } }
