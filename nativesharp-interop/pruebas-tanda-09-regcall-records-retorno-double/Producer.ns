namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    Triple a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    Other b; b.pair.x=(float)1; b.pair.y=(float)2;
    CombineFn f=get_combine();
    double c=combine(a,7,b);
    double d=f(a,7,b);
    return c==(double)166.5 && d==(double)166.5 && a.pair.x==(float)10 && b.pair.x==(float)1 ? 0 : 1;
} } }
