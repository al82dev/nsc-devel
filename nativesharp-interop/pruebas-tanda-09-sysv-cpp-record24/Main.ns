int Main() { T09Cpp.Small s; s.x=10; s.y=20; s.z=30; s.w=40; s.v=50; s.u=60; T09Cpp.Callback callback=T09Cpp.fetchCallback();
T09Cpp.Callback direct=T09Cpp.most; T09Cpp.Small a=T09Cpp.most(s); T09Cpp.Small b=callback(s);
return callback==direct && s.x==10 && s.y==20 && s.z==30 && s.w==40 && s.v==50 && s.u==60 && a.x==11 && a.y==20 && a.z==33 && a.w==44 && a.v==55 && a.u==66 && b.x==11 && b.y==20 && b.z==33 && b.w==44 && b.v==55 && b.u==66 ? 0 : 1; }
