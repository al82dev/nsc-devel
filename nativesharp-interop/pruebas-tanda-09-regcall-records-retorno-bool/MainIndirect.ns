int Main() {
    Triple a; a.pair.x=(float)10; a.pair.y=(float)20; a.z=(float)30;
    Other b; b.pair.x=(float)1; b.pair.y=(float)2;
    CombineFn f=get_combine();
    bool c=combine(a,7,b);
    bool d=f(a,7,b);
    return combine(a,8,b)==false && c==true && f(a,8,b)==false && d==true && a.pair.x==(float)10 && b.pair.x==(float)1 ? 0 : 1;
}
