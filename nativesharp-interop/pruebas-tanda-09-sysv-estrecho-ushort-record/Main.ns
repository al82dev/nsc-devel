int Main() { T09Byte first; first.x=11; T09Wide wide; wide.x=1.5f; wide.y=2.5f; ushort result=sysv_narrow_ushort_record(1.5f,first,wide,(ushort)60000,7); ushort named=sysv_narrow_ushort_record(n: 7, small: (ushort)60000, wide: wide, first: first, factor: 1.5f); if (first.x!=11 || wide.x!=1.5f || wide.y!=2.5f || result!=(ushort)60000 || named!=(ushort)60000) return 1; return 0; }
