int Main()
{
    if (read_mood(current_mood()) != -3) return 1;
    MoodCallback callback = (Mood value) => value;
    if (read_mood(apply_mood(callback, current_mood())) != -3) return 2;
    MoodData* data = get_mood_data();
    data->value = current_mood();
    data->values[1] = current_mood();
    if (read_mood_data(data) != -6) return 3;
    shared_mood = current_mood();
    if (read_mood(shared_mood) != -3 || read_shared_mood() != -3) return 4;
    if ((int)hidden_global != 7 || read_hidden_raw() != 7) return 5;
    if ((int)readonly_mood != -3) return 6;
    if (read_mood(*shared_mood_ptr) != -3) return 7;
    if ((int)*pointer_global_only != 9) return 8;
    if ((int)*(*double_pointer_global_only) != 11) return 9;
    if (read_pointer_globals() != 20) return 10;
    volatile_mood = current_mood();
    if (read_mood(volatile_mood) != -3 || read_volatile_mood() != -3) return 11;
    array_states[0] = array_states[1];
    matrix_states[1][0] = matrix_states[1][1];
    if ((int)array_states[0] != 8 || (int)matrix_states[1][0] != 12 || read_state_arrays() != 20) return 12;
    return 0;
}
