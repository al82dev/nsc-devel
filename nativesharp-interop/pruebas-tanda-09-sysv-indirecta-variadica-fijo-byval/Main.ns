int Main() {
    T09IndirectVarRecord value; value.a = 1; value.b = 2; value.c = 3; value.d = 4; value.e = 5;
    T09OtherVarRecord second; second.x = 3.5; second.y = 11;
    T09IndirectVarCallback callback = t09_get_var_record_callback();
    if (callback(value, second) != 1 || value.a != 1 || value.e != 5 || second.x != 3.5 || second.y != 11) return 1;
    return 0;
}
