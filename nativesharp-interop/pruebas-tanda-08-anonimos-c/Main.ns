int Main()
{
    LAnonymous* value = probe_anonymous();
    if (sizeof(LAnonymous) != (nuint)probe_anonymous_size()) return 1;
    value->tag = 1;
    value->i = 2;
    value->x = (short)3;
    value->y = (short)4;
    value->deep = 5;
    value->low = (uint)3;
    value->high = (uint)17;
    VolatileAccess.SetNatural(value, 12345);
    LPackedAnonymous* packed = probe_packed_anonymous();
    if (sizeof(LPackedAnonymous) != (nuint)probe_packed_anonymous_size()) return 3;
    packed->tag = (byte)6;
    packed->packedInt = 7;
    packed->packedShort = (short)8;
    packed->packedBits = (uint)5;
    packed->packedMore = (uint)19;
    VolatileAccess.SetPacked(packed, 23456);
    if (probe_anonymous_check() != 1) return 2;
    if (VolatileAccess.GetNatural(value) != 12345 || VolatileAccess.GetPacked(packed) != 23456) return 6;
    probe_anonymous_set_bits();
    if (value->low != (uint)2 || value->high != (uint)11) return 4;
    if (packed->packedBits != (uint)6 || packed->packedMore != (uint)23) return 5;
    return 0;
}
