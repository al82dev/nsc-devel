int Main()
{
    LAnonymous* value = probe_anonymous();
    if (sizeof(LAnonymous) != (nuint)probe_anonymous_size()) return 1;
    value->tag = 1;
    value->i = 2;
    value->x = (short)3;
    value->y = (short)4;
    value->deep = 5;
    LPackedAnonymous* packed = probe_packed_anonymous();
    if (sizeof(LPackedAnonymous) != (nuint)probe_packed_anonymous_size()) return 3;
    packed->tag = (byte)6;
    packed->packedInt = 7;
    packed->packedShort = (short)8;
    if (probe_anonymous_check() != 1) return 2;
    return 0;
}
