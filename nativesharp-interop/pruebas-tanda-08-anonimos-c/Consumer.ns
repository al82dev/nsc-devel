int Main()
{
    var value = Published.Bridge.Obj();
    if (sizeof(*value) != (nuint)Published.Bridge.Size()) return 1;
    value->tag = 1;
    value->i = 2;
    value->x = (short)3;
    value->y = (short)4;
    value->deep = 5;
    value->low = (uint)3;
    value->high = (uint)17;
    var packed = Published.Bridge.Packed();
    if (sizeof(*packed) != (nuint)Published.Bridge.PackedSize()) return 3;
    packed->tag = (byte)6;
    packed->packedInt = 7;
    packed->packedShort = (short)8;
    packed->packedBits = (uint)5;
    packed->packedMore = (uint)19;
    if (Published.Bridge.Check() != 1) return 2;
    Published.Bridge.SetBits();
    if (value->low != (uint)2 || value->high != (uint)11) return 4;
    if (packed->packedBits != (uint)6 || packed->packedMore != (uint)23) return 5;
    return 0;
}
