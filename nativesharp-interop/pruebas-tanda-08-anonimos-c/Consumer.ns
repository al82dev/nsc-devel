int Main()
{
    if (Published.Bridge.Constant<int>(1) != 12) return 7;
    var value = Published.Bridge.Obj();
    if (sizeof(*value) != (nuint)Published.Bridge.Size()) return 1;
    value->tag = 1;
    value->i = 2;
    value->x = (short)3;
    value->y = (short)4;
    value->deep = 5;
    value->low = (uint)3;
    value->high = (uint)17;
    VolatileAccess.SetNatural(value, 12345);
    value->items[1] = 21;
    var packed = Published.Bridge.Packed();
    if (sizeof(*packed) != (nuint)Published.Bridge.PackedSize()) return 3;
    packed->tag = (byte)6;
    packed->packedInt = 7;
    packed->packedShort = (short)8;
    packed->packedBits = (uint)5;
    packed->packedMore = (uint)19;
    VolatileAccess.SetPacked(packed, 23456);
    packed->packedItems[1] = (short)22;
    if (Published.Bridge.Check() != 1) return 2;
    if (VolatileAccess.GetNatural(value) != 12345 || VolatileAccess.GetPacked(packed) != 23456) return 6;
    Published.Bridge.SetBits();
    if (value->low != (uint)2 || value->high != (uint)11) return 4;
    if (packed->packedBits != (uint)6 || packed->packedMore != (uint)23) return 5;
    Published.Bridge.SetItems();
    if (value->items[1] != 31 || packed->packedItems[1] != (short)32) return 8;
    return 0;
}
