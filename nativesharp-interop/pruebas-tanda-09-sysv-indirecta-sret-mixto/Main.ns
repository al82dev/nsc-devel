int Main() {
    T09SretSplit small; small.x = 1.5; small.y = 7;
    T09SretLarge large; large.a = 1; large.b = 2; large.c = 3; large.d = 4; large.e = 5;
    T09SretMixedCallback callback = t09_get_sret_mixed_callback();
    T09SretLarge result = callback(3, small, large, 10);
    if (small.x != 1.5 || small.y != 7 || large.a != 1 || large.b != 2 || large.e != 5 ||
        result.a != 4 || result.b != 9 || result.c != 3 || result.d != 4 || result.e != 15) return 1;
    return 0;
}
