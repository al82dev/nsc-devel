namespace T09 { public class RegBridge { public static int Run<T>(T unused) {
T09Cpp.Small s; s.x=10; s.y=20; s.z=30; s.w=40; s.v=50; s.u=60;
T09Cpp.Other t; t.x=(double)100.5; t.y=(double)200.25; t.z=(double)300.75;
T09Cpp.Callback callback=T09Cpp.fetchCallback(); T09Cpp.Callback direct=T09Cpp.most;
T09Cpp.Small a=T09Cpp.most(s,7,t); T09Cpp.Small b=callback(s,7,t); T09Cpp.Small c=callback(s,7,t);
return callback==direct && s.x==10 && s.y==20 && s.z==30 && s.w==40 && s.v==50 && s.u==60 &&
t.x==100.5 && t.y==200.25 && t.z==300.75 &&
a.x==110 && a.y==37 && a.z==330 && a.w==44 && a.v==55 && a.u==66 &&
b.x==110 && b.y==37 && b.z==330 && b.w==44 && b.v==55 && b.u==66 &&
c.x==110 && c.y==37 && c.z==330 && c.w==44 && c.v==55 && c.u==66 ? 0 : 1;
} } }
