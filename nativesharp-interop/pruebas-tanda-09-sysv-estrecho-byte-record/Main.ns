int Main() { T09Byte first; first.x=11; T09Wide wide; wide.x=1.5f; wide.y=2.5f; byte result=sysv_narrow_byte_record(1.5f,first,wide,(byte)250,7); byte named=sysv_narrow_byte_record(n: 7, small: (byte)250, wide: wide, first: first, factor: 1.5f); if (first.x!=11 || wide.x!=1.5f || wide.y!=2.5f || result!=(byte)250 || named!=(byte)250) return 1; return 0; }
