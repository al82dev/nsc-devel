int Main()
{
    if (atomic_tls != 3) return 1;
    atomic_tls = 41;
    atomic_tls += 1;
    if (atomic_tls_read() != 42) return 2;
    if (atomic_tls++ != 42 || --atomic_tls != 42) return 3;
    atomic_tls -= 1;
    if (atomic_tls_read() != 41) return 4;
    atomic_tls = 0;
    if (atomic_start_worker() != 0) return 5;
    for (int i = 0; i < 10000; ++i) { atomic_tls += 1; }
    if (atomic_wait_worker() != 0 || atomic_tls != 20000) return 6;
    return 0;
}
