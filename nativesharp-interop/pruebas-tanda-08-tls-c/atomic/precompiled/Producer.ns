namespace PublishedAtomicTls
{
    public struct Bridge
    {
        public static int Read() { return atomic_tls; }
        public static int Add() { return atomic_tls += 2; }
        public static int CheckIsolation() { return atomic_tls_isolation_check(); }
        public static int ReadConstPointee()
        {
            atomic_pointer_const_pointee = atomic_pointer_expected();
            return *(atomic_pointer_const_pointee + 1);
        }
        public static int WriteVolatilePointee()
        {
            atomic_pointer_volatile_pointee = atomic_pointer_expected();
            *atomic_pointer_volatile_pointee = 81;
            return *atomic_pointer_volatile_pointee;
        }
    }
}
