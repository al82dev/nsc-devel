int Main()
{
    atomic_pointer = atomic_pointer_expected();
    if (*(atomic_pointer += 1) != 74) return 1;
    if (*(atomic_pointer -= 1) != 73) return 2;
    if (atomic_pointer++ != atomic_pointer_expected()) return 3;
    if (*(++atomic_pointer) != 75) return 4;
    if (*(atomic_pointer--) != 75) return 5;
    if (*(--atomic_pointer) != 73) return 6;
    atomic_pointer += 1;
    if (*(atomic_pointer += -1) != 73) return 7;
    return 0;
}
