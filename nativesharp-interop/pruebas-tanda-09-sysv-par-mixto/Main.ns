class T09Trace {
    public static int value = 0;
    public static float F(float x) { value = value * 10 + 3; return x; }
    public static int I(int x) { value = value * 10 + 7; return x; }
}
int Main() {
    T09SysvPairMix original; original.x = 1; original.y = 2; original.z = 3; original.w = 4; original.a = 5; original.b = 6; original.c = 7; original.d = 8; original.e = 9; original.f = 10; original.g = 11; original.h = 12;
    T09SysvPairMix result = sysv_pair_mix(original, 7, 3.0f);
    T09SysvPairMix named = sysv_pair_mix(b: T09Trace.F(3.0f), value: original, a: T09Trace.I(7));
    if (named.x != 11 || named.h != 12 || T09Trace.value != 37) return 2;
    if (original.x != 1 || original.y != 2 || original.z != 3 || original.w != 4 || original.a != 5 || original.b != 6 || original.c != 7 || original.d != 8 || original.e != 9 || original.f != 10 || original.g != 11 || original.h != 12 || result.x != 11 || result.y != 2 || result.z != 3 || result.w != 4 || result.a != 5 || result.b != 6 || result.c != 7 || result.d != 8 || result.e != 9 || result.f != 10 || result.g != 11 || result.h != 12) return 1;
    return 0;
}
