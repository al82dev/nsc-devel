namespace T09 { public class NestedBridge { public static int Run<T>(T unused) {
    T09Wide.PairDouble value; value.x=(float)10.25; value.y=(double)20.5; value.z=(double)3.5;
    bool direct=T09Wide.sum(value,7); T09Wide.SumFn fn=T09Wide.fetch(); bool indirect=fn(value,7);
    return direct==true && indirect==true && T09Wide.sum(value,8)==false && value.x==(float)10.25 ? 0 : 1;
} } }
