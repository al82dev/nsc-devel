int Main() { T09Byte first; first.x=1.5; first.y=2; T09Wide wide; wide.x=11; wide.y=13; wide.z=17; wide.w=19; T09Out probe; probe.a=2.5; probe.b=(byte)3; T09Out result=sysv_padded_pair_dc(1.5f,first,probe,wide,7); T09Out named=sysv_padded_pair_dc(n: 7, wide: wide, probe: probe, first: first, factor: 1.5f); if (first.x!=1.5 || first.y!=2 || wide.x!=11 || wide.y!=13 || wide.z!=17 || wide.w!=19 || probe.a!=2.5 || probe.b!=3 || result.a!=13.5 || result.b!=5 || named.a!=13.5 || named.b!=5) return 1; return 0; }
