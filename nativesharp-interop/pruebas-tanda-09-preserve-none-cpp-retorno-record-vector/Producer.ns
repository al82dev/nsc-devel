namespace T09 { public class RegBridge { public static int Run<T>(T unused) { T09Cpp.Small v; t09_init(&v); T09Cpp.Small a=T09Cpp.scalar(-3.5f,v); if(t09_check(&a,10)==0 || t09_check(&v,3)==0) return 1; T09Cpp.Callback callback=T09Cpp.fetchCallback(); T09Cpp.Small b=callback(1.25f,v); if(t09_check(&b,1)==0 || t09_check(&v,3)==0) return 2; return 0; } } }
