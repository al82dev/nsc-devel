int WaitTurn(int wanted)
{
    for (int spin = 0; spin < 1000000; ++spin) {
        if (atomic_turn == wanted) return 0;
        yield_atomic_worker();
    }
    return 1;
}
int Main()
{
    atomic_global = 0;
    atomic_turn = 0;
    if (start_atomic_worker() != 0) return 1;
    for (int round = 0; round < 100; ++round) {
        atomic_turn = 1;
        if (WaitTurn(2) != 0) return 4;
        atomic_turn = 3;
        for (int i = 0; i < 100; ++i) { atomic_global += 1; }
        if (WaitTurn(4) != 0) return 5;
        atomic_turn = 5;
        if (WaitTurn(0) != 0) return 6;
    }
    if (wait_atomic_worker() != 0) return 2;
    if (atomic_global != 20000 || c_read_atomic_global() != 20000) return 3;
    return 0;
}
