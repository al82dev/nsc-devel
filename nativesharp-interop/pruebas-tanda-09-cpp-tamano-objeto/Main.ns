int Main() {
    int value = 7;
    if (T09ObjectSize.size0(&value) != 4) return 1;
    if (T09ObjectSize.size1(&value) != 4) return 2;
    if (T09ObjectSize.size2(&value) != 4) return 3;
    if (T09ObjectSize.size3(&value) != 4) return 4;
    if (T09ObjectSize.dynamic0(&value) != 4) return 5;
    if (T09ObjectSize.dynamic2(&value) != 4) return 6;
    if (T09ObjectSize.dynamic1(&value) != 4) return 17;
    if (T09ObjectSize.dynamic3(&value) != 4) return 18;
    if (T09ObjectSize.mixed(1, &value, 2, &value, 3) != 14) return 7;
    if (T09ObjectSize.size0(T09ObjectSize.next()) != -1) return 8;
    if (T09ObjectSize.size2(T09ObjectSize.next()) != 0) return 9;
    if (T09ObjectSize.size1(T09ObjectSize.next()) != -1) return 13;
    if (T09ObjectSize.size3(T09ObjectSize.next()) != 0) return 14;
    if (T09ObjectSize.calls() != 4) return 10;
    T09ObjectSize.Pair pair;
    if (T09ObjectSize.size0(&pair.first) != 8) return 11;
    if (T09ObjectSize.size2(&pair.first) != 8) return 12;
    if (T09ObjectSize.size1(&pair.first) != 4) return 15;
    if (T09ObjectSize.size3(&pair.first) != 4) return 16;
    if (T09ObjectSize.dynamic1(&pair.first) != 4) return 19;
    if (T09ObjectSize.dynamic3(&pair.first) != 4) return 20;
    T09ObjectSize.ArrayPair array;
    if (T09ObjectSize.size1(&array.values[0]) != 8) return 21;
    if (T09ObjectSize.size1(&array.values[1]) != 4) return 22;
    if (T09ObjectSize.size3(&array.values[0]) != 8) return 23;
    if (T09ObjectSize.size3(&array.values[1]) != 4) return 24;
    if (T09ObjectSize.dynamic1(&array.values[1]) != 4) return 25;
    if (T09ObjectSize.dynamic3(&array.values[1]) != 4) return 26;
    const int constantIndex = 1;
    if (T09ObjectSize.size1(&array.values[constantIndex]) != 4) return 27;
    if (T09ObjectSize.size3(&array.values[constantIndex]) != 4) return 28;
    return 0;
}
