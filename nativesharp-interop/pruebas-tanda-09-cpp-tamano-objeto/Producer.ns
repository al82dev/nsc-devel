namespace T09 { public class SizeBridge { public static int Run<T>(T unused) {
    int value = 7;
    if (T09ObjectSize.size0(&value) != 4) return 1;
    if (T09ObjectSize.size2(&value) != 4) return 2;
    if (T09ObjectSize.size1(&value) != 4) return 6;
    if (T09ObjectSize.size3(&value) != 4) return 7;
    if (T09ObjectSize.dynamic0(&value) != 4) return 3;
    if (T09ObjectSize.dynamic2(&value) != 4) return 4;
    if (T09ObjectSize.dynamic1(&value) != 4) return 8;
    if (T09ObjectSize.dynamic3(&value) != 4) return 9;
    T09ObjectSize.Pair pair;
    if (T09ObjectSize.size1(&pair.first) != 4 || T09ObjectSize.size3(&pair.first) != 4) return 10;
    T09ObjectSize.ArrayPair array;
    if (T09ObjectSize.size1(&array.values[1]) != 4 || T09ObjectSize.size3(&array.values[0]) != 8) return 11;
    const int constantIndex = 1;
    if (T09ObjectSize.size1(&array.values[constantIndex]) != 4 || T09ObjectSize.size3(&array.values[constantIndex]) != 4) return 12;
    if (T09ObjectSize.mixed(1, &value, 2, &value, 3) != 14) return 5;
    return 0;
} } }
