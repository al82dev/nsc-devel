namespace T09 { public class RegBridge { public static int Run<T>(T unused) { T09Cpp.Small v; v.value=3; T09Cpp.Small a=T09Cpp.scalar(-3.5f,v); if(a.value!=10 || v.value!=3) return 1; T09Cpp.Callback callback=T09Cpp.fetchCallback(); T09Cpp.Small b=callback(1.25f,v); if(b.value!=1 || v.value!=3) return 2; return 0; } } }
