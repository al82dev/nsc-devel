namespace T09 { public class DoubleBridge { public static int Run<T>(T unused) {
    int a=7; int b=7; T09DoubleFn callback=t09_double_get();
    double direct=t09_double_transform(2.25, &a, 3.5);
    double indirect=callback(2.25, &b, 3.5);
    return direct==5.75 && indirect==5.75 && a==19 && b==19 ? 0 : 1;
} } }
