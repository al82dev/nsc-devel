using NativeSharp.Core;

namespace NativeSharp.BookExamples.DoublyLinkedList
{
    public class DoublyLinkedList<T>
    {
        private DoublyNode<T> head;
        private DoublyNode<T> tail;
        private int count;

        public DoublyLinkedList()
        {
            head = null;
            tail = null;
            count = 0;
        }

        public int Count { get { return count; } }
        public bool IsEmpty { get { return count == 0; } }
        public DoublyNode<T> First { get { return head; } }
        public DoublyNode<T> Last { get { return tail; } }

        private DoublyNode<T> NodeAt(int index)
        {
            if (index < 0 || index >= count)
            {
                throw new ArgumentOutOfRangeException();
            }

            if (index < count / 2)
            {
                DoublyNode<T> current = head;
                int i = 0;
                while (i < index)
                {
                    current = current.Next;
                    i = i + 1;
                }
                return current;
            }

            DoublyNode<T> reverse = tail;
            int j = count - 1;
            while (j > index)
            {
                reverse = reverse.Previous;
                j = j - 1;
            }
            return reverse;
        }

        public T GetAt(int index)
        {
            return NodeAt(index).Value;
        }

        public void AddFirst(T value)
        {
            DoublyNode<T> node = new DoublyNode<T>(value);
            node.Next = head;
            if (head != null)
            {
                head.Previous = node;
            }
            else
            {
                tail = node;
            }
            head = node;
            count = count + 1;
        }

        public void AddLast(T value)
        {
            DoublyNode<T> node = new DoublyNode<T>(value);
            node.Previous = tail;
            if (tail != null)
            {
                tail.Next = node;
            }
            else
            {
                head = node;
            }
            tail = node;
            count = count + 1;
        }

        public void InsertAt(int index, T value)
        {
            if (index < 0 || index > count)
            {
                throw new ArgumentOutOfRangeException();
            }
            if (index == 0)
            {
                AddFirst(value);
                return;
            }
            if (index == count)
            {
                AddLast(value);
                return;
            }

            DoublyNode<T> after = NodeAt(index);
            DoublyNode<T> before = after.Previous;
            DoublyNode<T> node = new DoublyNode<T>(value);
            node.Previous = before;
            node.Next = after;
            before.Next = node;
            after.Previous = node;
            count = count + 1;
        }

        private void Detach(DoublyNode<T> node)
        {
            if (node.Previous != null)
            {
                node.Previous.Next = node.Next;
            }
            else
            {
                head = node.Next;
            }

            if (node.Next != null)
            {
                node.Next.Previous = node.Previous;
            }
            else
            {
                tail = node.Previous;
            }

            node.Previous = null;
            node.Next = null;
            count = count - 1;
        }

        public void RemoveAt(int index, T[] result)
        {
            DoublyNode<T> node = NodeAt(index);
            result[0] = node.Value;
            Detach(node);
            delete node;
        }

        public bool RemoveFirstValue(T value)
        {
            DoublyNode<T> current = head;
            while (current != null)
            {
                if (current.Value == value)
                {
                    Detach(current);
                    delete current;
                    return true;
                }
                current = current.Next;
            }
            return false;
        }

        public int IndexOf(T value)
        {
            int index = 0;
            DoublyNode<T> current = head;
            while (current != null)
            {
                if (current.Value == value)
                {
                    return index;
                }
                current = current.Next;
                index = index + 1;
            }
            return -1;
        }

        public void Reverse()
        {
            DoublyNode<T> current = head;
            while (current != null)
            {
                DoublyNode<T> originalNext = current.Next;
                current.Next = current.Previous;
                current.Previous = originalNext;
                current = originalNext;
            }

            DoublyNode<T> temporary = head;
            head = tail;
            tail = temporary;
        }

        public void Clear()
        {
            DoublyNode<T> current = head;
            while (current != null)
            {
                DoublyNode<T> next = current.Next;
                current.Previous = null;
                current.Next = null;
                delete current;
                current = next;
            }
            head = null;
            tail = null;
            count = 0;
        }

        ~DoublyLinkedList()
        {
            Clear();
        }
    }
}
