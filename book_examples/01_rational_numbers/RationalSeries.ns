using NativeSharp.Core;

namespace NativeSharp.BookExamples.RationalNumbers
{
    public class RationalSeries
    {
        public static owned Rational Harmonic(int terms)
        {
            raii Rational sum = new Rational(0);
            int k = 1;

            while (k <= terms)
            {
                raii Rational term = new Rational(1, k);
                raii Rational next = sum + term;

                sum = move(next);

                k = k + 1;
            }

            return move(sum);
        }

        public static owned Rational LeibnizPiQuarter(int terms)
        {
            raii Rational sum = new Rational(0);
            int k = 0;
            int sign = 1;

            while (k < terms)
            {
                int denominator = 2 * k + 1;
                raii Rational term = new Rational(sign, denominator);
                raii Rational next = sum + term;

                sum = move(next);

                sign = -sign;
                k = k + 1;
            }

            return move(sum);
        }
    }
}
