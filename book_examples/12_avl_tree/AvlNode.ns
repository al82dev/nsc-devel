namespace NativeSharp.BookExamples.AvlTree
{
    public class AvlNode
    {
        public owned AvlRecord Value;
        public AvlNode Left;
        public AvlNode Right;
        public int Height;
        public AvlNode(owned AvlRecord value)
        {
            Value = move(value);
            Left = null;
            Right = null;
            Height = 1;
        }
    }
}
