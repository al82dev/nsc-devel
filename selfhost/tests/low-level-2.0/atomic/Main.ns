public class AtomicInt64
{
    private long value_;
    public AtomicInt64(long value) { value_ = value; }
    public long Load() { return 0; }
    public void Store(long value) { }
    public long Add(long value) { return 0; }
    public long Exchange(long value) { return 0; }
    public long CompareExchange(long value, long comparand) { return 0; }
}
public class Program
{
    public static int Main()
    {
        raii AtomicInt64 value = new AtomicInt64(40L);
        if (value.Load() != 40L || value.Add(2L) != 42L) { return 1; }
        if (value.CompareExchange(44L, 42L) != 42L || value.Exchange(45L) != 44L) { return 2; }
        value.Store(46L); return value.Load() == 46L ? 0 : 3;
    }
}
