        private static int EmitDiagnostic(Diagnostic diagnostic, bool json)
        {
            if (json)
            {
                raii string rendered = DiagnosticRenderer.Json(diagnostic);
                Console.ErrorWriteLine(rendered);
            }
            else
            {
                raii string rendered = DiagnosticRenderer.Human(diagnostic);
                Console.ErrorWriteLine(rendered);
            }
            return diagnostic.ExitCode();
        }

        private static int ReadSource(string path, bool dump)
        {
            if (!File.Exists(path))
            {
                raii Diagnostic missing = DiagnosticCatalog.MissingSource(path);
                return EmitDiagnostic(missing, false);
            }
            raii SourceBuffer source = SourceBuffer.Load(new FileId(1), path);
            if (dump)
            {
                raii string length = String.ToString(source.Length());
                raii string lines = String.ToString(source.LineCount());
                raii string hash = String.ToString(source.ContentHash());
                raii string first = String.Concat("{\"schema\":\"nativesharp-source-info\",\"version\":1,\"path\":\"", source.Path());
                raii string second = String.Concat(first, "\",\"bytes\":");
                raii string third = String.Concat(second, length);
                raii string fourth = String.Concat(third, ",\"lines\":");
                raii string fifth = String.Concat(fourth, lines);
                raii string sixth = String.Concat(fifth, ",\"fnv1a64\":\"");
                raii string seventh = String.Concat(sixth, hash);
                raii string output = String.Concat(seventh, "\"}");
                Console.WriteLine(output);
            }
            return 0;
        }

        private static int DumpTokens(string path)
        {
            if (!File.Exists(path))
            {
                raii Diagnostic missing = DiagnosticCatalog.MissingSource(path);
                return EmitDiagnostic(missing, false);
            }
            raii SourceBuffer source = SourceBuffer.Load(new FileId(1), path);
            raii Lexer lexer = new Lexer(source);
            raii TokenStream tokens = lexer.LexAll();
            raii string output = TokenDumper.Dump(source, tokens);
            Console.Write(output);
            if (tokens.ErrorCount() != 0) { return 1; }
            return 0;
        }

        private static int DumpAst(string path)
        {
            if (!File.Exists(path))
            {
                raii Diagnostic missing = DiagnosticCatalog.MissingSource(path);
                return EmitDiagnostic(missing, false);
            }
            raii SourceBuffer source = SourceBuffer.Load(new FileId(1), path);
            raii Lexer lexer = new Lexer(source);
            raii TokenStream tokens = lexer.LexAll();
            raii Parser parser = new Parser(source, tokens);
            raii SyntaxTree tree = parser.ParseCompilationUnit();
            raii string output = SyntaxDumper.Dump(tree);
            Console.Write(output);
            if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0) { return 1; }
            return 0;
        }

        private static int DumpSemantic(string path, int mode)
        {
            if (!File.Exists(path))
            {
                raii Diagnostic missing = DiagnosticCatalog.MissingSource(path);
                return EmitDiagnostic(missing, false);
            }
            raii SourceBuffer source = SourceBuffer.Load(new FileId(1), path);
            raii Lexer lexer = new Lexer(source);
            raii TokenStream tokens = lexer.LexAll();
            raii Parser parser = new Parser(source, tokens);
            raii SyntaxTree tree = parser.ParseCompilationUnit();
            raii SemanticAnalyzer analyzer = new SemanticAnalyzer(tree);
            raii SemanticModel semantic = analyzer.Analyze();
            raii string output = mode == 1 ? SemanticDumper.DumpSymbols(semantic) :
                (mode == 2 ? SemanticDumper.DumpMetadata(semantic) : SemanticDumper.Dump(tree, semantic));
            Console.Write(output);
            if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0 || semantic.ErrorCount() != 0) { return 1; }
            return 0;
        }

        private static int RunIr(string path, int stage, bool verify)
        {
            if (!File.Exists(path))
            {
                raii Diagnostic missing = DiagnosticCatalog.MissingSource(path);
                return EmitDiagnostic(missing, false);
            }
            raii SourceBuffer source = SourceBuffer.Load(new FileId(1), path);
            raii Lexer lexer = new Lexer(source); raii TokenStream tokens = lexer.LexAll();
            raii Parser parser = new Parser(source, tokens); raii SyntaxTree tree = parser.ParseCompilationUnit();
            raii SemanticAnalyzer analyzer = new SemanticAnalyzer(tree); raii SemanticModel semantic = analyzer.Analyze();
            if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0 || semantic.ErrorCount() != 0) { return 1; }
            if (verify) { return IrPipeline.Verify(tree, semantic, stage) ? 0 : 1; }
            raii string output = IrPipeline.Dump(tree, semantic, stage); Console.Write(output);
            return String.Contains(output, "ir.error") ? 1 : 0;
        }

        private static int SelfTest()
        {
            FileId file = new FileId(7);
            SourcePosition begin = new SourcePosition(file, 1);
            SourcePosition end = new SourcePosition(file, 4);
            SourceRange range = new SourceRange(begin, end);
            if (!file.IsValid() || !range.IsValid() || range.Length() != 3) { return 10; }
            if (StableHash.Text("native") != StableHash.Text("native")) { return 11; }
            if (StableHash.Text("native") == StableHash.Text("sharp")) { return 12; }

            raii GenerationArena arena = new GenerationArena(64);
            ArenaHandle handle = arena.Allocate(16);
            if (arena.Resolve(handle) == null || arena.BytesUsed() < 16) { return 13; }
            arena.Reset();
            if (arena.Resolve(handle) != null || arena.BytesUsed() != 0) { return 14; }

            raii SourceBuffer source = new SourceBuffer(file, "fixture.ns", "a\r\nb\rc\n");
            if (source.Text() != "a\nb\nc\n" || source.LineCount() != 4) { return 15; }
            int line = 0;
            int column = 0;
            source.GetLineColumn(4, out line, out column);
            if (line != 3 || column != 1) { return 16; }

            raii Diagnostic unknown = DiagnosticCatalog.UnknownOption("--bad");
            raii string rendered = DiagnosticRenderer.Human(unknown);
            if (rendered != "nsc: error: unknown option '--bad'") { return 17; }
            CompilerResult result = CompilerResult.Success();
            if (!result.Succeeded() || result.ExitCode() != 0) { return 18; }
            Console.WriteLine("SH04 Basic/Source/Diagnostics self-test passed");
            return 42;
        }

        private static int EmitBackend(string command, string sourcePath, string profile, string outputPath)
        {
            if (!File.Exists(sourcePath)) { return 1; }
            raii SourceBuffer source = SourceBuffer.Load(new FileId(1), sourcePath);
            raii Lexer lexer = new Lexer(source); raii TokenStream tokens = lexer.LexAll();
            raii Parser parser = new Parser(source, tokens); raii SyntaxTree tree = parser.ParseCompilationUnit();
            raii SemanticAnalyzer analyzer = new SemanticAnalyzer(tree); raii SemanticModel semantic = analyzer.Analyze();
            raii ValidatedIrProgram program = IrPipeline.Prepare(tree, semantic);
            if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0 || semantic.ErrorCount() != 0 ||
                !program.Valid()) { return 1; }
            BackendOptimization optimization = BackendOptimization.O0;
            if (profile == "-O1") { optimization = BackendOptimization.O1; }
            else if (profile == "-O2") { optimization = BackendOptimization.O2; }
            else if (profile == "-O3") { optimization = BackendOptimization.O3; }
            else if (profile != "-O0") { return 2; }
            BackendArtifactKind kind = command == "--emit-assembly" ?
                BackendArtifactKind.Assembly : BackendArtifactKind.Object;
            int result = LlvmBackend.EmitExecutableObject(program, outputPath, optimization, kind);
            if (result != 0)
            {
                raii string code = String.ToString(result);
                raii string message = String.Concat("nsc-next: error: LLVM backend failed with code ", code);
                Console.ErrorWriteLine(message);
                return 1;
            }
            Console.WriteLine(kind == BackendArtifactKind.Assembly ?
                "SH08 LLVM assembly emission: ok" : "SH08 LLVM object emission: ok");
            return 0;
        }

        // SH27 project backend. SourceGraph supplies canonical unit order; the root units become
        // one LLVM program module instead of the historical FirstSourcePath surrogate.
        private static int EmitProjectBackend(string projectPath, string profile, string outputPath)
        {
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath);
            raii ProjectModel project = ProjectLoader.Load(projectPath);
            if (graph.Failed() || !ProjectLoader.Verify(project)) { return 1; }
            raii StringBuilder sourceText = new StringBuilder();
            int unit = 0;
            while (unit < graph.UnitCount())
            {
                SourceUnit value = graph.UnitAt(unit);
                if (value.Owner() == project.Name())
                {
                    string text = File.ReadAllText(value.PathValue());
                    sourceText.Append(text); sourceText.Append('\n');
                }
                unit = unit + 1;
            }
            raii string merged = sourceText.ToOwnedString();
            raii SourceBuffer source = new SourceBuffer(new FileId(1), projectPath, merged);
            raii Lexer lexer = new Lexer(source); raii TokenStream tokens = lexer.LexAll();
            raii Parser parser = new Parser(source, tokens); raii SyntaxTree tree = parser.ParseCompilationUnit();
            raii SemanticAnalyzer analyzer = new SemanticAnalyzer(tree); raii SemanticModel semantic = analyzer.Analyze();
            raii ValidatedIrProgram program = IrPipeline.Prepare(tree, semantic);
            if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0 || semantic.ErrorCount() != 0 ||
                !program.Valid()) { return 1; }
            BackendOptimization optimization = BackendOptimization.O0;
            if (profile == "-O1") { optimization = BackendOptimization.O1; }
            else if (profile == "-O2") { optimization = BackendOptimization.O2; }
            else if (profile == "-O3") { optimization = BackendOptimization.O3; }
            else if (profile != "-O0") { return 2; }
            int result = LlvmBackend.EmitExecutableObject(program, outputPath, optimization,
                BackendArtifactKind.Object);
            if (result != 0)
            {
                raii string code = String.ToString(result);
                raii string message = String.Concat("nsc-next: error: project LLVM backend failed with code ", code);
                Console.ErrorWriteLine(message); return 1;
            }
            Console.WriteLine("SH27 project LLVM object emission: ok");
            return 0;
        }

        private static int DumpProjectIr(string projectPath, string stageName)
        {
            int stage = 0;
            if (stageName == "hir") { stage = 1; }
            else if (stageName == "mir") { stage = 2; }
            else if (stageName == "cfg") { stage = 3; }
            else if (stageName == "dominance") { stage = 4; }
            else if (stageName == "ssa") { stage = 5; }
            else { return 2; }
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath);
            raii ProjectModel project = ProjectLoader.Load(projectPath);
            if (graph.Failed() || !ProjectLoader.Verify(project)) { return 1; }
            raii StringBuilder sourceText = new StringBuilder(); int unit = 0;
            while (unit < graph.UnitCount())
            {
                SourceUnit value = graph.UnitAt(unit);
                if (value.Owner() == project.Name())
                { string text = File.ReadAllText(value.PathValue()); sourceText.Append(text); sourceText.Append('\n'); }
                unit = unit + 1;
            }
            raii string merged = sourceText.ToOwnedString();
            raii SourceBuffer source = new SourceBuffer(new FileId(1), projectPath, merged);
            raii Lexer lexer = new Lexer(source); raii TokenStream tokens = lexer.LexAll();
            raii Parser parser = new Parser(source, tokens); raii SyntaxTree tree = parser.ParseCompilationUnit();
            raii SemanticAnalyzer analyzer = new SemanticAnalyzer(tree); raii SemanticModel semantic = analyzer.Analyze();
            if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0 || semantic.ErrorCount() != 0) { return 1; }
            raii ValidatedIrProgram program = IrPipeline.Prepare(tree, semantic);
            if (!program.Valid()) { return 1; }
            raii string dump = IrPipeline.Dump(tree, semantic, stage); Console.Write(dump); return 0;
        }

