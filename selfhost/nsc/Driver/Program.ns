                { string text = File.ReadAllText(value.PathValue()); sourceText.Append(text); sourceText.Append('\n'); }
                unit = unit + 1;
            }
            raii string merged = sourceText.ToOwnedString();
            raii SourceBuffer source = new SourceBuffer(new FileId(1), projectPath, merged);
