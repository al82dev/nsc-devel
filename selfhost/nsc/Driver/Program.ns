        private static int DumpProjectEh(string projectPath)
        {
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath); raii ProjectModel project = ProjectLoader.Load(projectPath);
            if (graph.Failed() || !ProjectLoader.Verify(project)) { return 1; }
            raii StringBuilder sourceText = new StringBuilder(); int unit = 0;
            while (unit < graph.UnitCount())
            {
                SourceUnit value = graph.UnitAt(unit);
                if (value.Owner() == project.Name()) { string body = File.ReadAllText(value.PathValue()); sourceText.Append(body); sourceText.Append('\n'); }
                unit = unit + 1;
            }
            raii string merged = sourceText.ToOwnedString(); raii SourceBuffer source = new SourceBuffer(new FileId(1), projectPath, merged);
            raii Lexer lexer = new Lexer(source); raii TokenStream tokens = lexer.LexAll(); raii Parser parser = new Parser(source, tokens);
            raii SyntaxTree tree = parser.ParseCompilationUnit(); if (tokens.ErrorCount() != 0 || parser.ErrorCount() != 0) { return 1; }
            raii string dump = ExceptionRegionGraph.Dump(tree); Console.Write(dump); return 0;
        }

        // SH25. The whole source graph, dumped. Deterministic by construction: the order comes
        // from SourceGraph, never from the filesystem enumeration.
        private static int DumpSourceGraph(string projectPath)
        {
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath);
            raii string dump = SourceGraphDumper.Dump(graph);
            Console.Write(dump);
            return graph.Failed() ? 1 : 0;
        }

        // SH26. El conjunto de compilacion y su identidad de simbolos entre unidades.
        private static int DumpModuleSet(string projectPath, bool exports)
        {
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath);
            raii ProjectModel project = ProjectLoader.Load(projectPath);
            raii ModuleSet moduleSet = ModuleSet.Build(graph, project);
            raii string dump = exports ? ModuleSetDumper.DumpExports(moduleSet) : ModuleSetDumper.Dump(moduleSet);
            Console.Write(dump);
            return moduleSet.Failed() ? 1 : 0;
        }

        private static int VerifyBootstrapDependencies(string projectPath)
        {
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath);
            raii ProjectModel project = ProjectLoader.Load(projectPath);
            raii ModuleSet modules = ModuleSet.Build(graph, project);
            if (graph.Failed() || modules.Failed()) { return 1; }
            raii StringBuilder output = new StringBuilder();
            output.Append("bootstrap.dependencies schema=1\nprojects="); output.Append(graph.ProjectCount());
            output.Append("\ngraph-units="); output.Append(graph.UnitCount());
            output.Append("\ncompiler-units="); output.Append(modules.UnitCount());
            output.Append("\nexternal-projects="); output.Append(modules.ExternalProjectCount());
            output.Append("\nexternal-resolutions="); output.Append(modules.ExternalResolutionCount());
            output.Append("\nstatus=source-verified\n");
            raii string rendered = output.ToOwnedString(); Console.Write(rendered);
            return graph.ProjectCount() == 5 && graph.UnitCount() >= 90 &&
                modules.ExternalProjectCount() == 4 ? 0 : 1;
        }

        // SH25. Every root unit through the existing lexer and parser, with diagnostics attributed
        // PER UNIT. Each unit gets its own FileId, so a position reported for unit 7 cannot be
        // confused with one reported for unit 3.
        //
        // This deliberately makes no semantic claim: SemanticAnalyzer does not yet diagnose an
        // unresolved name. Cross-module symbols and semantic diagnostics belong to SH26.
        private static int CheckProject(string projectPath)
        {
            raii SourceGraph graph = SourceGraphBuilder.Build(projectPath);
            if (graph.Failed())
            {
                raii string failure = String.Concat("nsc-next: error: ", graph.Diagnostic());
                Console.ErrorWriteLine(failure);
                return 1;
            }

            raii ProjectModel rootProject = ProjectLoader.Load(projectPath);
            raii string rootOwner = String.Copy(rootProject.Name());
            int failed = 0;
            int checkedUnits = 0;
            int index = 0;
            while (index < graph.UnitCount())
            {
                SourceUnit unit = graph.UnitAt(index);
                if (unit.Owner() != rootOwner)
                {
                    index = index + 1;
                    continue;
                }
                raii SourceBuffer source = SourceBuffer.Load(new FileId(unit.Order() + 1), unit.PathValue());
                raii Lexer lexer = new Lexer(source);
                raii TokenStream tokens = lexer.LexAll();
                raii Parser parser = new Parser(source, tokens);
                raii SyntaxTree tree = parser.ParseCompilationUnit();
                int errors = tokens.ErrorCount() + parser.ErrorCount();
                raii StringBuilder line = new StringBuilder();
                line.Append("unit ");
                line.Append(unit.Order());
                line.Append(' ');
                line.Append(unit.Owner());
                line.Append(' ');
                line.Append(unit.RelativePath());
                line.Append(" errors=");
                line.Append(errors);
                raii string rendered = line.ToOwnedString();
                Console.WriteLine(rendered);
                if (errors != 0) { failed = failed + 1; }
                checkedUnits = checkedUnits + 1;
                index = index + 1;
            }

            raii StringBuilder summary = new StringBuilder();
            summary.Append("graph-units=");
            summary.Append(graph.UnitCount());
            summary.Append(" checked=");
            summary.Append(checkedUnits);
            summary.Append(" failed=");
            summary.Append(failed);
            raii string summaryText = summary.ToOwnedString();
            Console.WriteLine(summaryText);
            return failed == 0 ? 0 : 1;
        }

        private static int ProjectCommand(string command, string projectPath, string outputPath)
        {
            raii ProjectModel project = ProjectLoader.Load(projectPath);
            if (!ProjectLoader.Verify(project)) { Console.ErrorWriteLine("nsc-next: error: invalid project"); return 1; }
            if (command == "--verify-project") { return 0; }
            if (command == "--dump-project") { raii string dump = ProjectDumper.Dump(project); Console.Write(dump); return 0; }
            if (command == "--emit-nsmeta")
            {
                raii string metadata = MetadataContract.Write(project); File.WriteAllText(outputPath, metadata); return File.Exists(outputPath) ? 0 : 1;
            }
            raii string manifest = ToolchainManifest.Create(project, "O2", "configured");
            File.WriteAllText(outputPath, manifest); return File.Exists(outputPath) ? 0 : 1;
        }

        private static int RunResponseFile(string responsePath)
        {
            if (!File.Exists(responsePath)) { return 1; }
            string contents = File.ReadAllText(responsePath); int separator = String.IndexOf(contents, "\n");
            if (separator < 0) { return 2; }
            raii string actionRaw = String.Substring(contents, 0, separator); raii string action = String.Trim(actionRaw);
            raii string pathRaw = String.Substring(contents, separator + 1, contents.Length - separator - 1);
            raii string path = String.Trim(pathRaw);
            if (action != "--dump-project" && action != "--verify-project") { return 2; }
            return ProjectCommand(action, path, "");
        }

        public static int Main()
        {
            int count = Environment.GetCommandLineArgCount();
            string[] arguments = new string[count];
            if (Environment.GetCommandLineArgs(arguments) != count) { return 3; }
            if (count == 1)
            {
                PrintHelp();
                return 0;
            }

            string command = arguments[1];
            if (command.Length > 1 && command[0] == '@')
            {
                raii string responsePath = String.Substring(command, 1, command.Length - 1);
                return RunResponseFile(responsePath);
            }
            if (command == "--version") { PrintVersion(); return 0; }
            if (command == "--help") { PrintHelp(); return 0; }
            if (command == "--self-test-basic") { return SelfTest(); }
            if (command == "--bootstrap-generation")
            {
                if (count != 7) { return 2; }
                return GenerationBuilder.Build(arguments[2], arguments[3], arguments[4], arguments[5], arguments[6]);
            }
            if (command == "--dump-source-graph" || command == "--check-project")
            {
                if (count != 3) { return 2; }
                if (command == "--dump-source-graph") { return DumpSourceGraph(arguments[2]); }
                return CheckProject(arguments[2]);
            }
            if (command == "--dump-module-set" || command == "--dump-module-exports")
            {
                if (count != 3) { return 2; }
                return DumpModuleSet(arguments[2], command == "--dump-module-exports");
            }
            if (command == "--verify-bootstrap-dependencies")
            {
                if (count != 3) { return 2; }
                return VerifyBootstrapDependencies(arguments[2]);
            }
            if (command == "--dump-project" || command == "--verify-project")
            {
                if (count != 3) { return 2; }
                return ProjectCommand(command, arguments[2], "");
            }
            if (command == "--emit-nsmeta" || command == "--emit-toolchain-manifest")
            {
                if (count != 4) { return 2; }
                return ProjectCommand(command, arguments[2], arguments[3]);
            }
            if (command == "--emit-product-plan")
            {
                if (count != 6) { return 2; }
                raii ProjectModel project = ProjectLoader.Load(arguments[2]);
                if (!ProjectLoader.Verify(project)) { return 1; }
                raii string plan = ProductPlan.Create(project, arguments[3], arguments[4]);
                File.WriteAllText(arguments[5], plan); return File.Exists(arguments[5]) ? 0 : 1;
            }
            if (command == "--verify-nsmeta")
            {
                if (count != 3 || !File.Exists(arguments[2])) { return 2; }
                string metadata = File.ReadAllText(arguments[2]); return MetadataContract.ReadCompatible(metadata) ? 0 : 1;
            }
            if (command == "--emit-project-object")
            {
                if (count != 6 || arguments[4] != "-o") { return 2; }
                return EmitProjectBackend(arguments[2], arguments[3], arguments[5]);
            }
            if (command == "--dump-project-ir")
            {
                if (count != 4) { return 2; }
                return DumpProjectIr(arguments[2], arguments[3]);
            }
            if (command == "--dump-project-layout")
            {
                if (count != 3) { return 2; }
                return DumpProjectLayout(arguments[2]);
            }
            if (command == "--dump-project-generics")
            {
                if (count != 3) { return 2; }
                return DumpProjectGenerics(arguments[2]);
            }
            if (command == "--dump-project-callables")
            {
                if (count != 3) { return 2; }
                return DumpProjectCallables(arguments[2]);
            }
            if (command == "--dump-project-eh")
            {
                if (count != 3) { return 2; }
                return DumpProjectEh(arguments[2]);
            }
            if (command == "--emit-object" || command == "--emit-assembly")
            {
                if (count != 6 || arguments[4] != "-o") { return 2; }
                return EmitBackend(command, arguments[2], arguments[3], arguments[5]);
            }
            if (command == "--dump-tokens")
            {
                if (count != 3) { return 2; }
                return DumpTokens(arguments[2]);
            }
            if (command == "--dump-ast")
            {
                if (count != 3) { return 2; }
                return DumpAst(arguments[2]);
            }
            if (command == "--dump-symbols" || command == "--dump-sema")
            {
                if (count != 3) { return 2; }
                return DumpSemantic(arguments[2], command == "--dump-symbols" ? 1 : 0);
            }
            if (command == "--dump-semantic-metadata")
            {
                if (count != 3) { return 2; }
                return DumpSemantic(arguments[2], 2);
            }
            if (command == "--dump-hir" || command == "--dump-mir" || command == "--dump-cfg" ||
                command == "--dump-dominance" || command == "--dump-ssa" || command == "--dump-pass-pipeline" ||
                command == "--verify-hir" || command == "--verify-mir" || command == "--verify-cfg" ||
                command == "--verify-dominance" || command == "--verify-ssa")
            {
                if (count != 3) { return 2; }
                int stage = 6;
                if (String.Contains(command, "hir")) { stage = 1; }
                else if (String.Contains(command, "mir")) { stage = 2; }
                else if (String.Contains(command, "cfg")) { stage = 3; }
                else if (String.Contains(command, "dominance")) { stage = 4; }
                else if (String.Contains(command, "ssa")) { stage = 5; }
                return RunIr(arguments[2], stage, String.Contains(command, "--verify-"));
            }
            if (command == "--read-source" || command == "--dump-source-info")
            {
                if (count != 3)
                {
                    raii Diagnostic invalid = DiagnosticCatalog.UnknownOption(command);
                    return EmitDiagnostic(invalid, false);
                }
                return ReadSource(arguments[2], command == "--dump-source-info");
            }
            if (command == "--diagnostic-format=json")
            {
                if (count != 3) { return 2; }
                if (!File.Exists(arguments[2]))
                {
                    raii string normalized = DiagnosticRenderer.NormalizedPath(arguments[2]);
                    raii Diagnostic missing = DiagnosticCatalog.MissingSource(normalized);
                    return EmitDiagnostic(missing, true);
                }
                return ReadSource(arguments[2], false);
            }
            if (command.Length > 0 && command[0] == '-')
            {
                raii Diagnostic unknown = DiagnosticCatalog.UnknownOption(command);
                return EmitDiagnostic(unknown, false);
            }
            return ReadSource(command, false);
        }
    }
}
