using NativeSharp.Core;
using NativeSharp.Core.Collections.Generic;
using NativeSharp.LLVM.C;
using NativeSharp.Compiler.Lexer;
using NativeSharp.Compiler.Syntax;
using NativeSharp.Compiler.Sema;

namespace NativeSharp.Compiler.CodeGen
{
    public enum BackendArtifactKind
    {
        Assembly = 0,
        Object = 1
    }

    public enum BackendOptimization
    {
        O0 = 0,
        O1 = 1,
        O2 = 2,
        O3 = 3
    }

    // SH18 keeps LLVM handles non-owning.  The state owns only these small binding records;
    // LLVM continues to own the alloca instructions referenced by Storage().
    public class LocalBinding
    {
        private int symbol;
        private void* storage;
        public LocalBinding(int symbolId, void* storageValue) { symbol = symbolId; storage = storageValue; }
        public int Symbol() { return symbol; }
        public void* Storage() { return storage; }
    }

    public class FunctionLoweringState
    {
        private owned List<LocalBinding> locals;
        public FunctionLoweringState() { locals = new List<LocalBinding>(); }
        public void AddLocal(int symbol, void* storage)
        {
            raii LocalBinding binding = new LocalBinding(symbol, storage); locals.Add(move(binding));
        }
        public void* FindLocal(int symbol)
        {
            int index = locals.Count() - 1;
            while (index >= 0)
            {
                if (locals[index].Symbol() == symbol) { return locals[index].Storage(); }
                index = index - 1;
            }
            return null;
        }
    }

    // Backend bootstrap SH08. Toda dependencia de LLVM cruza exclusivamente LLVM-C.dll;
    // ningún layout de C++ ni header de LLVM forma parte del compilador autocontenido.
    public class LlvmBackend
    {
        private static int FindEntryExpression(SyntaxTree tree, int syntaxId)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode declaration = tree.Node(syntaxId);
            if ((declaration.Kind() == "FunctionDeclaration" || declaration.Kind() == "MethodDeclaration") &&
                declaration.Text() == "Main" && declaration.First() >= 0)
            {
                SyntaxNode body = tree.Node(declaration.First());
                int statementIndex = 0;
                while (statementIndex < body.ChildCount())
                {
                    SyntaxNode statement = tree.Node(body.ChildAt(statementIndex));
                    if (statement.Kind() == "ReturnStatement" && statement.First() >= 0)
                    { return statement.First(); }
                    statementIndex = statementIndex + 1;
                }
            }
            int found = FindEntryExpression(tree, declaration.First()); if (found >= 0) { return found; }
            found = FindEntryExpression(tree, declaration.Second()); if (found >= 0) { return found; }
            found = FindEntryExpression(tree, declaration.Third()); if (found >= 0) { return found; }
            int child = 0;
            while (child < declaration.ChildCount())
            {
                found = FindEntryExpression(tree, declaration.ChildAt(child));
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int EntryExpression(SyntaxTree tree)
        { return FindEntryExpression(tree, tree.Root()); }

        private static int ParameterCount(SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId); int count = 0; int index = 0;
            while (index < declaration.ChildCount())
            {
                if (tree.Node(declaration.ChildAt(index)).Kind() == "ParameterDeclaration")
                { count = count + 1; }
                index = index + 1;
            }
            return count;
        }

        private static void* I32FunctionType(void* i32, int parameterCount)
        {
            if (parameterCount < 0 || parameterCount > 4) { return null; }
            void*[4] parameterTypes;
            int index = 0; while (index < parameterCount) { parameterTypes[index] = i32; index = index + 1; }
            void** parameters = null;
            if (parameterCount > 0) { parameters = &parameterTypes[0]; }
            return LLVM.LLVMFunctionType(i32, parameters, (uint)parameterCount, 0);
        }

        private static owned string LlvmFunctionName(string sourceName)
        { return String.Concat("__nativesharp_source_", sourceName); }

        private static int FindFunctionDeclaration(SyntaxTree tree, int syntaxId, string name)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.Text() == name && node.First() >= 0) { return syntaxId; }
            int found = FindFunctionDeclaration(tree, node.First(), name); if (found >= 0) { return found; }
            found = FindFunctionDeclaration(tree, node.Second(), name); if (found >= 0) { return found; }
            found = FindFunctionDeclaration(tree, node.Third(), name); if (found >= 0) { return found; }
            int child = 0;
            while (child < node.ChildCount())
            {
                found = FindFunctionDeclaration(tree, node.ChildAt(child), name);
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int ReturnExpression(SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            if (declaration.First() < 0) { return -1; }
            SyntaxNode body = tree.Node(declaration.First()); int index = 0;
            while (index < body.ChildCount())
            {
                SyntaxNode statement = tree.Node(body.ChildAt(index));
                if (statement.Kind() == "ReturnStatement" && statement.First() >= 0)
                { return statement.First(); }
                index = index + 1;
            }
            return -1;
        }

        private static bool DeclareFunctions(void* module, void* i32, SyntaxTree tree, int syntaxId)
        {
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.First() >= 0 && node.TypeText() == "int")
            {
                int parameterCount = ParameterCount(tree, syntaxId);
                void* functionType = I32FunctionType(i32, parameterCount);
                if (functionType == null) { return false; }
                raii string llvmNameText = LlvmFunctionName(node.Text());
                raii CString llvmName = new CString(llvmNameText);
                if (LLVM.LLVMAddFunction(module, llvmName.Pointer(), functionType) == null) { return false; }
            }
            if (!DeclareFunctions(module, i32, tree, node.First())) { return false; }
            if (!DeclareFunctions(module, i32, tree, node.Second())) { return false; }
            if (!DeclareFunctions(module, i32, tree, node.Third())) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                if (!DeclareFunctions(module, i32, tree, node.ChildAt(child))) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static void* EmitI32Expression(void* module, void* builder, void* i32, SyntaxTree tree,
            SemanticModel semantic, int declarationId, void* function, FunctionLoweringState state,
            int syntaxId, out bool valid)
        {
            valid = false;
            if (syntaxId < 0) { return null; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "IntegerLiteralExpression")
            {
                long value = 0;
                if (!Number.TryParseInt64(semantic.Fact(syntaxId).ConstantText(), out value)) { return null; }
                valid = true;
                return LLVM.LLVMConstInt(i32, (ulong)value, 1);
            }
            if (node.Kind() == "UnaryExpression" &&
                (node.OperatorKind() == TokenKind.Plus || node.OperatorKind() == TokenKind.Minus))
            {
                bool operandValid = false;
                void* operand = EmitI32Expression(module, builder, i32, tree, semantic,
                    declarationId, function, state, node.First(), out operandValid);
                if (!operandValid || operand == null) { return null; }
                valid = true;
                if (node.OperatorKind() == TokenKind.Plus) { return operand; }
                raii CString unaryName = new CString("unary.minus");
                return LLVM.LLVMBuildSub(builder, LLVM.LLVMConstInt(i32, 0UL, 0), operand, unaryName.Pointer());
            }
            if (node.Kind() == "IdentifierExpression")
            {
                int symbol = semantic.Fact(syntaxId).SymbolId();
                void* localStorage = state.FindLocal(symbol);
                if (localStorage != null)
                {
                    raii CString loadName = new CString("local.load"); valid = true;
                    return LLVM.LLVMBuildLoad2(builder, i32, localStorage, loadName.Pointer());
                }
                SyntaxNode declaration = tree.Node(declarationId);
                int parameter = 0; int child = 0;
                while (child < declaration.ChildCount())
                {
                    int childId = declaration.ChildAt(child); SyntaxNode value = tree.Node(childId);
                    if (value.Kind() == "ParameterDeclaration")
                    {
                        if (semantic.NodeSymbol(childId) == symbol)
                        { valid = true; return LLVM.LLVMGetParam(function, (uint)parameter); }
                        parameter = parameter + 1;
                    }
                    child = child + 1;
                }
                return null;
            }
            if (node.Kind() == "AssignmentExpression" && node.OperatorKind() == TokenKind.Equal &&
                node.First() >= 0 && tree.Node(node.First()).Kind() == "IdentifierExpression")
            {
                bool assignedValid = false;
                void* assigned = EmitI32Expression(module, builder, i32, tree, semantic,
                    declarationId, function, state, node.Second(), out assignedValid);
                int symbol = semantic.Fact(node.First()).SymbolId(); void* storage = state.FindLocal(symbol);
                if (!assignedValid || assigned == null || storage == null ||
                    LLVM.LLVMBuildStore(builder, assigned, storage) == null) { return null; }
                valid = true; return assigned;
            }
            if (node.Kind() == "CallExpression" && node.First() >= 0)
            {
                SyntaxNode callee = tree.Node(node.First());
                if (callee.Kind() != "IdentifierExpression" || node.ChildCount() > 4) { return null; }
                int calleeDeclaration = FindFunctionDeclaration(tree, tree.Root(), callee.Text());
                if (calleeDeclaration < 0 || ParameterCount(tree, calleeDeclaration) != node.ChildCount())
                { return null; }
                raii string llvmNameText = LlvmFunctionName(callee.Text()); raii CString llvmName = new CString(llvmNameText);
                void* calleeFunction = LLVM.LLVMGetNamedFunction(module, llvmName.Pointer());
                void* calleeType = I32FunctionType(i32, node.ChildCount());
                if (calleeFunction == null || calleeType == null) { return null; }
                void*[4] arguments; int argument = 0;
                while (argument < node.ChildCount())
                {
                    bool argumentValid = false;
                    arguments[argument] = EmitI32Expression(module, builder, i32, tree, semantic,
                        declarationId, function, state, node.ChildAt(argument), out argumentValid);
                    if (!argumentValid || arguments[argument] == null) { return null; }
                    argument = argument + 1;
                }
                raii CString callName = new CString("source.call");
                void** callArguments = null;
                if (node.ChildCount() > 0) { callArguments = &arguments[0]; }
                void* call = LLVM.LLVMBuildCall2(builder, calleeType, calleeFunction,
                    callArguments, (uint)node.ChildCount(), callName.Pointer());
                valid = call != null; return call;
            }
            if (node.Kind() != "BinaryExpression") { return null; }
            bool leftValid = false; bool rightValid = false;
            void* left = EmitI32Expression(module, builder, i32, tree, semantic,
                declarationId, function, state, node.First(), out leftValid);
            void* right = EmitI32Expression(module, builder, i32, tree, semantic,
                declarationId, function, state, node.Second(), out rightValid);
            if (!leftValid || !rightValid || left == null || right == null) { return null; }
            raii CString temporaryName = new CString("source.value");
            void* result = null;
            if (node.OperatorKind() == TokenKind.Plus)
            { result = LLVM.LLVMBuildAdd(builder, left, right, temporaryName.Pointer()); }
            else if (node.OperatorKind() == TokenKind.Minus)
            { result = LLVM.LLVMBuildSub(builder, left, right, temporaryName.Pointer()); }
            else if (node.OperatorKind() == TokenKind.Star)
            { result = LLVM.LLVMBuildMul(builder, left, right, temporaryName.Pointer()); }
            else if (node.OperatorKind() == TokenKind.Slash)
            { result = LLVM.LLVMBuildSDiv(builder, left, right, temporaryName.Pointer()); }
            valid = result != null;
            return result;
        }

        private static bool Comparison(TokenKind operation)
        {
            return operation == TokenKind.EqualEqual || operation == TokenKind.BangEqual ||
                operation == TokenKind.Less || operation == TokenKind.LessEqual ||
                operation == TokenKind.Greater || operation == TokenKind.GreaterEqual;
        }

        private static LLVMIntPredicate ComparisonPredicate(TokenKind operation)
        {
            if (operation == TokenKind.EqualEqual) { return LLVMIntPredicate.Equal; }
            if (operation == TokenKind.BangEqual) { return LLVMIntPredicate.NotEqual; }
            if (operation == TokenKind.Less) { return LLVMIntPredicate.SignedLessThan; }
            if (operation == TokenKind.LessEqual) { return LLVMIntPredicate.SignedLessOrEqual; }
            if (operation == TokenKind.Greater) { return LLVMIntPredicate.SignedGreaterThan; }
            return LLVMIntPredicate.SignedGreaterOrEqual;
        }

        private static void* EmitCondition(void* module, void* builder, void* i32, SyntaxTree tree,
            SemanticModel semantic, int declarationId, void* function, FunctionLoweringState state,
            int syntaxId, out bool valid)
        {
            valid = false; SyntaxNode node = tree.Node(syntaxId); raii CString conditionName = new CString("condition");
            if (node.Kind() == "BinaryExpression" && Comparison(node.OperatorKind()))
            {
                bool leftValid = false; bool rightValid = false;
                void* left = EmitI32Expression(module, builder, i32, tree, semantic,
                    declarationId, function, state, node.First(), out leftValid);
                void* right = EmitI32Expression(module, builder, i32, tree, semantic,
                    declarationId, function, state, node.Second(), out rightValid);
                if (!leftValid || !rightValid || left == null || right == null) { return null; }
                void* comparison = LLVM.LLVMBuildICmp(builder, ComparisonPredicate(node.OperatorKind()),
                    left, right, conditionName.Pointer()); valid = comparison != null; return comparison;
            }
            bool valueValid = false;
            void* value = EmitI32Expression(module, builder, i32, tree, semantic,
                declarationId, function, state, syntaxId, out valueValid);
            if (!valueValid || value == null) { return null; }
            void* comparison = LLVM.LLVMBuildICmp(builder, LLVMIntPredicate.NotEqual, value,
                LLVM.LLVMConstInt(i32, 0UL, 0), conditionName.Pointer());
            valid = comparison != null; return comparison;
        }

        private static bool EmitStatement(void* context, void* module, void* builder, void* i32,
            SyntaxTree tree, SemanticModel semantic, int declarationId, void* function,
            FunctionLoweringState state, int syntaxId, out bool terminated)
        {
            terminated = false;
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "BlockStatement")
            {
                int child = 0;
                while (child < node.ChildCount() && !terminated)
                {
                    bool childTerminated = false;
                    if (!EmitStatement(context, module, builder, i32, tree, semantic, declarationId,
                        function, state, node.ChildAt(child), out childTerminated)) { return false; }
                    terminated = childTerminated; child = child + 1;
                }
                return true;
            }
            if (node.Kind() == "VariableDeclarationStatement" && node.TypeText() == "int")
            {
                raii CString localName = new CString(node.Text());
                void* storage = LLVM.LLVMBuildAlloca(builder, i32, localName.Pointer());
                if (storage == null) { return false; }
                state.AddLocal(semantic.NodeSymbol(syntaxId), storage);
                void* value = LLVM.LLVMConstInt(i32, 0UL, 0);
                if (node.First() >= 0)
                {
                    bool valueValid = false;
                    value = EmitI32Expression(module, builder, i32, tree, semantic,
                        declarationId, function, state, node.First(), out valueValid);
                    if (!valueValid || value == null) { return false; }
                }
                return LLVM.LLVMBuildStore(builder, value, storage) != null;
            }
            if (node.Kind() == "ExpressionStatement" && node.First() >= 0)
            {
                bool expressionValid = false;
                void* value = EmitI32Expression(module, builder, i32, tree, semantic,
                    declarationId, function, state, node.First(), out expressionValid);
                return expressionValid && value != null;
            }
            if (node.Kind() == "ReturnStatement" && node.First() >= 0)
            {
                bool valueValid = false;
                void* value = EmitI32Expression(module, builder, i32, tree, semantic,
                    declarationId, function, state, node.First(), out valueValid);
                if (!valueValid || value == null || LLVM.LLVMBuildRet(builder, value) == null) { return false; }
                terminated = true; return true;
            }
            if (node.Kind() == "IfStatement")
            {
                bool conditionValid = false;
                void* condition = EmitCondition(module, builder, i32, tree, semantic, declarationId,
                    function, state, node.First(), out conditionValid);
                raii CString thenName = new CString("if.then"); raii CString elseName = new CString("if.else");
                raii CString mergeName = new CString("if.end");
                void* thenBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, thenName.Pointer());
                void* mergeBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, mergeName.Pointer());
                void* elseBlock = node.Third() >= 0 ?
                    LLVM.LLVMAppendBasicBlockInContext(context, function, elseName.Pointer()) : mergeBlock;
                if (!conditionValid || condition == null || thenBlock == null || mergeBlock == null ||
                    elseBlock == null || LLVM.LLVMBuildCondBr(builder, condition, thenBlock, elseBlock) == null)
                { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, thenBlock); bool thenTerminated = false;
                if (!EmitStatement(context, module, builder, i32, tree, semantic, declarationId,
                    function, state, node.Second(), out thenTerminated)) { return false; }
                if (!thenTerminated && LLVM.LLVMBuildBr(builder, mergeBlock) == null) { return false; }
                bool elseTerminated = false;
                if (node.Third() >= 0)
                {
                    LLVM.LLVMPositionBuilderAtEnd(builder, elseBlock);
                    if (!EmitStatement(context, module, builder, i32, tree, semantic, declarationId,
                        function, state, node.Third(), out elseTerminated)) { return false; }
                    if (!elseTerminated && LLVM.LLVMBuildBr(builder, mergeBlock) == null) { return false; }
                }
                LLVM.LLVMPositionBuilderAtEnd(builder, mergeBlock);
                terminated = thenTerminated && node.Third() >= 0 && elseTerminated;
                if (terminated && LLVM.LLVMBuildUnreachable(builder) == null) { return false; }
                return true;
            }
            if (node.Kind() == "WhileStatement")
            {
                raii CString conditionName = new CString("while.condition");
                raii CString bodyName = new CString("while.body"); raii CString endName = new CString("while.end");
                void* conditionBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, conditionName.Pointer());
                void* bodyBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, bodyName.Pointer());
                void* endBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, endName.Pointer());
                if (conditionBlock == null || bodyBlock == null || endBlock == null ||
                    LLVM.LLVMBuildBr(builder, conditionBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, conditionBlock); bool conditionValid = false;
                void* condition = EmitCondition(module, builder, i32, tree, semantic, declarationId,
                    function, state, node.First(), out conditionValid);
                if (!conditionValid || condition == null ||
                    LLVM.LLVMBuildCondBr(builder, condition, bodyBlock, endBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, bodyBlock); bool bodyTerminated = false;
                if (!EmitStatement(context, module, builder, i32, tree, semantic, declarationId,
                    function, state, node.Second(), out bodyTerminated)) { return false; }
                if (!bodyTerminated && LLVM.LLVMBuildBr(builder, conditionBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, endBlock); return true;
            }
            return false;
        }

        private static bool EmitFunctions(void* context, void* module, void* builder, void* i32,
            SyntaxTree tree, SemanticModel semantic, int syntaxId)
        {
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.First() >= 0 && node.TypeText() == "int")
            {
                raii string llvmNameText = LlvmFunctionName(node.Text()); raii CString llvmName = new CString(llvmNameText);
                void* function = LLVM.LLVMGetNamedFunction(module, llvmName.Pointer());
                raii CString entryName = new CString("source.entry");
                void* block = LLVM.LLVMAppendBasicBlockInContext(context, function, entryName.Pointer());
                if (function == null || block == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, block);
                raii FunctionLoweringState state = new FunctionLoweringState(); bool terminated = false;
                if (!EmitStatement(context, module, builder, i32, tree, semantic, syntaxId,
                    function, state, node.First(), out terminated) || !terminated) { return false; }
            }
            if (!EmitFunctions(context, module, builder, i32, tree, semantic, node.First())) { return false; }
            if (!EmitFunctions(context, module, builder, i32, tree, semantic, node.Second())) { return false; }
            if (!EmitFunctions(context, module, builder, i32, tree, semantic, node.Third())) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                if (!EmitFunctions(context, module, builder, i32, tree, semantic, node.ChildAt(child))) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static void Dispose(
            void* context, void* module, void* builder, void* machine, void* layout)
        {
            if (layout != null) { LLVM.LLVMDisposeTargetData(layout); }
            if (machine != null) { LLVM.LLVMDisposeTargetMachine(machine); }
            if (builder != null) { LLVM.LLVMDisposeBuilder(builder); }
            if (module != null) { LLVM.LLVMDisposeModule(module); }
            if (context != null) { LLVM.LLVMContextDispose(context); }
        }

        private static LLVMCodeGenOptLevel CodeGenLevel(BackendOptimization optimization)
        {
            if (optimization == BackendOptimization.O0) { return LLVMCodeGenOptLevel.None; }
            if (optimization == BackendOptimization.O1) { return LLVMCodeGenOptLevel.Less; }
            if (optimization == BackendOptimization.O3) { return LLVMCodeGenOptLevel.Aggressive; }
            return LLVMCodeGenOptLevel.Default;
        }

        private static owned string PassPipeline(BackendOptimization optimization)
        {
            if (optimization == BackendOptimization.O0) { return String.Copy("verify"); }
            if (optimization == BackendOptimization.O1) { return String.Copy("default<O1>"); }
            if (optimization == BackendOptimization.O2) { return String.Copy("default<O2>"); }
            return String.Copy("default<O3>");
        }

        public static int EmitExecutableObject(SyntaxTree tree, SemanticModel semantic,
            string outputPath, BackendOptimization optimization, BackendArtifactKind artifact)
        {
            uint major = 0u; uint minor = 0u; uint patch = 0u;
            LLVM.LLVMGetVersion(&major, &minor, &patch);
            if (major != 23u) { return 90; }

            LLVM.LLVMInitializeX86TargetInfo(); LLVM.LLVMInitializeX86Target();
            LLVM.LLVMInitializeX86TargetMC(); LLVM.LLVMInitializeX86AsmParser();
            LLVM.LLVMInitializeX86AsmPrinter();

            int entryExpression = EntryExpression(tree);
            if (entryExpression < 0) { return 12; }
            raii CString moduleName = new CString("nativesharp.source.derived.backend");
            raii CString triple = new CString("x86_64-pc-windows-msvc");
            raii CString empty = new CString(""); raii CString entryName = new CString("mainCRTStartup");
            raii CString exitName = new CString("ExitProcess"); raii CString computeName = new CString("NativeSharpCompute");
            raii CString blockName = new CString("entry"); raii CString temporaryName = new CString("answer");
            raii CString globalName = new CString("__nativesharp_backend_contract");
            raii CString output = new CString(outputPath); raii string pipelineText = PassPipeline(optimization);
            raii CString pipeline = new CString(pipelineText);

            void* context = LLVM.LLVMContextCreate(); if (context == null) { return 1; }
            void* module = LLVM.LLVMModuleCreateWithNameInContext(moduleName.Pointer(), context);
            void* builder = null; void* machine = null; void* layout = null;
            if (module == null) { Dispose(context, module, builder, machine, layout); return 2; }
            LLVM.LLVMSetTarget(module, triple.Pointer());

            void* voidType = LLVM.LLVMVoidTypeInContext(context);
            void* i32 = LLVM.LLVMInt32TypeInContext(context);
            void* contractGlobal = LLVM.LLVMAddGlobal(module, i32, globalName.Pointer());
            LLVM.LLVMSetInitializer(contractGlobal, LLVM.LLVMConstInt(i32, 8UL, 0));
            LLVM.LLVMSetGlobalConstant(contractGlobal, 1);

            void* computeType = LLVM.LLVMFunctionType(i32, null, 0u, 0);
            void* compute = LLVM.LLVMAddFunction(module, computeName.Pointer(), computeType);
            builder = LLVM.LLVMCreateBuilderInContext(context);
            if (builder == null)
            { Dispose(context, module, builder, machine, layout); return 3; }
            if (!DeclareFunctions(module, i32, tree, tree.Root()))
            { Dispose(context, module, builder, machine, layout); return 13; }
            if (!EmitFunctions(context, module, builder, i32, tree, semantic, tree.Root()))
            { Dispose(context, module, builder, machine, layout); return 14; }
            void* computeBlock = LLVM.LLVMAppendBasicBlockInContext(context, compute, blockName.Pointer());
            if (computeBlock == null) { Dispose(context, module, builder, machine, layout); return 3; }
            LLVM.LLVMPositionBuilderAtEnd(builder, computeBlock);
            raii string mainNameText = LlvmFunctionName("Main"); raii CString mainName = new CString(mainNameText);
            void* mainFunction = LLVM.LLVMGetNamedFunction(module, mainName.Pointer());
            if (mainFunction == null) { Dispose(context, module, builder, machine, layout); return 4; }
            void* answer = LLVM.LLVMBuildCall2(builder, computeType, mainFunction, null, 0u, temporaryName.Pointer());
            if (answer == null || LLVM.LLVMBuildRet(builder, answer) == null)
            { Dispose(context, module, builder, machine, layout); return 4; }

            void* startupType = LLVM.LLVMFunctionType(voidType, null, 0u, 0);
            void* startup = LLVM.LLVMAddFunction(module, entryName.Pointer(), startupType);
            void* exitParameter = i32; void* exitType = LLVM.LLVMFunctionType(voidType, &exitParameter, 1u, 0);
            void* exitFunction = LLVM.LLVMAddFunction(module, exitName.Pointer(), exitType);
            void* startupBlock = LLVM.LLVMAppendBasicBlockInContext(context, startup, blockName.Pointer());
            LLVM.LLVMPositionBuilderAtEnd(builder, startupBlock);
            void* result = LLVM.LLVMBuildCall2(builder, computeType, compute, null, 0u, temporaryName.Pointer());
            void* exitArgument = result;
            if (result == null || LLVM.LLVMBuildCall2(builder, exitType, exitFunction, &exitArgument, 1u, empty.Pointer()) == null ||
                LLVM.LLVMBuildUnreachable(builder) == null)
            { Dispose(context, module, builder, machine, layout); return 5; }

            byte* verifyMessage = null;
            if (LLVM.LLVMVerifyModule(module, LLVMVerifierFailureAction.ReturnStatus, &verifyMessage) != 0)
            { if (verifyMessage != null) { LLVM.LLVMDisposeMessage(verifyMessage); } Dispose(context, module, builder, machine, layout); return 6; }
            if (verifyMessage != null) { LLVM.LLVMDisposeMessage(verifyMessage); }

            void* target = null; byte* targetError = null;
            if (LLVM.LLVMGetTargetFromTriple(triple.Pointer(), &target, &targetError) != 0 || target == null)
            { if (targetError != null) { LLVM.LLVMDisposeMessage(targetError); } Dispose(context, module, builder, machine, layout); return 7; }
            machine = LLVM.LLVMCreateTargetMachine(target, triple.Pointer(), empty.Pointer(), empty.Pointer(),
                CodeGenLevel(optimization), LLVMRelocMode.Static, LLVMCodeModel.Default);
            layout = LLVM.LLVMCreateTargetDataLayout(machine);
            if (machine == null || layout == null) { Dispose(context, module, builder, machine, layout); return 8; }
            LLVM.LLVMSetModuleDataLayout(module, layout);

            void* options = LLVM.LLVMCreatePassBuilderOptions(); LLVM.LLVMPassBuilderOptionsSetVerifyEach(options, 1);
            void* passError = LLVM.LLVMRunPasses(module, pipeline.Pointer(), machine, options);
            LLVM.LLVMDisposePassBuilderOptions(options);
            if (passError != null)
            { byte* message = LLVM.LLVMGetErrorMessage(passError); if (message != null) { LLVM.LLVMDisposeErrorMessage(message); }
              Dispose(context, module, builder, machine, layout); return 9; }

            void* debugBuilder = LLVM.LLVMCreateDIBuilder(module);
            if (debugBuilder == null) { Dispose(context, module, builder, machine, layout); return 10; }
            LLVM.LLVMDIBuilderFinalize(debugBuilder); LLVM.LLVMDisposeDIBuilder(debugBuilder);

            byte* emitError = null;
            LLVMCodeGenFileType fileType = artifact == BackendArtifactKind.Assembly ?
                LLVMCodeGenFileType.Assembly : LLVMCodeGenFileType.Object;
            int failed = LLVM.LLVMTargetMachineEmitToFile(machine, module, output.Pointer(), fileType, &emitError);
            if (emitError != null) { LLVM.LLVMDisposeMessage(emitError); }
            Dispose(context, module, builder, machine, layout);
            return failed == 0 ? 0 : 11;
        }
    }
}
