using NativeSharp.Core;
using NativeSharp.Core.Collections.Generic;
using NativeSharp.LLVM.C;
using NativeSharp.Compiler.Lexer;
using NativeSharp.Compiler.Syntax;
using NativeSharp.Compiler.Sema;
using NativeSharp.Compiler.Basic;
using NativeSharp.Compiler.Symbols;
using NativeSharp.Compiler.IR;
using NativeSharp.Compiler.Types;

namespace NativeSharp.Compiler.CodeGen
{
    public enum BackendArtifactKind
    {
        Assembly = 0,
        Object = 1
    }

    public enum BackendOptimization
    {
        O0 = 0,
        O1 = 1,
        O2 = 2,
        O3 = 3
    }

    // SH18 keeps LLVM handles non-owning.  The state owns only these small binding records;
    // LLVM continues to own the alloca instructions referenced by Storage().
    public class LocalBinding
    {
        private int symbol;
        private void* storage;
        private void* valueType;
        public LocalBinding(int symbolId, void* storageValue, void* typeValue)
        { symbol = symbolId; storage = storageValue; valueType = typeValue; }
        public int Symbol() { return symbol; }
        public void* Storage() { return storage; }
        public void* ValueType() { return valueType; }
    }

    public class LoopBinding
    {
        private void* breakTarget;
        private void* continueTarget;
        public LoopBinding(void* breakBlock, void* continueBlock)
        { breakTarget = breakBlock; continueTarget = continueBlock; }
        public void* BreakTarget() { return breakTarget; }
        public void* ContinueTarget() { return continueTarget; }
    }

    public class FunctionLoweringState
    {
        private owned List<LocalBinding> locals;
        private owned List<LoopBinding> loops;
        private void* thisValue;
        public FunctionLoweringState()
        {
            locals = new List<LocalBinding>(); loops = new List<LoopBinding>(); thisValue = null;
        }
        public void SetThis(void* value) { thisValue = value; }
        public void* ThisValue() { return thisValue; }
        public void AddLocal(int symbol, void* storage, void* valueType)
        {
            raii LocalBinding binding = new LocalBinding(symbol, storage, valueType); locals.Add(move(binding));
        }
        public void* FindLocal(int symbol)
        {
            int index = locals.Count() - 1;
            while (index >= 0)
            {
                if (locals[index].Symbol() == symbol) { return locals[index].Storage(); }
                index = index - 1;
            }
            return null;
        }
        public void* FindLocalType(int symbol)
        {
            int index = locals.Count() - 1;
            while (index >= 0)
            {
                if (locals[index].Symbol() == symbol) { return locals[index].ValueType(); }
                index = index - 1;
            }
            return null;
        }
        public void PushLoop(void* breakTarget, void* continueTarget)
        {
            raii LoopBinding binding = new LoopBinding(breakTarget, continueTarget);
            loops.Add(move(binding));
        }
        public void PopLoop() { if (loops.Count() > 0) { loops.RemoveAt(loops.Count() - 1); } }
        public void* BreakTarget()
        {
            if (loops.Count() == 0) { return null; }
            return loops[loops.Count() - 1].BreakTarget();
        }
        public void* ContinueTarget()
        {
            if (loops.Count() == 0) { return null; }
            return loops[loops.Count() - 1].ContinueTarget();
        }
    }

    // Backend bootstrap SH08. Toda dependencia de LLVM cruza exclusivamente LLVM-C.dll;
    // ningún layout de C++ ni header de LLVM forma parte del compilador autocontenido.
    public class LlvmBackend
    {
        private static bool LoweringFailure(SyntaxTree tree, int syntaxId, string phase)
        {
            SyntaxNode node = tree.Node(syntaxId); raii StringBuilder message = new StringBuilder();
            message.Append("nsc-next: backend "); message.Append(phase); message.Append(" failed at ");
            message.Append(node.Kind()); if (node.Text().Length != 0) { message.Append(" '"); message.Append(node.Text()); message.Append("'"); }
            raii string rendered = message.ToOwnedString(); Console.ErrorWriteLine(rendered); return false;
        }
        private static int FindEntryExpression(SyntaxTree tree, int syntaxId)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode declaration = tree.Node(syntaxId);
            if ((declaration.Kind() == "FunctionDeclaration" || declaration.Kind() == "MethodDeclaration") &&
                declaration.Text() == "Main" && declaration.First() >= 0)
            {
                SyntaxNode body = tree.Node(declaration.First());
                int statementIndex = 0;
                while (statementIndex < body.ChildCount())
                {
                    SyntaxNode statement = tree.Node(body.ChildAt(statementIndex));
                    if (statement.Kind() == "ReturnStatement" && statement.First() >= 0)
                    { return statement.First(); }
                    statementIndex = statementIndex + 1;
                }
            }
            int found = FindEntryExpression(tree, declaration.First()); if (found >= 0) { return found; }
            found = FindEntryExpression(tree, declaration.Second()); if (found >= 0) { return found; }
            found = FindEntryExpression(tree, declaration.Third()); if (found >= 0) { return found; }
            int child = 0;
            while (child < declaration.ChildCount())
            {
                found = FindEntryExpression(tree, declaration.ChildAt(child));
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int EntryExpression(SyntaxTree tree)
        { return FindEntryExpression(tree, tree.Root()); }

        private static int ParameterCount(SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId); int count = 0; int index = 0;
            while (index < declaration.ChildCount())
            {
                if (tree.Node(declaration.ChildAt(index)).Kind() == "ParameterDeclaration")
                { count = count + 1; }
                index = index + 1;
            }
            return count;
        }

        private static bool SupportedScalar(string type)
        {
            return type.Length != 0;
        }

        private static bool IntegerEnum(string type)
        {
            return type == "TokenKind" || type == "SymbolKind" || type == "DiagnosticSeverity" ||
                type == "SemanticTypeKind" || type == "OwnershipKind" || type == "ValueCategory" ||
                type == "BackendArtifactKind" || type == "BackendOptimization" ||
                type == "LLVMAtomicOrdering" || type == "LLVMAtomicRMWBinOp" || type == "LLVMCodeGenFileType" ||
                type == "LLVMCodeGenOptLevel" || type == "LLVMCodeModel" ||
                type == "LLVMIntPredicate" || type == "LLVMRealPredicate" ||
                type == "LLVMLinkage" || type == "LLVMRelocMode" || type == "LLVMVerifierFailureAction" ||
                type == "StringComparison" || type == "StringSplitOptions";
        }

        private static int FindTypeSymbol(SemanticModel semantic, int typeId)
        {
            int symbol = 0;
            while (symbol < semantic.SymbolCount())
            {
                Symbol candidate = semantic.GetSymbol(symbol);
                if ((candidate.Kind() == SymbolKind.Struct || candidate.Kind() == SymbolKind.Class ||
                    candidate.Kind() == SymbolKind.Interface || candidate.Kind() == SymbolKind.Union ||
                    candidate.Kind() == SymbolKind.Enum) && candidate.TypeId() == typeId) { return symbol; }
                symbol = symbol + 1;
            }
            return -1;
        }

        private static int FindTypeSymbolByDisplay(SemanticModel semantic, string display)
        {
            raii string normalized = String.Copy(display);
            if (String.StartsWith(normalized, "owned "))
            { raii string stripped = String.Substring(normalized, 6, normalized.Length - 6); normalized = move(stripped); }
            else if (String.StartsWith(normalized, "borrowed "))
            { raii string stripped = String.Substring(normalized, 9, normalized.Length - 9); normalized = move(stripped); }
            int generic = String.IndexOf(normalized, "<");
            raii string baseName = generic < 0 ? String.Copy(normalized) : String.Substring(normalized, 0, generic);
            int symbol = 0;
            while (symbol < semantic.SymbolCount())
            {
                Symbol candidate = semantic.GetSymbol(symbol);
                if ((candidate.Kind() == SymbolKind.Struct || candidate.Kind() == SymbolKind.Class ||
                    candidate.Kind() == SymbolKind.Interface || candidate.Kind() == SymbolKind.Union) &&
                    (candidate.Name() == baseName || candidate.QualifiedName() == baseName)) { return symbol; }
                symbol = symbol + 1;
            }
            return -1;
        }

        private static void* ScalarType(void* context, string type)
        {
            if (type == "void") { return LLVM.LLVMVoidTypeInContext(context); }
            if (type == "bool") { return LLVM.LLVMInt1TypeInContext(context); }
            if (type == "byte" || type == "char") { return LLVM.LLVMInt8TypeInContext(context); }
            if (type == "short" || type == "ushort") { return LLVM.LLVMInt16TypeInContext(context); }
            if (type == "int" || type == "uint") { return LLVM.LLVMInt32TypeInContext(context); }
            if (type == "long" || type == "ulong" || type == "nint" || type == "nuint")
            { return LLVM.LLVMInt64TypeInContext(context); }
            if (type == "float") { return LLVM.LLVMFloatTypeInContext(context); }
            if (type == "double") { return LLVM.LLVMDoubleTypeInContext(context); }
            if (IntegerEnum(type)) { return LLVM.LLVMInt32TypeInContext(context); }
            if (type.Length > 0 && type[type.Length - 1] == '*')
            { return LLVM.LLVMPointerTypeInContext(context, 0u); }
            if (type.Length != 0) { return LLVM.LLVMPointerTypeInContext(context, 0u); }
            return null;
        }

        private static int AggregateSize(SemanticModel semantic, string type)
        {
            int symbol = FindTypeSymbolByDisplay(semantic, type);
            if (symbol < 0) { return 0; }
            Symbol aggregate = semantic.GetSymbol(symbol);
            if (aggregate.Kind() != SymbolKind.Struct && aggregate.Kind() != SymbolKind.Union) { return 0; }
            return aggregate.Size();
        }

        private static bool DirectAggregateSize(int size)
        { return size == 1 || size == 2 || size == 4 || size == 8; }

        private static void* DirectAggregateType(void* context, int size)
        {
            if (size == 1) { return LLVM.LLVMInt8TypeInContext(context); }
            if (size == 2) { return LLVM.LLVMInt16TypeInContext(context); }
            if (size == 4) { return LLVM.LLVMInt32TypeInContext(context); }
            if (size == 8) { return LLVM.LLVMInt64TypeInContext(context); }
            return null;
        }

        private static void* AbiValueType(void* context, SemanticModel semantic, string type)
        {
            int aggregateSize = AggregateSize(semantic, type);
            if (DirectAggregateSize(aggregateSize)) { return DirectAggregateType(context, aggregateSize); }
            return ScalarType(context, type);
        }

        private static int ParameterDeclarationAt(SyntaxTree tree, int declarationId, int ordinal)
        {
            SyntaxNode declaration = tree.Node(declarationId); int child = 0; int position = 0;
            while (child < declaration.ChildCount())
            {
                int childId = declaration.ChildAt(child);
                if (tree.Node(childId).Kind() == "ParameterDeclaration")
                {
                    if (position == ordinal) { return childId; }
                    position = position + 1;
                }
                child = child + 1;
            }
            return -1;
        }

        private static bool HasReceiver(SemanticModel semantic, int declarationId)
        {
            int symbol = semantic.NodeSymbol(declarationId); if (symbol < 0) { return false; }
            Symbol value = semantic.GetSymbol(symbol);
            return value.Kind() == SymbolKind.Constructor || value.Kind() == SymbolKind.Destructor ||
                (value.Kind() == SymbolKind.Method && !value.IsStatic() && !value.IsExternC());
        }

        private static bool UsesNativeAbi(SemanticModel semantic, int declarationId)
        {
            int symbol = semantic.NodeSymbol(declarationId);
            return symbol >= 0 && semantic.GetSymbol(symbol).IsExternC();
        }

        private static void* ScalarFunctionType(void* context, SyntaxTree tree,
            SemanticModel semantic, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            int declarationSymbol = semantic.NodeSymbol(declarationId);
            bool lifetimeEntry = declarationSymbol >= 0 &&
                (semantic.GetSymbol(declarationSymbol).Kind() == SymbolKind.Constructor ||
                 semantic.GetSymbol(declarationSymbol).Kind() == SymbolKind.Destructor);
            bool nativeAbi = UsesNativeAbi(semantic, declarationId);
            void* returnType = nativeAbi ? AbiValueType(context, semantic,
                lifetimeEntry ? "void" : declaration.TypeText()) :
                ScalarType(context, lifetimeEntry ? "void" : declaration.TypeText());
            if (returnType == null) { return null; }
            bool receiver = HasReceiver(semantic, declarationId);
            int parameterCount = ParameterCount(tree, declarationId) + (receiver ? 1 : 0);
            if (parameterCount < 0) { return null; }
            void** parameterTypes = null;
            if (parameterCount > 0) { parameterTypes = stackalloc void*[parameterCount]; }
            int index = 0; int parameter = 0;
            if (receiver)
            { parameterTypes[0] = LLVM.LLVMPointerTypeInContext(context, 0u); parameter = 1; }
            while (index < declaration.ChildCount())
            {
                SyntaxNode child = tree.Node(declaration.ChildAt(index));
                if (child.Kind() == "ParameterDeclaration")
                {
                    void* parameterType = nativeAbi ? AbiValueType(context, semantic, child.TypeText()) :
                        ScalarType(context, child.TypeText());
                    if (parameterType == null || child.TypeText() == "void") { return null; }
                    parameterTypes[parameter] = parameterType; parameter = parameter + 1;
                }
                index = index + 1;
            }
            return LLVM.LLVMFunctionType(returnType, parameterTypes, (uint)parameterCount,
                declaration.IsVariadic() ? 1 : 0);
        }

        // SH27 stable native identity. Source spelling alone aliases overloads and equal names in
        // different namespaces. The qualified semantic name plus its nominal function type is the
        // ABI identity; StableHash gives it a path-, locale- and process-independent COFF spelling.
        private static owned string LlvmFunctionName(SyntaxTree tree, SemanticModel semantic,
            int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            raii string qualified = String.Copy(declaration.Text());
            raii string signature = String.Copy(declaration.TypeText());
            int symbolId = semantic.NodeSymbol(declarationId);
            if (symbolId >= 0)
            {
                Symbol symbol = semantic.GetSymbol(symbolId);
                if (symbol.IsExternC()) { return String.Copy(symbol.Name()); }
                raii string symbolName = String.Copy(symbol.QualifiedName()); qualified = move(symbolName);
                if (symbol.TypeId() >= 0)
                {
                    raii string symbolType = String.Copy(semantic.Types().Get(symbol.TypeId()).Display());
                    signature = move(symbolType);
                }
            }
            raii string left = String.Concat(qualified, "|");
            raii string identity = String.Concat(left, signature);
            raii string hash = String.ToString(StableHash.Text(identity));
            raii string prefix = String.Concat("__nativesharp_", hash);
            raii string separator = String.Concat(prefix, "_");
            return String.Concat(separator, declaration.Text());
        }

        private static owned string LlvmGlobalName(SemanticModel semantic, int symbolId)
        {
            Symbol symbol = semantic.GetSymbol(symbolId);
            raii string type = String.Copy(semantic.Types().Get(symbol.TypeId()).Display());
            raii string left = String.Concat(symbol.QualifiedName(), "|");
            raii string identity = String.Concat(left, type);
            raii string hash = String.ToString(StableHash.Text(identity));
            raii string prefix = String.Concat("__nativesharp_global_", hash);
            raii string separator = String.Concat(prefix, "_");
            return String.Concat(separator, symbol.Name());
        }

        private static void* ConstantInitializer(void* context, SyntaxTree tree,
            SemanticModel semantic, Symbol symbol)
        {
            void* type = ScalarType(context, semantic.Types().Get(symbol.TypeId()).Display());
            if (type == null) { return null; }
            int declaration = symbol.Declaration();
            if (declaration < 0 || tree.Node(declaration).First() < 0) { return LLVM.LLVMConstNull(type); }
            int initializer = tree.Node(declaration).First();
            SemanticFact fact = semantic.Fact(initializer);
            if (!fact.IsConstant()) { return null; }
            if (FloatingScalar(semantic.Types().Get(symbol.TypeId()).Display()))
            {
                double value = 0.0;
                if (!Number.TryParseDouble(fact.ConstantText(), out value)) { return null; }
                return LLVM.LLVMConstReal(type, value);
            }
            if (semantic.Types().Get(symbol.TypeId()).Display() == "bool")
            { return LLVM.LLVMConstInt(type, fact.ConstantText() == "true" ? 1UL : 0UL, 0); }
            long signedValue = 0;
            if (!Number.TryParseInt64(fact.ConstantText(), out signedValue)) { return null; }
            return LLVM.LLVMConstInt(type, (ulong)signedValue, 1);
        }

        private static bool DeclareData(void* module, SyntaxTree tree, SemanticModel semantic)
        {
            void* context = LLVM.LLVMGetModuleContext(module); int symbolId = 0;
            while (symbolId < semantic.SymbolCount())
            {
                Symbol symbol = semantic.GetSymbol(symbolId);
                if ((symbol.Kind() == SymbolKind.GlobalVariable ||
                    (symbol.Kind() == SymbolKind.Field && symbol.IsStatic())) && symbol.TypeId() >= 0 &&
                    SupportedScalar(semantic.Types().Get(symbol.TypeId()).Display()))
                {
                    void* initializer = ConstantInitializer(context, tree, semantic, symbol);
                    if (initializer == null) { return false; }
                    raii string globalNameText = LlvmGlobalName(semantic, symbolId);
                    raii CString globalName = new CString(globalNameText);
                    void* global = LLVM.LLVMAddGlobal(module,
                        ScalarType(context, semantic.Types().Get(symbol.TypeId()).Display()), globalName.Pointer());
                    if (global == null) { return false; }
                    LLVM.LLVMSetInitializer(global, initializer);
                    LLVM.LLVMSetGlobalConstant(global, symbol.IsConst() ? 1 : 0);
                    LLVM.LLVMSetAlignment(global, (uint)semantic.Types().Get(symbol.TypeId()).Alignment());
                }
                symbolId = symbolId + 1;
            }
            return true;
        }

        private static int FindFunctionDeclaration(SyntaxTree tree, int syntaxId, string name)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.Text() == name && node.First() >= 0) { return syntaxId; }
            int found = FindFunctionDeclaration(tree, node.First(), name); if (found >= 0) { return found; }
            found = FindFunctionDeclaration(tree, node.Second(), name); if (found >= 0) { return found; }
            found = FindFunctionDeclaration(tree, node.Third(), name); if (found >= 0) { return found; }
            int child = 0;
            while (child < node.ChildCount())
            {
                found = FindFunctionDeclaration(tree, node.ChildAt(child), name);
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int FindFunctionDeclarationByArity(SyntaxTree tree, SemanticModel semantic,
            int syntaxId, string name, int argumentCount, int parent)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration" ||
                node.Kind() == "ConstructorDeclaration" || node.Kind() == "DestructorDeclaration") && node.Text() == name &&
                ((node.IsVariadic() && ParameterCount(tree, syntaxId) <= argumentCount) ||
                 (!node.IsVariadic() && ParameterCount(tree, syntaxId) == argumentCount)))
            {
                int symbol = semantic.NodeSymbol(syntaxId);
                if (parent < 0 || (symbol >= 0 && semantic.GetSymbol(symbol).Parent() == parent))
                { return syntaxId; }
            }
            int found = FindFunctionDeclarationByArity(tree, semantic, node.First(), name, argumentCount, parent);
            if (found >= 0) { return found; }
            found = FindFunctionDeclarationByArity(tree, semantic, node.Second(), name, argumentCount, parent);
            if (found >= 0) { return found; }
            found = FindFunctionDeclarationByArity(tree, semantic, node.Third(), name, argumentCount, parent);
            if (found >= 0) { return found; }
            int child = 0;
            while (child < node.ChildCount())
            {
                found = FindFunctionDeclarationByArity(tree, semantic, node.ChildAt(child), name, argumentCount, parent);
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int FindDelegateDeclaration(SyntaxTree tree, int syntaxId, string name)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "DelegateDeclaration" && node.Text() == name) { return syntaxId; }
            int found = FindDelegateDeclaration(tree, node.First(), name); if (found >= 0) { return found; }
            found = FindDelegateDeclaration(tree, node.Second(), name); if (found >= 0) { return found; }
            found = FindDelegateDeclaration(tree, node.Third(), name); if (found >= 0) { return found; }
            int child = 0; while (child < node.ChildCount())
            { found = FindDelegateDeclaration(tree, node.ChildAt(child), name); if (found >= 0) { return found; } child = child + 1; }
            return -1;
        }

        private static int FindBestOverload(SyntaxTree tree, SemanticModel semantic,
            string name, int callId, int parent)
        {
            SyntaxNode call = tree.Node(callId); int best = -1; int bestScore = -100000; int symbol = 0;
            while (symbol < semantic.SymbolCount())
            {
                Symbol candidate = semantic.GetSymbol(symbol);
                if ((candidate.Kind() == SymbolKind.Function || candidate.Kind() == SymbolKind.Method ||
                    candidate.Kind() == SymbolKind.Constructor) && candidate.Name() == name &&
                    candidate.Declaration() >= 0 && (parent < 0 || candidate.Parent() == parent) &&
                    ParameterCount(tree, candidate.Declaration()) == call.ChildCount())
                {
                    SemanticType signature = semantic.Types().Get(candidate.TypeId()); int score = 0; int argument = 0;
                    while (argument < call.ChildCount() && argument < signature.ParameterCount())
                    {
                        int sourceType = semantic.Fact(call.ChildAt(argument)).TypeId();
                        int destinationType = signature.ParameterType(argument);
                        string sourceName = semantic.Types().Get(sourceType).Display();
                        string destinationName = semantic.Types().Get(destinationType).Display();
                        SemanticTypeKind sourceKind = semantic.Types().Get(sourceType).Kind();
                        SemanticTypeKind destinationKind = semantic.Types().Get(destinationType).Kind();
                        if (sourceName == destinationName) { score = score + 8; }
                        else if (sourceKind == SemanticTypeKind.StringLiteral && destinationName == "string")
                        { score = score + 6; }
                        else if (semantic.Types().IsNumeric(sourceType) && semantic.Types().IsNumeric(destinationType))
                        { score = score + 3; }
                        else if (sourceKind == SemanticTypeKind.Error || destinationKind == SemanticTypeKind.Named)
                        { score = score + 1; }
                        else { score = score - 20; }
                        argument = argument + 1;
                    }
                    if (score > bestScore) { bestScore = score; best = candidate.Declaration(); }
                }
                symbol = symbol + 1;
            }
            return best;
        }

        private static void MarkReachableFunction(SyntaxTree tree, SemanticModel semantic, int declarationId)
        {
            if (declarationId < 0) { return; }
            int symbol = semantic.NodeSymbol(declarationId);
            if (symbol >= 0)
            {
                if (semantic.GetSymbol(symbol).IsReachable()) { return; }
                semantic.GetSymbol(symbol).SetReachable(true);
            }
            SyntaxNode declaration = tree.Node(declarationId);
            MarkReachableNode(tree, semantic, declaration.First());
        }

        private static int DestructorDeclaration(SemanticModel semantic, int owner)
        {
            if (owner < 0) { return -1; } Symbol type = semantic.GetSymbol(owner); int member = 0;
            while (member < type.MemberCount())
            {
                Symbol candidate = semantic.GetSymbol(type.MemberAt(member));
                if (candidate.Kind() == SymbolKind.Destructor) { return candidate.Declaration(); }
                member = member + 1;
            }
            return -1;
        }

        private static void MarkReachableNode(SyntaxTree tree, SemanticModel semantic, int syntaxId)
        {
            if (syntaxId < 0) { return; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "CallExpression" && node.First() >= 0)
            {
                SyntaxNode callee = tree.Node(node.First()); int calleeSymbol = semantic.Fact(node.First()).SymbolId();
                int declaration = calleeSymbol >= 0 ? semantic.GetSymbol(calleeSymbol).Declaration() : -1;
                int parent = calleeSymbol >= 0 ? semantic.GetSymbol(calleeSymbol).Parent() : -1;
                int best = FindBestOverload(tree, semantic, callee.Text(), syntaxId, parent);
                if (best >= 0) { declaration = best; }
                if (declaration < 0 ||
                    ((!tree.Node(declaration).IsVariadic() && ParameterCount(tree, declaration) != node.ChildCount()) ||
                     (tree.Node(declaration).IsVariadic() && ParameterCount(tree, declaration) > node.ChildCount())))
                { declaration = FindFunctionDeclarationByArity(tree, semantic, tree.Root(), callee.Text(), node.ChildCount(), parent); }
                MarkReachableFunction(tree, semantic, declaration);
            }
            else if (node.Kind() == "ObjectCreationExpression" || node.Kind() == "PlacementConstructionExpression")
            {
                int owner = FindTypeSymbolByDisplay(semantic, node.SemanticTypeText());
                if (owner >= 0)
                {
                    int constructor = FindFunctionDeclarationByArity(tree, semantic, tree.Root(),
                        semantic.GetSymbol(owner).Name(), node.ChildCount(), owner);
                    MarkReachableFunction(tree, semantic, constructor);
                }
            }
            else if (node.Kind() == "DestroyExpression" && node.First() >= 0)
            {
                int valueType = semantic.Fact(node.First()).TypeId(); int owner = -1;
                if (valueType >= 0 && semantic.Types().Get(valueType).Kind() == SemanticTypeKind.Pointer)
                { owner = FindTypeSymbolByDisplay(semantic, semantic.Types().Get(semantic.Types().Get(valueType).ElementType()).Display()); }
                else if (valueType >= 0)
                { owner = FindTypeSymbolByDisplay(semantic, semantic.Types().Get(valueType).Display()); }
                MarkReachableFunction(tree, semantic, DestructorDeclaration(semantic, owner));
            }
            else if (node.Kind() == "IndexExpression")
            {
                int accessor = semantic.Fact(syntaxId).SymbolId();
                if (accessor >= 0 && semantic.GetSymbol(accessor).Kind() == SymbolKind.Method)
                { MarkReachableFunction(tree, semantic, semantic.GetSymbol(accessor).Declaration()); }
            }
            else if (node.Kind() == "IdentifierExpression")
            {
                int symbol = semantic.Fact(syntaxId).SymbolId();
                if (symbol >= 0 && (semantic.GetSymbol(symbol).Kind() == SymbolKind.Function ||
                    semantic.GetSymbol(symbol).Kind() == SymbolKind.Method))
                { MarkReachableFunction(tree, semantic, semantic.GetSymbol(symbol).Declaration()); }
            }
            MarkReachableNode(tree, semantic, node.First());
            MarkReachableNode(tree, semantic, node.Second());
            MarkReachableNode(tree, semantic, node.Third());
            int child = 0; while (child < node.ChildCount())
            { MarkReachableNode(tree, semantic, node.ChildAt(child)); child = child + 1; }
        }

        private static bool BackendEligibleFunction(SyntaxTree tree, SemanticModel semantic, int syntaxId)
        {
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() != "FunctionDeclaration" && node.Kind() != "MethodDeclaration" &&
                node.Kind() != "ConstructorDeclaration" && node.Kind() != "DestructorDeclaration") { return false; }
            int symbolId = semantic.NodeSymbol(syntaxId);
            if (symbolId < 0 || !semantic.GetSymbol(symbolId).IsReachable()) { return false; }
            bool lifetimeEntry = symbolId >= 0 && (semantic.GetSymbol(symbolId).Kind() == SymbolKind.Constructor ||
                semantic.GetSymbol(symbolId).Kind() == SymbolKind.Destructor);
            if (node.First() < 0 || (!lifetimeEntry && !SupportedScalar(node.TypeText()))) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                SyntaxNode parameter = tree.Node(node.ChildAt(child));
                if (parameter.Kind() == "ParameterDeclaration" &&
                    !SupportedScalar(parameter.TypeText())) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static bool BackendDeclarableFunction(SyntaxTree tree, SemanticModel semantic, int syntaxId)
        {
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() != "FunctionDeclaration" && node.Kind() != "MethodDeclaration" &&
                node.Kind() != "ConstructorDeclaration" && node.Kind() != "DestructorDeclaration") { return false; }
            int symbolId = semantic.NodeSymbol(syntaxId);
            bool external = symbolId >= 0 && semantic.GetSymbol(symbolId).IsExternC();
            if (!external && !BackendEligibleFunction(tree, semantic, syntaxId)) { return false; }
            bool lifetimeEntry = symbolId >= 0 && (semantic.GetSymbol(symbolId).Kind() == SymbolKind.Constructor ||
                semantic.GetSymbol(symbolId).Kind() == SymbolKind.Destructor);
            if (!lifetimeEntry && !SupportedScalar(node.TypeText())) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                SyntaxNode parameter = tree.Node(node.ChildAt(child));
                if (parameter.Kind() == "ParameterDeclaration" &&
                    !SupportedScalar(parameter.TypeText())) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static int ReturnExpression(SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            if (declaration.First() < 0) { return -1; }
            SyntaxNode body = tree.Node(declaration.First()); int index = 0;
            while (index < body.ChildCount())
            {
                SyntaxNode statement = tree.Node(body.ChildAt(index));
                if (statement.Kind() == "ReturnStatement" && statement.First() >= 0)
                { return statement.First(); }
                index = index + 1;
            }
            return -1;
        }

        private static bool DeclareFunctions(void* module, SyntaxTree tree, SemanticModel semantic,
            int syntaxId)
        {
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if (BackendDeclarableFunction(tree, semantic, syntaxId))
            {
                void* functionType = ScalarFunctionType(LLVM.LLVMGetModuleContext(module), tree, semantic, syntaxId);
                if (functionType == null) { return false; }
                raii string llvmNameText = LlvmFunctionName(tree, semantic, syntaxId);
                raii CString llvmName = new CString(llvmNameText);
                void* declared = LLVM.LLVMAddFunction(module, llvmName.Pointer(), functionType);
                if (declared == null) { return false; }
                if (String.Contains(node.ModifiersText(), "vectorcall"))
                { LLVM.LLVMSetFunctionCallConv(declared, 80u); }
            }
            if (!DeclareFunctions(module, tree, semantic, node.First())) { return false; }
            if (!DeclareFunctions(module, tree, semantic, node.Second())) { return false; }
            if (!DeclareFunctions(module, tree, semantic, node.Third())) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                if (!DeclareFunctions(module, tree, semantic, node.ChildAt(child))) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static int IntegerBits(string type)
        {
            if (type == "bool") { return 1; }
            if (type == "byte" || type == "char") { return 8; }
            if (type == "short" || type == "ushort") { return 16; }
            if (type == "int" || type == "uint") { return 32; }
            if (type == "long" || type == "ulong" || type == "nint" || type == "nuint") { return 64; }
            if (IntegerEnum(type)) { return 32; }
            return 0;
        }

        private static bool UnsignedInteger(string type)
        {
            return type == "bool" || type == "byte" || type == "char" || type == "ushort" ||
                type == "uint" || type == "ulong" || type == "nuint";
        }

        private static void* BitfieldStorageType(void* context, int size)
        {
            if (size <= 1) { return LLVM.LLVMInt8TypeInContext(context); }
            if (size == 2) { return LLVM.LLVMInt16TypeInContext(context); }
            if (size == 4) { return LLVM.LLVMInt32TypeInContext(context); }
            return LLVM.LLVMInt64TypeInContext(context);
        }

        private static bool FloatingScalar(string type)
        { return type == "float" || type == "double"; }

        private static bool GenericPlaceholder(string type)
        {
            if (String.StartsWith(type, "owned "))
            { raii string inner = String.Substring(type, 6, type.Length - 6); return GenericPlaceholder(inner); }
            if (String.StartsWith(type, "borrowed "))
            { raii string inner = String.Substring(type, 9, type.Length - 9); return GenericPlaceholder(inner); }
            if (String.EndsWith(type, "*"))
            { raii string inner = String.Substring(type, 0, type.Length - 1); return GenericPlaceholder(inner); }
            int bracket = String.IndexOf(type, "[");
            if (bracket > 0 && String.EndsWith(type, "]"))
            { raii string inner = String.Substring(type, 0, bracket); return GenericPlaceholder(inner); }
            return type == "T" || type == "TKey" || type == "TValue" ||
                type == "TElement" || type == "TPriority" ||
                type == "owned T" || type == "owned TKey" || type == "owned TValue" ||
                type == "owned TElement" || type == "owned TPriority" ||
                type == "borrowed T" || type == "borrowed TKey" || type == "borrowed TValue" ||
                type == "borrowed TElement" || type == "borrowed TPriority";
        }

        private static bool PhysicalValueScalar(string type)
        {
            return IntegerBits(type) != 0 || FloatingScalar(type) || IntegerEnum(type);
        }

        private static void* BoxGenericScalar(void* module, void* builder, void* value)
        {
            void* context = LLVM.LLVMGetModuleContext(module);
            void* i32 = LLVM.LLVMInt32TypeInContext(context);
            void* i64 = LLVM.LLVMInt64TypeInContext(context);
            raii CString heapName = new CString("GetProcessHeap");
            raii CString allocateName = new CString("HeapAlloc");
            void* heapFunction = LLVM.LLVMGetNamedFunction(module, heapName.Pointer());
            void* allocateFunction = LLVM.LLVMGetNamedFunction(module, allocateName.Pointer());
            if (heapFunction == null || allocateFunction == null) { return null; }
            void* heapType = LLVM.LLVMGlobalGetValueType(heapFunction);
            void* allocateType = LLVM.LLVMGlobalGetValueType(allocateFunction);
            raii CString empty = new CString("");
            void* heap = LLVM.LLVMBuildCall2(builder, heapType, heapFunction, null, 0u, empty.Pointer());
            void*[3] arguments; arguments[0] = heap;
            arguments[1] = LLVM.LLVMConstInt(i32, 8UL, 0);
            arguments[2] = LLVM.LLVMConstInt(i64, 8UL, 0);
            raii CString boxName = new CString("generic.box");
            void* box = LLVM.LLVMBuildCall2(builder, allocateType, allocateFunction,
                &arguments[0], 3u, boxName.Pointer());
            if (heap == null || box == null || LLVM.LLVMBuildStore(builder, value, box) == null) { return null; }
            return box;
        }

        private static void* ConvertScalar(void* module, void* builder, SemanticModel semantic,
            void* value, int sourceType, int destinationType)
        {
            if (value == null || sourceType == destinationType) { return value; }
            raii string source = String.Copy(semantic.Types().Get(sourceType).Display());
            raii string destination = String.Copy(semantic.Types().Get(destinationType).Display());
            if (source == destination) { return value; }
            bool sourcePointer = source.Length > 0 && source[source.Length - 1] == '*';
            bool destinationPointer = destination.Length > 0 && destination[destination.Length - 1] == '*';
            SemanticTypeKind sourceKind = semantic.Types().Get(sourceType).Kind();
            SemanticTypeKind destinationKind = semantic.Types().Get(destinationType).Kind();
            // Handle erased generic value boundaries before nominal-reference shortcuts: enums
            // are nominal in the semantic table but physically i32, so treating every Named
            // source as a reference would silently pass an integer where the erased ABI needs a
            // pointer (and would return a pointer from a closed enum/int indexer).
            if (GenericPlaceholder(destination) && PhysicalValueScalar(source))
            { return BoxGenericScalar(module, builder, value); }
            if (GenericPlaceholder(source) && PhysicalValueScalar(destination))
            {
                void* closedType = ScalarType(LLVM.LLVMGetModuleContext(module), destination);
                raii CString loadName = new CString("generic.unbox");
                return LLVM.LLVMBuildLoad2(builder, closedType, value, loadName.Pointer());
            }
            bool sourceReference = sourcePointer || sourceKind == SemanticTypeKind.Named ||
                sourceKind == SemanticTypeKind.Array || sourceKind == SemanticTypeKind.StringLiteral ||
                sourceKind == SemanticTypeKind.TypeParameter || sourceKind == SemanticTypeKind.Function;
            bool destinationReference = destinationPointer || destinationKind == SemanticTypeKind.Named ||
                destinationKind == SemanticTypeKind.Array || destinationKind == SemanticTypeKind.StringLiteral ||
                destinationKind == SemanticTypeKind.TypeParameter || destinationKind == SemanticTypeKind.Function;
            // Generic erasure can leave the source fact unresolved even though the selected
            // declaration has already fixed the physical LLVM type. Preserve that value; the
            // module verifier remains the final authority for an incompatible width.
            if (sourceKind == SemanticTypeKind.Error) { return value; }
            if (sourceKind == SemanticTypeKind.NullLiteral && destinationReference) { return value; }
            if (destinationPointer && sourceKind == SemanticTypeKind.StringLiteral)
            {
                void* header = LLVM.LLVMConstInt(LLVM.LLVMInt64TypeInContext(
                    LLVM.LLVMGetModuleContext(module)), 8UL, 0);
                return ByteOffset(module, builder, value, header, "string.literal.data");
            }
            if (sourceReference && destinationReference) { return value; }
            if (destinationPointer && (sourcePointer || source == "null")) { return value; }
            int sourceBits = IntegerBits(source); int destinationBits = IntegerBits(destination);
            void* context = LLVM.LLVMGetModuleContext(module);
            void* destinationLlvm = ScalarType(context, destination);
            raii CString conversionName = new CString("scalar.convert");
            if (destination == "bool")
            {
                raii CString comparisonName = new CString("scalar.to.bool");
                void* sourceLlvm = ScalarType(context, source);
                if (FloatingScalar(source))
                {
                    return LLVM.LLVMBuildFCmp(builder, LLVMRealPredicate.UnorderedNotEqual, value,
                        LLVM.LLVMConstReal(sourceLlvm, 0.0), comparisonName.Pointer());
                }
                return LLVM.LLVMBuildICmp(builder, LLVMIntPredicate.NotEqual, value,
                    LLVM.LLVMConstInt(sourceLlvm, 0UL, 0), comparisonName.Pointer());
            }
            if (FloatingScalar(source) && FloatingScalar(destination))
            {
                if (source == "float")
                { return LLVM.LLVMBuildFPExt(builder, value, destinationLlvm, conversionName.Pointer()); }
                return LLVM.LLVMBuildFPTrunc(builder, value, destinationLlvm, conversionName.Pointer());
            }
            if (FloatingScalar(source) && destinationBits != 0)
            {
                return UnsignedInteger(destination) ?
                    LLVM.LLVMBuildFPToUI(builder, value, destinationLlvm, conversionName.Pointer()) :
                    LLVM.LLVMBuildFPToSI(builder, value, destinationLlvm, conversionName.Pointer());
            }
            if (sourceBits != 0 && FloatingScalar(destination))
            {
                return UnsignedInteger(source) ?
                    LLVM.LLVMBuildUIToFP(builder, value, destinationLlvm, conversionName.Pointer()) :
                    LLVM.LLVMBuildSIToFP(builder, value, destinationLlvm, conversionName.Pointer());
            }
            if (sourceBits == 0 || destinationBits == 0) { return null; }
            if (sourceBits == destinationBits) { return value; }
            if (sourceBits > destinationBits)
            { return LLVM.LLVMBuildTrunc(builder, value, destinationLlvm, conversionName.Pointer()); }
            if (UnsignedInteger(source))
            { return LLVM.LLVMBuildZExt(builder, value, destinationLlvm, conversionName.Pointer()); }
            return LLVM.LLVMBuildSExt(builder, value, destinationLlvm, conversionName.Pointer());
        }

        private static void* ApplyConversion(void* module, void* builder, SemanticModel semantic,
            SemanticFact fact, void* value, string role, int operand)
        {
            int index = 0;
            while (index < fact.ConversionCount())
            {
                SemanticConversion conversion = fact.ConversionAt(index);
                if (conversion.Role() == role && conversion.OperandIndex() == operand)
                {
                    value = ConvertScalar(module, builder, semantic, value,
                        conversion.SourceType(), conversion.DestinationType());
                    if (value == null)
                    {
                        raii StringBuilder message = new StringBuilder(); message.Append("nsc-next: unsupported conversion ");
                        message.Append(semantic.Types().Get(conversion.SourceType()).Display()); message.Append(" -> ");
                        message.Append(semantic.Types().Get(conversion.DestinationType()).Display()); message.Append(" role=");
                        message.Append(role); raii string rendered = message.ToOwnedString(); Console.ErrorWriteLine(rendered);
                        return null;
                    }
                }
                index = index + 1;
            }
            return value;
        }

        private static void* EmitIntegerOperation(void* builder, TokenKind operation,
            bool unsignedOperation, void* left, void* right, byte* name)
        {
            if (operation == TokenKind.Plus || operation == TokenKind.PlusEqual)
            { return LLVM.LLVMBuildAdd(builder, left, right, name); }
            if (operation == TokenKind.Minus || operation == TokenKind.MinusEqual)
            { return LLVM.LLVMBuildSub(builder, left, right, name); }
            if (operation == TokenKind.Star || operation == TokenKind.StarEqual)
            { return LLVM.LLVMBuildMul(builder, left, right, name); }
            if (operation == TokenKind.Slash || operation == TokenKind.SlashEqual)
            { return unsignedOperation ? LLVM.LLVMBuildUDiv(builder, left, right, name) :
                LLVM.LLVMBuildSDiv(builder, left, right, name); }
            if (operation == TokenKind.Percent || operation == TokenKind.PercentEqual)
            { return unsignedOperation ? LLVM.LLVMBuildURem(builder, left, right, name) :
                LLVM.LLVMBuildSRem(builder, left, right, name); }
            if (operation == TokenKind.Amp || operation == TokenKind.AmpEqual)
            { return LLVM.LLVMBuildAnd(builder, left, right, name); }
            if (operation == TokenKind.Pipe || operation == TokenKind.PipeEqual)
            { return LLVM.LLVMBuildOr(builder, left, right, name); }
            if (operation == TokenKind.Caret || operation == TokenKind.CaretEqual)
            { return LLVM.LLVMBuildXor(builder, left, right, name); }
            if (operation == TokenKind.LessLess || operation == TokenKind.LessLessEqual)
            { return LLVM.LLVMBuildShl(builder, left, right, name); }
            if (operation == TokenKind.GreaterGreater || operation == TokenKind.GreaterGreaterEqual)
            { return unsignedOperation ? LLVM.LLVMBuildLShr(builder, left, right, name) :
                LLVM.LLVMBuildAShr(builder, left, right, name); }
            return null;
        }

        private static void* EmitFloatingOperation(void* builder, TokenKind operation,
            void* left, void* right, byte* name)
        {
            if (operation == TokenKind.Plus || operation == TokenKind.PlusEqual)
            { return LLVM.LLVMBuildFAdd(builder, left, right, name); }
            if (operation == TokenKind.Minus || operation == TokenKind.MinusEqual)
            { return LLVM.LLVMBuildFSub(builder, left, right, name); }
            if (operation == TokenKind.Star || operation == TokenKind.StarEqual)
            { return LLVM.LLVMBuildFMul(builder, left, right, name); }
            if (operation == TokenKind.Slash || operation == TokenKind.SlashEqual)
            { return LLVM.LLVMBuildFDiv(builder, left, right, name); }
            if (operation == TokenKind.Percent || operation == TokenKind.PercentEqual)
            { return LLVM.LLVMBuildFRem(builder, left, right, name); }
            return null;
        }

        private static void* EmitGlobalString(void* module, void* builder, string text)
        {
            void* context = LLVM.LLVMGetModuleContext(module);
            raii string hashText = String.ToString(StableHash.Text(text));
            raii string nameText = String.Concat("__nsc_string_literal_", hashText);
            raii CString name = new CString(nameText);
            void* existing = LLVM.LLVMGetNamedGlobal(module, name.Pointer());
            if (existing != null) { return existing; }
            void* i8 = LLVM.LLVMInt8TypeInContext(context);
            void* i64 = LLVM.LLVMInt64TypeInContext(context);
            void* bytesType = LLVM.LLVMArrayType2(i8, (ulong)text.Length + 1UL);
            raii string typeNameText = String.Concat(nameText, "_type");
            raii CString typeName = new CString(typeNameText);
            void* literalType = LLVM.LLVMStructCreateNamed(context, typeName.Pointer());
            void*[2] fields; fields[0] = i64; fields[1] = bytesType;
            LLVM.LLVMStructSetBody(literalType, &fields[0], 2u, 0);
            raii CString value = new CString(text);
            void*[2] values;
            values[0] = LLVM.LLVMConstInt(i64, (ulong)text.Length, 0);
            values[1] = LLVM.LLVMConstStringInContext2(context, value.Pointer(), (ulong)text.Length, 0);
            void* initializer = LLVM.LLVMConstNamedStruct(literalType, &values[0], 2u);
            void* global = LLVM.LLVMAddGlobal(module, literalType, name.Pointer());
            if (global == null || initializer == null) { return null; }
            LLVM.LLVMSetInitializer(global, initializer); LLVM.LLVMSetGlobalConstant(global, 1);
            return global;
        }

        private static void* ByteOffset(void* module, void* builder, void* pointer,
            void* offset, string stem)
        {
            raii CString name = new CString(stem);
            return LLVM.LLVMBuildGEP2(builder, LLVM.LLVMInt8TypeInContext(
                LLVM.LLVMGetModuleContext(module)), pointer, &offset, 1u, name.Pointer());
        }

        private static int LValueSymbol(SyntaxTree tree, SemanticModel semantic, int syntaxId)
        {
            if (syntaxId < 0) { return -1; } SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "IdentifierExpression" || node.Kind() == "MemberExpression")
            { return semantic.Fact(syntaxId).SymbolId(); }
            if (node.Kind() == "UnaryExpression" && node.OperatorKind() == TokenKind.Star) { return -1; }
            return -1;
        }

        private static void ApplyMemoryContract(void* instruction, SemanticModel semantic, int symbol)
        {
            if (instruction == null || symbol < 0) { return; } Symbol value = semantic.GetSymbol(symbol);
            if (value.Alignment() > 0) { LLVM.LLVMSetAlignment(instruction, (uint)value.Alignment()); }
            if (value.IsVolatile()) { LLVM.LLVMSetVolatile(instruction, 1); }
        }

        private static void* LoadMemory(void* module, void* builder, void* valueType, void* address,
            SemanticModel semantic, int symbol, string stem)
        {
            if (symbol < 0)
            {
                raii CString plainName = new CString(stem);
                return LLVM.LLVMBuildLoad2(builder, valueType, address, plainName.Pointer());
            }
            Symbol field = semantic.GetSymbol(symbol); bool bitfield = field.BitWidth() >= 0;
            void* storageType = bitfield ? BitfieldStorageType(LLVM.LLVMGetModuleContext(module), field.Size()) : valueType;
            raii CString loadName = new CString(stem);
            void* loaded = LLVM.LLVMBuildLoad2(builder, storageType, address, loadName.Pointer());
            ApplyMemoryContract(loaded, semantic, symbol); if (loaded == null) { return loaded; }
            int width = field.BitWidth();
            if (width < 0) { return loaded; } if (width == 0) { return null; }
            ulong mask = width >= 64 ? 18446744073709551615UL : ((1UL << width) - 1UL);
            void* narrowed = loaded;
            if (field.BitOffset() > 0)
            {
                raii CString shiftName = new CString("bitfield.shift");
                narrowed = LLVM.LLVMBuildLShr(builder, narrowed,
                    LLVM.LLVMConstInt(storageType, (ulong)field.BitOffset(), 0), shiftName.Pointer());
            }
            raii CString maskName = new CString("bitfield.value");
            narrowed = LLVM.LLVMBuildAnd(builder, narrowed, LLVM.LLVMConstInt(storageType, mask, 0), maskName.Pointer());
            string declared = semantic.Types().Get(field.TypeId()).Display(); int storageBits = field.Size() * 8;
            if (!UnsignedInteger(declared) && width < storageBits)
            {
                int extension = storageBits - width; raii CString leftName = new CString("bitfield.sign.left");
                void* shifted = LLVM.LLVMBuildShl(builder, narrowed,
                    LLVM.LLVMConstInt(storageType, (ulong)extension, 0), leftName.Pointer());
                raii CString rightName = new CString("bitfield.sign.right");
                narrowed = LLVM.LLVMBuildAShr(builder, shifted,
                    LLVM.LLVMConstInt(storageType, (ulong)extension, 0), rightName.Pointer());
            }
            if (declared == "bool")
            {
                raii CString boolName = new CString("bitfield.bool");
                return LLVM.LLVMBuildTrunc(builder, narrowed, valueType, boolName.Pointer());
            }
            return narrowed;
        }

        private static void* StoreMemory(void* module, void* builder, void* valueType, void* address, void* value,
            SemanticModel semantic, int symbol)
        {
            if (symbol >= 0 && semantic.GetSymbol(symbol).BitWidth() >= 0)
            {
                Symbol field = semantic.GetSymbol(symbol); int width = field.BitWidth();
                if (width == 0) { return null; }
                void* storageType = BitfieldStorageType(LLVM.LLVMGetModuleContext(module), field.Size());
                if (semantic.Types().Get(field.TypeId()).Display() == "bool")
                {
                    raii CString extendName = new CString("bitfield.bool.extend");
                    value = LLVM.LLVMBuildZExt(builder, value, storageType, extendName.Pointer());
                }
                ulong lowMask = width >= 64 ? 18446744073709551615UL : ((1UL << width) - 1UL);
                ulong shiftedMask = lowMask << field.BitOffset();
                raii CString oldName = new CString("bitfield.old");
                void* previous = LLVM.LLVMBuildLoad2(builder, storageType, address, oldName.Pointer());
                ApplyMemoryContract(previous, semantic, symbol);
                raii CString cleanName = new CString("bitfield.clean");
                void* clean = LLVM.LLVMBuildAnd(builder, previous,
                    LLVM.LLVMConstInt(storageType, 18446744073709551615UL ^ shiftedMask, 0), cleanName.Pointer());
                raii CString narrowName = new CString("bitfield.narrow");
                void* narrowed = LLVM.LLVMBuildAnd(builder, value,
                    LLVM.LLVMConstInt(storageType, lowMask, 0), narrowName.Pointer());
                void* shifted = narrowed;
                if (field.BitOffset() > 0)
                {
                    raii CString shiftName = new CString("bitfield.insert");
                    shifted = LLVM.LLVMBuildShl(builder, narrowed,
                        LLVM.LLVMConstInt(storageType, (ulong)field.BitOffset(), 0), shiftName.Pointer());
                }
                raii CString mergeName = new CString("bitfield.merge");
                value = LLVM.LLVMBuildOr(builder, clean, shifted, mergeName.Pointer());
            }
            void* stored = LLVM.LLVMBuildStore(builder, value, address);
            ApplyMemoryContract(stored, semantic, symbol); return stored;
        }

        private static void* AllocateNativeString(void* module, void* builder, void* length)
        {
            void* context = LLVM.LLVMGetModuleContext(module);
            void* i32 = LLVM.LLVMInt32TypeInContext(context);
            void* i64 = LLVM.LLVMInt64TypeInContext(context);
            raii CString heapName = new CString("GetProcessHeap");
            raii CString allocateName = new CString("HeapAlloc");
            void* heapFunction = LLVM.LLVMGetNamedFunction(module, heapName.Pointer());
            void* allocateFunction = LLVM.LLVMGetNamedFunction(module, allocateName.Pointer());
            if (heapFunction == null || allocateFunction == null) { return null; }
            raii CString empty = new CString("");
            void* heap = LLVM.LLVMBuildCall2(builder, LLVM.LLVMGlobalGetValueType(heapFunction),
                heapFunction, null, 0u, empty.Pointer());
            raii CString bytesName = new CString("string.bytes");
            void* bytes = LLVM.LLVMBuildAdd(builder, length,
                LLVM.LLVMConstInt(i64, 9UL, 0), bytesName.Pointer());
            void*[3] arguments; arguments[0] = heap;
            arguments[1] = LLVM.LLVMConstInt(i32, 8UL, 0); arguments[2] = bytes;
            raii CString resultName = new CString("string.storage");
            void* result = LLVM.LLVMBuildCall2(builder, LLVM.LLVMGlobalGetValueType(allocateFunction),
                allocateFunction, &arguments[0], 3u, resultName.Pointer());
            if (result == null || LLVM.LLVMBuildStore(builder, length, result) == null) { return null; }
            void* dataOffset = LLVM.LLVMConstInt(i64, 8UL, 0);
            void* data = ByteOffset(module, builder, result, dataOffset, "string.data");
            void* end = ByteOffset(module, builder, data, length, "string.end");
            if (data == null || end == null || LLVM.LLVMBuildStore(builder,
                LLVM.LLVMConstInt(LLVM.LLVMInt8TypeInContext(context), 0UL, 0), end) == null) { return null; }
            return result;
        }

        private static void* CopyNativeBytes(void* module, void* builder,
            void* destination, void* source, void* length)
        {
