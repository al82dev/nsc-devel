using NativeSharp.Core;
using NativeSharp.Core.Collections.Generic;
using NativeSharp.LLVM.C;
using NativeSharp.Compiler.Lexer;
using NativeSharp.Compiler.Syntax;
using NativeSharp.Compiler.Sema;
using NativeSharp.Compiler.Basic;
using NativeSharp.Compiler.Symbols;

namespace NativeSharp.Compiler.CodeGen
{
    public enum BackendArtifactKind
    {
        Assembly = 0,
        Object = 1
    }

    public enum BackendOptimization
    {
        O0 = 0,
        O1 = 1,
        O2 = 2,
        O3 = 3
    }

    // SH18 keeps LLVM handles non-owning.  The state owns only these small binding records;
    // LLVM continues to own the alloca instructions referenced by Storage().
    public class LocalBinding
    {
        private int symbol;
        private void* storage;
        private void* valueType;
        public LocalBinding(int symbolId, void* storageValue, void* typeValue)
        { symbol = symbolId; storage = storageValue; valueType = typeValue; }
        public int Symbol() { return symbol; }
        public void* Storage() { return storage; }
        public void* ValueType() { return valueType; }
    }

    public class LoopBinding
    {
        private void* breakTarget;
        private void* continueTarget;
        public LoopBinding(void* breakBlock, void* continueBlock)
        { breakTarget = breakBlock; continueTarget = continueBlock; }
        public void* BreakTarget() { return breakTarget; }
        public void* ContinueTarget() { return continueTarget; }
    }

    public class FunctionLoweringState
    {
        private owned List<LocalBinding> locals;
        private owned List<LoopBinding> loops;
        public FunctionLoweringState()
        {
            locals = new List<LocalBinding>(); loops = new List<LoopBinding>();
        }
        public void AddLocal(int symbol, void* storage, void* valueType)
        {
            raii LocalBinding binding = new LocalBinding(symbol, storage, valueType); locals.Add(move(binding));
        }
        public void* FindLocal(int symbol)
        {
            int index = locals.Count() - 1;
            while (index >= 0)
            {
                if (locals[index].Symbol() == symbol) { return locals[index].Storage(); }
                index = index - 1;
            }
            return null;
        }
        public void* FindLocalType(int symbol)
        {
            int index = locals.Count() - 1;
            while (index >= 0)
            {
                if (locals[index].Symbol() == symbol) { return locals[index].ValueType(); }
                index = index - 1;
            }
            return null;
        }
        public void PushLoop(void* breakTarget, void* continueTarget)
        {
            raii LoopBinding binding = new LoopBinding(breakTarget, continueTarget);
            loops.Add(move(binding));
        }
        public void PopLoop() { if (loops.Count() > 0) { loops.RemoveAt(loops.Count() - 1); } }
        public void* BreakTarget()
        {
            if (loops.Count() == 0) { return null; }
            return loops[loops.Count() - 1].BreakTarget();
        }
        public void* ContinueTarget()
        {
            if (loops.Count() == 0) { return null; }
            return loops[loops.Count() - 1].ContinueTarget();
        }
    }

    // Backend bootstrap SH08. Toda dependencia de LLVM cruza exclusivamente LLVM-C.dll;
    // ningún layout de C++ ni header de LLVM forma parte del compilador autocontenido.
    public class LlvmBackend
    {
        private static int FindEntryExpression(SyntaxTree tree, int syntaxId)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode declaration = tree.Node(syntaxId);
            if ((declaration.Kind() == "FunctionDeclaration" || declaration.Kind() == "MethodDeclaration") &&
                declaration.Text() == "Main" && declaration.First() >= 0)
            {
                SyntaxNode body = tree.Node(declaration.First());
                int statementIndex = 0;
                while (statementIndex < body.ChildCount())
                {
                    SyntaxNode statement = tree.Node(body.ChildAt(statementIndex));
                    if (statement.Kind() == "ReturnStatement" && statement.First() >= 0)
                    { return statement.First(); }
                    statementIndex = statementIndex + 1;
                }
            }
            int found = FindEntryExpression(tree, declaration.First()); if (found >= 0) { return found; }
            found = FindEntryExpression(tree, declaration.Second()); if (found >= 0) { return found; }
            found = FindEntryExpression(tree, declaration.Third()); if (found >= 0) { return found; }
            int child = 0;
            while (child < declaration.ChildCount())
            {
                found = FindEntryExpression(tree, declaration.ChildAt(child));
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int EntryExpression(SyntaxTree tree)
        { return FindEntryExpression(tree, tree.Root()); }

        private static int ParameterCount(SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId); int count = 0; int index = 0;
            while (index < declaration.ChildCount())
            {
                if (tree.Node(declaration.ChildAt(index)).Kind() == "ParameterDeclaration")
                { count = count + 1; }
                index = index + 1;
            }
            return count;
        }

        private static bool SupportedScalar(string type)
        {
            bool pointer = type.Length > 0 && type[type.Length - 1] == '*';
            return pointer || type == "void" || type == "bool" || type == "byte" || type == "char" ||
                type == "short" || type == "ushort" || type == "int" || type == "uint" ||
                type == "long" || type == "ulong" || type == "nint" || type == "nuint" ||
                type == "float" || type == "double";
        }

        private static void* ScalarType(void* context, string type)
        {
            if (type == "void") { return LLVM.LLVMVoidTypeInContext(context); }
            if (type == "bool") { return LLVM.LLVMInt1TypeInContext(context); }
            if (type == "byte" || type == "char") { return LLVM.LLVMInt8TypeInContext(context); }
            if (type == "short" || type == "ushort") { return LLVM.LLVMInt16TypeInContext(context); }
            if (type == "int" || type == "uint") { return LLVM.LLVMInt32TypeInContext(context); }
            if (type == "long" || type == "ulong" || type == "nint" || type == "nuint")
            { return LLVM.LLVMInt64TypeInContext(context); }
            if (type == "float") { return LLVM.LLVMFloatTypeInContext(context); }
            if (type == "double") { return LLVM.LLVMDoubleTypeInContext(context); }
            if (type.Length > 0 && type[type.Length - 1] == '*')
            { return LLVM.LLVMPointerTypeInContext(context, 0u); }
            return null;
        }

        private static void* ScalarFunctionType(void* context, SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            void* returnType = ScalarType(context, declaration.TypeText());
            if (returnType == null) { return null; }
            int parameterCount = ParameterCount(tree, declarationId);
            if (parameterCount < 0) { return null; }
            void** parameterTypes = null;
            if (parameterCount > 0) { parameterTypes = stackalloc void*[parameterCount]; }
            int index = 0; int parameter = 0;
            while (index < declaration.ChildCount())
            {
                SyntaxNode child = tree.Node(declaration.ChildAt(index));
                if (child.Kind() == "ParameterDeclaration")
                {
                    void* parameterType = ScalarType(context, child.TypeText());
                    if (parameterType == null || child.TypeText() == "void") { return null; }
                    parameterTypes[parameter] = parameterType; parameter = parameter + 1;
                }
                index = index + 1;
            }
            return LLVM.LLVMFunctionType(returnType, parameterTypes, (uint)parameterCount, 0);
        }

        // SH27 stable native identity. Source spelling alone aliases overloads and equal names in
        // different namespaces. The qualified semantic name plus its nominal function type is the
        // ABI identity; StableHash gives it a path-, locale- and process-independent COFF spelling.
        private static owned string LlvmFunctionName(SyntaxTree tree, SemanticModel semantic,
            int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            raii string qualified = String.Copy(declaration.Text());
            raii string signature = String.Copy(declaration.TypeText());
            int symbolId = semantic.NodeSymbol(declarationId);
            if (symbolId >= 0)
            {
                Symbol symbol = semantic.GetSymbol(symbolId);
                raii string symbolName = String.Copy(symbol.QualifiedName()); qualified = move(symbolName);
                if (symbol.TypeId() >= 0)
                {
                    raii string symbolType = String.Copy(semantic.Types().Get(symbol.TypeId()).Display());
                    signature = move(symbolType);
                }
            }
            raii string left = String.Concat(qualified, "|");
            raii string identity = String.Concat(left, signature);
            raii string hash = String.ToString(StableHash.Text(identity));
            raii string prefix = String.Concat("__nativesharp_", hash);
            raii string separator = String.Concat(prefix, "_");
            return String.Concat(separator, declaration.Text());
        }

        private static int FindFunctionDeclaration(SyntaxTree tree, int syntaxId, string name)
        {
            if (syntaxId < 0) { return -1; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.Text() == name && node.First() >= 0) { return syntaxId; }
            int found = FindFunctionDeclaration(tree, node.First(), name); if (found >= 0) { return found; }
            found = FindFunctionDeclaration(tree, node.Second(), name); if (found >= 0) { return found; }
            found = FindFunctionDeclaration(tree, node.Third(), name); if (found >= 0) { return found; }
            int child = 0;
            while (child < node.ChildCount())
            {
                found = FindFunctionDeclaration(tree, node.ChildAt(child), name);
                if (found >= 0) { return found; }
                child = child + 1;
            }
            return -1;
        }

        private static int ReturnExpression(SyntaxTree tree, int declarationId)
        {
            SyntaxNode declaration = tree.Node(declarationId);
            if (declaration.First() < 0) { return -1; }
            SyntaxNode body = tree.Node(declaration.First()); int index = 0;
            while (index < body.ChildCount())
            {
                SyntaxNode statement = tree.Node(body.ChildAt(index));
                if (statement.Kind() == "ReturnStatement" && statement.First() >= 0)
                { return statement.First(); }
                index = index + 1;
            }
            return -1;
        }

        private static bool DeclareFunctions(void* module, SyntaxTree tree, SemanticModel semantic,
            int syntaxId)
        {
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.First() >= 0 && SupportedScalar(node.TypeText()))
            {
                void* functionType = ScalarFunctionType(LLVM.LLVMGetModuleContext(module), tree, syntaxId);
                if (functionType == null) { return false; }
                raii string llvmNameText = LlvmFunctionName(tree, semantic, syntaxId);
                raii CString llvmName = new CString(llvmNameText);
                if (LLVM.LLVMAddFunction(module, llvmName.Pointer(), functionType) == null) { return false; }
            }
            if (!DeclareFunctions(module, tree, semantic, node.First())) { return false; }
            if (!DeclareFunctions(module, tree, semantic, node.Second())) { return false; }
            if (!DeclareFunctions(module, tree, semantic, node.Third())) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                if (!DeclareFunctions(module, tree, semantic, node.ChildAt(child))) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static int IntegerBits(string type)
        {
            if (type == "bool") { return 1; }
            if (type == "byte" || type == "char") { return 8; }
            if (type == "short" || type == "ushort") { return 16; }
            if (type == "int" || type == "uint") { return 32; }
            if (type == "long" || type == "ulong" || type == "nint" || type == "nuint") { return 64; }
            return 0;
        }

        private static bool UnsignedInteger(string type)
        {
            return type == "bool" || type == "byte" || type == "char" || type == "ushort" ||
                type == "uint" || type == "ulong" || type == "nuint";
        }

        private static bool FloatingScalar(string type)
        { return type == "float" || type == "double"; }

        private static void* ConvertScalar(void* module, void* builder, SemanticModel semantic,
            void* value, int sourceType, int destinationType)
        {
            if (value == null || sourceType == destinationType) { return value; }
            raii string source = String.Copy(semantic.Types().Get(sourceType).Display());
            raii string destination = String.Copy(semantic.Types().Get(destinationType).Display());
            bool sourcePointer = source.Length > 0 && source[source.Length - 1] == '*';
            bool destinationPointer = destination.Length > 0 && destination[destination.Length - 1] == '*';
            if (destinationPointer && (sourcePointer || source == "null")) { return value; }
            int sourceBits = IntegerBits(source); int destinationBits = IntegerBits(destination);
            void* context = LLVM.LLVMGetModuleContext(module);
            void* destinationLlvm = ScalarType(context, destination);
            raii CString conversionName = new CString("scalar.convert");
            if (destination == "bool")
            {
                raii CString comparisonName = new CString("scalar.to.bool");
                void* sourceLlvm = ScalarType(context, source);
                if (FloatingScalar(source))
                {
                    return LLVM.LLVMBuildFCmp(builder, LLVMRealPredicate.UnorderedNotEqual, value,
                        LLVM.LLVMConstReal(sourceLlvm, 0.0), comparisonName.Pointer());
                }
                return LLVM.LLVMBuildICmp(builder, LLVMIntPredicate.NotEqual, value,
                    LLVM.LLVMConstInt(sourceLlvm, 0UL, 0), comparisonName.Pointer());
            }
            if (FloatingScalar(source) && FloatingScalar(destination))
            {
                if (source == "float")
                { return LLVM.LLVMBuildFPExt(builder, value, destinationLlvm, conversionName.Pointer()); }
                return LLVM.LLVMBuildFPTrunc(builder, value, destinationLlvm, conversionName.Pointer());
            }
            if (FloatingScalar(source) && destinationBits != 0)
            {
                return UnsignedInteger(destination) ?
                    LLVM.LLVMBuildFPToUI(builder, value, destinationLlvm, conversionName.Pointer()) :
                    LLVM.LLVMBuildFPToSI(builder, value, destinationLlvm, conversionName.Pointer());
            }
            if (sourceBits != 0 && FloatingScalar(destination))
            {
                return UnsignedInteger(source) ?
                    LLVM.LLVMBuildUIToFP(builder, value, destinationLlvm, conversionName.Pointer()) :
                    LLVM.LLVMBuildSIToFP(builder, value, destinationLlvm, conversionName.Pointer());
            }
            if (sourceBits == 0 || destinationBits == 0) { return null; }
            if (sourceBits == destinationBits) { return value; }
            if (sourceBits > destinationBits)
            { return LLVM.LLVMBuildTrunc(builder, value, destinationLlvm, conversionName.Pointer()); }
            if (UnsignedInteger(source))
            { return LLVM.LLVMBuildZExt(builder, value, destinationLlvm, conversionName.Pointer()); }
            return LLVM.LLVMBuildSExt(builder, value, destinationLlvm, conversionName.Pointer());
        }

        private static void* ApplyConversion(void* module, void* builder, SemanticModel semantic,
            SemanticFact fact, void* value, string role, int operand)
        {
            int index = 0;
            while (index < fact.ConversionCount())
            {
                SemanticConversion conversion = fact.ConversionAt(index);
                if (conversion.Role() == role && conversion.OperandIndex() == operand)
                {
                    value = ConvertScalar(module, builder, semantic, value,
                        conversion.SourceType(), conversion.DestinationType());
                    if (value == null) { return null; }
                }
                index = index + 1;
            }
            return value;
        }

        private static void* EmitIntegerOperation(void* builder, TokenKind operation,
            bool unsignedOperation, void* left, void* right, byte* name)
        {
            if (operation == TokenKind.Plus || operation == TokenKind.PlusEqual)
            { return LLVM.LLVMBuildAdd(builder, left, right, name); }
            if (operation == TokenKind.Minus || operation == TokenKind.MinusEqual)
            { return LLVM.LLVMBuildSub(builder, left, right, name); }
            if (operation == TokenKind.Star || operation == TokenKind.StarEqual)
            { return LLVM.LLVMBuildMul(builder, left, right, name); }
            if (operation == TokenKind.Slash || operation == TokenKind.SlashEqual)
            { return unsignedOperation ? LLVM.LLVMBuildUDiv(builder, left, right, name) :
                LLVM.LLVMBuildSDiv(builder, left, right, name); }
            if (operation == TokenKind.Percent || operation == TokenKind.PercentEqual)
            { return unsignedOperation ? LLVM.LLVMBuildURem(builder, left, right, name) :
                LLVM.LLVMBuildSRem(builder, left, right, name); }
            if (operation == TokenKind.Amp || operation == TokenKind.AmpEqual)
            { return LLVM.LLVMBuildAnd(builder, left, right, name); }
            if (operation == TokenKind.Pipe || operation == TokenKind.PipeEqual)
            { return LLVM.LLVMBuildOr(builder, left, right, name); }
            if (operation == TokenKind.Caret || operation == TokenKind.CaretEqual)
            { return LLVM.LLVMBuildXor(builder, left, right, name); }
            if (operation == TokenKind.LessLess || operation == TokenKind.LessLessEqual)
            { return LLVM.LLVMBuildShl(builder, left, right, name); }
            if (operation == TokenKind.GreaterGreater || operation == TokenKind.GreaterGreaterEqual)
            { return unsignedOperation ? LLVM.LLVMBuildLShr(builder, left, right, name) :
                LLVM.LLVMBuildAShr(builder, left, right, name); }
            return null;
        }

        private static void* EmitFloatingOperation(void* builder, TokenKind operation,
            void* left, void* right, byte* name)
        {
            if (operation == TokenKind.Plus || operation == TokenKind.PlusEqual)
            { return LLVM.LLVMBuildFAdd(builder, left, right, name); }
            if (operation == TokenKind.Minus || operation == TokenKind.MinusEqual)
            { return LLVM.LLVMBuildFSub(builder, left, right, name); }
            if (operation == TokenKind.Star || operation == TokenKind.StarEqual)
            { return LLVM.LLVMBuildFMul(builder, left, right, name); }
            if (operation == TokenKind.Slash || operation == TokenKind.SlashEqual)
            { return LLVM.LLVMBuildFDiv(builder, left, right, name); }
            if (operation == TokenKind.Percent || operation == TokenKind.PercentEqual)
            { return LLVM.LLVMBuildFRem(builder, left, right, name); }
            return null;
        }

        private static void* EmitLValue(void* module, void* builder, void* i32, void* i1,
            SyntaxTree tree, SemanticModel semantic, int declarationId, void* function,
            FunctionLoweringState state, int syntaxId, out void* valueType, out bool valid)
        {
            valueType = null; valid = false;
            if (syntaxId < 0) { return null; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "IdentifierExpression")
            {
                int symbol = semantic.Fact(syntaxId).SymbolId();
                void* storage = state.FindLocal(symbol); valueType = state.FindLocalType(symbol);
                valid = storage != null && valueType != null; return storage;
            }
            if (node.Kind() == "UnaryExpression" && node.OperatorKind() == TokenKind.Star)
            {
                bool pointerValid = false;
                void* pointer = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out pointerValid);
                int typeId = semantic.Fact(syntaxId).TypeId();
                if (typeId >= 0)
                { valueType = ScalarType(LLVM.LLVMGetModuleContext(module), semantic.Types().Get(typeId).Display()); }
                valid = pointerValid && pointer != null && valueType != null; return pointer;
            }
            if (node.Kind() == "IndexExpression")
            {
                bool pointerValid = false; bool indexValid = false;
                void* pointer = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out pointerValid);
                void* index = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.Second(), out indexValid);
                int typeId = semantic.Fact(syntaxId).TypeId();
                if (typeId < 0) { return null; }
                valueType = ScalarType(LLVM.LLVMGetModuleContext(module), semantic.Types().Get(typeId).Display());
                if (!pointerValid || !indexValid || pointer == null || index == null || valueType == null) { return null; }
                void* gepIndex = index; raii CString gepName = new CString("index.address");
                void* address = LLVM.LLVMBuildGEP2(builder, valueType, pointer, &gepIndex, 1u, gepName.Pointer());
                valid = address != null; return address;
            }
            return null;
        }

        private static void* EmitScalarExpression(void* module, void* builder, void* i32, void* i1, SyntaxTree tree,
            SemanticModel semantic, int declarationId, void* function, FunctionLoweringState state,
            int syntaxId, out bool valid)
        {
            valid = false;
            if (syntaxId < 0) { return null; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "IntegerLiteralExpression")
            {
                ulong value = 0UL;
                if (!Number.TryParseUInt64(semantic.Fact(syntaxId).ConstantText(), out value)) { return null; }
                int semanticType = semantic.Fact(syntaxId).TypeId();
                if (semanticType < 0) { return null; }
                void* literalType = ScalarType(LLVM.LLVMGetModuleContext(module),
                    semantic.Types().Get(semanticType).Display());
                if (literalType == null) { return null; }
                valid = true;
                return LLVM.LLVMConstInt(literalType, value, 0);
            }
            if (node.Kind() == "BooleanLiteralExpression")
            {
                valid = true;
                return LLVM.LLVMConstInt(i1, node.Text() == "true" ? 1UL : 0UL, 0);
            }
            if (node.Kind() == "FloatingLiteralExpression")
            {
                double value = 0.0;
                if (!Number.TryParseDouble(semantic.Fact(syntaxId).ConstantText(), out value)) { return null; }
                int semanticType = semantic.Fact(syntaxId).TypeId();
                if (semanticType < 0) { return null; }
                void* literalType = ScalarType(LLVM.LLVMGetModuleContext(module),
                    semantic.Types().Get(semanticType).Display());
                if (literalType == null) { return null; }
                valid = true; return LLVM.LLVMConstReal(literalType, value);
            }
            if (node.Kind() == "NullLiteralExpression")
            {
                valid = true;
                return LLVM.LLVMConstNull(LLVM.LLVMPointerTypeInContext(
                    LLVM.LLVMGetModuleContext(module), 0u));
            }
            if (node.Kind() == "StackallocExpression")
            {
                bool countValid = false;
                void* count = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out countValid);
                void* elementType = ScalarType(LLVM.LLVMGetModuleContext(module), node.SemanticTypeText());
                if (!countValid || count == null || elementType == null) { return null; }
                raii CString allocationName = new CString("stack.buffer");
                void* allocation = LLVM.LLVMBuildArrayAlloca(
                    builder, elementType, count, allocationName.Pointer());
                valid = allocation != null; return allocation;
            }
            if (node.Kind() == "UnaryExpression" && node.OperatorKind() == TokenKind.Amp)
            {
                void* valueType = null;
                void* address = EmitLValue(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out valueType, out valid);
                return address;
            }
            if ((node.Kind() == "UnaryExpression" && node.OperatorKind() == TokenKind.Star) ||
                node.Kind() == "IndexExpression")
            {
                void* valueType = null; bool addressValid = false;
                void* address = EmitLValue(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, syntaxId, out valueType, out addressValid);
                if (!addressValid || address == null || valueType == null) { return null; }
                raii CString loadName = new CString("memory.load");
                void* value = LLVM.LLVMBuildLoad2(builder, valueType, address, loadName.Pointer());
                valid = value != null; return value;
            }
            if (node.Kind() == "UnaryExpression" && node.OperatorKind() == TokenKind.Bang)
            {
                bool operandValid = false;
                void* operand = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out operandValid);
                if (!operandValid || operand == null) { return null; }
                raii CString unaryName = new CString("unary.not"); valid = true;
                return LLVM.LLVMBuildNot(builder, operand, unaryName.Pointer());
            }
            if (node.Kind() == "UnaryExpression" &&
                (node.OperatorKind() == TokenKind.Plus || node.OperatorKind() == TokenKind.Minus))
            {
                bool operandValid = false;
                void* operand = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out operandValid);
                if (!operandValid || operand == null) { return null; }
                valid = true;
                if (node.OperatorKind() == TokenKind.Plus) { return operand; }
                raii CString unaryName = new CString("unary.minus");
                int resultType = semantic.Fact(syntaxId).TypeId();
                if (resultType < 0) { valid = false; return null; }
                void* llvmType = ScalarType(LLVM.LLVMGetModuleContext(module),
                    semantic.Types().Get(resultType).Display());
                if (llvmType == null) { valid = false; return null; }
                if (FloatingScalar(semantic.Types().Get(resultType).Display()))
                { return LLVM.LLVMBuildFNeg(builder, operand, unaryName.Pointer()); }
                return LLVM.LLVMBuildSub(builder, LLVM.LLVMConstInt(llvmType, 0UL, 0), operand, unaryName.Pointer());
            }
            if ((node.Kind() == "UnaryExpression" || node.Kind() == "PostfixExpression") &&
                (node.OperatorKind() == TokenKind.PlusPlus || node.OperatorKind() == TokenKind.MinusMinus) &&
                node.First() >= 0 && tree.Node(node.First()).Kind() == "IdentifierExpression")
            {
                int symbol = semantic.Fact(node.First()).SymbolId(); void* storage = state.FindLocal(symbol);
                void* valueType = state.FindLocalType(symbol);
                if (storage == null || valueType == null) { return null; }
                raii CString loadName = new CString("increment.load");
                raii CString resultName = new CString("increment.value");
                void* previous = LLVM.LLVMBuildLoad2(builder, valueType, storage, loadName.Pointer());
                int operandType = semantic.Fact(node.First()).TypeId();
                bool floating = operandType >= 0 && FloatingScalar(semantic.Types().Get(operandType).Display());
                void* one = floating ? LLVM.LLVMConstReal(valueType, 1.0) : LLVM.LLVMConstInt(valueType, 1UL, 0);
                TokenKind updateOperation = node.OperatorKind() == TokenKind.PlusPlus ?
                    TokenKind.Plus : TokenKind.Minus;
                void* result = floating ? EmitFloatingOperation(builder, updateOperation,
                    previous, one, resultName.Pointer()) : EmitIntegerOperation(builder,
                    updateOperation, false, previous, one, resultName.Pointer());
                if (previous == null || result == null || LLVM.LLVMBuildStore(builder, result, storage) == null)
                { return null; }
                valid = true; return node.Kind() == "PostfixExpression" ? previous : result;
            }
            if (node.Kind() == "IdentifierExpression")
            {
                int symbol = semantic.Fact(syntaxId).SymbolId();
                void* localStorage = state.FindLocal(symbol);
                if (localStorage != null)
                {
                    raii CString loadName = new CString("local.load"); valid = true;
                    void* localType = state.FindLocalType(symbol);
                    if (localType == null) { valid = false; return null; }
                    return LLVM.LLVMBuildLoad2(builder, localType, localStorage, loadName.Pointer());
                }
                SyntaxNode declaration = tree.Node(declarationId);
                int parameter = 0; int child = 0;
                while (child < declaration.ChildCount())
                {
                    int childId = declaration.ChildAt(child); SyntaxNode value = tree.Node(childId);
                    if (value.Kind() == "ParameterDeclaration")
                    {
                        if (semantic.NodeSymbol(childId) == symbol)
                        { valid = true; return LLVM.LLVMGetParam(function, (uint)parameter); }
                        parameter = parameter + 1;
                    }
                    child = child + 1;
                }
                return null;
            }
            if (node.Kind() == "CastExpression")
            {
                bool operandValid = false;
                void* operand = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out operandValid);
                if (!operandValid || operand == null) { return null; }
                void* converted = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId),
                    operand, "contextual", -1);
                valid = converted != null; return converted;
            }
            if (node.Kind() == "AssignmentExpression")
            {
                void* valueType = null; bool storageValid = false;
                void* storage = EmitLValue(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out valueType, out storageValid);
                bool assignedValid = false;
                void* assigned = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.Second(), out assignedValid);
                void* result = assigned;
                if (!storageValid || !assignedValid || assigned == null ||
                    storage == null || valueType == null) { return null; }
                assigned = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId),
                    assigned, "operand", 1);
                if (assigned == null) { return null; }
                if (node.OperatorKind() != TokenKind.Equal)
                {
                    raii CString loadName = new CString("compound.load");
                    raii CString resultName = new CString("compound.value");
                    void* previous = LLVM.LLVMBuildLoad2(builder, valueType, storage, loadName.Pointer());
                    int operationType = semantic.Fact(syntaxId).OperationType();
                    bool floatingOperation = operationType >= 0 &&
                        FloatingScalar(semantic.Types().Get(operationType).Display());
                    bool unsignedOperation = operationType >= 0 &&
                        UnsignedInteger(semantic.Types().Get(operationType).Display());
                    void* convertedPrevious = ApplyConversion(module, builder, semantic,
                        semantic.Fact(syntaxId), previous, "operand", 0);
                    result = floatingOperation ? EmitFloatingOperation(builder, node.OperatorKind(),
                        convertedPrevious, assigned, resultName.Pointer()) :
                        EmitIntegerOperation(builder, node.OperatorKind(), unsignedOperation,
                            convertedPrevious, assigned, resultName.Pointer());
                    if (previous == null || result == null) { return null; }
                    result = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId),
                        result, "result", -1);
                    if (result == null) { return null; }
                }
                if (LLVM.LLVMBuildStore(builder, result, storage) == null) { return null; }
                valid = true; return result;
            }
            if (node.Kind() == "CallExpression" && node.First() >= 0)
            {
                SyntaxNode callee = tree.Node(node.First());
                if (callee.Kind() != "IdentifierExpression") { return null; }
                int calleeDeclaration = -1;
                int calleeSymbol = semantic.Fact(node.First()).SymbolId();
                if (calleeSymbol >= 0) { calleeDeclaration = semantic.GetSymbol(calleeSymbol).Declaration(); }
                if (calleeDeclaration < 0)
                { calleeDeclaration = FindFunctionDeclaration(tree, tree.Root(), callee.Text()); }
                if (calleeDeclaration < 0 || ParameterCount(tree, calleeDeclaration) != node.ChildCount())
                { return null; }
                raii string llvmNameText = LlvmFunctionName(tree, semantic, calleeDeclaration);
                raii CString llvmName = new CString(llvmNameText);
                void* calleeFunction = LLVM.LLVMGetNamedFunction(module, llvmName.Pointer());
                if (calleeFunction == null) { return null; }
                void* calleeType = LLVM.LLVMGlobalGetValueType(calleeFunction);
                if (calleeFunction == null || calleeType == null) { return null; }
                void** arguments = null;
                if (node.ChildCount() > 0) { arguments = stackalloc void*[node.ChildCount()]; }
                int argument = 0;
                while (argument < node.ChildCount())
                {
                    bool argumentValid = false;
                    arguments[argument] = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                        declarationId, function, state, node.ChildAt(argument), out argumentValid);
                    if (!argumentValid || arguments[argument] == null) { return null; }
                    arguments[argument] = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId),
                        arguments[argument], "operand", argument);
                    if (arguments[argument] == null) { return null; }
                    argument = argument + 1;
                }
                raii CString callName = new CString("");
                void* call = LLVM.LLVMBuildCall2(builder, calleeType, calleeFunction,
                    arguments, (uint)node.ChildCount(), callName.Pointer());
                valid = call != null; return call;
            }
            if (node.Kind() == "BinaryExpression" &&
                (node.OperatorKind() == TokenKind.AmpAmp || node.OperatorKind() == TokenKind.PipePipe))
            {
                bool leftValid = false;
                void* left = EmitCondition(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out leftValid);
                void* leftBlock = LLVM.LLVMGetInsertBlock(builder);
                raii CString rhsName = new CString("logic.rhs"); raii CString endName = new CString("logic.end");
                void* rhsBlock = LLVM.LLVMAppendBasicBlockInContext(
                    LLVM.LLVMGetModuleContext(module), function, rhsName.Pointer());
                void* endBlock = LLVM.LLVMAppendBasicBlockInContext(
                    LLVM.LLVMGetModuleContext(module), function, endName.Pointer());
                if (!leftValid || left == null || leftBlock == null || rhsBlock == null || endBlock == null)
                { return null; }
                bool isAnd = node.OperatorKind() == TokenKind.AmpAmp;
                if (LLVM.LLVMBuildCondBr(builder, left, isAnd ? rhsBlock : endBlock,
                    isAnd ? endBlock : rhsBlock) == null) { return null; }
                LLVM.LLVMPositionBuilderAtEnd(builder, rhsBlock); bool rightValid = false;
                void* right = EmitCondition(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.Second(), out rightValid);
                void* rightBlock = LLVM.LLVMGetInsertBlock(builder);
                if (!rightValid || right == null || rightBlock == null ||
                    LLVM.LLVMBuildBr(builder, endBlock) == null) { return null; }
                LLVM.LLVMPositionBuilderAtEnd(builder, endBlock); raii CString phiName = new CString("logic.value");
                void* phi = LLVM.LLVMBuildPhi(builder, i1, phiName.Pointer());
                void*[2] incomingValues; void*[2] incomingBlocks;
                incomingValues[0] = LLVM.LLVMConstInt(i1, isAnd ? 0UL : 1UL, 0);
                incomingBlocks[0] = leftBlock; incomingValues[1] = right; incomingBlocks[1] = rightBlock;
                if (phi == null) { return null; }
                LLVM.LLVMAddIncoming(phi, &incomingValues[0], &incomingBlocks[0], 2u);
                valid = true; return phi;
            }
            if (node.Kind() == "ConditionalExpression")
            {
                bool conditionValid = false;
                void* condition = EmitCondition(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out conditionValid);
                raii CString thenName = new CString("select.then"); raii CString elseName = new CString("select.else");
                raii CString endName = new CString("select.end");
                void* context = LLVM.LLVMGetModuleContext(module);
                void* thenBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, thenName.Pointer());
                void* elseBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, elseName.Pointer());
                void* endBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, endName.Pointer());
                if (!conditionValid || condition == null || thenBlock == null || elseBlock == null || endBlock == null ||
                    LLVM.LLVMBuildCondBr(builder, condition, thenBlock, elseBlock) == null) { return null; }
                LLVM.LLVMPositionBuilderAtEnd(builder, thenBlock); bool thenValid = false;
                void* thenValue = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.Second(), out thenValid);
                void* thenEnd = LLVM.LLVMGetInsertBlock(builder);
                if (!thenValid || thenValue == null || thenEnd == null || LLVM.LLVMBuildBr(builder, endBlock) == null)
                { return null; }
                LLVM.LLVMPositionBuilderAtEnd(builder, elseBlock); bool elseValid = false;
                void* elseValue = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.Third(), out elseValid);
                void* elseEnd = LLVM.LLVMGetInsertBlock(builder);
                if (!elseValid || elseValue == null || elseEnd == null || LLVM.LLVMBuildBr(builder, endBlock) == null)
                { return null; }
                int resultType = semantic.Fact(syntaxId).TypeId();
                if (resultType < 0) { return null; }
                void* llvmType = ScalarType(LLVM.LLVMGetModuleContext(module),
                    semantic.Types().Get(resultType).Display());
                if (llvmType == null) { return null; }
                LLVM.LLVMPositionBuilderAtEnd(builder, endBlock); raii CString phiName = new CString("select.value");
                void* phi = LLVM.LLVMBuildPhi(builder, llvmType, phiName.Pointer());
                void*[2] incomingValues; void*[2] incomingBlocks;
                incomingValues[0] = thenValue; incomingBlocks[0] = thenEnd;
                incomingValues[1] = elseValue; incomingBlocks[1] = elseEnd;
                if (phi == null) { return null; }
                LLVM.LLVMAddIncoming(phi, &incomingValues[0], &incomingBlocks[0], 2u);
                valid = true; return phi;
            }
            if (node.Kind() != "BinaryExpression") { return null; }
            bool leftValid = false; bool rightValid = false;
            void* left = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                declarationId, function, state, node.First(), out leftValid);
            void* right = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                declarationId, function, state, node.Second(), out rightValid);
            if (!leftValid || !rightValid || left == null || right == null) { return null; }
            left = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId), left, "operand", 0);
            right = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId), right, "operand", 1);
            if (left == null || right == null) { return null; }
            raii CString temporaryName = new CString("source.value");
            void* result = null;
            int operationType = semantic.Fact(syntaxId).OperationType();
            bool floatingOperation = operationType >= 0 &&
                FloatingScalar(semantic.Types().Get(operationType).Display());
            bool unsignedOperation = operationType >= 0 &&
                UnsignedInteger(semantic.Types().Get(operationType).Display());
            if (Comparison(node.OperatorKind()))
            {
                result = floatingOperation ? LLVM.LLVMBuildFCmp(builder,
                    FloatingComparisonPredicate(node.OperatorKind()), left, right, temporaryName.Pointer()) :
                    LLVM.LLVMBuildICmp(builder, ComparisonPredicate(node.OperatorKind(), unsignedOperation),
                        left, right, temporaryName.Pointer());
            }
            else
            {
                result = floatingOperation ? EmitFloatingOperation(builder, node.OperatorKind(),
                    left, right, temporaryName.Pointer()) : EmitIntegerOperation(builder,
                    node.OperatorKind(), unsignedOperation, left, right, temporaryName.Pointer());
            }
            valid = result != null;
            return result;
        }

        private static bool Comparison(TokenKind operation)
        {
            return operation == TokenKind.EqualEqual || operation == TokenKind.BangEqual ||
                operation == TokenKind.Less || operation == TokenKind.LessEqual ||
                operation == TokenKind.Greater || operation == TokenKind.GreaterEqual;
        }

        private static LLVMIntPredicate ComparisonPredicate(TokenKind operation, bool unsignedOperation)
        {
            if (operation == TokenKind.EqualEqual) { return LLVMIntPredicate.Equal; }
            if (operation == TokenKind.BangEqual) { return LLVMIntPredicate.NotEqual; }
            if (operation == TokenKind.Less)
            { return unsignedOperation ? LLVMIntPredicate.UnsignedLessThan : LLVMIntPredicate.SignedLessThan; }
            if (operation == TokenKind.LessEqual)
            { return unsignedOperation ? LLVMIntPredicate.UnsignedLessOrEqual : LLVMIntPredicate.SignedLessOrEqual; }
            if (operation == TokenKind.Greater)
            { return unsignedOperation ? LLVMIntPredicate.UnsignedGreaterThan : LLVMIntPredicate.SignedGreaterThan; }
            return unsignedOperation ? LLVMIntPredicate.UnsignedGreaterOrEqual : LLVMIntPredicate.SignedGreaterOrEqual;
        }

        private static LLVMRealPredicate FloatingComparisonPredicate(TokenKind operation)
        {
            if (operation == TokenKind.EqualEqual) { return LLVMRealPredicate.OrderedEqual; }
            if (operation == TokenKind.BangEqual) { return LLVMRealPredicate.UnorderedNotEqual; }
            if (operation == TokenKind.Less) { return LLVMRealPredicate.OrderedLessThan; }
            if (operation == TokenKind.LessEqual) { return LLVMRealPredicate.OrderedLessOrEqual; }
            if (operation == TokenKind.Greater) { return LLVMRealPredicate.OrderedGreaterThan; }
            return LLVMRealPredicate.OrderedGreaterOrEqual;
        }

        private static void* EmitCondition(void* module, void* builder, void* i32, void* i1, SyntaxTree tree,
            SemanticModel semantic, int declarationId, void* function, FunctionLoweringState state,
            int syntaxId, out bool valid)
        {
            valid = false; SyntaxNode node = tree.Node(syntaxId); raii CString conditionName = new CString("condition");
            if (node.Kind() == "BinaryExpression" && Comparison(node.OperatorKind()))
            {
                bool leftValid = false; bool rightValid = false;
                void* left = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out leftValid);
                void* right = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.Second(), out rightValid);
                if (!leftValid || !rightValid || left == null || right == null) { return null; }
                SemanticFact fact = semantic.Fact(syntaxId);
                left = ApplyConversion(module, builder, semantic, fact, left, "operand", 0);
                right = ApplyConversion(module, builder, semantic, fact, right, "operand", 1);
                int operationType = fact.OperationType();
                bool floatingOperation = operationType >= 0 &&
                    FloatingScalar(semantic.Types().Get(operationType).Display());
                bool unsignedOperation = operationType >= 0 &&
                    UnsignedInteger(semantic.Types().Get(operationType).Display());
                if (left == null || right == null) { return null; }
                void* comparison = floatingOperation ? LLVM.LLVMBuildFCmp(builder,
                    FloatingComparisonPredicate(node.OperatorKind()), left, right, conditionName.Pointer()) :
                    LLVM.LLVMBuildICmp(builder, ComparisonPredicate(node.OperatorKind(), unsignedOperation),
                        left, right, conditionName.Pointer());
                valid = comparison != null; return comparison;
            }
            bool valueValid = false;
            void* value = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                declarationId, function, state, syntaxId, out valueValid);
            if (!valueValid || value == null) { return null; }
            int valueType = semantic.Fact(syntaxId).TypeId();
            if (valueType >= 0 && semantic.Types().Get(valueType).Display() == "bool")
            { valid = true; return value; }
            void* valueLlvmType = ScalarType(LLVM.LLVMGetModuleContext(module),
                semantic.Types().Get(valueType).Display());
            if (valueLlvmType == null) { return null; }
            if (FloatingScalar(semantic.Types().Get(valueType).Display()))
            {
                void* comparison = LLVM.LLVMBuildFCmp(builder, LLVMRealPredicate.UnorderedNotEqual,
                    value, LLVM.LLVMConstReal(valueLlvmType, 0.0), conditionName.Pointer());
                valid = comparison != null; return comparison;
            }
            void* comparison = LLVM.LLVMBuildICmp(builder, LLVMIntPredicate.NotEqual, value,
                LLVM.LLVMConstInt(valueLlvmType, 0UL, 0), conditionName.Pointer());
            valid = comparison != null; return comparison;
        }

        private static void* EmitEntryAlloca(void* builder, void* function, void* type, byte* name)
        {
            void* current = LLVM.LLVMGetInsertBlock(builder);
            void* entry = LLVM.LLVMGetEntryBasicBlock(function);
            if (current == null || entry == null) { return null; }
            void* first = LLVM.LLVMGetFirstInstruction(entry);
            if (first == null) { LLVM.LLVMPositionBuilderAtEnd(builder, entry); }
            else { LLVM.LLVMPositionBuilderBefore(builder, first); }
            void* storage = LLVM.LLVMBuildAlloca(builder, type, name);
            LLVM.LLVMPositionBuilderAtEnd(builder, current);
            return storage;
        }

        private static bool EmitStatement(void* context, void* module, void* builder, void* i32, void* i1,
            SyntaxTree tree, SemanticModel semantic, int declarationId, void* function,
            FunctionLoweringState state, int syntaxId, out bool terminated)
        {
            terminated = false;
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if (node.Kind() == "BlockStatement")
            {
                int child = 0;
                while (child < node.ChildCount() && !terminated)
                {
                    bool childTerminated = false;
                    if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                        function, state, node.ChildAt(child), out childTerminated)) { return false; }
                    terminated = childTerminated; child = child + 1;
                }
                return true;
            }
            if (node.Kind() == "VariableDeclarationStatement" &&
                SupportedScalar(node.TypeText()) && node.TypeText() != "void")
            {
                void* localType = ScalarType(context, node.TypeText());
                if (localType == null) { return false; }
                raii CString localName = new CString(node.Text());
                void* storage = EmitEntryAlloca(builder, function, localType, localName.Pointer());
                if (storage == null) { return false; }
                state.AddLocal(semantic.NodeSymbol(syntaxId), storage, localType);
                void* value = LLVM.LLVMConstInt(localType, 0UL, 0);
                if (node.First() >= 0)
                {
                    bool valueValid = false;
                    value = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                        declarationId, function, state, node.First(), out valueValid);
                    if (!valueValid || value == null) { return false; }
                    value = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId),
                        value, "contextual", -1);
                    if (value == null) { return false; }
                }
                return LLVM.LLVMBuildStore(builder, value, storage) != null;
            }
            if (node.Kind() == "ExpressionStatement" && node.First() >= 0)
            {
                bool expressionValid = false;
                void* value = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out expressionValid);
                return expressionValid && value != null;
            }
            if (node.Kind() == "ReturnStatement" && node.First() >= 0)
            {
                bool valueValid = false;
                void* value = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                    declarationId, function, state, node.First(), out valueValid);
                if (!valueValid || value == null) { return false; }
                value = ApplyConversion(module, builder, semantic, semantic.Fact(syntaxId),
                    value, "contextual", -1);
                if (value == null || LLVM.LLVMBuildRet(builder, value) == null) { return false; }
                terminated = true; return true;
            }
            if (node.Kind() == "ReturnStatement" && node.First() < 0)
            {
                if (tree.Node(declarationId).TypeText() != "void" || LLVM.LLVMBuildRetVoid(builder) == null)
                { return false; }
                terminated = true; return true;
            }
            if (node.Kind() == "BreakStatement" || node.Kind() == "ContinueStatement")
            {
                void* target = node.Kind() == "BreakStatement" ? state.BreakTarget() : state.ContinueTarget();
                if (target == null || LLVM.LLVMBuildBr(builder, target) == null) { return false; }
                terminated = true; return true;
            }
            if (node.Kind() == "IfStatement")
            {
                bool conditionValid = false;
                void* condition = EmitCondition(module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.First(), out conditionValid);
                raii CString thenName = new CString("if.then"); raii CString elseName = new CString("if.else");
                raii CString mergeName = new CString("if.end");
                void* thenBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, thenName.Pointer());
                void* mergeBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, mergeName.Pointer());
                void* elseBlock = node.Third() >= 0 ?
                    LLVM.LLVMAppendBasicBlockInContext(context, function, elseName.Pointer()) : mergeBlock;
                if (!conditionValid || condition == null || thenBlock == null || mergeBlock == null ||
                    elseBlock == null || LLVM.LLVMBuildCondBr(builder, condition, thenBlock, elseBlock) == null)
                { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, thenBlock); bool thenTerminated = false;
                if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.Second(), out thenTerminated)) { return false; }
                if (!thenTerminated && LLVM.LLVMBuildBr(builder, mergeBlock) == null) { return false; }
                bool elseTerminated = false;
                if (node.Third() >= 0)
                {
                    LLVM.LLVMPositionBuilderAtEnd(builder, elseBlock);
                    if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                        function, state, node.Third(), out elseTerminated)) { return false; }
                    if (!elseTerminated && LLVM.LLVMBuildBr(builder, mergeBlock) == null) { return false; }
                }
                LLVM.LLVMPositionBuilderAtEnd(builder, mergeBlock);
                terminated = thenTerminated && node.Third() >= 0 && elseTerminated;
                if (terminated && LLVM.LLVMBuildUnreachable(builder) == null) { return false; }
                return true;
            }
            if (node.Kind() == "WhileStatement")
            {
                raii CString conditionName = new CString("while.condition");
                raii CString bodyName = new CString("while.body"); raii CString endName = new CString("while.end");
                void* conditionBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, conditionName.Pointer());
                void* bodyBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, bodyName.Pointer());
                void* endBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, endName.Pointer());
                if (conditionBlock == null || bodyBlock == null || endBlock == null ||
                    LLVM.LLVMBuildBr(builder, conditionBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, conditionBlock); bool conditionValid = false;
                void* condition = EmitCondition(module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.First(), out conditionValid);
                if (!conditionValid || condition == null ||
                    LLVM.LLVMBuildCondBr(builder, condition, bodyBlock, endBlock) == null) { return false; }
                state.PushLoop(endBlock, conditionBlock);
                LLVM.LLVMPositionBuilderAtEnd(builder, bodyBlock); bool bodyTerminated = false;
                if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.Second(), out bodyTerminated)) { state.PopLoop(); return false; }
                if (!bodyTerminated && LLVM.LLVMBuildBr(builder, conditionBlock) == null) { return false; }
                state.PopLoop();
                LLVM.LLVMPositionBuilderAtEnd(builder, endBlock); return true;
            }
            if (node.Kind() == "DoWhileStatement")
            {
                raii CString bodyName = new CString("do.body"); raii CString conditionName = new CString("do.condition");
                raii CString endName = new CString("do.end");
                void* bodyBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, bodyName.Pointer());
                void* conditionBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, conditionName.Pointer());
                void* endBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, endName.Pointer());
                if (bodyBlock == null || conditionBlock == null || endBlock == null ||
                    LLVM.LLVMBuildBr(builder, bodyBlock) == null) { return false; }
                state.PushLoop(endBlock, conditionBlock);
                LLVM.LLVMPositionBuilderAtEnd(builder, bodyBlock); bool bodyTerminated = false;
                if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.Second(), out bodyTerminated)) { state.PopLoop(); return false; }
                if (!bodyTerminated && LLVM.LLVMBuildBr(builder, conditionBlock) == null)
                { state.PopLoop(); return false; }
                state.PopLoop(); LLVM.LLVMPositionBuilderAtEnd(builder, conditionBlock); bool conditionValid = false;
                void* condition = EmitCondition(module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.First(), out conditionValid);
                if (!conditionValid || condition == null ||
                    LLVM.LLVMBuildCondBr(builder, condition, bodyBlock, endBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, endBlock); return true;
            }
            if (node.Kind() == "ForStatement")
            {
                if (node.First() >= 0)
                {
                    if (tree.Node(node.First()).Kind() == "VariableDeclarationStatement")
                    {
                        bool initializerTerminated = false;
                        if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                            function, state, node.First(), out initializerTerminated) || initializerTerminated)
                        { return false; }
                    }
                    else
                    {
                        bool initializerValid = false;
                        void* initializer = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                            declarationId, function, state, node.First(), out initializerValid);
                        if (!initializerValid || initializer == null) { return false; }
                    }
                }
                raii CString conditionName = new CString("for.condition"); raii CString bodyName = new CString("for.body");
                raii CString incrementName = new CString("for.increment"); raii CString endName = new CString("for.end");
                void* conditionBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, conditionName.Pointer());
                void* bodyBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, bodyName.Pointer());
                void* incrementBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, incrementName.Pointer());
                void* endBlock = LLVM.LLVMAppendBasicBlockInContext(context, function, endName.Pointer());
                if (conditionBlock == null || bodyBlock == null || incrementBlock == null || endBlock == null ||
                    LLVM.LLVMBuildBr(builder, conditionBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, conditionBlock); void* condition = null; bool conditionValid = true;
                if (node.Second() >= 0)
                {
                    condition = EmitCondition(module, builder, i32, i1, tree, semantic, declarationId,
                        function, state, node.Second(), out conditionValid);
                }
                else { condition = LLVM.LLVMConstInt(LLVM.LLVMInt1TypeInContext(context), 1UL, 0); }
                if (!conditionValid || condition == null ||
                    LLVM.LLVMBuildCondBr(builder, condition, bodyBlock, endBlock) == null) { return false; }
                state.PushLoop(endBlock, incrementBlock);
                LLVM.LLVMPositionBuilderAtEnd(builder, bodyBlock); bool bodyTerminated = false;
                if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, declarationId,
                    function, state, node.ChildAt(0), out bodyTerminated)) { state.PopLoop(); return false; }
                if (!bodyTerminated && LLVM.LLVMBuildBr(builder, incrementBlock) == null)
                { state.PopLoop(); return false; }
                state.PopLoop(); LLVM.LLVMPositionBuilderAtEnd(builder, incrementBlock);
                if (node.Third() >= 0)
                {
                    bool incrementValid = false;
                    void* increment = EmitScalarExpression(module, builder, i32, i1, tree, semantic,
                        declarationId, function, state, node.Third(), out incrementValid);
                    if (!incrementValid || increment == null) { return false; }
                }
                if (LLVM.LLVMBuildBr(builder, conditionBlock) == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, endBlock); return true;
            }
            return false;
        }

        private static bool EmitFunctions(void* context, void* module, void* builder, void* i32, void* i1,
            SyntaxTree tree, SemanticModel semantic, int syntaxId)
        {
            if (syntaxId < 0) { return true; }
            SyntaxNode node = tree.Node(syntaxId);
            if ((node.Kind() == "FunctionDeclaration" || node.Kind() == "MethodDeclaration") &&
                node.First() >= 0 && SupportedScalar(node.TypeText()))
            {
                raii string llvmNameText = LlvmFunctionName(tree, semantic, syntaxId);
                raii CString llvmName = new CString(llvmNameText);
                void* function = LLVM.LLVMGetNamedFunction(module, llvmName.Pointer());
                raii CString entryName = new CString("source.entry");
                void* block = LLVM.LLVMAppendBasicBlockInContext(context, function, entryName.Pointer());
                if (function == null || block == null) { return false; }
                LLVM.LLVMPositionBuilderAtEnd(builder, block);
                raii FunctionLoweringState state = new FunctionLoweringState();
                int child = 0; int parameter = 0;
                while (child < node.ChildCount())
                {
                    int childId = node.ChildAt(child); SyntaxNode parameterNode = tree.Node(childId);
                    if (parameterNode.Kind() == "ParameterDeclaration")
                    {
                        void* parameterType = ScalarType(context, parameterNode.TypeText());
                        raii CString parameterName = new CString(parameterNode.Text());
                        void* storage = EmitEntryAlloca(builder, function, parameterType, parameterName.Pointer());
                        void* incoming = LLVM.LLVMGetParam(function, (uint)parameter);
                        if (parameterType == null || storage == null || incoming == null ||
                            LLVM.LLVMBuildStore(builder, incoming, storage) == null) { return false; }
                        state.AddLocal(semantic.NodeSymbol(childId), storage, parameterType);
                        parameter = parameter + 1;
                    }
                    child = child + 1;
                }
                bool terminated = false;
                if (!EmitStatement(context, module, builder, i32, i1, tree, semantic, syntaxId,
                    function, state, node.First(), out terminated) || !terminated) { return false; }
            }
            if (!EmitFunctions(context, module, builder, i32, i1, tree, semantic, node.First())) { return false; }
            if (!EmitFunctions(context, module, builder, i32, i1, tree, semantic, node.Second())) { return false; }
            if (!EmitFunctions(context, module, builder, i32, i1, tree, semantic, node.Third())) { return false; }
            int child = 0;
            while (child < node.ChildCount())
            {
                if (!EmitFunctions(context, module, builder, i32, i1, tree, semantic, node.ChildAt(child))) { return false; }
                child = child + 1;
            }
            return true;
        }

        private static void Dispose(
            void* context, void* module, void* builder, void* machine, void* layout)
        {
            if (layout != null) { LLVM.LLVMDisposeTargetData(layout); }
            if (machine != null) { LLVM.LLVMDisposeTargetMachine(machine); }
            if (builder != null) { LLVM.LLVMDisposeBuilder(builder); }
            if (module != null) { LLVM.LLVMDisposeModule(module); }
            if (context != null) { LLVM.LLVMContextDispose(context); }
        }

        private static LLVMCodeGenOptLevel CodeGenLevel(BackendOptimization optimization)
        {
            if (optimization == BackendOptimization.O0) { return LLVMCodeGenOptLevel.None; }
            if (optimization == BackendOptimization.O1) { return LLVMCodeGenOptLevel.Less; }
            if (optimization == BackendOptimization.O3) { return LLVMCodeGenOptLevel.Aggressive; }
            return LLVMCodeGenOptLevel.Default;
        }

        private static owned string PassPipeline(BackendOptimization optimization)
        {
            if (optimization == BackendOptimization.O0) { return String.Copy("verify"); }
            if (optimization == BackendOptimization.O1) { return String.Copy("default<O1>"); }
            if (optimization == BackendOptimization.O2) { return String.Copy("default<O2>"); }
            return String.Copy("default<O3>");
        }

        public static int EmitExecutableObject(SyntaxTree tree, SemanticModel semantic,
            string outputPath, BackendOptimization optimization, BackendArtifactKind artifact)
        {
            uint major = 0u; uint minor = 0u; uint patch = 0u;
            LLVM.LLVMGetVersion(&major, &minor, &patch);
            if (major != 23u) { return 90; }

            LLVM.LLVMInitializeX86TargetInfo(); LLVM.LLVMInitializeX86Target();
            LLVM.LLVMInitializeX86TargetMC(); LLVM.LLVMInitializeX86AsmParser();
            LLVM.LLVMInitializeX86AsmPrinter();

            int entryExpression = EntryExpression(tree);
            if (entryExpression < 0) { return 12; }
            raii CString moduleName = new CString("nativesharp.source.derived.backend");
            raii CString triple = new CString("x86_64-pc-windows-msvc");
            raii CString empty = new CString(""); raii CString entryName = new CString("mainCRTStartup");
            raii CString exitName = new CString("ExitProcess"); raii CString computeName = new CString("NativeSharpCompute");
            raii CString blockName = new CString("entry"); raii CString temporaryName = new CString("answer");
            raii CString globalName = new CString("__nativesharp_backend_contract");
            raii CString fltusedName = new CString("_fltused");
            raii CString output = new CString(outputPath); raii string pipelineText = PassPipeline(optimization);
            raii CString pipeline = new CString(pipelineText);

            void* context = LLVM.LLVMContextCreate(); if (context == null) { return 1; }
            void* module = LLVM.LLVMModuleCreateWithNameInContext(moduleName.Pointer(), context);
            void* builder = null; void* machine = null; void* layout = null;
            if (module == null) { Dispose(context, module, builder, machine, layout); return 2; }
            LLVM.LLVMSetTarget(module, triple.Pointer());

            void* voidType = LLVM.LLVMVoidTypeInContext(context);
            void* i1 = LLVM.LLVMInt1TypeInContext(context);
            void* i32 = LLVM.LLVMInt32TypeInContext(context);
            void* contractGlobal = LLVM.LLVMAddGlobal(module, i32, globalName.Pointer());
            LLVM.LLVMSetInitializer(contractGlobal, LLVM.LLVMConstInt(i32, 8UL, 0));
            LLVM.LLVMSetGlobalConstant(contractGlobal, 1);
            void* fltused = LLVM.LLVMAddGlobal(module, i32, fltusedName.Pointer());
            LLVM.LLVMSetInitializer(fltused, LLVM.LLVMConstInt(i32, 0UL, 0));

            void* computeType = LLVM.LLVMFunctionType(i32, null, 0u, 0);
            void* compute = LLVM.LLVMAddFunction(module, computeName.Pointer(), computeType);
            builder = LLVM.LLVMCreateBuilderInContext(context);
            if (builder == null)
            { Dispose(context, module, builder, machine, layout); return 3; }
            if (!DeclareFunctions(module, tree, semantic, tree.Root()))
            { Dispose(context, module, builder, machine, layout); return 13; }
            if (!EmitFunctions(context, module, builder, i32, i1, tree, semantic, tree.Root()))
            { Dispose(context, module, builder, machine, layout); return 14; }
            void* computeBlock = LLVM.LLVMAppendBasicBlockInContext(context, compute, blockName.Pointer());
            if (computeBlock == null) { Dispose(context, module, builder, machine, layout); return 3; }
            LLVM.LLVMPositionBuilderAtEnd(builder, computeBlock);
            int mainDeclaration = FindFunctionDeclaration(tree, tree.Root(), "Main");
            if (mainDeclaration < 0) { Dispose(context, module, builder, machine, layout); return 4; }
            raii string mainNameText = LlvmFunctionName(tree, semantic, mainDeclaration);
            raii CString mainName = new CString(mainNameText);
            void* mainFunction = LLVM.LLVMGetNamedFunction(module, mainName.Pointer());
            if (mainFunction == null) { Dispose(context, module, builder, machine, layout); return 4; }
            void* answer = LLVM.LLVMBuildCall2(builder, computeType, mainFunction, null, 0u, temporaryName.Pointer());
            if (answer == null || LLVM.LLVMBuildRet(builder, answer) == null)
            { Dispose(context, module, builder, machine, layout); return 4; }

            void* startupType = LLVM.LLVMFunctionType(voidType, null, 0u, 0);
            void* startup = LLVM.LLVMAddFunction(module, entryName.Pointer(), startupType);
            void* exitParameter = i32; void* exitType = LLVM.LLVMFunctionType(voidType, &exitParameter, 1u, 0);
            void* exitFunction = LLVM.LLVMAddFunction(module, exitName.Pointer(), exitType);
            void* startupBlock = LLVM.LLVMAppendBasicBlockInContext(context, startup, blockName.Pointer());
            LLVM.LLVMPositionBuilderAtEnd(builder, startupBlock);
            void* result = LLVM.LLVMBuildCall2(builder, computeType, compute, null, 0u, temporaryName.Pointer());
            void* exitArgument = result;
            if (result == null || LLVM.LLVMBuildCall2(builder, exitType, exitFunction, &exitArgument, 1u, empty.Pointer()) == null ||
                LLVM.LLVMBuildUnreachable(builder) == null)
            { Dispose(context, module, builder, machine, layout); return 5; }

            byte* verifyMessage = null;
            if (LLVM.LLVMVerifyModule(module, LLVMVerifierFailureAction.ReturnStatus, &verifyMessage) != 0)
            { if (verifyMessage != null) { LLVM.LLVMDisposeMessage(verifyMessage); } Dispose(context, module, builder, machine, layout); return 6; }
            if (verifyMessage != null) { LLVM.LLVMDisposeMessage(verifyMessage); }

            void* target = null; byte* targetError = null;
            if (LLVM.LLVMGetTargetFromTriple(triple.Pointer(), &target, &targetError) != 0 || target == null)
            { if (targetError != null) { LLVM.LLVMDisposeMessage(targetError); } Dispose(context, module, builder, machine, layout); return 7; }
            machine = LLVM.LLVMCreateTargetMachine(target, triple.Pointer(), empty.Pointer(), empty.Pointer(),
                CodeGenLevel(optimization), LLVMRelocMode.Static, LLVMCodeModel.Default);
            layout = LLVM.LLVMCreateTargetDataLayout(machine);
            if (machine == null || layout == null) { Dispose(context, module, builder, machine, layout); return 8; }
            LLVM.LLVMSetModuleDataLayout(module, layout);

            void* options = LLVM.LLVMCreatePassBuilderOptions(); LLVM.LLVMPassBuilderOptionsSetVerifyEach(options, 1);
            void* passError = LLVM.LLVMRunPasses(module, pipeline.Pointer(), machine, options);
            LLVM.LLVMDisposePassBuilderOptions(options);
            if (passError != null)
            { byte* message = LLVM.LLVMGetErrorMessage(passError); if (message != null) { LLVM.LLVMDisposeErrorMessage(message); }
              Dispose(context, module, builder, machine, layout); return 9; }

            void* debugBuilder = LLVM.LLVMCreateDIBuilder(module);
            if (debugBuilder == null) { Dispose(context, module, builder, machine, layout); return 10; }
            LLVM.LLVMDIBuilderFinalize(debugBuilder); LLVM.LLVMDisposeDIBuilder(debugBuilder);

            byte* emitError = null;
            LLVMCodeGenFileType fileType = artifact == BackendArtifactKind.Assembly ?
                LLVMCodeGenFileType.Assembly : LLVMCodeGenFileType.Object;
            int failed = LLVM.LLVMTargetMachineEmitToFile(machine, module, output.Pointer(), fileType, &emitError);
            if (emitError != null) { LLVM.LLVMDisposeMessage(emitError); }
            Dispose(context, module, builder, machine, layout);
            return failed == 0 ? 0 : 11;
        }
    }
}
