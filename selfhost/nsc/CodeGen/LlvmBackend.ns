        private static owned string RuntimeHook(string owner, string method)
        {
            if (owner == "Environment" && method == "GetCommandLineArgCount")
            { return String.Copy("__nativesharp_environment_get_command_line_arg_count"); }
            if (owner == "Environment" && method == "GetCommandLineArgs")
            { return String.Copy("__nativesharp_environment_get_command_line_args"); }
            if (owner == "File" && method == "Exists") { return String.Copy("__nativesharp_file_exists"); }
            if (owner == "File" && method == "ReadAllText") { return String.Copy("__nativesharp_file_read_all_text"); }
            if (owner == "File" && method == "WriteAllText") { return String.Copy("__nativesharp_file_write_all_text"); }
            if (owner == "Directory" && method == "Exists") { return String.Copy("__nativesharp_directory_exists"); }
            if (owner == "Directory" && method == "GetFileCount") { return String.Copy("__nativesharp_directory_get_file_count"); }
            if (owner == "Directory" && method == "GetFiles") { return String.Copy("__nativesharp_directory_get_files"); }
            if (owner == "Directory" && method == "GetDirectoryCount") { return String.Copy("__nativesharp_directory_get_directory_count"); }
            if (owner == "Directory" && method == "GetDirectories") { return String.Copy("__nativesharp_directory_get_directories"); }
            if (owner == "Path" && method == "GetFullPath") { return String.Copy("__nativesharp_path_get_full_path"); }
            return String.Copy("");
        }

        private static LLVMAtomicOrdering AtomicOrderingFor(SyntaxTree tree, SemanticModel semantic,
            SyntaxNode call, int argument, bool failure)
        {
            if (argument < 0 || argument >= call.ChildCount()) { return LLVMAtomicOrdering.SequentiallyConsistent; }
            SemanticFact fact = semantic.Fact(call.ChildAt(argument)); long value = 4;
            if (!fact.IsConstant() || !Number.TryParseInt64(fact.ConstantText(), out value))
            { return LLVMAtomicOrdering.SequentiallyConsistent; }
            if (value == 0) { return LLVMAtomicOrdering.Monotonic; }
            if (value == 1) { return LLVMAtomicOrdering.Acquire; }
            if (value == 2) { return failure ? LLVMAtomicOrdering.Monotonic : LLVMAtomicOrdering.Release; }
            if (value == 3) { return failure ? LLVMAtomicOrdering.Acquire : LLVMAtomicOrdering.AcquireRelease; }
            return LLVMAtomicOrdering.SequentiallyConsistent;
        }

