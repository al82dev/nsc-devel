using NativeSharp.Core;
using NativeSharp.Core.Collections.Generic;
using NativeSharp.Compiler.Syntax;

namespace NativeSharp.Compiler.Sema
{
    public class CallableGraph
    {
        private owned List<string> records;
        public CallableGraph() { records = new List<string>(); }
        private void Add(string kind, string name)
        {
            raii string head = String.Concat(kind, " "); raii string record = String.Concat(head, name);
            int i = 0; while (i < records.Count()) { if (records[i] == record) { return; } i = i + 1; }
            records.Add(move(record));
        }
        private void Visit(SyntaxTree tree, int id)
        {
            if (id < 0) { return; } SyntaxNode node = tree.Node(id);
            if (node.Kind() == "DelegateDeclaration") { Add("delegate", node.Text()); }
            else if (node.Kind() == "LambdaExpression") { Add("lambda", node.Flag() ? "block" : "expression"); }
            else if (node.Kind() == "CallExpression" && node.First() >= 0)
            { Add("call", tree.Node(node.First()).Text()); }
            else if (node.Kind() == "MethodDeclaration" || node.Kind() == "FunctionDeclaration")
            {
                if (String.Contains(node.ModifiersText(), "virtual")) { Add("virtual", node.Text()); }
                if (String.Contains(node.ModifiersText(), "override")) { Add("override", node.Text()); }
            }
            Visit(tree, node.First()); Visit(tree, node.Second()); Visit(tree, node.Third());
            int child = 0; while (child < node.ChildCount()) { Visit(tree, node.ChildAt(child)); child = child + 1; }
        }
        public static owned CallableGraph Build(SyntaxTree tree)
        { raii CallableGraph graph = new CallableGraph(); graph.Visit(tree, tree.Root()); return move(graph); }
        public owned string Dump()
        {
            raii StringBuilder output = new StringBuilder(); output.Append("callables="); output.Append(records.Count()); output.Append('\n');
            raii string previous = String.Copy(""); int emitted = 0;
            while (emitted < records.Count())
            {
                int best = -1; int i = 0;
                while (i < records.Count())
                {
                    if ((previous.Length == 0 || String.Compare(records[i], previous) > 0) &&
                        (best < 0 || String.Compare(records[i], records[best]) < 0)) { best = i; }
                    i = i + 1;
                }
                if (best < 0) { break; } output.Append(records[best]); output.Append('\n');
                raii string copy = String.Copy(records[best]); previous = move(copy); emitted = emitted + 1;
            }
            return output.ToOwnedString();
        }
    }
}
