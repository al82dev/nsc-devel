namespace NativeSharp.Core.Collections.Generic
{
    // Enumerator returned by Queue<T>.GetEnumerator() (P1.2 of
    // STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md -- extending the enumerator pattern
    // beyond List<T> to the rest of the Generic Collections library). See ListEnumerator.ns's
    // class comment for the general design this whole family of enumerators follows (top-level
    // class, not nested -- this compiler cannot express nested types; borrows rather than owns
    // the source container; every element is read back through a public accessor on the source,
    // never by duplicating its storage).
    //
    // Iteration order matches Queue<T>.ToArray()/CopyTo(): oldest-enqueued element first (FIFO
    // order), via Queue<T>'s own logical-index indexer (added alongside this enumerator).
    public class QueueEnumerator<T>
    {
        private Queue<T> source;
        private int index;

        public QueueEnumerator(Queue<T> sourceQueue)
        {
            source = sourceQueue;
            index = -1;
        }

        public bool MoveNext()
        {
            index = index + 1;
            return index < source.Count();
        }

        // EN: Freeze 3.0 P3: the element by reference, so `foreach (ref ...)` reaches it without a copy
        //     and a by-value foreach copies only a copyable T.
        // ES: Congelamiento 3.0 P3: el elemento por referencia, asi que `foreach (ref ...)` llega a el
        //     sin copia y un foreach por valor copia solo un T copiable.
        public ref T Current
        {
            get { return ref source.RefAt(index); }
        }
    }
}
