using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.HashSet<T> as a thin wrapper around
    // Dictionary<T, bool> -- a set is exactly a map that only ever cares whether a key is
    // present, so there is no reason to duplicate the hash table logic (buckets/entries/
    // free-list/Grow()) a second time; every real allocation, hashing, and ownership decision
    // lives in Dictionary.ns's single implementation. This is the same "build the narrower
    // container out of the more general one" choice real C#'s own base class library does NOT
    // make internally (its HashSet<T> has its own independent implementation), but is a
    // reasonable, honest simplification for a hand-written, from-scratch native compiler's
    // standard library -- documented here and in the Stage 52 didactic writeup, not hidden.
    //
    // Ownership: `Add(owned T value)` transfers ownership of `value` into the backing
    // Dictionary<T, bool> exactly like Dictionary<TKey,TValue>.Add does for its key (the `bool`
    // stored alongside it is a fixed, meaningless placeholder -- always `true` -- never surfaced
    // through this class's own API). `Remove`/`Contains`/`Clear`/the destructor all defer
    // straight to the backing dictionary, which already frees a reference-typed element (a no-op
    // for a value-typed one) at the right times.
    public class HashSet<T>
    {
        private Dictionary<T, bool> items;

        public HashSet()
        {
            items = new Dictionary<T, bool>();
        }

        public HashSet(int capacity)
        {
            items = new Dictionary<T, bool>(capacity);
        }

        // EN: Freeze 3.0 P2: a HashFunc<T> receives a copy, so these constructors require `T : copy`.
        // ES: Congelamiento 3.0 P2: un HashFunc<T> recibe una copia, asi que estos constructores exigen
        //     `T : copy`.
        public HashSet(HashFunc<T> hashFunc) where T : copy
        {
            items = new Dictionary<T, bool>(hashFunc);
        }

        public HashSet(HashFunc<T> hashFunc, int capacity) where T : copy
        {
            items = new Dictionary<T, bool>(hashFunc, capacity);
        }

        public int Count()
        {
            return items.Count();
        }

        // Mirrors real C#'s HashSet<T>.Add: returns whether `value` was actually a NEW element.
        // Dictionary.TryAdd preserves that non-throwing contract and consumes either outcome.
        public bool Add(owned T value)
        {
            return items.TryAdd(move(value), true);
        }

        public bool Contains(T value)
        {
            return items.ContainsKey(value);
        }

        public bool Remove(T value)
        {
            return items.Remove(value);
        }

        public void Clear()
        {
            items.Clear();
        }

        public T[] ToArray()
        {
            return items.Keys();
        }

        // Public so callers can pre-size before a known-size batch of Add()s. Delegates straight
        // to the backing Dictionary<T,bool>.
        public int EnsureCapacity(int capacity)
        {
            return items.EnsureCapacity(capacity);
        }

        public void TrimExcess()
        {
            items.TrimExcess();
        }

        // Mirrors HashSet<T>.UnionWith: adds every element of `other` not already present. Each
        // added element is a PLAIN (non-owned) read from `other`'s own backing dictionary handed
        // straight to this set's Add-equivalent path -- the same "plain reference into an owned
        // slot" gap List.ns's class comment already documents for Sort/Insert/RemoveAt's internal
        // same-array moves, here extended across two different sets. Safe for a value-typed T
        // (owned is a no-op there); for a reference-typed T this means the element ends up
        // referenced from BOTH sets, a known, deliberately-not-yet-hardened gap (see the Stage 52
        // closure notes' item on owned-slot assignment hardening) -- callers should not rely on a
        // reference-typed HashSet<T> owning independent copies after UnionWith/SymmetricExceptWith.
        public void UnionWith(HashSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!items.ContainsKey(snapshot[i]))
                {
                    items.TryAdd(snapshot[i], true);
                }
                i = i + 1;
            }
            delete[] snapshot;
        }

        // Mirrors HashSet<T>.IntersectWith: keeps only elements also present in `other`. Pure
        // removal, no cross-set ownership question.
        public void IntersectWith(HashSet<T> other)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!other.Contains(snapshot[i]))
                {
                    items.Remove(snapshot[i]);
                }
                i = i + 1;
            }
            delete[] snapshot;
        }

        // Mirrors HashSet<T>.ExceptWith: removes every element also present in `other`.
        public void ExceptWith(HashSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                items.Remove(snapshot[i]);
                i = i + 1;
            }
            delete[] snapshot;
        }

        // Mirrors HashSet<T>.SymmetricExceptWith: keeps elements present in exactly one of the
        // two sets. Same cross-set ownership caveat as UnionWith for the elements it adds.
        public void SymmetricExceptWith(HashSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (items.ContainsKey(snapshot[i]))
                {
                    items.Remove(snapshot[i]);
                }
                else
                {
                    items.TryAdd(snapshot[i], true);
                }
                i = i + 1;
            }
            delete[] snapshot;
        }

        public bool IsSubsetOf(HashSet<T> other)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!other.Contains(snapshot[i]))
                {
                    delete[] snapshot;
                    return false;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return true;
        }

        public bool IsProperSubsetOf(HashSet<T> other)
        {
            return Count() < other.Count() && IsSubsetOf(other);
        }

        public bool IsSupersetOf(HashSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!items.ContainsKey(snapshot[i]))
                {
                    delete[] snapshot;
                    return false;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return true;
        }

        public bool IsProperSupersetOf(HashSet<T> other)
        {
            return Count() > other.Count() && IsSupersetOf(other);
        }

        public bool Overlaps(HashSet<T> other)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (other.Contains(snapshot[i]))
                {
                    delete[] snapshot;
                    return true;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return false;
        }

        // Two sets of the same size where every element of one is in the other are equal sets
        // (no duplicates are possible within either one).
        public bool SetEquals(HashSet<T> other)
        {
            return Count() == other.Count() && IsSubsetOf(other);
        }

        // Mirrors HashSet<T>.RemoveWhere: removes every element matching `predicate`, returns how
        // many were removed.
        //
        // EN: Freeze 3.0 P2: the Predicate overload copies every element into a snapshot and into
        //     the predicate, so it requires `T : copy`; the InPredicate overload lends the elements
        //     in place.
        // ES: Congelamiento 3.0 P2: la sobrecarga con Predicate copia cada elemento a una instantanea y
        //     al predicado, asi que exige `T : copy`; la de InPredicate presta los elementos en su
        //     sitio.
        public int RemoveWhere(Predicate<T> predicate) where T : copy
        {
            const T[] snapshot = items.Keys();
            int removed = 0;
            int i = 0;
            while (i < snapshot.Length)
            {
                if (predicate(snapshot[i]))
                {
                    items.Remove(snapshot[i]);
                    removed = removed + 1;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return removed;
        }

        public int RemoveWhere(InPredicate<T> predicate)
        {
            return items.RemoveKeysWhere(predicate);
        }

        // Mirrors HashSet<T>.TryGetValue: returns the actual stored element structurally equal to
        // `equalValue` (useful when T's `==` doesn't imply full reference identity -- see
        // Delegates.ns). Dictionary<TKey,TValue> only exposes value lookup by key, not "find the
        // canonical stored key", so this is an O(n) scan rather than O(1) -- a documented
        // simplification, not a correctness issue.
        public bool TryGetValue(T equalValue, T[] result)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (snapshot[i] == equalValue)
                {
                    result[0] = snapshot[i];
                    delete[] snapshot;
                    return true;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return false;
        }

        // EN: Freeze 3.0 P2: same split as RemoveWhere.
        // ES: Congelamiento 3.0 P2: la misma division que RemoveWhere.
        public void ForEach(Action<T> action) where T : copy
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                action(snapshot[i]);
                i = i + 1;
            }
            delete[] snapshot;
        }

        public void ForEach(InAction<T> action)
        {
            items.ForEachKey(action);
        }

        // P1.2 of STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md. Unlike List<T>/Queue<T>/
        // Stack<T>, this is a SNAPSHOT enumerator, not a live-reference one: HashSet<T> is a thin
        // wrapper over Dictionary<T, bool> (see this class's own comment), and Dictionary's
        // internal bucket/entry/free-list layout has no stable "logical position i" to index by
        // the way an array-backed container does -- ToArray() (already used the same way by
        // ForEach() above) is the cheapest correct way to get one, at the cost of one array
        // allocation per `foreach`, matching the same idiom ForEach() already established.
        public owned HashSetEnumerator<T> GetEnumerator()
        {
            return new HashSetEnumerator<T>(this);
        }

        ~HashSet()
        {
            delete items;
        }
    }
}
