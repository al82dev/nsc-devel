namespace NativeSharp.Core.Collections.Generic
{
    // Enumerator returned by SortedSet<T>.GetEnumerator() (P1.2 of
    // STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md). See HashSetEnumerator.ns's class
    // comment -- identical shape, just over SortedSet<T>.ToArray() (already sorted order)
    // instead of HashSet<T>.ToArray().
    public class SortedSetEnumerator<T>
    {
        private T[] snapshot;
        private int index;

        // EN: Freeze 3.0 P3: the snapshot copies every element, so this enumerator exists only for a
        //     copyable element type (GetEnumerator carries the same constraint).
        // ES: Congelamiento 3.0 P3: la instantanea copia cada elemento, asi que este enumerador solo
        //     existe para un tipo de elemento copiable (GetEnumerator lleva el mismo constraint).
        public SortedSetEnumerator(SortedSet<T> sourceSet) where T : copy
        {
            snapshot = sourceSet.ToArray();
            index = -1;
        }

        public bool MoveNext()
        {
            index = index + 1;
            return index < snapshot.Length;
        }

        public T Current
        {
            get { return snapshot[index]; }
        }

        ~SortedSetEnumerator()
        {
            delete[] snapshot;
        }
    }
}
