using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // NativeSharp.Core.Collections.Generic.Algorithm -- Bloque 5, fase A. SHR-052.
    //
    // NUEVE FUNCIONES, NO DIECIOCHO. La lista no sale de copiar <algorithm>: sale de contar lo que
    // `src/` usa de verdad --find 13 · max 7 · min 5 · sort 2 · any_of 2 · y una cada uno reverse,
    // remove_if, find_if, all_of--. No hay operaciones de heap, ni partition, ni unique, porque no
    // se usan. Copiar la cabecera entera habria sido escribir el doble de codigo del que nadie
    // llama y que nadie prueba.
    //
    // POR QUE VIVE AQUI Y NO EN NativeSharp.Core. Predicate<T> y Comparison<T> estan en ESTE
    // paquete, y este paquete ya referencia a Core. Poner Algorithm en Core obligaria a que Core
    // referenciara a Collections.Generic: una dependencia circular. Ademas es donde vive
    // <algorithm> respecto de <vector> en cualquier biblioteca estandar.
    //
    // TODAS LAS LLAMADAS LLEVAN EL ARGUMENTO DE TIPO ESCRITO -- `Algorithm.Find<int>(v, 6)`, no
    // `Algorithm.Find(v, 6)`. NativeSharp no infiere argumentos de tipo en metodos genericos
    // estaticos; sin el, el error es "has no compatible member named 'Find'", que no dice que
    // falta. Medido antes de escribir la primera firma.
    //
    // Y TODO PREDICADO SE LIGA A UNA LOCAL ANTES DE PASARLO:
    //
    //     Predicate<int> esPar = EsPar;
    //     int donde = Algorithm.FindIf<int>(vista, esPar);
    //
    // Pasar el grupo de metodos directo en la llamada da "method group 'EsPar' can only be used as
    // a call target". No es una limitacion de esta clase: es del lenguaje, y se dice aqui para que
    // nadie la descubra en la linea de llamada.
    public class Algorithm
    {
        // --- BUSQUEDA -----------------------------------------------------------------------

        // Indice del primer elemento igual a `que`, o -1. Usa el `==` estructural de NativeSharp,
        // que para primitivos es comparacion de valor y para clases/structs es identidad o el
        // `operator ==` que el tipo defina -- lo mismo que hacen las colecciones de este paquete.
        //
        // EN: Freeze 3.0 P3: the elements are compared in place through the span's pointer; the
        //     indexer would copy each one and requires `T : copy`.
        // ES: Congelamiento 3.0 P3: los elementos se comparan en su lugar por el puntero del span; el
        //     indexador copiaria cada uno y exige `T : copy`.
        public static int Find<T>(ReadOnlySpan<T> donde, T que)
        {
            T* datos = donde.Data();
            int i = 0;
            while (i < donde.Length())
            {
                if (datos[i] == que) { return i; }
                i = i + 1;
            }
            return -1;
        }

        // Indice del primer elemento que cumple el predicado, o -1.
        //
        // EN: Freeze 3.0 P2: the by-value predicate copies each element, so these three overloads
        //     require `T : copy`; the InPredicate overloads read through a borrow and serve any T.
        // ES: Congelamiento 3.0 P2: el predicado por valor copia cada elemento, asi que estas tres
        //     sobrecargas exigen `T : copy`; las de InPredicate leen por prestamo y sirven para todo T.
        public static int FindIf<T>(ReadOnlySpan<T> donde, Predicate<T> condicion) where T : copy
        {
            int i = 0;
            while (i < donde.Length())
            {
                if (condicion(donde[i])) { return i; }
                i = i + 1;
            }
            return -1;
        }

        public static int FindIf<T>(ReadOnlySpan<T> donde, InPredicate<T> condicion)
        {
            T* datos = donde.Data();
            int i = 0;
            while (i < donde.Length())
            {
                if (condicion(in datos[i])) { return i; }
                i = i + 1;
            }
            return -1;
        }

        // Sobre un rango VACIO devuelve false, que es el convenio de std::any_of y el unico que
        // compone: "alguno cumple" sobre nada es falso.
        public static bool AnyOf<T>(ReadOnlySpan<T> donde, Predicate<T> condicion) where T : copy
        {
            int i = 0;
            while (i < donde.Length())
            {
                if (condicion(donde[i])) { return true; }
                i = i + 1;
            }
            return false;
        }

        public static bool AnyOf<T>(ReadOnlySpan<T> donde, InPredicate<T> condicion)
        {
            return FindIf<T>(donde, condicion) >= 0;
        }

        // Sobre un rango VACIO devuelve true -- verdad vacua, igual que std::all_of. Parece raro y
        // es lo correcto: "todos cumplen" sobre ningun elemento no tiene contraejemplo. Cambiarlo
        // romperia la propiedad de que dividir un rango en dos y preguntar por cada mitad da lo
        // mismo que preguntar por el entero.
        public static bool AllOf<T>(ReadOnlySpan<T> donde, Predicate<T> condicion) where T : copy
        {
            int i = 0;
            while (i < donde.Length())
            {
                if (!condicion(donde[i])) { return false; }
                i = i + 1;
            }
            return true;
        }

        public static bool AllOf<T>(ReadOnlySpan<T> donde, InPredicate<T> condicion)
        {
            T* datos = donde.Data();
            int i = 0;
            while (i < donde.Length())
            {
                if (!condicion(in datos[i])) { return false; }
                i = i + 1;
            }
            return true;
        }

        // --- MINIMO Y MAXIMO ----------------------------------------------------------------

        // Sobre DOS valores, no sobre un rango, porque asi es como se usan las doce llamadas de
        // `src/`. Un Min/Max sobre un span seria una funcion mas que nadie llama.
        //
        // Empate: devuelve `a`. Es el convenio de std::min/std::max y no es indiferente cuando T
        // tiene identidad --dos objetos "iguales" que no son el mismo--; quedando escrito, el
        // resultado es predecible.
        public static T Min<T>(T a, T b)
        {
            if (b < a) { return b; }
            return a;
        }

        public static T Max<T>(T a, T b)
        {
            if (a < b) { return b; }
            return a;
        }

        // --- TRANSFORMACION EN SITIO --------------------------------------------------------

        // EN: Freeze 3.0 P2: Reverse, RemoveIf and every Sort move elements only by swapping them
        //     (Intercambiar), never by copying, so they serve a move-only T. Elements are read
        //     through `Data()`, as `in` borrows.
        // ES: Congelamiento 3.0 P2: Reverse, RemoveIf y todo Sort mueven elementos solo
        //     intercambiandolos (Intercambiar), nunca copiandolos, asi que sirven para un T move-only.
        //     Los elementos se leen por `Data()`, como prestamos `in`.
        public static void Reverse<T>(Span<T> datos)
        {
            if (datos.Length() < 2) { return; }
            T* elementos = datos.Data();
            int izquierda = 0;
            int derecha = datos.Length() - 1;
            while (izquierda < derecha)
            {
                Intercambiar<T>(elementos, izquierda, derecha);
                izquierda = izquierda + 1;
                derecha = derecha - 1;
            }
        }

        // Compacta hacia el principio los elementos que NO cumplen el predicado y devuelve cuantos
        // quedan.
        //
        // EN: Freeze 3.0 P2: the compaction swaps, so the removed elements end up behind the new
        //     length, intact, in an unspecified order -- std::remove_if's tail is also valid but
        //     unspecified. Before, the tail kept stale copies; for a T with a destructor that would
        //     have destroyed some values twice and others never.
        // ES: Congelamiento 3.0 P2: la compactacion intercambia, asi que los elementos quitados
        //     quedan detras de la nueva longitud, intactos y en orden sin especificar -- la cola de
        //     std::remove_if tambien es valida pero sin especificar. Antes la cola guardaba copias
        //     viejas; con un T con destructor algunos valores se habrian destruido dos veces y otros
        //     nunca.
        //
        // DEVUELVE LA NUEVA LONGITUD Y NO UN ITERADOR. std::remove_if devuelve el nuevo final y el
        // llamador hace erase(); aqui no hay iteradores, y un entero lleva la misma informacion sin
        // inventar un tipo para transportarla.
        public static int RemoveIf<T>(Span<T> datos, Predicate<T> condicion) where T : copy
        {
            if (datos.Length() == 0) { return 0; }
            T* elementos = datos.Data();
            int escribir = 0;
            int leer = 0;
            while (leer < datos.Length())
            {
                if (!condicion(elementos[leer]))
                {
                    if (escribir != leer) { Intercambiar<T>(elementos, escribir, leer); }
                    escribir = escribir + 1;
                }
                leer = leer + 1;
            }
            return escribir;
        }

        public static int RemoveIf<T>(Span<T> datos, InPredicate<T> condicion)
        {
            if (datos.Length() == 0) { return 0; }
            T* elementos = datos.Data();
            int escribir = 0;
            int leer = 0;
            while (leer < datos.Length())
            {
                if (!condicion(in elementos[leer]))
                {
                    if (escribir != leer) { Intercambiar<T>(elementos, escribir, leer); }
                    escribir = escribir + 1;
                }
                leer = leer + 1;
            }
            return escribir;
        }

        // --- ORDENACION ---------------------------------------------------------------------

        // HEAPSORT, Y LA RAZON NO ES LA VELOCIDAD.
        //
        // O(n log n) GARANTIZADO, en sitio, y SIN RECURSION. Un quicksort medio es dos o tres veces
        // mas rapido, y tiene un peor caso cuadratico y una pila que crece con la entrada. Un
        // compilador ordenando tablas de simbolos prefiere que el peor caso sea el caso medio y no
        // tener ninguna profundidad de pila que estimar. Introsort daria lo mejor de los dos a
        // cambio de tres veces mas codigo, en un sitio donde el contenedor no puede ejecutar nada
        // para comprobarlo.
        //
        // NO ES ESTABLE, y std::sort tampoco, asi que no se pierde ninguna garantia que el codigo
        // de origen tuviera.
        //
        // SOBRECARGA DE Sort, desde el 2026-09-03. Aqui hubo un `SortWith` con este comentario:
        //
        //     "SortWith Y NO UNA SOBRECARGA DE Sort. ID 132: las plantillas genericas se
        //      identifican por nombre + ARIDAD GENERICA, no por lista de parametros, asi que
        //      Sort<T>(span) y Sort<T>(span, cmp) chocarian con duplicate generic template
        //      identity. Se rodea renombrando."
        //
        // El ID 132 se cerro: la identidad de una plantilla generica incluye ahora la CUENTA DE
        // PARAMETROS DE VALOR, asi que las dos conviven y el rodeo sobra. Un nombre peor que
        // sobrevive al motivo que lo justificaba es deuda disfrazada de decision.
        //
        // EN: Freeze 3.0 P2: Sort(span, Comparison) and Sort(span, InComparison) have the same
        //     count and differ in the delegate type; measured on 2026-10-26, overload resolution
        //     picks by that type (a lambda's parameter modes included). Sort(span) compares with
        //     T's `<` on borrowed elements, so `operator <(in T, in T)` sorts a move-only T.
        // ES: Congelamiento 3.0 P2: Sort(span, Comparison) y Sort(span, InComparison) tienen la misma
        //     cuenta y difieren en el tipo del delegado; medido el 2026-10-26, la resolucion de
        //     sobrecargas elige por ese tipo (incluidos los modos de parametro de una lambda).
        //     Sort(span) compara con el `<` de T sobre elementos prestados, asi que
        //     `operator <(in T, in T)` ordena un T move-only.
        public static void Sort<T>(Span<T> datos)
        {
            int cuantos = datos.Length();
            if (cuantos < 2) { return; }
            T* elementos = datos.Data();

            // Construir el monticulo: se hunde cada nodo interno, del ultimo al primero. El ultimo
            // nodo interno es (n/2 - 1); las hojas ya son monticulos de un elemento.
            int i = cuantos / 2 - 1;
            while (i >= 0)
            {
                Hundir<T>(elementos, i, cuantos);
                i = i - 1;
            }

            // Extraer: el mayor esta en la raiz, va al final, y se rehace el monticulo con uno
            // menos. Cuando el monticulo se queda en uno, el arreglo esta ordenado.
            int fin = cuantos - 1;
            while (fin > 0)
            {
                Intercambiar<T>(elementos, 0, fin);
                Hundir<T>(elementos, 0, fin);
                fin = fin - 1;
            }
        }

        public static void Sort<T>(Span<T> datos, Comparison<T> comparador) where T : copy
        {
            int cuantos = datos.Length();
            if (cuantos < 2) { return; }
            T* elementos = datos.Data();
            int i = cuantos / 2 - 1;
            while (i >= 0)
            {
                HundirCon<T>(elementos, i, cuantos, comparador);
                i = i - 1;
            }
            int fin = cuantos - 1;
            while (fin > 0)
            {
                Intercambiar<T>(elementos, 0, fin);
                HundirCon<T>(elementos, 0, fin, comparador);
                fin = fin - 1;
            }
        }

        public static void Sort<T>(Span<T> datos, InComparison<T> comparador)
        {
            int cuantos = datos.Length();
            if (cuantos < 2) { return; }
            T* elementos = datos.Data();
            int i = cuantos / 2 - 1;
            while (i >= 0)
            {
                HundirConIn<T>(elementos, i, cuantos, comparador);
                i = i - 1;
            }
            int fin = cuantos - 1;
            while (fin > 0)
            {
                Intercambiar<T>(elementos, 0, fin);
                HundirConIn<T>(elementos, 0, fin, comparador);
                fin = fin - 1;
            }
        }

        // Stable insertion sort for small compiler and tooling tables. Equal elements keep their
        // discovery order because an element only passes strictly greater predecessors. The
        // implementation is iterative and deliberately exposes its O(n^2) cost instead of
        // pretending that the heap-based Sort overload is stable.
        //
        // EN: Freeze 3.0 P2: the element walks left by adjacent swaps instead of being held in a
        //     copy while the greater predecessors shift right; the comparisons and the result are
        //     the same.
        // ES: Congelamiento 3.0 P2: el elemento avanza a la izquierda por intercambios adyacentes en
        //     vez de guardarse en una copia mientras los predecesores mayores se corren a la derecha;
        //     las comparaciones y el resultado son los mismos.
        public static void StableSort<T>(Span<T> datos, Comparison<T> comparador) where T : copy
        {
            if (datos.Length() < 2) { return; }
            T* elementos = datos.Data();
            int i = 1;
            while (i < datos.Length())
            {
                int destino = i;
                while (destino > 0 && comparador(elementos[destino], elementos[destino - 1]) < 0)
                {
                    Intercambiar<T>(elementos, destino, destino - 1);
                    destino = destino - 1;
                }
                i = i + 1;
            }
        }

        public static void StableSort<T>(Span<T> datos, InComparison<T> comparador)
        {
            if (datos.Length() < 2) { return; }
            T* elementos = datos.Data();
            int i = 1;
            while (i < datos.Length())
            {
                int destino = i;
                while (destino > 0 &&
                       comparador(in elementos[destino], in elementos[destino - 1]) < 0)
                {
                    Intercambiar<T>(elementos, destino, destino - 1);
                    destino = destino - 1;
                }
                i = i + 1;
            }
        }

        // EN: Swaps the bytes of two elements: a relocation, so nothing is copied or destroyed. A
        //     swap through `move` cannot be written here: storing through a `T*` destroys the value
        //     it overwrites, and the slot `move` just emptied still holds a zeroed T, so every swap
        //     would run the destructor twice on an empty value (measured, 2026-10-26). The bytes are
        //     exchanged eight or four at a time when the size allows.
        // ES: Intercambia los bytes de dos elementos: una reubicacion, asi que nada se copia ni se
        //     destruye. Un intercambio con `move` no se puede escribir aqui: guardar por un `T*`
        //     destruye el valor que sobrescribe, y el hueco que `move` acaba de vaciar aun tiene un T
        //     en cero, asi que cada intercambio correria dos veces el destructor sobre un valor vacio
        //     (medido, 2026-10-26). Los bytes se intercambian de ocho o de cuatro en cuatro cuando el
        //     tamano lo permite.
        private static void Intercambiar<T>(T* elementos, int a, int b)
        {
            int tamano = (int)sizeof(T);
            if (tamano % 8 == 0)
            {
                IntercambiarPalabras((long*)(elementos + a), (long*)(elementos + b), tamano / 8);
                return;
            }
            if (tamano % 4 == 0)
            {
                IntercambiarMedias((int*)(elementos + a), (int*)(elementos + b), tamano / 4);
                return;
            }
            byte* x = (byte*)(elementos + a);
            byte* y = (byte*)(elementos + b);
            int i = 0;
            while (i < tamano)
            {
                byte t = x[i];
                x[i] = y[i];
                y[i] = t;
                i = i + 1;
            }
        }

        private static void IntercambiarPalabras(long* x, long* y, int cuantas)
        {
            int i = 0;
            while (i < cuantas)
            {
                long t = x[i];
                x[i] = y[i];
                y[i] = t;
                i = i + 1;
            }
        }

        private static void IntercambiarMedias(int* x, int* y, int cuantas)
        {
            int i = 0;
            while (i < cuantas)
            {
                int t = x[i];
                x[i] = y[i];
                y[i] = t;
                i = i + 1;
            }
        }

        // Baja el elemento de `raiz` hasta que los dos hijos sean menores o iguales. `limite` es
        // cuantos elementos del principio siguen formando parte del monticulo -- lo demas ya esta
        // colocado al final y no se toca.
        //
        // Iterativo y no recursivo: es la propiedad que hace que este sort no tenga profundidad de
        // pila. Escrito una vez por variante en vez de con un comparador por omision, porque
        // NativeSharp no tiene valores por omision de parametro y envolver `<` en un delegado
        // costaria una llamada indirecta por comparacion.
        private static void Hundir<T>(T* datos, int raiz, int limite)
        {
            int actual = raiz;
            while (true)
            {
                int mayor = actual;
                int izquierdo = 2 * actual + 1;
                int derecho = izquierdo + 1;

                if (izquierdo < limite && datos[mayor] < datos[izquierdo])
                {
                    mayor = izquierdo;
                }
                if (derecho < limite && datos[mayor] < datos[derecho])
                {
                    mayor = derecho;
                }
                if (mayor == actual) { return; }

                Intercambiar<T>(datos, actual, mayor);
                actual = mayor;
            }
        }

        private static void HundirCon<T>(T* datos, int raiz, int limite, Comparison<T> comparador)
            where T : copy
        {
            int actual = raiz;
            while (true)
            {
                int mayor = actual;
                int izquierdo = 2 * actual + 1;
                int derecho = izquierdo + 1;

                if (izquierdo < limite && comparador(datos[mayor], datos[izquierdo]) < 0)
                {
                    mayor = izquierdo;
                }
                if (derecho < limite && comparador(datos[mayor], datos[derecho]) < 0)
                {
                    mayor = derecho;
                }
                if (mayor == actual) { return; }

                Intercambiar<T>(datos, actual, mayor);
                actual = mayor;
            }
        }

        private static void HundirConIn<T>(
            T* datos, int raiz, int limite, InComparison<T> comparador)
        {
            int actual = raiz;
            while (true)
            {
                int mayor = actual;
                int izquierdo = 2 * actual + 1;
                int derecho = izquierdo + 1;

                if (izquierdo < limite && comparador(in datos[mayor], in datos[izquierdo]) < 0)
                {
                    mayor = izquierdo;
                }
                if (derecho < limite && comparador(in datos[mayor], in datos[derecho]) < 0)
                {
                    mayor = derecho;
                }
                if (mayor == actual) { return; }

                Intercambiar<T>(datos, actual, mayor);
                actual = mayor;
            }
        }
    }
}
