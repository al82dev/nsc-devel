using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.SortedSet<T> -- a thin wrapper around
    // SortedList<T, bool>, exactly like HashSet<T> wraps Dictionary<T, bool> (see its class
    // comment). The `bool` stored alongside each element is a fixed, meaningless placeholder
    // (always `true`), never surfaced through this class's own API.
    //
    // Real C#'s SortedSet<T> is a red-black tree, same as SortedDictionary<TKey,TValue> --
    // see SortedDictionary.ns's class comment for why this package uses a sorted array instead
    // (a deliberate, documented simplification: O(n) Add/Remove instead of O(log n), full sorted
    // order and API surface otherwise). T needs only `operator <` (SortedList<T, bool>'s own
    // requirement), never `==`/`GetHashCode()`.
    public class SortedSet<T>
    {
        private SortedList<T, bool> items;

        public SortedSet()
        {
            items = new SortedList<T, bool>();
        }

        public SortedSet(int capacity)
        {
            items = new SortedList<T, bool>(capacity);
        }

        // Mirrors real C#'s SortedSet<T>(IComparer<T>) -- see SortedList.ns's own
        // `Comparison<T>` constructor for why a delegate stands in for IComparer<T>.
        //
        // EN: Freeze 3.0 P2: the Comparison constructor requires `T : copy` (see SortedList); the
        //     InComparison one serves any T.
        // ES: Congelamiento 3.0 P2: el constructor con Comparison exige `T : copy` (ver SortedList); el
        //     de InComparison sirve para todo T.
        public SortedSet(Comparison<T> comparerFunc) where T : copy
        {
            items = new SortedList<T, bool>(comparerFunc);
        }

        public SortedSet(InComparison<T> comparerFunc)
        {
            items = new SortedList<T, bool>(comparerFunc);
        }

        public int Count()
        {
            return items.Count();
        }

        public int EnsureCapacity(int capacity)
        {
            return items.EnsureCapacity(capacity);
        }

        public void TrimExcess()
        {
            items.TrimExcess();
        }

        // Mirrors real C#'s SortedSet<T>.Add: returns whether `value` was actually a NEW element
        // (false if it was already present).
        public bool Add(owned T value)
        {
            if (items.ContainsKey(value))
            {
                delete value;
                return false;
            }
            items.AddOrUpdate(move(value), true);
            return true;
        }

        public bool Contains(T value)
        {
            return items.ContainsKey(value);
        }

        public bool Remove(T value)
        {
            return items.Remove(value);
        }

        public void Clear()
        {
            items.Clear();
        }

        // O(1): the backing SortedList<T, bool> keeps its keys sorted at all times, so the
        // element at a given position is already known without any extra work.
        public T Min() throws InvalidOperationException
        {
            if (items.Count() == 0)
            {
                throw new InvalidOperationException();
            }
            return items.KeyAt(0);
        }

        public T Max() throws InvalidOperationException
        {
            if (items.Count() == 0)
            {
                throw new InvalidOperationException();
            }
            return items.KeyAt(items.Count() - 1);
        }

        public T[] ToArray()
        {
            return items.Keys();
        }

        // Mirrors SortedSet<T>.Reverse: an enumeration of elements from Max to Min, as a snapshot
        // array (see the class comment on ToArray()'s own snapshot semantics -- NativeSharp has no
        // IEnumerable<T>/lazy enumerator, so a reversed-order array is the ownership-safe
        // equivalent).
        public T[] Reverse()
        {
            const T[] ascending = items.Keys();
            const T[] result = new T[ascending.Length];
            int i = 0;
            while (i < ascending.Length)
            {
                result[i] = ascending[ascending.Length - 1 - i];
                i = i + 1;
            }
            delete[] ascending;
            return result;
        }

        // Mirrors SortedSet<T>.GetViewBetween: a snapshot SNAPSHOT of every element in
        // [lowerValue, upperValue] (inclusive), NOT a live view -- real C#'s GetViewBetween
        // returns a window still linked to the original set (mutating one mutates the other);
        // NativeSharp has no way to express that kind of aliasing safely without a GC (the same
        // reasoning List.ns's GetRange()/ToArray() class comments already give), so this returns a
        // brand-new SortedSet<T> with its own copies instead. Uses T's own `<` for the bounds test
        // even when this set was constructed with a custom comparer (a documented simplification --
        // see the class comment on T needing only `<`).
        //
        // Freeze 3.0 (C-01): the snapshot is a new set the caller owns, so the return is `owned`
        // and the caller binds it to a raii local.
        public owned SortedSet<T> GetViewBetween(T lowerValue, T upperValue)
        {
            raii SortedSet<T> result = new SortedSet<T>();
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!(snapshot[i] < lowerValue) && !(upperValue < snapshot[i]))
                {
                    result.Add(snapshot[i]);
                }
                i = i + 1;
            }
            delete[] snapshot;
            return move(result);
        }

        // Mirrors SortedSet<T>.RemoveWhere: removes every element matching `predicate`, returns how
        // many were removed.
        //
        // EN: Freeze 3.0 P2: the Predicate overload copies every element into a snapshot and into
        //     the predicate, so it requires `T : copy`; the InPredicate overload lends the elements
        //     in place.
        // ES: Congelamiento 3.0 P2: la sobrecarga con Predicate copia cada elemento a una instantanea y
        //     al predicado, asi que exige `T : copy`; la de InPredicate presta los elementos en su
        //     sitio.
        public int RemoveWhere(Predicate<T> predicate) where T : copy
        {
            const T[] snapshot = items.Keys();
            int removed = 0;
            int i = 0;
            while (i < snapshot.Length)
            {
                if (predicate(snapshot[i]))
                {
                    items.Remove(snapshot[i]);
                    removed = removed + 1;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return removed;
        }

        public int RemoveWhere(InPredicate<T> predicate)
        {
            return items.RemoveKeysWhere(predicate);
        }

        // Same cross-set ownership caveat as HashSet<T>.UnionWith -- see its comment.
        public void UnionWith(SortedSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!items.ContainsKey(snapshot[i]))
                {
                    items.AddOrUpdate(snapshot[i], true);
                }
                i = i + 1;
            }
            delete[] snapshot;
        }

        public void IntersectWith(SortedSet<T> other)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!other.Contains(snapshot[i]))
                {
                    items.Remove(snapshot[i]);
                }
                i = i + 1;
            }
            delete[] snapshot;
        }

        public void ExceptWith(SortedSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                items.Remove(snapshot[i]);
                i = i + 1;
            }
            delete[] snapshot;
        }

        // Same cross-set ownership caveat as HashSet<T>.UnionWith for the elements it adds.
        public void SymmetricExceptWith(SortedSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (items.ContainsKey(snapshot[i]))
                {
                    items.Remove(snapshot[i]);
                }
                else
                {
                    items.AddOrUpdate(snapshot[i], true);
                }
                i = i + 1;
            }
            delete[] snapshot;
        }

        public bool IsSubsetOf(SortedSet<T> other)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!other.Contains(snapshot[i]))
                {
                    delete[] snapshot;
                    return false;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return true;
        }

        public bool IsProperSubsetOf(SortedSet<T> other)
        {
            return Count() < other.Count() && IsSubsetOf(other);
        }

        public bool IsSupersetOf(SortedSet<T> other)
        {
            const T[] snapshot = other.ToArray();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (!items.ContainsKey(snapshot[i]))
                {
                    delete[] snapshot;
                    return false;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return true;
        }

        public bool IsProperSupersetOf(SortedSet<T> other)
        {
            return Count() > other.Count() && IsSupersetOf(other);
        }

        public bool Overlaps(SortedSet<T> other)
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                if (other.Contains(snapshot[i]))
                {
                    delete[] snapshot;
                    return true;
                }
                i = i + 1;
            }
            delete[] snapshot;
            return false;
        }

        public bool SetEquals(SortedSet<T> other)
        {
            return Count() == other.Count() && IsSubsetOf(other);
        }

        // EN: Freeze 3.0 P2: same split as RemoveWhere.
        // ES: Congelamiento 3.0 P2: la misma division que RemoveWhere.
        public void ForEach(Action<T> action) where T : copy
        {
            const T[] snapshot = items.Keys();
            int i = 0;
            while (i < snapshot.Length)
            {
                action(snapshot[i]);
                i = i + 1;
            }
            delete[] snapshot;
        }

        public void ForEach(InAction<T> action)
        {
            items.ForEachKey(action);
        }

        // P1.2 of STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md -- see
        // HashSet<T>.GetEnumerator()'s comment for why this is snapshot-based (via the already
        // sorted ToArray()) rather than a live indexer: SortedSet<T> wraps SortedList<T, bool>
        // the same way HashSet<T> wraps Dictionary<T, bool>.
        public owned SortedSetEnumerator<T> GetEnumerator()
        {
            return new SortedSetEnumerator<T>(this);
        }

        ~SortedSet()
        {
            delete items;
        }
    }
}
