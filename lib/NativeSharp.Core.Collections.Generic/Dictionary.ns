using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.Dictionary<TKey,TValue> -- a hash table with separate
    // chaining, structurally close to the CLR's own internal Dictionary<TKey,TValue> layout:
    // `buckets[hash % buckets.Length]` holds the index of the first entry in that bucket's
    // chain, and `entryNext[i]` links entry `i` to the next entry in the SAME bucket (-1 ends
    // the chain). Two differences from the CLR's version, both deliberate simplifications
    // documented here and in the Stage 52 didactic writeup:
    //   - Bucket-array growth doubles capacity (matching every other container in this package,
    //     e.g. List<T>.EnsureCapacity) instead of stepping through prime sizes. A doubling table
    //     size makes `hash % buckets.Length` more collision-prone for hash functions that are
    //     themselves multiples of a power of two, which the real CLR's prime sizing avoids --
    //     acceptable here given this package's Hashing.ns functions are not exposed as
    //     adversarial-input-hardened anyway.
    //   - A resize (Grow()) COMPACTS: every live entry gets a fresh, dense slot instead of
    //     preserving free-list holes across the table-size change. This trades a little copying
    //     (no worse than List<T>.EnsureCapacity's own O(n) relocation) for a resize step with no
    //     separate "carry the free list across resize" bookkeeping at all.
    //
    // Ownership design (see List.ns's class comment for the general story this package follows):
    //   - `entryKeys`/`entryValues` are `owned TKey[]`/`owned TValue[]` -- the dictionary owns
    //     every stored key and value, freed via `delete` (a no-op for a value-typed TKey/TValue,
    //     a real free for a reference-typed one) on Remove/Clear/the destructor/a Grow() that
    //     relocates a slot away.
    //   - `buckets`/`entryHashCodes`/`entryNext` are plain (non-owned) `int[]` bookkeeping
    //     arrays -- see the class comment on List.ns's `ToArray()`/`CopyTo()` for why a
    //     non-generic, non-owned array still needs an explicit `delete[]` when replaced: there is
    //     no GC to reclaim the backing allocation for it.
    //   - `Add(owned TKey, owned TValue)` mirrors real C#'s Add -- throws ArgumentException on a
    //     duplicate key, exactly like the CLR's Dictionary<TKey,TValue>.Add. `AddOrUpdate` is the
    //     ownership-aware add-or-replace path. Unlike List<T>, a Dictionary indexer setter would
    //     receive an owned VALUE but only a borrowed KEY, so it still could not safely add a
    //     missing reference-typed key. `AddOrUpdate` explicitly consumes both; `SetValue` updates
    //     an existing key while consuming only the replacement value.
    //   - `Keys()`/`Values()`/`ToArray()` return plain (non-owned) snapshot arrays, deliberately
    //     NOT owned -- exactly like List<T>.ToArray(), see its class comment for why that is safe
    //     here without a GC.
    //
    // Aggregate ABI: NativeSharp 3.0 now lowers non-direct structs through Win64 sret, so a
    // KeyValuePair<TKey,TValue> larger than eight bytes is a valid first-class Current value.
    // GetEnumerator returns a snapshot enumerator whose array block is owned by the enumerator
    // and whose pair fields are non-owning aliases. It neither copies the dictionary owner nor
    // transfers keys/values; the dictionary must outlive the loop.
    //
    // Equality/hashing: structural `==` remains the equality operation. Default constructors
    // select Hashing.Default for integral, native-integer, bool, char and string keys. Custom
    // class/struct keys and floating-point policies stay explicit through HashFunc<TKey>; there
    // is deliberately no guessed universal object hash.
    public class Dictionary<TKey, TValue>
    {
        private HashFunc<TKey> hasher;
        private int[] buckets;
        private int[] entryHashCodes;
        private int[] entryNext;
        private owned TKey[] entryKeys;
        private owned TValue[] entryValues;
        private int count;
        private int freeFirst;
        private int freeCount;

        // Available when TKey has one of Hashing.Default's stable built-in overloads. A custom
        // class/struct or floating-point key deliberately fails overload resolution here and must
        // use the explicit HashFunc<TKey> constructor below.
        public Dictionary()
        {
            hasher = Hashing.Default;
            Initialize(4);
        }

        public Dictionary(int capacity)
        {
            hasher = Hashing.Default;
            int actual = capacity;
            if (actual < 1) { actual = 1; }
            Initialize(actual);
        }

        // EN: Freeze 3.0 P2: a HashFunc<TKey> receives a copy of the key, so these constructors
        //     require `TKey : copy`.
        // ES: Congelamiento 3.0 P2: un HashFunc<TKey> recibe una copia de la clave, asi que estos
        //     constructores exigen `TKey : copy`.
        public Dictionary(HashFunc<TKey> hashFunc) where TKey : copy
        {
            hasher = hashFunc;
            Initialize(4);
        }

        public Dictionary(HashFunc<TKey> hashFunc, int capacity) where TKey : copy
        {
            hasher = hashFunc;
            int actual = capacity;
            if (actual < 1) { actual = 1; }
            Initialize(actual);
        }

        private void Initialize(int capacity)
        {
            buckets = new int[capacity];
            entryHashCodes = new int[capacity];
            entryNext = new int[capacity];
            entryKeys = new TKey[capacity];
            entryValues = new TValue[capacity];
            count = 0;
            freeFirst = -1;
            freeCount = 0;
            ClearBucketSlots();
            ClearHashCodeSlots();
        }

        private void ClearBucketSlots()
        {
            int i = 0;
            while (i < buckets.Length)
            {
                buckets[i] = -1;
                i = i + 1;
            }
        }

        // A slot's hash code is always >= 0 (ComputeHash masks the sign bit off) while it holds a
        // live entry, so -1 unambiguously marks a slot as free/never-used -- the same trick
        // Remove() and Grow() both rely on to tell a live entry apart from a hole.
        private void ClearHashCodeSlots()
        {
            int i = 0;
            while (i < entryHashCodes.Length)
            {
                entryHashCodes[i] = -1;
                i = i + 1;
            }
        }

        public int Count()
        {
            return count - freeCount;
        }

        // Clears the sign bit instead of negating, so this is well-defined even for a hasher
        // that returns int.MinValue (negating int.MinValue overflows; masking never does).
        private int ComputeHash(TKey key)
        {
            return hasher(key) & 2147483647;
        }

        private int FindEntry(TKey key)
        {
            if (buckets.Length == 0) { return -1; }
            int hashCode = ComputeHash(key);
            int bucketIndex = hashCode % buckets.Length;
            int i = buckets[bucketIndex];
            while (i >= 0)
            {
                if (entryHashCodes[i] == hashCode && entryKeys[i] == key) { return i; }
                i = entryNext[i];
            }
            return -1;
        }

        public bool ContainsKey(TKey key)
        {
            return FindEntry(key) >= 0;
        }

        public bool ContainsValue(TValue value)
        {
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0 && entryValues[i] == value) { return true; }
                i = i + 1;
            }
            return false;
        }

        // Mirrors real C#'s `bool TryGetValue(TKey key, out TValue value)` -- except NativeSharp
        // has no `ref`/`out` parameters at all (a pre-existing, general language limitation,
        // unrelated to generics and out of this stage's scope -- see
        // claude/04_restricciones_arquitectonicas.md), and an EARLIER version of this method that
        // returned a small `Found`/`Value` struct by value instead ran into a SEPARATE, equally
        // pre-existing and equally general limitation: Stage 40's Windows x64 struct-return ABI
        // only lowers a direct (register/stack-passed) struct return for 1/2/4/8-byte aggregates,
        // and `{bool, TValue}` exceeds that the moment TValue is a reference type or a multi-field
        // struct. Neither limitation is specific to generics or to this stage (a plain, wholly
        // non-generic struct bigger than 8 bytes hits the very same ABI wall), so rather than grow
        // either restriction, this method uses the same caller-supplied-single-element-array idiom
        // this whole package already relies on elsewhere as an `out`-parameter stand-in: pass a
        // `TValue[]` of length (at least) 1, and slot 0 is written with the found value.
        // `result[0] = entryValues[index]` is a plain (non-owned) array-element write -- exactly
        // Keys()/Values()/ToArray()'s own snapshot-aliasing story, not an ownership transfer.
        //
        // EN: Freeze 3.0 P3: TryGetValue and the getter copy the value and require `TValue : copy`;
        //     Keys, Values, ToArray and the snapshot enumerator copy too.
        // ES: Congelamiento 3.0 P3: TryGetValue y el getter copian el valor y exigen `TValue : copy`;
        //     Keys, Values, ToArray y el enumerador por instantanea tambien copian.
        public bool TryGetValue(TKey key, TValue[] result) where TValue : copy
        {
            int index = FindEntry(key);
            if (index < 0) { return false; }
            result[0] = entryValues[index];
            return true;
        }

        // Language 3 collection accessors are total for compatibility with the official NSC.
        // Use TryGetValue when a stored default(TValue) must be distinguished from a missing key.
        public TValue this[TKey key]
        {
            get where TValue : copy
            {
                int index = FindEntry(key);
                if (index < 0)
                {
                    return default(TValue);
                }
                return entryValues[index];
            }
        }

        // Rehashes every live entry into a fresh, dense table of exactly `newCapacity` slots --
        // the shared compaction core behind both growth (Grow(), called with a bigger capacity)
        // and shrinking (TrimExcess(), called with a smaller one). See the class comment on why a
        // resize always compacts away Remove()'s free-list holes instead of preserving them.
        private void RehashTo(int newCapacity)
        {
            const TKey[] grownKeys = new TKey[newCapacity];
            const TValue[] grownValues = new TValue[newCapacity];
            int[] grownHashCodes = new int[newCapacity];
            int[] grownNext = new int[newCapacity];
            int[] grownBuckets = new int[newCapacity];

            int b = 0;
            while (b < newCapacity)
            {
                grownBuckets[b] = -1;
                b = b + 1;
            }

            int liveCount = 0;
            int j = 0;
            while (j < count)
            {
                if (entryHashCodes[j] >= 0)
                {
                    int hashCode = entryHashCodes[j];
                    int bucketIndex = hashCode % newCapacity;
                    grownHashCodes[liveCount] = hashCode;
                    grownKeys[liveCount] = move(entryKeys[j]);
                    grownValues[liveCount] = move(entryValues[j]);
                    grownNext[liveCount] = grownBuckets[bucketIndex];
                    grownBuckets[bucketIndex] = liveCount;
                    liveCount = liveCount + 1;
                }
                j = j + 1;
            }

            delete[] entryKeys;
            delete[] entryValues;
            delete[] entryHashCodes;
            delete[] entryNext;
            delete[] buckets;

            entryKeys = grownKeys;
            entryValues = grownValues;
            entryHashCodes = grownHashCodes;
            entryNext = grownNext;
            buckets = grownBuckets;
            count = liveCount;
            freeFirst = -1;
            freeCount = 0;
        }

        // Doubles capacity (or reaches a minimum of 4), same policy every other container in this
        // package uses for its own EnsureCapacity -- called by InsertNew() when the table is full.
        private void Grow()
        {
            int newCapacity = entryKeys.Length * 2;
            if (newCapacity < 4) { newCapacity = 4; }
            RehashTo(newCapacity);
        }

        // Public so callers can pre-size before a known-size batch of Add()s. Grows straight to
        // (at least) `capacity` -- unlike the internal doubling Grow() uses, this targets exactly
        // what the caller asked for, mirroring List<T>.EnsureCapacity's contract. Returns the
        // resulting capacity; a no-op, returning the current capacity, when already big enough.
        public int EnsureCapacity(int capacity)
        {
            if (entryKeys.Length >= capacity) { return entryKeys.Length; }
            RehashTo(capacity);
            return entryKeys.Length;
        }

        // Mirrors Dictionary<TKey,TValue>.TrimExcess: compacts down to (at least) the live entry
        // count when Count() is meaningfully smaller than Capacity -- same 90% threshold every
        // other container in this package uses for its own TrimExcess.
        public void TrimExcess()
        {
            int live = Count();
            int threshold = (entryKeys.Length * 9) / 10;
            if (live >= threshold) { return; }
            int newCapacity = live;
            if (newCapacity < 1) { newCapacity = 1; }
            if (newCapacity == entryKeys.Length) { return; }
            RehashTo(newCapacity);
        }

        // Allocates a fresh slot for a brand-new entry (either reusing a Remove()d hole, or
        // growing/appending), WITHOUT checking for a duplicate key -- shared by Add() (which
        // checks first) and AddOrUpdate() (which only reaches here once FindEntry has already
        // confirmed the key is absent).
        private void InsertNew(owned TKey key, owned TValue value, int hashCode)
        {
            int slot;
            if (freeCount > 0)
            {
                slot = freeFirst;
                freeFirst = entryNext[slot];
                freeCount = freeCount - 1;
            }
            else
            {
                if (count == entryKeys.Length)
                {
                    Grow();
                }
                slot = count;
                count = count + 1;
            }

            int bucketIndex = hashCode % buckets.Length;
            entryHashCodes[slot] = hashCode;
            entryNext[slot] = buckets[bucketIndex];
            // move(key)/move(value): see List.ns's Add() for the full explanation -- InsertNew's
            // own `key`/`value` parameters are owned, and without move() here their automatic
            // end-of-scope cleanup double-frees the very key/value just stored in the table.
            entryKeys[slot] = move(key);
            entryValues[slot] = move(value);
            buckets[bucketIndex] = slot;
        }

        // Mirrors real C#'s Dictionary<TKey,TValue>.Add: throws ArgumentException if `key` is
        // already present, exactly like the CLR's Dictionary<TKey,TValue>.
        public void Add(owned TKey key, owned TValue value) throws ArgumentException
        {
            int hashCode = ComputeHash(key);
            if (FindEntry(key) >= 0)
            {
                throw new ArgumentException();
            }
            InsertNew(move(key), move(value), hashCode);
        }

        // Mirrors Dictionary<TKey,TValue>.TryAdd: same as Add(), but returns false instead of
        // throwing when `key` is already present. `value` is freed (a no-op for a value-typed
        // TValue) rather than leaked when the add is rejected, since the caller has already
        // handed over ownership by calling this method with `owned TValue value`.
        public bool TryAdd(owned TKey key, owned TValue value)
        {
            int hashCode = ComputeHash(key);
            if (FindEntry(key) >= 0)
            {
                delete key;
                delete value;
                return false;
            }
            InsertNew(move(key), move(value), hashCode);
            return true;
        }

        // The `owned`-argument-friendly stand-in for real C#'s indexer setter (`d[key] = value;`)
        // -- see the class comment for why NativeSharp cannot give the indexer itself an owned
        // setter parameter. Adds a brand-new entry, or replaces an existing one's value (freeing
        // the value it displaces, and discarding the now-redundant freshly-owned `key` argument
        // since the dictionary already owns the stored key for an existing entry).
        public void AddOrUpdate(owned TKey key, owned TValue value)
        {
            int hashCode = ComputeHash(key);
            int index = FindEntry(key);
            if (index >= 0)
            {
                delete entryValues[index];
                // move(value): see List.ns's Add() for the full explanation.
                entryValues[index] = move(value);
                delete key;
                return;
            }
            InsertNew(move(key), move(value), hashCode);
        }

        // Replaces the value of an ALREADY-PRESENT key (throws KeyNotFoundException otherwise) --
        // the common "update" case, needing no ownership of the key at all since the dictionary
        // already owns the one it has stored.
        public void SetValue(TKey key, owned TValue value) throws KeyNotFoundException
        {
            int index = FindEntry(key);
            if (index < 0)
            {
                throw new KeyNotFoundException();
            }
            delete entryValues[index];
            // move(value): see List.ns's Add() for the full explanation.
            entryValues[index] = move(value);
        }

        public bool Remove(TKey key)
        {
            if (buckets.Length == 0) { return false; }
            int hashCode = ComputeHash(key);
            int bucketIndex = hashCode % buckets.Length;
            int previous = -1;
            int i = buckets[bucketIndex];
            while (i >= 0)
            {
                if (entryHashCodes[i] == hashCode && entryKeys[i] == key)
                {
                    if (previous < 0)
                    {
                        buckets[bucketIndex] = entryNext[i];
                    }
                    else
                    {
                        entryNext[previous] = entryNext[i];
                    }
                    delete entryKeys[i];
                    delete entryValues[i];
                    entryHashCodes[i] = -1;
                    entryNext[i] = freeFirst;
                    freeFirst = i;
                    freeCount = freeCount + 1;
                    return true;
                }
                previous = i;
                i = entryNext[i];
            }
            return false;
        }

        public void Clear()
        {
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0)
                {
                    delete entryKeys[i];
                    delete entryValues[i];
                }
                i = i + 1;
            }
            ClearBucketSlots();
            ClearHashCodeSlots();
            count = 0;
            freeFirst = -1;
            freeCount = 0;
        }

        public TKey[] Keys() where TKey : copy
        {
            const TKey[] result = new TKey[Count()];
            int outIndex = 0;
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0)
                {
                    result[outIndex] = entryKeys[i];
                    outIndex = outIndex + 1;
                }
                i = i + 1;
            }
            return result;
        }

        public TValue[] Values() where TValue : copy
        {
            const TValue[] result = new TValue[Count()];
            int outIndex = 0;
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0)
                {
                    result[outIndex] = entryValues[i];
                    outIndex = outIndex + 1;
                }
                i = i + 1;
            }
            return result;
        }

        // The returned snapshot aliases the dictionary's keys/values; it owns no element.
        public KeyValuePair<TKey, TValue>[] ToArray() where TKey : copy where TValue : copy
        {
            const KeyValuePair<TKey, TValue>[] result = new KeyValuePair<TKey, TValue>[Count()];
            int outIndex = 0;
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0)
                {
                    result[outIndex].Key = entryKeys[i];
                    result[outIndex].Value = entryValues[i];
                    outIndex = outIndex + 1;
                }
                i = i + 1;
            }
            return result;
        }

        // Snapshot enumerator. The snapshot allocation is owned by the enumerator, but each
        // Key/Value in it is a plain non-owning alias into this dictionary. Thus foreach never
        // copies the dictionary owner or transfers an element; the dictionary must outlive the
        // loop. Mutations after GetEnumerator() do not change the sequence being visited.
        public owned DictionaryEnumerator<TKey, TValue> GetEnumerator() where TKey : copy where TValue : copy
        {
            return new DictionaryEnumerator<TKey, TValue>(this);
        }

        // Two plain (key, value) parameters rather than one `KeyValuePair<TKey,TValue>` parameter
        // -- see the class comment for why: this sidesteps Stage 40's struct-size ABI limitation
        // entirely (two plain values are never at risk of it, however large TKey/TValue are).
        //
        // EN: Freeze 3.0 P2: the action receives copies of the key and the value.
        // ES: Congelamiento 3.0 P2: la accion recibe copias de la clave y del valor.
        public void ForEach(KeyValueAction<TKey, TValue> action) where TKey : copy where TValue : copy
        {
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0)
                {
                    action(entryKeys[i], entryValues[i]);
                }
                i = i + 1;
            }
        }

        // EN: Freeze 3.0 P2: lends every live key to `action`, in entry order. HashSet<T>.ForEach
        //     (InAction<T>) uses it, because Keys() copies.
        // ES: Congelamiento 3.0 P2: presta cada clave viva a `action`, en orden de entradas. Lo usa
        //     HashSet<T>.ForEach(InAction<T>), porque Keys() copia.
        public void ForEachKey(InAction<TKey> action)
        {
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0) { action(in entryKeys[i]); }
                i = i + 1;
            }
        }

        // EN: Freeze 3.0 P2: removes (and destroys) every entry whose key matches `predicate`, which
        //     borrows the key; returns how many were removed. Used by HashSet<T>.RemoveWhere.
        // ES: Congelamiento 3.0 P2: quita (y destruye) cada entrada cuya clave cumple `predicate`, que
        //     recibe la clave prestada; devuelve cuantas quito. Lo usa HashSet<T>.RemoveWhere.
        public int RemoveKeysWhere(InPredicate<TKey> predicate)
        {
            int removed = 0;
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0 && predicate(in entryKeys[i]))
                {
                    RemoveEntryAt(i);
                    removed = removed + 1;
                }
                i = i + 1;
            }
            return removed;
        }

        // EN: Unlinks live entry `index` from its bucket chain, destroys its key and value and puts
        //     the slot on the free list -- the same steps Remove(key) takes once it finds the entry.
        // ES: Desengancha la entrada viva `index` de su cadena, destruye su clave y su valor y pone el
        //     hueco en la lista libre -- los mismos pasos que Remove(key) da al encontrar la entrada.
        private void RemoveEntryAt(int index)
        {
            int bucketIndex = entryHashCodes[index] % buckets.Length;
            int previous = -1;
            int i = buckets[bucketIndex];
            while (i != index)
            {
                previous = i;
                i = entryNext[i];
            }
            if (previous < 0)
            {
                buckets[bucketIndex] = entryNext[index];
            }
            else
            {
                entryNext[previous] = entryNext[index];
            }
            delete entryKeys[index];
            delete entryValues[index];
            entryHashCodes[index] = -1;
            entryNext[index] = freeFirst;
            freeFirst = index;
            freeCount = freeCount + 1;
        }

        ~Dictionary()
        {
            int i = 0;
            while (i < count)
            {
                if (entryHashCodes[i] >= 0)
                {
                    delete entryKeys[i];
                    delete entryValues[i];
                }
                i = i + 1;
            }
            delete[] entryKeys;
            delete[] entryValues;
            delete[] entryHashCodes;
            delete[] entryNext;
            delete[] buckets;
        }
    }
}
