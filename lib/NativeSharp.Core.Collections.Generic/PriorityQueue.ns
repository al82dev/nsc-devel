using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.PriorityQueue<TElement,TPriority> -- a binary min-heap:
    // Dequeue()/Peek() always return the element with the SMALLEST priority (natural `<` order,
    // or an explicit `Comparison<TPriority>` supplied at construction -- same comparer story as
    // SortedList<TKey,TValue>, see its class comment for why a delegate stands in for
    // IComparer<T>). Two parallel owned arrays (`elements`/`priorities`), heap-ordered by index:
    // a node at index i has children at 2i+1/2i+2 and parent (i-1)/2 -- the textbook array-backed
    // binary heap real C#'s own PriorityQueue<TElement,TPriority> uses internally too.
    //
    // Ownership: identical story to every other container in this package (see List.ns's class
    // comment) -- `elements`/`priorities` are `owned TElement[]`/`owned TPriority[]`. Enqueue
    // takes `owned TElement`/`owned TPriority`; Dequeue returns `owned TElement` (freeing the
    // discarded priority itself); Peek returns a plain (borrowed) `TElement`, same shape as
    // Queue<T>.Peek. Dequeue's root-removal deliberately swaps the root with the LAST live slot
    // before shrinking `count` (rather than copying the last element's VALUE into slot 0), so the
    // value being returned ends up sitting at the now out-of-range index `count` (after the
    // decrement) -- letting the return use the same proven array-element `move()` Queue<T>.Dequeue
    // already relies on, instead of needing an intermediate owned local (which the compiler does
    // not support for a non-class T -- only `raii` locals and owned parameters are move() sources,
    // and `raii` itself only accepts a class/interface/string type).
    public class PriorityQueue<TElement, TPriority>
    {
        private owned TElement[] elements;
        private owned TPriority[] priorities;
        private int count;
        // EN: Freeze 3.0 P2: stored as InComparison<TPriority>, so comparing priorities never copies
        //     one (see the Comparison constructor).
        // ES: Congelamiento 3.0 P2: se guarda como InComparison<TPriority>, asi que comparar
        //     prioridades nunca copia una (ver el constructor con Comparison).
        private InComparison<TPriority> comparer;

        public PriorityQueue()
        {
            elements = new TElement[4];
            priorities = new TPriority[4];
            count = 0;
            comparer = null;
        }

        public PriorityQueue(int capacity)
        {
            int actual = capacity;
            if (actual < 1) { actual = 1; }
            elements = new TElement[actual];
            priorities = new TPriority[actual];
            count = 0;
            comparer = null;
        }

        // Mirrors real C#'s PriorityQueue<TElement,TPriority>(IComparer<TPriority>).
        //
        // EN: Freeze 3.0 P2: a Comparison<TPriority> receives copies, so this constructor requires
        //     `TPriority : copy` and wraps it in a borrowing InComparison; the InComparison
        //     constructor serves any TPriority.
        // ES: Congelamiento 3.0 P2: un Comparison<TPriority> recibe copias, asi que este constructor
        //     exige `TPriority : copy` y lo envuelve en un InComparison que presta; el constructor con
        //     InComparison sirve para todo TPriority.
        public PriorityQueue(Comparison<TPriority> comparerFunc) where TPriority : copy
        {
            elements = new TElement[4];
            priorities = new TPriority[4];
            count = 0;
            comparer = (in TPriority a, in TPriority b) => comparerFunc(a, b);
        }

        public PriorityQueue(InComparison<TPriority> comparerFunc)
        {
            elements = new TElement[4];
            priorities = new TPriority[4];
            count = 0;
            comparer = comparerFunc;
        }

        public int Count()
        {
            return count;
        }

        public int Capacity()
        {
            return elements.Length;
        }

        private bool Less(int i, int j)
        {
            if (comparer != null)
            {
                return comparer(in priorities[i], in priorities[j]) < 0;
            }
            return priorities[i] < priorities[j];
        }

        // A pure relocation of two same-array-index pairs. A one-element raw array supplies the
        // generic owner slot that a local cannot express uniformly for both value and reference
        // T; every live reference changes slots through move(), and the temporary is empty before
        // its backing block is released.
        private void SwapAt(int i, int j)
        {
            const TElement[] tempElement = new TElement[1];
            tempElement[0] = move(elements[i]);
            elements[i] = move(elements[j]);
            elements[j] = move(tempElement[0]);
            delete[] tempElement;
            const TPriority[] tempPriority = new TPriority[1];
            tempPriority[0] = move(priorities[i]);
            priorities[i] = move(priorities[j]);
            priorities[j] = move(tempPriority[0]);
            delete[] tempPriority;
        }

        public int EnsureCapacity(int capacity)
        {
            if (elements.Length >= capacity) { return elements.Length; }
            int newCapacity = elements.Length * 2;
            if (newCapacity < capacity) { newCapacity = capacity; }
            const TElement[] grownElements = new TElement[newCapacity];
            const TPriority[] grownPriorities = new TPriority[newCapacity];
            int i = 0;
            while (i < count)
            {
                grownElements[i] = move(elements[i]);
                grownPriorities[i] = move(priorities[i]);
                i = i + 1;
            }
            delete[] elements;
            delete[] priorities;
            elements = grownElements;
            priorities = grownPriorities;
            return elements.Length;
        }

        public void TrimExcess()
        {
            int threshold = (elements.Length * 9) / 10;
            if (count >= threshold) { return; }
            int newCapacity = count;
            if (newCapacity < 1) { newCapacity = 1; }
            if (newCapacity == elements.Length) { return; }
            const TElement[] shrunkElements = new TElement[newCapacity];
            const TPriority[] shrunkPriorities = new TPriority[newCapacity];
            int i = 0;
            while (i < count)
            {
                shrunkElements[i] = move(elements[i]);
                shrunkPriorities[i] = move(priorities[i]);
                i = i + 1;
            }
            delete[] elements;
            delete[] priorities;
            elements = shrunkElements;
            priorities = shrunkPriorities;
        }

        private void SiftUp(int index)
        {
            int i = index;
            while (i > 0)
            {
                int parent = (i - 1) / 2;
                if (!Less(i, parent)) { return; }
                SwapAt(i, parent);
                i = parent;
            }
        }

        private void SiftDown(int index)
        {
            int i = index;
            while (true)
            {
                int left = 2 * i + 1;
                int right = 2 * i + 2;
                int smallest = i;
                if (left < count && Less(left, smallest)) { smallest = left; }
                if (right < count && Less(right, smallest)) { smallest = right; }
                if (smallest == i) { return; }
                SwapAt(i, smallest);
                i = smallest;
            }
        }

        public void Enqueue(owned TElement element, owned TPriority priority)
        {
            EnsureCapacity(count + 1);
            // move(element)/move(priority): see List.ns's Add() for the full explanation -- both
            // are owned parameters, and without move() here their automatic end-of-scope cleanup
            // double-frees the very element/priority just stored.
            elements[count] = move(element);
            priorities[count] = move(priority);
            count = count + 1;
            SiftUp(count - 1);
        }

        // EN: Freeze 3.0 P3: Peek lends the element by reference, for any TElement. TryPeek and
        //     TryDequeue copy what they report and require the matching `copy` constraints.
        // ES: Congelamiento 3.0 P3: Peek presta el elemento por referencia, para todo TElement.
        //     TryPeek y TryDequeue copian lo que informan y exigen los `copy` correspondientes.
        public ref TElement Peek() throws InvalidOperationException
        {
            if (count == 0)
            {
                throw new InvalidOperationException();
            }
            return ref elements[0];
        }

        // See the class comment for why the root is swapped to the (about to become out-of-range)
        // last slot before `count` shrinks, rather than copying the last element's value forward.
        public owned TElement Dequeue() throws InvalidOperationException
        {
            if (count == 0)
            {
                throw new InvalidOperationException();
            }
            SwapAt(0, count - 1);
            delete priorities[count - 1];
            count = count - 1;
            if (count > 0)
            {
                SiftDown(0);
            }
            return move(elements[count]);
        }

        // Mirrors `bool TryDequeue(out TElement element, out TPriority priority)` -- see
        // Dictionary.ns's TryGetValue comment for why NativeSharp expresses `out` as a
        // caller-supplied single-element array. `priorityResult[0]` is a plain (non-owned) read
        // of the priority that is about to be discarded (see Dequeue() -- the priority itself is
        // never returned to the caller by real C#'s TryDequeue either, only reported).
        public bool TryDequeue(TElement[] elementResult, TPriority[] priorityResult) where TPriority : copy
        {
            if (count == 0) { return false; }
            priorityResult[0] = priorities[0];
            // EN: Freeze 3.0 C-13: Dequeue() declares throws; the empty case is answered above, so the
            //     catch only satisfies the checked contract.
            // ES: Congelamiento 3.0 C-13: Dequeue() declara throws; el caso vacio ya se respondio arriba,
            //     asi que el catch solo cumple el contrato verificado.
            try { elementResult[0] = Dequeue(); }
            catch (InvalidOperationException problem) { return false; }
            return true;
        }

        public bool TryPeek(TElement[] elementResult, TPriority[] priorityResult)
            where TElement : copy where TPriority : copy
        {
            if (count == 0) { return false; }
            elementResult[0] = elements[0];
            priorityResult[0] = priorities[0];
            return true;
        }

        public void Clear()
        {
            int i = 0;
            while (i < count)
            {
                delete elements[i];
                delete priorities[i];
                i = i + 1;
            }
            count = 0;
        }

        // Get-only indexer over the raw heap array position (0..Count()-1) -- NOT sorted/priority
        // order, exactly the same "unspecified, heap-internal order" guarantee real C#'s own
        // PriorityQueue<TElement,TPriority>.GetEnumerator() documents (it yields TElement only,
        // never a (element, priority) pair -- see this class's own GetEnumerator() comment below
        // for why that specific asymmetry with Dictionary/SortedList is safe here but isn't there).
        // Added so PriorityQueueEnumerator<TElement,TPriority> can borrow a live reference to this
        // queue, same design as List<T>/Queue<T>/Stack<T>'s enumerators (P1.2 of
        // STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md).
        //
        // EN: Freeze 3.0 P3: the getter copies and requires `TElement : copy`; RefAt lends the same
        //     element for any TElement (PriorityQueueEnumerator uses it).
        // ES: Congelamiento 3.0 P3: el getter copia y exige `TElement : copy`; RefAt presta el mismo
        //     elemento para todo TElement (PriorityQueueEnumerator lo usa).
        public TElement this[int index]
        {
            get where TElement : copy { return elements[index]; }
        }

        public ref TElement RefAt(int index)
        {
            if (index < 0 || index >= count)
            {
                panic("PriorityQueue index out of range");
            }
            return ref elements[index];
        }

        // P1.2: `Current` yields TElement ONLY, not a (TElement, TPriority) pair -- mirroring
        // real C#'s own PriorityQueue<TElement,TPriority>, which implements IEnumerable<TElement>
        // (never IEnumerable<(TElement,TPriority)>). This side-steps the exact ABI landmine
        // Dictionary<TKey,TValue>/SortedDictionary<TKey,TValue>/SortedList<TKey,TValue>
        // deliberately do NOT get a GetEnumerator() for (see their own class comments): TElement
        // alone is a single type, same ABI story every other single-type-parameter container in
        // this package already has, never a struct combining two independent generic parameters
        // whose combined size cannot be predicted at library-authoring time.
        public owned PriorityQueueEnumerator<TElement, TPriority> GetEnumerator()
        {
            return new PriorityQueueEnumerator<TElement, TPriority>(this);
        }

        ~PriorityQueue()
        {
            Clear();
            delete[] elements;
            delete[] priorities;
        }
    }
}
