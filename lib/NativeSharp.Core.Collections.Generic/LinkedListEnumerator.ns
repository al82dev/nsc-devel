namespace NativeSharp.Core.Collections.Generic
{
    // Enumerator returned by LinkedList<T>.GetEnumerator() (P1.2 of
    // STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md). See ListEnumerator.ns's class comment
    // for the general design this whole family of enumerators follows.
    //
    // Unlike the array-backed containers (List/Queue/Stack), this enumerator does NOT use a
    // logical-index indexer -- LinkedList<T> has no O(1) "get element at position i" operation
    // to offer one over, and adding one would defeat the point of a linked list. Instead it walks
    // the live node chain directly: `current` starts as a sentinel (before the first node,
    // tracked by `started` rather than by using null itself as the sentinel, since null is also
    // the legitimate "chain exhausted" value) and each MoveNext() advances to
    // `current.Next()` (or `source.First()` on the very first call).
    public class LinkedListEnumerator<T>
    {
        private LinkedList<T> source;
        private LinkedListNode<T> current;
        private bool started;

        public LinkedListEnumerator(LinkedList<T> sourceList)
        {
            source = sourceList;
            current = null;
            started = false;
        }

        public bool MoveNext()
        {
            if (started)
            {
                current = current.Next();
            }
            else
            {
                current = source.First();
                started = true;
            }
            return current != null;
        }

        // EN: Freeze 3.0 P3: the value by reference, so `foreach (ref ...)` reaches it without a copy
        //     and a by-value foreach copies only a copyable T.
        // ES: Congelamiento 3.0 P3: el valor por referencia, asi que `foreach (ref ...)` llega a el sin
        //     copia y un foreach por valor copia solo un T copiable.
        public ref T Current
        {
            get { return ref current.Value(); }
        }
    }
}
