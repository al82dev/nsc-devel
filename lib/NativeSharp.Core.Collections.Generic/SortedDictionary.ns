using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Mirrors System.Collections.Generic.SortedDictionary<TKey,TValue> -- as a thin wrapper
    // around SortedList<TKey,TValue>.
    //
    // Real C#'s SortedDictionary<TKey,TValue> is a red-black tree: O(log n) insert/remove/lookup,
    // versus SortedList<TKey,TValue>'s O(n) insert/remove (the array shift) for the same O(log n)
    // lookup. This package deliberately does NOT implement a balanced tree -- a self-balancing
    // tree's rotation logic is exactly the kind of intricate, easy-to-get-subtly-wrong code this
    // whole package's design has avoided everywhere else (see List.ns's Sort() choosing insertion
    // sort over an introspective sort for the very same "confident correctness over asymptotic
    // optimality, given there is no way to execute and observe the compiled binary" reasoning),
    // so SortedDictionary<TKey,TValue> here collapses to the SAME sorted-array representation as
    // SortedList<TKey,TValue> -- a real, honest simplification, documented here and in the Stage
    // 52 didactic writeup, not hidden. What real C# users get from SortedDictionary that this
    // wrapper does NOT reproduce is SortedList<TKey,TValue>'s O(n) insert/remove cost turning into
    // SortedDictionary's O(log n) -- the API surface and the sorted-order guarantee are both
    // fully real, only the asymptotic complexity differs from the CLR's tree-based version.
    //
    // This class exists as its own distinct type anyway (rather than simply telling users "use
    // SortedList<TKey,TValue>") for the same reason HashSet<T> exists as its own type over
    // Dictionary<T, bool>: API discoverability and source-level compatibility with code written
    // against real C#'s collections.
    //
    // P1.2 of STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md: deliberately no GetEnumerator()
    // here, for the exact same reason as Dictionary<TKey,TValue> -- see its class comment for the
    // full explanation (a directly-yielded KeyValuePair<TKey,TValue> per foreach iteration would
    // only work for the narrow subset of TKey/TValue size combinations that happen to fit Stage
    // 40's 1/2/4/8-byte struct-value ABI, silently failing otherwise). Use `Keys()`/`Values()`
    // below instead (`foreach (var key in dict.Keys())`), already ABI-safe and already
    // foreach-compatible today via the array-mode candidate, with zero additional code.
    public class SortedDictionary<TKey, TValue>
    {
        private SortedList<TKey, TValue> items;

        public SortedDictionary()
        {
            items = new SortedList<TKey, TValue>();
        }

        public SortedDictionary(int capacity)
        {
            items = new SortedList<TKey, TValue>(capacity);
        }

        // Mirrors real C#'s SortedDictionary<TKey,TValue>(IComparer<TKey>) -- see SortedList.ns's
        // own `Comparison<TKey>` constructor for why a delegate stands in for IComparer<T>.
        //
        // EN: Freeze 3.0 P2: the Comparison constructor requires `TKey : copy` (see SortedList); the
        //     InComparison one serves any TKey.
        // ES: Congelamiento 3.0 P2: el constructor con Comparison exige `TKey : copy` (ver SortedList);
        //     el de InComparison sirve para todo TKey.
        public SortedDictionary(Comparison<TKey> comparerFunc) where TKey : copy
        {
            items = new SortedList<TKey, TValue>(comparerFunc);
        }

        public SortedDictionary(InComparison<TKey> comparerFunc)
        {
            items = new SortedList<TKey, TValue>(comparerFunc);
        }

        public int Count()
        {
            return items.Count();
        }

        public int EnsureCapacity(int capacity)
        {
            return items.EnsureCapacity(capacity);
        }

        public void TrimExcess()
        {
            items.TrimExcess();
        }

        public bool ContainsKey(TKey key)
        {
            return items.ContainsKey(key);
        }

        public bool ContainsValue(TValue value)
        {
            return items.ContainsValue(value);
        }

        public bool TryGetValue(TKey key, TValue[] result)
        {
            return items.TryGetValue(key, result);
        }

        // A missing key follows Core's total-accessor contract and returns default(TValue).
        // TryGetValue remains the non-ambiguous lookup when default(TValue) can be stored.
        public TValue this[TKey key]
        {
            get
            {
                return items[key];
            }
        }

        public void Add(owned TKey key, owned TValue value) throws ArgumentException
        {
            items.Add(move(key), move(value));
        }

        public void AddOrUpdate(owned TKey key, owned TValue value)
        {
            items.AddOrUpdate(move(key), move(value));
        }

        public void SetValue(TKey key, owned TValue value) throws KeyNotFoundException
        {
            items.SetValue(key, move(value));
        }

        public bool Remove(TKey key)
        {
            return items.Remove(key);
        }

        public void Clear()
        {
            items.Clear();
        }

        public TKey[] Keys()
        {
            return items.Keys();
        }

        public TValue[] Values()
        {
            return items.Values();
        }

        // See SortedList.ns/Dictionary.ns's class comments: consumed via `result[i].Key`/
        // `result[i].Value` field access, never by copying an element into a standalone
        // `KeyValuePair<TKey, TValue>` local (Stage 40's over-8-byte struct-value ABI limit).
        public KeyValuePair<TKey, TValue>[] ToArray()
        {
            return items.ToArray();
        }

        // EN: Freeze 3.0 P2: the action receives copies of the key and the value.
        // ES: Congelamiento 3.0 P2: la accion recibe copias de la clave y del valor.
        public void ForEach(KeyValueAction<TKey, TValue> action) where TKey : copy where TValue : copy
        {
            items.ForEach(action);
        }

        ~SortedDictionary()
        {
            delete items;
        }
    }
}
