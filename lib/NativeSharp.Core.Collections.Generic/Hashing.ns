using NativeSharp.Core;

namespace NativeSharp.Core.Collections.Generic
{
    // Ready-made HashFunc<T> targets (see Delegates.ns for why hashing needs an explicit function
    // instead of a structural T.GetHashCode()) for every built-in key type, plus one combinator
    // for building a hash out of several fields. A custom class/struct key needs its own plain
    // static method with this same shape (T -> int); HashCombine below is the tool for writing
    // one that mixes more than one field.
    //
    // None of these claim cryptographic quality or DoS-resistance -- they are the same class of
    // simple, fast, well-distributed hash used by textbook hash tables (FNV-1a for byte streams,
    // Knuth's multiplicative hash for folding a 64-bit value into 32 bits).
    public class Hashing
    {
        // `Default` is intentionally an overload family rather than a pretend universal hash.
        // A Dictionary<TKey,TValue> default constructor resolves this method group after TKey is
        // specialized. Built-in integral keys and string therefore need no boilerplate hasher;
        // structs/classes and floating-point keys still require an explicit HashFunc<T> so their
        // equality/hash policy cannot be guessed by the runtime.
        public static int Default(int value) { return Int32(value); }
        public static int Default(uint value) { return UInt32(value); }
        public static int Default(long value) { return Int64(value); }
        public static int Default(ulong value) { return UInt64(value); }
        public static int Default(nint value) { return Int64((long)value); }
        public static int Default(nuint value) { return UInt64((ulong)value); }
        public static int Default(bool value) { return Boolean(value); }
        public static int Default(char value) { return Char(value); }
        public static int Default(byte value) { return Byte(value); }
        public static int Default(sbyte value) { return (int)value; }
        public static int Default(short value) { return Short(value); }
        public static int Default(ushort value) { return (int)value; }
        public static int Default(string value) { return Str(value); }

        public static int Int32(int value)
        {
            return value;
        }

        public static int UInt32(uint value)
        {
            return (int)value;
        }

        public static int Int64(long value)
        {
            // Knuth's multiplicative folding: mixes both halves of the 64-bit value into a
            // well-distributed 32-bit result instead of just truncating (which would collide
            // every pair of longs that only differ in their high 32 bits).
            ulong mixed = (ulong)value * 2654435761UL;
            return (int)(mixed >> 32);
        }

        public static int UInt64(ulong value)
        {
            ulong mixed = value * 2654435761UL;
            return (int)(mixed >> 32);
        }

        public static int Boolean(bool value)
        {
            if (value) { return 1; }
            return 0;
        }

        public static int Char(char value)
        {
            return (int)value;
        }

        public static int Byte(byte value)
        {
            return (int)value;
        }

        public static int Short(short value)
        {
            return (int)value;
        }

        public static int Str(string value)
        {
            // Reuses the same ASCII-oriented FNV-1a hash already shipped and verified in
            // Stage 51 String.GetHashCode -- one real implementation, not a second copy.
            return String.GetHashCode(value);
        }

        // Combines a running hash with one more field's hash -- the standard
        // `hash = hash * 31 + fieldHash` mixing step, useful when writing a hash function for a
        // custom class/struct key with more than one field:
        //
        //     public static int HashPoint(Point p) {
        //         int h = Hashing.Int32(p.X);
        //         h = Hashing.HashCombine(h, Hashing.Int32(p.Y));
        //         return h;
        //     }
        public static int HashCombine(int runningHash, int fieldHash)
        {
            return runningHash * 31 + fieldHash;
        }
    }
}
