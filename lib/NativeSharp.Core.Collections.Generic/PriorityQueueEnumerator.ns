namespace NativeSharp.Core.Collections.Generic
{
    // Enumerator returned by PriorityQueue<TElement,TPriority>.GetEnumerator() (P1.2 of
    // STAGE52X_FOREACH_REVISION_TECNICA_Y_FALTANTES.md). See ListEnumerator.ns's class comment
    // for the general design this whole family of enumerators follows, and
    // PriorityQueue<TElement,TPriority>.GetEnumerator()'s own comment for why `Current` yields
    // TElement alone (heap-internal order, unspecified/not sorted -- exactly like real C#'s
    // PriorityQueue<TElement,TPriority>), never a (TElement, TPriority) pair.
    public class PriorityQueueEnumerator<TElement, TPriority>
    {
        private PriorityQueue<TElement, TPriority> source;
        private int index;

        public PriorityQueueEnumerator(PriorityQueue<TElement, TPriority> sourceQueue)
        {
            source = sourceQueue;
            index = -1;
        }

        public bool MoveNext()
        {
            index = index + 1;
            return index < source.Count();
        }

        // EN: Freeze 3.0 P3: the element by reference, so `foreach (ref ...)` reaches it without a copy
        //     and a by-value foreach copies only a copyable TElement.
        // ES: Congelamiento 3.0 P3: el elemento por referencia, asi que `foreach (ref ...)` llega a el
        //     sin copia y un foreach por valor copia solo un TElement copiable.
        public ref TElement Current
        {
            get { return ref source.RefAt(index); }
        }
    }
}
