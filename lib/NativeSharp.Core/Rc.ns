using NativeSharp.Core.Internal;

namespace NativeSharp.Core
{
    // A move-only local strong reference. Clone explicitly retains the same payload.
    public struct Rc<T>
    {
        private SharedLocalHandle<T> inner;

        internal Rc(SharedLocalHandle<T> value) { inner = move(value); }
        public readonly bool IsEmpty() { return inner.IsEmpty(); }
        public readonly long StrongCount() { return inner.StrongCount(); }
        public readonly long WeakCount() { return inner.WeakCount(); }
        public readonly ref readonly T Get() { return ref inner.Get(); }
        public readonly SharedView<T> Borrow() { return new SharedView<T>(inner.Borrow()); }

        public readonly Rc<T> Clone()
        {
            SharedLocalHandle<T> value = inner.Clone();
            return new Rc<T>(move(value));
        }

        public readonly WeakRc<T> Downgrade()
        {
            SharedLocalWeak<T> value = inner.Downgrade();
            return new WeakRc<T>(move(value));
        }
    }
}
