using NativeSharp.Core;

namespace NativeSharp.Core
{
    // NativeSharp.Core.IAllocator -- NS304-T13-F01. Surface #9: protocolo `IAllocator`.
    //
    // Contrato de "de donde sale la memoria". Tres operaciones, y las tres estan congeladas aqui:
    //
    //   * byte* Allocate(int bytes)
    //       Entrega un bloque de al menos `bytes` bytes, alineado a 8. `bytes <= 0` o un fallo de
    //       memoria devuelve null (no hay "tamano cero" silencioso ni fallo escondido). El bloque
    //       es propiedad del que llama hasta que lo libere.
    //
    //   * byte* Resize(byte* ptr, int oldBytes, int newBytes)
    //       Entrega un bloque de al menos `newBytes` conservando los primeros min(oldBytes,
    //       newBytes) bytes. Si devuelve null, `ptr` sigue valido e intacto y el que llama
    //       conserva la propiedad. Si devuelve un puntero distinto, `ptr` queda consumido (no se
    //       libera por separado) y el nuevo puntero es la propiedad.
    //
    //   * void Deallocate(byte* ptr)
    //       Libera un bloque entregado por Allocate/Resize. `ptr` deja de ser valido en el acto.
    //
    // Pairing: un Deallocate por cada Allocate; Resize sustituye el puntero (el viejo no se libera
    // aparte). Un bloque se libera exactamente una vez.
    public trait IAllocator
    {
        byte* Allocate(int bytes);
        byte* Resize(byte* ptr, int oldBytes, int newBytes);
        void Deallocate(byte* ptr);
    }
}
