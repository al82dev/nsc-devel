namespace NativeSharp.Core.Numerics
{
    // Vector SIMD publico de 128 bits. El layout es deliberadamente un struct ordinario de
    // cuatro floats: puede cruzar ABI, metadata y PDB sin exponer un tipo dependiente del target.
    // Add/Subtract/Multiply se reconocen por firma exacta y bajan a operaciones LLVM vectoriales.
    public struct Float32x4
    {
        public float X;
        public float Y;
        public float Z;
        public float W;

        public Float32x4(float x, float y, float z, float w)
        {
            X = x;
            Y = y;
            Z = z;
            W = w;
        }

        public static Float32x4 Add(Float32x4 left, Float32x4 right)
        {
            return default(Float32x4);
        }

        public static Float32x4 Subtract(Float32x4 left, Float32x4 right)
        {
            return default(Float32x4);
        }

        public static Float32x4 Multiply(Float32x4 left, Float32x4 right)
        {
            return default(Float32x4);
        }

        public static Float32x4 SwizzleWzyx(Float32x4 value)
        {
            return default(Float32x4);
        }

        public static Float32x4 ShuffleLowHigh(Float32x4 left, Float32x4 right)
        {
            return default(Float32x4);
        }

        public static float Dot(Float32x4 left, Float32x4 right)
        {
            return left.X * right.X + left.Y * right.Y + left.Z * right.Z + left.W * right.W;
        }

        public static Float32x4 Min(Float32x4 left, Float32x4 right)
        {
            Float32x4 result;
            result.X = left.X < right.X ? left.X : right.X;
            result.Y = left.Y < right.Y ? left.Y : right.Y;
            result.Z = left.Z < right.Z ? left.Z : right.Z;
            result.W = left.W < right.W ? left.W : right.W;
            return result;
        }

        public static Float32x4 Max(Float32x4 left, Float32x4 right)
        {
            Float32x4 result;
            result.X = left.X > right.X ? left.X : right.X;
            result.Y = left.Y > right.Y ? left.Y : right.Y;
            result.Z = left.Z > right.Z ? left.Z : right.Z;
            result.W = left.W > right.W ? left.W : right.W;
            return result;
        }

        public static Float32x4 Clamp(Float32x4 value, Float32x4 lower, Float32x4 upper)
        {
            return Min(Max(value, lower), upper);
        }
    }
}
