namespace NativeSharp.Core
{
    // Primitive spellings are language keywords and cannot own static members. These facade
    // types provide the direct Type.Parse surface while Number remains the single parsing core.
    // Parse(text) fails explicitly through the language panic boundary; the fallback overload
    // and TryParse never panic for malformed or null input.
    public class Byte
    {
        public static byte Parse(string text)
        {
            byte value;
            if (!Number.TryParseByte(text, out value)) { panic("Byte.Parse invalid input"); }
            return value;
        }

        public static byte Parse(string text, byte fallback)
        {
            byte value;
            return Number.TryParseByte(text, out value) ? value : fallback;
        }

        public static bool TryParse(string text, out byte value)
        {
            return Number.TryParseByte(text, out value);
        }
    }

    public class SByte
    {
        public static sbyte Parse(string text)
        {
            sbyte value;
            if (!Number.TryParseSByte(text, out value)) { panic("SByte.Parse invalid input"); }
            return value;
