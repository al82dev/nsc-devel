namespace NativeSharp.Core.Internal
{
    // Internal building block for a shared allocation. The compiler lowers this exact operation
    // to the descriptor's object-only destruction entry; the caller retains and frees storage.
    internal static class SharedStorage
    {
        public static void DestroyObject<T>(T target) where T : class { }
        // The null witness identifies T without allocating or evaluating a payload.
        public static long InstanceSize<T>(T witness) where T : class { return 0l; }
        public static long InstanceAlignment<T>(T witness) where T : class { return 0l; }
    }
}
