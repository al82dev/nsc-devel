using NativeSharp.Core;

namespace NativeSharp.Core
{
    // NativeSharp.Core.IExecutor -- NS304-T07-F07. Surface #7: protocolo de executor.
    //
    // Contrato de "quien corre las tareas hijas de un scope". Tres operaciones congeladas:
    //
    //   * int Spawn(Future<void> task)
    //       Registra una tarea hija (un future ya construido) y devuelve un handle estable. El
    //       executor pasa a ser responsable de avanzarla (poll) hasta su terminacion o cancelacion.
    //
    //   * bool PollJoin(int handle)
    //       Avanza la tarea hasta que termina; devuelve true una sola vez cuando ya esta terminada
    //       y su resultado/error se puede observar. Idempotente despues del true.
    //
    //   * void Cancel(int handle)
    //       Senala cancelacion a una tarea viva. No la une: PollJoin sigue siendo obligatorio.
    public trait IExecutor
    {
        int Spawn(Future<void> task);
        bool PollJoin(int handle);
        void Cancel(int handle);
    }
}
