namespace NativeSharp.Core.Internal
{
    // A view of a shared payload. The caller must keep the originating owner live.
    internal borrowed struct SharedBorrow<T>
    {
        private T* slot;

        public SharedBorrow(T* value)
        {
            slot = value;
        }

        public ref readonly T Get()
        {
            if (slot == null) panic("shared payload is empty");
            unsafe("shared payload view")
            {
                return ref *slot;
            }
        }
    }
}
