using NativeSharp.Core;

namespace NativeSharp.Core
{
    // NativeSharp.Core.BinaryReader -- Bloque 4, fase B. SHR-026.
    //
    // QUE ES. Lee enteros little-endian de un ReadOnlySpan<byte>, llevando una posicion.
    //
    // ES UN `borrowed struct`, Y ESA ES LA DECISION CENTRAL. No posee nada: lee de bytes que son
    // de otro. Declararlo asi hace que el chequeo de escape del Bloque 3 (SHR-013) impida
    // guardarlo en un campo o devolverlo desde un metodo que lo construya sobre un local -- que
    // son exactamente las dos formas en que un lector sobrevive al buffer del que lee, y eso es
    // un uso-despues-de-liberar. La alternativa --una clase que copiara los bytes-- convertiria
    // cada .obj en una copia entera, que es justo lo que el Bloque 3 y File.ReadBytes existen
    // para evitar.
    //
    // ERRORES: Optional<T>, NUNCA EXCEPCIONES. Esta decision se tomo y se escribio ANTES de la
    // primera firma (doc 98), porque cambiarla despues costaria reescribir todas.
    //
    // EL MOTIVO, que no es de gusto: parsear COFF es un bucle de campos. Si cada ReadUInt32
    // pudiera lanzar, cada campo seria un punto de salida y el codigo de arriba se llenaria de
    // try/catch, o peor, no los pondria y un fichero truncado se llevaria por delante la
    // compilacion entera con una excepcion que no dice que campo fallo. Un fin de buffer NO es
    // excepcional: es el caso normal de un formato que se esta VALIDANDO, y el codigo que lo
    // valida quiere preguntarlo, no capturarlo.
    //
    // Y la asimetria con BinaryWriter --que no devuelve nada-- es deliberada: escribir en un
    // buffer que crece no puede fallar; leer datos que otro escribio, si.
    //
    // LA POSICION NO RETROCEDE SOLA. Una lectura que no cabe devuelve None y **no avanza**, asi
    // que el lector queda exactamente donde estaba y el llamador puede decidir. Avanzar en una
    // lectura fallida dejaria la posicion en un sitio que no significa nada.
    public copy borrowed struct BinaryReader
    {
        private byte* data;
        private int length;
        private int position;

        public BinaryReader(ReadOnlySpan<byte> source)
        {
            data = source.Data();
            length = source.Length();
            position = 0;
        }

        public int Position() { return position; }

        public int Length() { return length; }

        public int Remaining() { return length - position; }

        public bool IsAtEnd() { return position >= length; }

        // Mover la posicion a mano: lo que hace falta para saltarse un campo reservado o para
        // volver a una tabla cuyo offset se acaba de leer. Devuelve false y NO mueve nada si el
        // destino cae fuera -- mismo criterio que las lecturas.
        public bool Seek(int newPosition)
        {
            if (newPosition < 0) { return false; }
            if (newPosition > length) { return false; }
            position = newPosition;
            return true;
        }

        public bool Skip(int count)
        {
            return Seek(position + count);
        }

        // El unico sitio donde se comprueba el espacio. Todas las lecturas pasan por aqui, asi
        // que la regla "no cabe -> None y no avanzo" esta escrita una vez.
        private bool Has(int count)
        {
            if (count < 0) { return false; }
            return length - position >= count;
        }

        public Optional<byte> ReadByte()
        {
            if (!Has(1)) { return Optionals.None<byte>(); }
            byte value = data[position];
            position = position + 1;
            return Optionals.Some<byte>(value);
        }

        public Optional<sbyte> ReadSByte()
        {
            Optional<byte> raw = ReadByte();
            if (raw.IsEmpty()) { return Optionals.None<sbyte>(); }
            return Optionals.Some<sbyte>((sbyte)raw.UncheckedValue());
        }

        // Little-endian, byte a byte y con desplazamientos -- mismo motivo que en BinaryWriter:
        // reinterpretar memoria daria el orden del anfitrion, que hoy coincide y en otra
        // arquitectura no, y el fallo seria un .obj mal leido sin ninguna pista.
        //
        // Y hay un motivo mas, que aqui pesa igual: los bytes de un fichero no tienen por que
        // estar ALINEADOS. Un `*(uint*)p` sobre un offset impar es comportamiento indefinido en
        // C y una lectura lenta o un fallo segun la arquitectura; byte a byte no tiene ese
        // problema en ningun sitio.
        public Optional<ushort> ReadUInt16()
        {
            if (!Has(2)) { return Optionals.None<ushort>(); }
            ushort value = (ushort)((ushort)data[position] |
                ((ushort)data[position + 1] << 8));
            position = position + 2;
            return Optionals.Some<ushort>(value);
        }

        public Optional<short> ReadInt16()
        {
            Optional<ushort> raw = ReadUInt16();
            if (raw.IsEmpty()) { return Optionals.None<short>(); }
            return Optionals.Some<short>((short)raw.UncheckedValue());
        }

        public Optional<uint> ReadUInt32()
        {
            if (!Has(4)) { return Optionals.None<uint>(); }
            uint value = (uint)data[position] |
                ((uint)data[position + 1] << 8) |
                ((uint)data[position + 2] << 16) |
                ((uint)data[position + 3] << 24);
            position = position + 4;
            return Optionals.Some<uint>(value);
        }

        public Optional<int> ReadInt32()
        {
            Optional<uint> raw = ReadUInt32();
            if (raw.IsEmpty()) { return Optionals.None<int>(); }
            return Optionals.Some<int>((int)raw.UncheckedValue());
        }

        public Optional<ulong> ReadUInt64()
        {
            if (!Has(8)) { return Optionals.None<ulong>(); }
            ulong value = (ulong)data[position] |
                ((ulong)data[position + 1] << 8) |
                ((ulong)data[position + 2] << 16) |
                ((ulong)data[position + 3] << 24) |
                ((ulong)data[position + 4] << 32) |
                ((ulong)data[position + 5] << 40) |
                ((ulong)data[position + 6] << 48) |
                ((ulong)data[position + 7] << 56);
            position = position + 8;
            return Optionals.Some<ulong>(value);
        }

        public Optional<long> ReadInt64()
        {
            Optional<ulong> raw = ReadUInt64();
            if (raw.IsEmpty()) { return Optionals.None<long>(); }
            return Optionals.Some<long>((long)raw.UncheckedValue());
        }

        // Un bloque de bytes SIN COPIAR: una vista sobre los que ya estan ahi. Es lo que hace que
        // leer la tabla de secciones de un COFF no asigne nada.
        //
        // Lo devuelto es una VISTA sobre el mismo buffer que este lector, con la misma vida. El
        // chequeo de escape lo sujeta igual que a este struct.
        public ReadOnlySpan<byte> ReadSpan(int count)
        {
            if (!Has(count))
            {
                return Spans.ReadOnlyOfRaw<byte>(data, 0);
            }
            ReadOnlySpan<byte> slice = Spans.ReadOnlyOfRaw<byte>(data + position, count);
            position = position + count;
            return slice;
        }

        // La version que SI copia, para cuando los bytes tienen que sobrevivir al buffer. Lee
        // dentro del destino del llamador --mismo patron que File.ReadBytes-- y devuelve cuantos
        // copio: 0 si no cabian.
        public int ReadInto(byte[] destination, int count)
        {
            int take = count;
            if (take < 0) { take = 0; }
            if (take > destination.Length) { take = destination.Length; }
            if (!Has(take)) { return 0; }
            int i = 0;
            while (i < take)
            {
                destination[i] = data[position + i];
                i = i + 1;
            }
            position = position + take;
            return take;
        }
    }
}
