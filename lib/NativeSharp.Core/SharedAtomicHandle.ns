namespace NativeSharp.Core.Internal
{
    // Move-only owner of one strong reference to a atomic shared block.
    internal struct SharedAtomicHandle<T>
    {
        private long[] block;
        private T* slot;

        public SharedAtomicHandle(long[] control, T* payload)
        {
            block = control;
            slot = payload;
        }

        ~SharedAtomicHandle()
        {
            if (block != null) SharedAtomicControl.DropStrong<T>(block, slot);
        }

        public readonly bool IsEmpty() { return block == null; }

        public readonly long StrongCount()
        {
            return block == null ? 0l : SharedAtomicControl.StrongCount(block);
        }

        public readonly long WeakCount()
        {
            return block == null ? 0l : SharedAtomicControl.WeakCount(block);
        }

        public readonly SharedAtomicHandle<T> Clone()
        {
            if (block == null || !SharedAtomicControl.TryRetainStrong(block))
                return new SharedAtomicHandle<T>(null, null);
            return new SharedAtomicHandle<T>(block, slot);
        }

        public readonly SharedAtomicWeak<T> Downgrade()
        {
            if (block == null || !SharedAtomicControl.TryRetainWeak(block))
                return new SharedAtomicWeak<T>(null, null);
            return new SharedAtomicWeak<T>(block, slot);
        }

        public readonly SharedBorrow<T> Borrow()
        {
            return new SharedBorrow<T>(slot);
        }

        public readonly ref readonly T Get()
        {
            if (slot == null) panic("shared payload is empty");
            unsafe("shared payload view") { return ref *slot; }
        }
    }
}
