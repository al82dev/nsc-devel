using NativeSharp.Core;

namespace NativeSharp.Core
{
    // NativeSharp.Core.StringBuilder -- Bloque 5, fase B. SHR-019.
    //
    // QUE ES Y PARA QUE. Un `char[]` que dobla, con Append. Existe para sustituir los seis usos de
    // <sstream> de `src/`: construir un texto a trozos sin que cada trozo asigne una cadena nueva.
    //
    // POR QUE NO BASTA String.Concat. Cada Concat asigna una cadena entera y copia las dos
    // anteriores, asi que construir un mensaje de N trozos cuesta O(N^2) bytes copiados y N
    // asignaciones intermedias que se tiran. Esa es exactamente la diferencia entre `s = s + x` en
    // un bucle y un StringBuilder, y en un compilador que emite diagnosticos y nombres decorados
    // el bucle es la forma normal.
    //
    // ES EL MISMO PATRON QUE ByteBuffer (Bloque 4, fase B) y eso es deliberado: capacidad inicial
    // pequena, duplicar al crecer, Clear que conserva la memoria. Lo que cambia es el elemento --
    // char en vez de byte-- y que aqui hay un ToString que materializa. No se hizo ByteBuffer
    // generico para reutilizarlo: un ByteBuffer<T> obligaria a que cada operacion de bytes pasara
    // por una instanciacion, y las dos clases tienen APIs distintas de verdad (una escribe enteros
    // en little-endian, la otra concatena texto).
    //
    // NO HAY AppendFormat NI NADA CON PLANTILLA. String.ToString(...) ya cubre cada tipo por
    // separado; un mini-lenguaje de formato es una superficie entera --parseo, escapes, errores en
    // tiempo de ejecucion-- que nadie ha pedido por su nombre.
    public class StringBuilder
    {
        private owned char[] datos;
        private int cuantos;

        // Dieciseis, el mismo arranque que ByteBuffer. Un mensaje de diagnostico tipico son dos o
        // tres duplicaciones desde aqui, y arrancar en 256 desperdiciaria la mayoria de las veces.
        public StringBuilder()
        {
            datos = new char[16];
            cuantos = 0;
        }

        public StringBuilder(int capacidadInicial)
        {
            int capacidad = capacidadInicial;
            if (capacidad < 1) { capacidad = 1; }
            datos = new char[capacidad];
            cuantos = 0;
        }

        public int Length() { return cuantos; }

        public int Capacity() { return datos.Length; }

        // Vacia SIN soltar la memoria: el siguiente uso no vuelve a pagar las duplicaciones. Es lo
        // que hace util reutilizar un StringBuilder en un bucle sobre muchos elementos.
        public void Clear() { cuantos = 0; }

        public char this[int index]
        {
            get { return datos[index]; }
        }

        // Duplica hasta que quepan `necesarios` mas. Doblar y no crecer en un tamano fijo es lo que
        // hace que N appends cuesten O(N) copias amortizadas y no O(N^2).
        private void Asegurar(int necesarios)
        {
            int objetivo = cuantos + necesarios;
            if (objetivo <= datos.Length) { return; }

            int capacidad = datos.Length;
            while (capacidad < objetivo) { capacidad = capacidad * 2; }

            // Una local `const` --que NO posee-- para el arreglo nuevo, copia explicita,
            // `delete[]` del viejo y asignacion al campo. La copia directa mantiene este tipo
            // fundamental utilizable durante el bootstrap antes de que la ABI generica de
            // Span<T> haya alcanzado el punto fijo.
            const char[] mayor = new char[capacidad];
            int indice = 0;
            while (indice < cuantos)
            {
                mayor[indice] = datos[indice];
                indice = indice + 1;
            }
            delete[] datos;
            datos = mayor;
        }

        public void Append(char valor)
        {
            Asegurar(1);
            datos[cuantos] = valor;
            cuantos = cuantos + 1;
        }

        public void Append(string texto)
        {
            Asegurar(texto.Length);
            int i = 0;
            while (i < texto.Length)
            {
                datos[cuantos] = texto[i];
                cuantos = cuantos + 1;
                i = i + 1;
            }
        }

        // Los Append de numeros pasan por String.ToString, que es la unica conversion del proyecto
        // y esta medida (doc 92, once cifras garantizadas contra glibc para double). Reimplementar
        // la conversion aqui seria una segunda copia de esa regla.
        public void Append(int valor)
        {
            raii string texto = String.ToString(valor);
            Append(texto);
        }

        public void Append(long valor)
        {
            raii string texto = String.ToString(valor);
            Append(texto);
        }

        public void Append(uint valor)
        {
            raii string texto = String.ToString((ulong)valor);
            Append(texto);
        }

        public void Append(ulong valor)
        {
            raii string texto = String.ToString(valor);
            Append(texto);
        }

        public void Append(bool valor)
        {
            raii string texto = String.ToString(valor);
            Append(texto);
        }

        public void Append(double valor)
        {
            raii string texto = String.ToString(valor);
            Append(texto);
        }

        // Un salto de linea `\n` y no `\r\n`, tambien en Windows. El proyecto emite diagnosticos y
        // ficheros de texto que se comparan byte a byte entre corridas y entre maquinas; un final
        // de linea que dependa del sistema convierte cualquier comparacion en una diferencia
        // falsa. Quien necesite CRLF lo escribe.
        public void AppendLine(string texto)
        {
            Append(texto);
            Append('\n');
        }

        public void AppendLine()
        {
            Append('\n');
        }

        // Repite un caracter -- el relleno de las tablas y las sangrias de los volcados, que es
        // donde aparece siempre.
        public void AppendRepeat(char valor, int veces)
        {
            if (veces <= 0) { return; }
            Asegurar(veces);
            int i = 0;
            while (i < veces)
            {
                datos[cuantos] = valor;
                cuantos = cuantos + 1;
                i = i + 1;
            }
        }

        // Materializa. Es el unico punto donde se asigna una cadena, y por eso el resto de la clase
        // vale la pena.
        //
        // SE LLAMA ToOwnedString Y NO ToString, Y NO ES UN CAPRICHO. `Object.ToString()` es virtual
        // y su contrato --escrito en Object.ns-- es que devuelve el nombre del tipo, una CONSTANTE
        // que vive en el binario y que NO asigna memoria. Un `ToString()` aqui tendria que asignar
        // y devolver algo que el llamador posee, que es un contrato distinto; el compilador lo
        // detecta ("method hides an inherited virtual signature; use override") y hace bien.
        //
        // Sobrescribirlo con `override string ToString()` habria sido peor que un nombre distinto:
        // un llamador con una referencia `Object` recibiria una cadena asignada creyendo que es una
        // constante, y la fuga no se veria en ningun sitio. El nombre lleva la diferencia encima.
        public owned string ToOwnedString()
        {
            // El arreglo temporal es del TAMANO EXACTO, no de la capacidad: String.FromCharArray
            // toma el arreglo entero, asi que pasarle `datos` directamente meteria en la cadena la
            // basura que haya despues de `cuantos`.
            const char[] exacto = new char[cuantos];
            int indice = 0;
            while (indice < cuantos)
            {
                exacto[indice] = datos[indice];
                indice = indice + 1;
            }
            return String.FromCharArray(exacto);
        }
    }
}
