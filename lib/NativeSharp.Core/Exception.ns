namespace NativeSharp.Core
{
    // NativeSharp.Core.Exception -- Stage 52.
    //
    // The compiler's throw/catch machinery (Stage 45 exceptional control flow, Stage 49
    // RAII-aware unwinding) has recognized exactly one root type by fully-qualified name since
    // it was built: `NativeSharp.Core.Exception`. Every example that used `throw`/`catch` before
    // this stage (Stage 45, Stage 49, ...) had to declare its own throwaway `Exception` class
    // locally to satisfy that requirement, because the real one was never shipped as part of the
    // core library -- so `throw`/`catch` were reachable in principle but not actually usable
    // without every project re-declaring this same boilerplate class first. Stage 52 needs real
    // exceptions (a missing Dictionary<TKey,TValue> key, an empty Queue<T>.Dequeue(), ...), so
    // this file ships the real thing once, here, for every project to reuse.
    //
    // This is pure library code -- no compiler change was needed, or made, to add this file; the
    // exception mechanism already fully worked, it simply had nothing named
    // `NativeSharp.Core.Exception` to find.
    public class Exception
    {
        private owned string messageStorage;
        private owned Exception innerStorage;
        private owned string stackTraceStorage;

        public string Message;
        public Exception InnerException;
        public string StackTrace;

        public Exception()
        {
            messageStorage = null;
            innerStorage = null;
            stackTraceStorage = null;
            Message = null;
            InnerException = null;
            StackTrace = null;
        }

        public Exception(string message)
        {
            messageStorage = String.Copy(message);
            innerStorage = null;
            stackTraceStorage = null;
            Message = messageStorage;
            InnerException = null;
            StackTrace = null;
        }

        public Exception(string message, owned Exception innerException)
        {
            messageStorage = String.Copy(message);
            innerStorage = move(innerException);
            stackTraceStorage = null;
            Message = messageStorage;
            InnerException = innerStorage;
            StackTrace = null;
        }

        public void SetStackTrace(string stackTrace)
        {
            stackTraceStorage = String.Copy(stackTrace);
            StackTrace = stackTraceStorage;
        }

        public owned string ToDiagnosticString()
        {
            string ownMessage = Message;
            if (ownMessage == null) { ownMessage = "Exception"; }
            raii string result = String.Copy(ownMessage);
            if (InnerException != null)
            {
                raii string withMarker = String.Concat(result, " ---> ");
                string innerMessage = InnerException.Message;
                if (innerMessage == null) { innerMessage = "Exception"; }
                raii string withInner = String.Concat(withMarker, innerMessage);
                result = move(withInner);
            }
            if (StackTrace != null)
            {
                raii string withBreak = String.Concat(result, "\n");
                raii string withStack = String.Concat(withBreak, StackTrace);
                result = move(withStack);
            }
            return move(result);
        }
    }

    // Mirrors System.InvalidOperationException: the receiver is in a state that does not support
    // the requested operation (e.g. Queue<T>.Dequeue()/Stack<T>.Pop()/Peek() on an empty
    // collection).
    public class InvalidOperationException : Exception
    {
        public InvalidOperationException() : base() { }
        public InvalidOperationException(string message) : base(message) { }
        public InvalidOperationException(string message, owned Exception innerException)
            : base(message, move(innerException)) { }
    }

    // NS304-T13-F08: excepcion publica especifica del perfil `failure: throws`. Se lanza cuando
    // `IAllocator.Allocate` devuelve null y el sitio de construccion eligio propagar el fallo como
    // excepcion. No lleva allocation secundaria propia: el mensaje queda vacio por defecto para
    // que materializar la excepcion no reintroduzca un fallback oculto de memoria.
    public class AllocationFailureException : Exception
    {
        public AllocationFailureException() : base() { }
        public AllocationFailureException(string message) : base(message) { }
        public AllocationFailureException(string message, owned Exception innerException)
            : base(message, move(innerException)) { }
    }

    // Mirrors System.ArgumentOutOfRangeException: an index/count argument fell outside the
    // receiver's valid range. NativeSharp's own array bounds checks already trap on raw native
    // index expressions (a hard runtime fault, not a catchable exception); collection methods
    // that validate an index explicitly before touching storage throw this instead, so the
    // failure is catchable exactly like real C#'s List<T>[index]/RemoveAt(index).
    public class ArgumentOutOfRangeException : Exception
    {
        public ArgumentOutOfRangeException() : base() { }
        public ArgumentOutOfRangeException(string message) : base(message) { }
        public ArgumentOutOfRangeException(string message, owned Exception innerException)
            : base(message, move(innerException)) { }
    }

    // Mirrors System.Collections.Generic.KeyNotFoundException: Dictionary<TKey,TValue>'s
    // (and SortedDictionary<TKey,TValue>'s) indexer getter throws this for an absent key,
    // exactly like real C#'s Dictionary<TKey,TValue> -- the non-throwing alternative is
    // TryGetValue.
    public class KeyNotFoundException : Exception
    {
        public KeyNotFoundException() : base() { }
        public KeyNotFoundException(string message) : base(message) { }
        public KeyNotFoundException(string message, owned Exception innerException)
            : base(message, move(innerException)) { }
    }

    // Mirrors System.ArgumentException: an argument's VALUE (as opposed to merely its range,
    // which is ArgumentOutOfRangeException's job) is invalid for the requested operation --
    // e.g. Dictionary<TKey,TValue>.Add(key, value)/SortedDictionary<TKey,TValue>.Add(key, value)
    // throw this when an entry for that key already exists, exactly like real C#'s
    // Dictionary<TKey,TValue>.Add.
    public class ArgumentException : Exception
    {
        public ArgumentException() : base() { }
        public ArgumentException(string message) : base(message) { }
        public ArgumentException(string message, owned Exception innerException)
            : base(message, move(innerException)) { }
    }

    public class DivideByZeroException : Exception
    {
        public DivideByZeroException() : base() { }
        public DivideByZeroException(string message) : base(message) { }
        public DivideByZeroException(string message, owned Exception innerException)
            : base(message, move(innerException)) { }
    }

