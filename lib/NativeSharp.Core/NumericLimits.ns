namespace NativeSharp.Core
{
    // NativeSharp.Core.NumericLimits -- Pre-Stage-56 "utilidades basicas" round (Alberto,
    // 2026-08-29).
    //
    // En C# real, `int.MaxValue`/`int.MinValue`/`long.MaxValue`/etc. son constantes de biblioteca
    // estandar accesibles directamente sobre el propio nombre del tipo primitivo (`System.Int32`
    // expone esos dos campos static, y el compilador de C# deja usar `int` como alias para
    // escribirlos sin el nombre completo). NativeSharp NO tiene ese mecanismo -- los tipos
    // primitivos (`int`, `long`, `byte`, etc.) son palabras clave del lenguaje, no clases reales
    // con miembros static propios, asi que no hay ningun `int.MaxValue` que escribir. Esta clase
    // es el reemplazo directo: los mismos valores, expuestos como metodos static sobre una clase
    // normal, siguiendo la misma convencion de nombres que Hashing.ns ya establecio para sus
    // metodos por tipo (`Int32`/`UInt32`/`Int64`/`UInt64`/`Byte`/`Short`/`Char` -- ver
    // NativeSharp.Core.Collections.Generic.Hashing) en vez de inventar una convencion nueva.
    //
    // Igual que Random.ns (ver su comentario de cabecera), esta clase es NativeSharp puro: cero
    // "core operations", cero cambio de compilador, cero nuevo import de Win32 -- cada metodo es
    // literalmente una constante devuelta tal cual, el tipo de pieza mas simple que este proyecto
    // puede agregar.
    //
    // == Int32Min()/Int64Min() YA SE ESCRIBEN CON SU LITERAL, desde el 2026-09-03 ==
    //
    // Aqui habia un rodeo --`-2147483647 - 1`-- y una explicacion larga de por que hacia falta:
    // un literal entero se lexea como su MAGNITUD positiva y el `-` unario la niega despues, asi
    // que `2147483648` (la magnitud de int.MinValue) es uno mas que int.MaxValue, no cabia en un
    // `int` positivo, se tipaba `long`, y arrastraba a la expresion entera.
    //
    // El diagnostico era correcto y la solucion era un parche. El compilador ahora tipa el menos
    // unario JUNTO CON el literal que tiene directamente debajo --la regla de C#, y la unica forma
    // de escribir el minimo de un ancho, que es uno mas que su maximo en magnitud-- asi que el
    // rodeo sobra. La regla vive en include/nativesharp/Frontend/IntegerLiteralTyping.h.
    //
    // `2147483648` A SECAS, sin menos delante, sigue siendo `long`. Solo cambia el par.
    public class NumericLimits
    {
        public static byte ByteMin()
        {
            return 0;
        }

        public static byte ByteMax()
        {
            return 255;
        }

        public static short ShortMin()
        {
            // A diferencia de Int32Min()/Int64Min() abajo (donde el tipo de retorno YA es el
            // tipo "natural" en el que `-32767 - 1` se evalua), aca la resta se computa en
            // `int` (el tipo por defecto de la aritmetica entre literales enteros en este
            // compilador, sin importar que tan chico sea el tipo de retorno declarado) y NO se
            // angosta implicitamente a `short` solo por tratarse de una expresion constante que
            // cabria -- a diferencia de un LITERAL suelto (ver el comentario de cabecera de la
            // clase), asi que hace falta el cast explicito.
            return (short)(-32767 - 1);
        }

        public static short ShortMax()
        {
            return 32767;
        }

        public static ushort UShortMin()
        {
            return 0;
        }

        public static ushort UShortMax()
        {
            return 65535;
        }

        public static int Int32Min()
        {
            return -2147483648;
        }

        public static int Int32Max()
        {
            return 2147483647;
        }

        public static uint UInt32Min()
        {
            return 0U;
        }

        public static uint UInt32Max()
        {
            return 4294967295U;
        }

        public static long Int64Min()
        {
            return -9223372036854775808L;
        }

        public static long Int64Max()
        {
            return 9223372036854775807L;
        }

        public static ulong UInt64Min()
        {
            return 0UL;
        }

        public static ulong UInt64Max()
        {
            return 18446744073709551615UL;
        }

        // Valores IEEE 754 finitos mas chico/grande representables -- NO Infinity/NaN (ninguno de
        // los dos es "un numero" en el sentido que MinValue/MaxValue implican; si una ronda futura
        // necesita constantes de Infinity/NaN, merecen su propio metodo con un nombre que lo diga
        // explicitamente, no una sobrecarga escondida detras de Min/Max).
        public static float FloatMin()
        {
            return -3.40282347E+38F;
        }

        public static float FloatMax()
        {
            return 3.40282347E+38F;
        }

        public static double DoubleMin()
        {
            return -1.7976931348623157E+308;
        }

        public static double DoubleMax()
        {
            return 1.7976931348623157E+308;
        }
    }
}
