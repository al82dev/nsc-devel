namespace NativeSharp.Core
{
    // NativeSharp.Core.Span<T> / ReadOnlySpan<T> -- SHR-011 y SHR-012, Bloque 3.
    //
    // POR QUE EXISTEN. `<span>` aparece 25 veces en el compilador actual (doc 80 seccion 2). Es
    // la tercera ausencia mas usada, detras de `string_view` y `optional`, y las tres son el
    // mismo problema: referirse a un tramo de memoria de otro sin copiarlo y sin poseerlo.
    //
    // ------------------------------------------------------------------------------------------
    // SON EL MISMO TIPO DOS VECES, Y ESO ES DELIBERADO.
    //
    // `Span<T>` y `ReadOnlySpan<T>` tienen exactamente los mismos campos y la misma
    // aritmetica. La unica diferencia es que el indexador de uno tiene `set` y el del otro no.
    // La alternativa era un solo tipo con un booleano `readOnly` comprobado en ejecucion, y es
    // peor por dos razones que no son de gusto:
    //
    //   * el booleano cuesta un byte y una comparacion POR ESCRITURA, en el tipo cuyo proposito
    //     entero es no costar nada;
    //   * y sobre todo, mueve a EJECUCION una comprobacion que el sistema de tipos hace GRATIS
    //     en compilacion. Un `ReadOnlySpan<T>` que no se puede escribir no falla al escribirse:
    //     no compila.
    //
    // El precio es duplicar unas cuantas lineas. Se paga.
    //
    // ------------------------------------------------------------------------------------------
    // AMBOS SON `borrowed struct` -- ver StringView.ns para la explicacion larga. En corto: el
    // compilador rechaza devolver uno enraizado en un local, guardarlo en un campo, o capturarlo
    // en un lambda. Sin esa marca los tres serian usos-despues-de-liberar silenciosos.
    //
    // LO QUE NO PROMETEN:
    //   * NO comprueban que `T` case con lo que hay en la memoria apuntada. Un `Span<int>` sobre
    //     bytes de otra cosa es exactamente igual de erroneo que un `int*` sobre lo mismo, y esta
    //     capa no anade proteccion que el nivel crudo no tenga.
    //   * NO liberan nada. Nunca. Ni siquiera el `Span` que envuelve un arreglo que alguien
    //     olvido liberar.
    //   * `CopyTo` NO se solapa con seguridad. Es una copia hacia delante; si el destino cae
    //     dentro del origen y por detras, los datos se pisan. Para eso esta `CopyToOverlapping`.
    public copy borrowed struct Span<T>
    {
        private T* start;
        private int count;
        // EN: Freeze 3.0 P4: a span made from an array also keeps the array and the index of its first
        //     element. Its accessors reach elements through that array, so an array with a liveness
        //     map (DEC-11) applies it: a write revives the slot and a read of a dead slot traps.
        //     Slice and AsReadOnly carry both. A raw span (OfRaw, stackalloc, Data()) has none.
        // ES: Congelamiento 3.0 P4: un span hecho de un arreglo guarda tambien el arreglo y el indice
        //     de su primer elemento. Sus accesos llegan a los elementos por ese arreglo, asi que un
        //     arreglo con mapa de vida (DEC-11) lo aplica: escribir revive el slot y leer un slot
        //     muerto atrapa. Slice y AsReadOnly conservan ambos. Un span crudo (OfRaw, stackalloc,
        //     Data()) no tiene ninguno.
        private T[] source;
        private int offset;

        public Span(T* data, int length)
        {
            start = data;
            count = length;
            source = null;
            offset = 0;
        }

        public Span(T* data, int length, T[] array, int first)
        {
            start = data;
            count = length;
            source = array;
            offset = first;
        }

        public readonly int Length()
        {
            return count;
        }

        public bool IsEmpty()
        {
            return count == 0;
        }

        // EN: Freeze 3.0 P4: a span made by Spans from an array keeps no pointer (taking `&items[i]` of a
        //     dead slot traps); Data() takes it on demand. That address is a read of the first element.
        // ES: Congelamiento 3.0 P4: un span que Spans hace de un arreglo no guarda puntero (tomar
        //     `&items[i]` de un slot muerto atrapa); Data() lo toma cuando se pide. Esa direccion es una
        //     lectura del primer elemento.
        public T* Data()
        {
            if (start == null && source != null && count > 0)
            {
                return &source[offset];
            }
            return start;
        }

        // El indexador es total para conservar compatibilidad con compiladores Language 3 que no
        // publican contratos `throws` en accesores. Una lectura fuera de rango devuelve el valor
        // por omision; una escritura fuera de rango no modifica memoria.
        //
        // EN: Freeze 3.0 P3: both accessors copy a T (the getter returns it, the setter stores its
        //     by-value parameter), so they require `T : copy`. RefAt reaches any T without copying.
        // ES: Congelamiento 3.0 P3: los dos accesores copian un T (el getter lo devuelve, el setter
        //     guarda su parametro por valor), asi que exigen `T : copy`. RefAt llega a cualquier T sin
        //     copiar.
        public T this[int index]
        {
            readonly get where T : copy
            {
                if (index < 0 || index >= count)
                {
                    return default(T);
                }
                if (source != null) { return source[offset + index]; }
                return start[index];
            }
            set where T : copy
            {
                if (index < 0 || index >= count)
                {
                    return;
                }
                if (source != null)
                {
                    source[offset + index] = value;
                    return;
                }
                start[index] = value;
            }
        }

        // EN: Freeze 3.0 P3: the element itself, for any T. Out of range is a program error and
        //     panics: there is no element to return a reference to.
        // ES: Congelamiento 3.0 P3: el elemento mismo, para cualquier T. Fuera de rango es un error
        //     del programa y hace panic: no hay elemento al cual devolver una referencia.
        public ref T RefAt(int index)
        {
            if (index < 0 || index >= count)
            {
                panic("Span index out of range");
            }
            if (source != null) { return ref source[offset + index]; }
            return ref start[index];
        }

        // EN: Freeze 3.0 P4: moves `value` into an element, for any value type T. Through an array with
        //     a liveness map a dead slot is revived and a live one is destroyed first, like `a[i] = v`.
        //     Out of range panics.
        // ES: Congelamiento 3.0 P4: mueve `value` a un elemento, para todo tipo valor T. Por un arreglo
        //     con mapa de vida un slot muerto revive y uno vivo se destruye antes, como `a[i] = v`.
        //     Fuera de rango hace panic.
        public void Put(int index, owned T value)
        {
            if (index < 0 || index >= count)
            {
                panic("Span index out of range");
            }
            if (source != null)
            {
                source[offset + index] = move(value);
                return;
            }
            start[index] = move(value);
        }

        public T UncheckedAt(int index) where T : copy
        {
            if (source != null) { return source[offset + index]; }
            return start[index];
        }

        public void UncheckedSet(int index, T value) where T : copy
        {
            if (source != null)
            {
                source[offset + index] = value;
                return;
            }
            start[index] = value;
        }

        public Span<T> Slice(int start)
        {
            return Slice(start, count - start);
        }

        public Span<T> Slice(int start, int length)
        {
            int begin = start;
            if (begin < 0) { begin = 0; }
            if (begin > count) { begin = count; }
            int available = count - begin;
            int take = length;
            if (take < 0) { take = 0; }
            if (take > available) { take = available; }
            if (take == 0)
            {
                return new Span<T>(null, 0);
            }
            if (this.start == null)
            {
                return new Span<T>(null, take, source, offset + begin);
            }
            return new Span<T>(this.start + begin, take, source, offset + begin);
        }

        public void Fill(T value) where T : copy
        {
            int index = 0;
            while (index < count)
            {
                UncheckedSet(index, value);
                index = index + 1;
            }
        }

        // Devuelve cuantos elementos copio: el minimo de las dos longitudes. Devolver el conteo
        // en vez de fallar cuando el destino es mas corto es lo que permite escribir un bucle de
        // "vaciar en trozos" sin calcular el trozo dos veces.
        public int CopyTo(Span<T> destination) where T : copy
        {
            int limit = count;
            if (destination.Length() < limit) { limit = destination.Length(); }
            int index = 0;
            while (index < limit)
            {
                destination.UncheckedSet(index, UncheckedAt(index));
                index = index + 1;
            }
            return limit;
        }

        // Para cuando origen y destino SI se solapan. Copia hacia atras si el destino va por
        // delante del origen, que es el unico caso en que la copia hacia delante se pisa.
        public int CopyToOverlapping(Span<T> destination) where T : copy
        {
            int limit = count;
            if (destination.Length() < limit) { limit = destination.Length(); }
            if (destination.Data() > Data())
            {
                int index = limit - 1;
                while (index >= 0)
                {
                    destination.UncheckedSet(index, UncheckedAt(index));
                    index = index - 1;
                }
                return limit;
            }
            int forward = 0;
            while (forward < limit)
            {
                destination.UncheckedSet(forward, UncheckedAt(forward));
                forward = forward + 1;
            }
            return limit;
        }

        // La conversion barata en la direccion segura: de escribible a solo lectura. La contraria
        // no existe a proposito -- seria devolver permiso de escritura que nadie dio.
        public ReadOnlySpan<T> AsReadOnly()
        {
            return new ReadOnlySpan<T>(start, count, source, offset);
        }
    }

    // La mitad de solo lectura. Todo lo que no escribe, escrito igual; nada de lo que escribe.
    public copy borrowed struct ReadOnlySpan<T>
    {
        private T* start;
        private int count;
        // EN: Freeze 3.0 P4: the array and first index, as in Span<T>.
        // ES: Congelamiento 3.0 P4: el arreglo y el primer indice, como en Span<T>.
        private T[] source;
        private int offset;

        public ReadOnlySpan(T* data, int length)
        {
            start = data;
            count = length;
            source = null;
            offset = 0;
        }

        public ReadOnlySpan(T* data, int length, T[] array, int first)
        {
            start = data;
            count = length;
            source = array;
            offset = first;
        }

        public readonly int Length()
        {
            return count;
        }

        public bool IsEmpty()
        {
            return count == 0;
        }

        // EN: Freeze 3.0 P4: a span made by Spans from an array keeps no pointer (taking `&items[i]` of a
        //     dead slot traps); Data() takes it on demand. That address is a read of the first element.
        // ES: Congelamiento 3.0 P4: un span que Spans hace de un arreglo no guarda puntero (tomar
        //     `&items[i]` de un slot muerto atrapa); Data() lo toma cuando se pide. Esa direccion es una
        //     lectura del primer elemento.
        public T* Data()
        {
            if (start == null && source != null && count > 0)
            {
                return &source[offset];
            }
            return start;
        }

        // EN: Freeze 3.0 P3: the getter returns a copy and requires `T : copy`; RefAt lends the
        //     element of any T, readonly.
        // ES: Congelamiento 3.0 P3: el getter devuelve una copia y exige `T : copy`; RefAt presta el
        //     elemento de cualquier T, de solo lectura.
        public readonly T this[int index]
        {
            get where T : copy
            {
                if (index < 0 || index >= count)
                {
                    return default(T);
                }
                if (source != null) { return source[offset + index]; }
                return start[index];
            }
        }

        public ref readonly T RefAt(int index)
        {
            if (index < 0 || index >= count)
            {
                panic("ReadOnlySpan index out of range");
            }
            if (source != null) { return ref source[offset + index]; }
            return ref start[index];
        }

        public T UncheckedAt(int index) where T : copy
        {
            if (source != null) { return source[offset + index]; }
            return start[index];
        }

        public ReadOnlySpan<T> Slice(int start)
        {
            return Slice(start, count - start);
        }

        public ReadOnlySpan<T> Slice(int start, int length)
        {
            int begin = start;
            if (begin < 0) { begin = 0; }
            if (begin > count) { begin = count; }
            int available = count - begin;
            int take = length;
            if (take < 0) { take = 0; }
            if (take > available) { take = available; }
            if (take == 0)
            {
                return new ReadOnlySpan<T>(null, 0);
            }
            if (this.start == null)
            {
                return new ReadOnlySpan<T>(null, take, source, offset + begin);
            }
            return new ReadOnlySpan<T>(this.start + begin, take, source, offset + begin);
        }

        public int CopyTo(Span<T> destination) where T : copy
        {
            int limit = count;
            if (destination.Length() < limit) { limit = destination.Length(); }
            int index = 0;
            while (index < limit)
            {
                destination.UncheckedSet(index, UncheckedAt(index));
                index = index + 1;
            }
            return limit;
        }
    }

    // ----------------------------------------------------------------------------------------
    // LAS FABRICAS VIVEN AQUI, Y NO DENTRO DE Span<T>, POR UN HUECO DEL LENGUAJE. NO ES ESTILO.
    //
    // MEDIDO, con el frontend real: `Span<int>.Of(items)` NO PARSEA. Un miembro estatico de un
    // tipo generico cerrado no se puede nombrar en una expresion; el parser lee `Span<int>` y
    // se atraganta con el punto. La forma que SI funciona es un METODO generico sobre una clase
    // no generica -- `Spans.Of<int>(items)` -- porque los argumentos de tipo de una LLAMADA si
    // se parsean (el arbol ya los usa: `Identity<T>(value)`).
    //
    //     class Box<T> { public static Box<T> Make(T v) {...} }
    //     Box<int> a = Box<int>.Make(1);      // "expected expression" / "expected ';'"
    //     Box<int> b = Helper.Wrap<int>(1);   // compila
    //
    // Queda anotado como ID 131. NO se arregla aqui: cerrarlo pide que el modelo de nombres
    // resuelva una instanciacion generica en posicion de EXPRESION y que el modelo generico la
    // monomorfice desde ahi, que es trabajo del compilador y de otro bloque. Meterlo dentro del
    // Bloque 3 seria arrastrar un cambio profundo del frontend detras de un tipo de biblioteca.
    //
    // Cuando ese ID se cierre, estas fabricas pueden mudarse a los structs sin tocar nada mas.
    //
    // Y UN SEGUNDO HUECO, encontrado al escribir esto y medido igual (ID 132): DOS METODOS
    // GENERICOS CON EL MISMO NOMBRE Y LA MISMA ARIDAD DE TIPOS NO SE PODIAN SOBRECARGAR, aunque
    // sus parametros fueran distintos. La identidad de una plantilla generica era nombre + numero
    // de parametros de tipo, sin la lista de parametros:
    //
    //     duplicate generic template identity 'NativeSharp.Core.Spans.Of``1'
    //
    // ESE ID SE CERRO EL 2026-09-03: la identidad incluye ahora la cuenta de parametros de valor,
    // asi que `Of<T>(T[])` y un `Of<T>(T[], int, int)` podrian convivir. El sitio donde el rodeo
    // SI se deshizo es Algorithm.SortWith, que paso a ser una sobrecarga de Sort.
    //
    // AQUI EL NOMBRE SE QUEDA, y no por inercia: `OfRange` describe lo que hace mejor que un `Of`
    // sobrecargado, y son 51 llamadas repartidas por la biblioteca y las fixtures. Renombrar
    // seria mover cincuenta y una lineas para empeorar el nombre. Lo que si cambia es este
    // comentario: decir que es un rodeo obligado, cuando ya no lo es, seria una deuda inventada.
    public class Spans
    {
        public static Span<T> Empty<T>()
        {
            return new Span<T>(null, 0);
        }

        // Sobre un arreglo nativo. El span guarda el arreglo y el indice inicial, no un puntero:
        // `&items[i]` lee el elemento, y un slot muerto (DEC-11) atraparia al crear el span
        // (Congelamiento 3.0 P4). Data() toma la direccion cuando se pide.
        //
        // El arreglo vacio se atiende antes: no hay elemento al cual referirse.
        public static Span<T> Of<T>(T[] items)
        {
            if (items == null || items.Length == 0)
            {
                return new Span<T>(null, 0);
            }
            return new Span<T>(null, items.Length, items, 0);
        }

        public static Span<T> OfRange<T>(T[] items, int start, int length)
        {
            if (items == null)
            {
                return new Span<T>(null, 0);
            }
            int begin = start;
            if (begin < 0) { begin = 0; }
            if (begin > items.Length) { begin = items.Length; }
            int available = items.Length - begin;
            int take = length;
            if (take < 0) { take = 0; }
            if (take > available) { take = available; }
            if (take == 0)
            {
                return new Span<T>(null, 0);
            }
            return new Span<T>(null, take, items, begin);
        }

        // Sobre un bloque crudo -- `stackalloc`, `RawAlloc`, un puntero que vino de C. Es el
        // constructor con nombre: no comprueba nada porque no hay nada que comprobar, la
        // longitud es una afirmacion del que llama.
        public static Span<T> OfRaw<T>(T* data, int length)
        {
            return new Span<T>(data, length);
        }

        public static ReadOnlySpan<T> ReadOnlyEmpty<T>()
        {
            return new ReadOnlySpan<T>(null, 0);
        }

        public static ReadOnlySpan<T> ReadOnlyOf<T>(T[] items)
        {
            if (items == null || items.Length == 0)
            {
                return new ReadOnlySpan<T>(null, 0);
            }
            return new ReadOnlySpan<T>(null, items.Length, items, 0);
        }

        public static ReadOnlySpan<T> ReadOnlyOfRange<T>(T[] items, int start, int length)
        {
            if (items == null)
            {
                return new ReadOnlySpan<T>(null, 0);
            }
            int begin = start;
            if (begin < 0) { begin = 0; }
            if (begin > items.Length) { begin = items.Length; }
            int available = items.Length - begin;
            int take = length;
            if (take < 0) { take = 0; }
            if (take > available) { take = available; }
            if (take == 0)
            {
                return new ReadOnlySpan<T>(null, 0);
            }
            return new ReadOnlySpan<T>(null, take, items, begin);
        }

        public static ReadOnlySpan<T> ReadOnlyOfRaw<T>(T* data, int length)
        {
            return new ReadOnlySpan<T>(data, length);
        }
    }
}
