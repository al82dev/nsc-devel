using NativeSharp.Core;

namespace NativeSharp.Core
{
    // Un bloque de la arena. Existe como clase --y no como campos sueltos-- porque una arena es
    // una CADENA de bloques y la cadena necesita un nodo.
    //
    // El almacenamiento es un `owned byte[]`, y esa eleccion es la que hace correcta a toda la
    // clase de arriba: un arreglo de NativeSharp vive en el heap y NO SE MUEVE NUNCA, asi que el
    // `byte*` que se saca de el sigue siendo valido mientras el arreglo viva. Medido antes de
    // escribir nada: Spans.Of<byte>(campo).Data() sobre un campo de una clase da un puntero estable.
    //
    // `siguiente` es un campo `owned` del propio tipo, exactamente como LinkedListNode: la cadena
    // se destruye sola cuando muere la arena.
    public class ArenaBlock
    {
        public owned byte[] almacen;
        public int usado;
        public owned ArenaBlock siguiente;

        public ArenaBlock(int tamano)
        {
            almacen = new byte[tamano];
            usado = 0;
            siguiente = null;
        }
    }

    // NativeSharp.Core.ArenaAllocator -- Bloque 5, fase D. SHR-039.
    //
    // QUE ES. Reparte memoria por incremento dentro de bloques grandes y la devuelve TODA DE
    // GOLPE. Es la forma de asignacion de un compilador: se crean cientos de miles de nodos de AST
    // que viven exactamente lo que dura una compilacion, y liberarlos uno a uno cuesta mas que
    // haberlos creado.
    //
    // LA PROPIEDAD QUE LO DEFINE ES QUE LOS BLOQUES NO SE MUEVEN. Una arena reparte punteros que
    // el llamador guarda; si al crecer realojara y copiara --como hacen List<T>, ByteBuffer o
    // StringBuilder-- todos los punteros repartidos quedarian colgando. Por eso NO se duplica un
    // arreglo: se ENCADENA uno nuevo y el viejo se queda exactamente donde estaba.
    //
    // Esa es tambien la diferencia con ByteBuffer, que por fuera se parece: ByteBuffer es un buffer
    // de SALIDA cuyo contenido se consume al final y puede realojar cuanto quiera; una arena es un
    // proveedor de MEMORIA cuyas direcciones son el producto.
    //
    // ALINEACION A 8. Todo lo que reparte queda en una direccion multiplo de 8, que es lo que
    // necesita cualquier `long`, `double` o puntero de x64. Repartir sin alinear funcionaria hoy
    // en x86-64 para casi todo y seria una bomba de relojeria en cuanto algo pidiera una lectura
    // alineada o se cambiara de arquitectura.
    public class ArenaAllocator : Allocator
    {
        private owned ArenaBlock primero;
        private ArenaBlock actual;
        private int tamanoBloque;
        private int cuantosBloques;
        private long asignacionesTotales;
        private long asignacionesActivas;
        private int reinicios;

        // 64 KiB por bloque. Suficientemente grande para que un AST normal quepa en uno o dos
        // --y por tanto para que el coste de encadenar sea irrelevante-- y suficientemente pequeno
        // para que una arena que apenas se usa no reserve megabytes.
        public static int DefaultBlockSize() { return 65536; }

        public ArenaAllocator()
        {
            tamanoBloque = DefaultBlockSize();
            primero = new ArenaBlock(tamanoBloque);
            actual = primero;
            cuantosBloques = 1;
            asignacionesTotales = 0;
            asignacionesActivas = 0;
            reinicios = 0;
        }

        public ArenaAllocator(int tamanoDeBloque)
        {
            int tamano = tamanoDeBloque;
            if (tamano < 64) { tamano = 64; }
            tamanoBloque = tamano;
            primero = new ArenaBlock(tamanoBloque);
            actual = primero;
            cuantosBloques = 1;
            asignacionesTotales = 0;
            asignacionesActivas = 0;
            reinicios = 0;
        }

        public int BlockSize() { return tamanoBloque; }

        public int BlockCount() { return cuantosBloques; }

        // Redondea hacia arriba al multiplo de 8. Escrito con aritmetica y no con un `while`
        // porque es la operacion que mas veces se ejecuta de toda la clase.
        private static int Alinear(int valor)
        {
            return (valor + 7) / 8 * 8;
        }

        public override byte* Allocate(int bytes)
        {
            if (bytes <= 0) { return null; }

            int pedido = Alinear(bytes);

            // PRIMERO SE APROVECHAN LOS BLOQUES QUE YA EXISTEN, y este bucle es una CORRECCION,
            // no una optimizacion. Sin el, la version anterior hacia directamente
            // `actual.siguiente = move(nuevo)` cuando el bloque actual se llenaba -- y eso PISA la
            // cadena que ya hubiera colgando de ahi.
            //
            // En la primera pasada no se notaba: `siguiente` siempre era null, asi que no habia
            // nada que pisar. Se notaba DESPUES DE UN Reset: `Reset()` rebobina todos los bloques
            // a cero y vuelve `actual` al primero, asi que al llenarse el primero otra vez la
            // asignacion tiraba los cuatro que ya estaban --se liberaban, porque el campo es
            // `owned`-- y pedia memoria nueva al sistema. Es decir: `Reset()` no conservaba nada,
            // que es exactamente lo contrario de lo que su comentario promete y de lo unico que
            // hace que una arena valga la pena entre compilaciones. Y `cuantosBloques` seguia
            // subiendo mientras los bloques se caian, asi que ademas MENTIA.
            //
            // Avanzar y no retroceder es lo normal en un asignador por incremento: el hueco que
            // quede en un bloque que se salta se pierde. Eso es el desperdicio que BytesUsed y
            // BytesReserved juntos permiten medir.
            while (actual.usado + pedido > actual.almacen.Length && actual.siguiente != null)
            {
                actual = actual.siguiente;
            }

            // Si NINGUNO de los que hay sirve, ahora si se encadena uno nuevo -- al final de la
            // cadena, porque el bucle de arriba dejo `actual` en el ultimo.
            if (actual.usado + pedido > actual.almacen.Length)
            {
                // El bloque nuevo es el mayor entre el tamano por omision y lo pedido, para que una
                // peticion mas grande que un bloque no falle NUNCA. Sin esto, pedir 100 KiB a una
                // arena de bloques de 64 KiB devolveria null para siempre, y el fallo apareceria
                // muy lejos de aqui.
                int tamanoNuevo = tamanoBloque;
                if (pedido > tamanoNuevo) { tamanoNuevo = pedido; }

                owned ArenaBlock nuevo = new ArenaBlock(tamanoNuevo);
                actual.siguiente = move(nuevo);
                actual = actual.siguiente;
                cuantosBloques = cuantosBloques + 1;
            }

            byte* baseDelBloque = Spans.Of<byte>(actual.almacen).Data();
            byte* entregado = baseDelBloque + actual.usado;
            actual.usado = actual.usado + pedido;
            asignacionesTotales = asignacionesTotales + 1;
            asignacionesActivas = asignacionesActivas + 1;
            return entregado;
        }

        // Rebobina TODOS los bloques a cero SIN liberar la memoria, y vuelve al primero. Eso es lo
        // que hace que una arena valga la pena entre compilaciones: la segunda no vuelve a pedirle
        // memoria al sistema.
        //
        // Los bloques encadenados se CONSERVAN a proposito. Tirarlos y quedarse solo con el primero
        // ahorraria memoria y convertiria cada compilacion en la primera; una arena que ya sabe que
        // el trabajo tipico ocupa cinco bloques debe seguir teniendo cinco.
        public override void Reset()
        {
            ArenaBlock bloque = primero;
            while (bloque != null)
            {
                bloque.usado = 0;
                bloque = bloque.siguiente;
            }
            actual = primero;
            asignacionesActivas = 0;
            reinicios = reinicios + 1;
        }

        // Contadores de vida para cargas de compilador. Una asignacion de arena no se libera de
        // forma individual: queda activa hasta Reset o hasta destruir la arena. Por eso este
        // contador mide obligaciones vivas, no bloques del sistema operativo.
        public long TotalAllocationCount() { return asignacionesTotales; }

        public long ActiveAllocationCount() { return asignacionesActivas; }

        public int ResetCount() { return reinicios; }

        public bool HasOutstandingAllocations() { return asignacionesActivas != 0; }

        public override long BytesUsed()
        {
            long total = 0;
            ArenaBlock bloque = primero;
            while (bloque != null)
            {
                total = total + (long)bloque.usado;
                bloque = bloque.siguiente;
            }
            return total;
        }

        // Cuanta memoria tiene RESERVADA la arena, se este usando o no. Con BytesUsed dice el
        // desperdicio, que es el unico numero con el que se elige un tamano de bloque.
        public long BytesReserved()
        {
            long total = 0;
            ArenaBlock bloque = primero;
            while (bloque != null)
            {
                total = total + (long)bloque.almacen.Length;
                bloque = bloque.siguiente;
            }
            return total;
        }

        // Un bloque de `cuantos` elementos de `bytesPorElemento`, como Span<byte>. Es la forma en
        // que el codigo de arriba va a pedir memoria de verdad -- un arreglo de nodos, no bytes
        // sueltos-- y tenerlo aqui evita que cada llamador repita la multiplicacion y se equivoque
        // en un desbordamiento.
        //
        // Devuelve un span VACIO si no se pudo asignar, que es comprobable con IsEmpty() sin
        // compararlo contra null.
        public Span<byte> AllocateSpan(int cuantos, int bytesPorElemento)
        {
            if (cuantos <= 0 || bytesPorElemento <= 0) { return Spans.Empty<byte>(); }

            long total = (long)cuantos * (long)bytesPorElemento;
            if (total > 2147483647) { return Spans.Empty<byte>(); }

            byte* memoria = Allocate((int)total);
            if (memoria == null) { return Spans.Empty<byte>(); }
            return Spans.OfRaw<byte>(memoria, (int)total);
        }
    }
}
