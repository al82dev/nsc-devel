namespace NativeSharp.LLVM.C
{
    // Valores ABI exactos de llvm-c/TargetMachine.h y llvm-c/Analysis.h (LLVM 23.x).
    public enum LLVMCodeGenOptLevel
    {
        None = 0,
        Less = 1,
        Default = 2,
        Aggressive = 3
    }

    public enum LLVMRelocMode
    {
        Default = 0,
        Static = 1,
        PIC = 2,
        DynamicNoPic = 3,
        ROPI = 4,
        RWPI = 5,
        ROPI_RWPI = 6
    }

    public enum LLVMCodeModel
    {
        Default = 0,
        JITDefault = 1,
        Tiny = 2,
        Small = 3,
        Kernel = 4,
        Medium = 5,
        Large = 6
    }

    public enum LLVMCodeGenFileType
    {
        Assembly = 0,
        Object = 1
    }

    public enum LLVMVerifierFailureAction
    {
        AbortProcess = 0,
        PrintMessage = 1,
        ReturnStatus = 2
    }

    // llvm-c/Core.h: valores ABI usados por el backend SH08. Se declaran como enums
    // NativeSharp para impedir que el lowering mezcle predicados u órdenes atómicos.
    public enum LLVMIntPredicate
    {
        Equal = 32,
        NotEqual = 33,
        UnsignedGreaterThan = 34,
        UnsignedGreaterOrEqual = 35,
        UnsignedLessThan = 36,
        UnsignedLessOrEqual = 37,
        SignedGreaterThan = 38,
        SignedGreaterOrEqual = 39,
        SignedLessThan = 40,
        SignedLessOrEqual = 41
    }

    public enum LLVMAtomicOrdering
    {
        NotAtomic = 0,
        Unordered = 1,
        Monotonic = 2,
        Acquire = 4,
        Release = 5,
        AcquireRelease = 6,
        SequentiallyConsistent = 7
    }
}
