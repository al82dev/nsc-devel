namespace NativeSharp.Core.Threading
{
    // Item 371/374. A fixed-size native worker pool with one bounded FIFO per worker. Work is
    // represented by the already-proven ThreadStart delegate and executed outside the queue
    // monitor, so producers and workers only hold the lock while changing queue state.
    public class ThreadPool
    {
        private owned Thread[] workers_;
        private owned ThreadStart[] queues_;
        private owned int[] heads_;
        private owned int[] counts_;
        private owned Monitor gate_;
        private int queueCapacity_;
        private int nextQueue_;
        private int startedWorkers_;
        private int pending_;
        private int stealCount_;
        private bool workStealing_;
        private bool stopping_;

        public ThreadPool(int workerCount, int queueCapacity)
        {
            int actualWorkers = workerCount;
            int actualCapacity = queueCapacity;
            if (actualWorkers < 1) { actualWorkers = 1; }
            if (actualCapacity < 1) { actualCapacity = 1; }

            workers_ = new Thread[actualWorkers];
            queues_ = new ThreadStart[actualWorkers * actualCapacity];
            heads_ = new int[actualWorkers];
            counts_ = new int[actualWorkers];
            gate_ = new Monitor();
            queueCapacity_ = actualCapacity;
            nextQueue_ = 0;
            startedWorkers_ = 0;
            pending_ = 0;
            stealCount_ = 0;
            workStealing_ = true;
            stopping_ = false;

            int i = 0;
            while (i < workers_.Length)
            {
                ThreadStart start = WorkerLoop;
                workers_[i] = new Thread(start);
                i = i + 1;
            }
        }

        // Directed-affinity users may disable stealing explicitly. The two-argument constructor
        // enables it by default so an idle worker can balance ordinary pool workloads.
        public ThreadPool(int workerCount, int queueCapacity, bool enableWorkStealing)
        {
            int actualWorkers = workerCount;
            int actualCapacity = queueCapacity;
            if (actualWorkers < 1) { actualWorkers = 1; }
            if (actualCapacity < 1) { actualCapacity = 1; }

            workers_ = new Thread[actualWorkers];
            queues_ = new ThreadStart[actualWorkers * actualCapacity];
            heads_ = new int[actualWorkers];
            counts_ = new int[actualWorkers];
            gate_ = new Monitor();
            queueCapacity_ = actualCapacity;
            nextQueue_ = 0;
            startedWorkers_ = 0;
            pending_ = 0;
            stealCount_ = 0;
            workStealing_ = enableWorkStealing;
            stopping_ = false;

            int i = 0;
            while (i < workers_.Length)
            {
                ThreadStart start = WorkerLoop;
                workers_[i] = new Thread(start);
                i = i + 1;
            }
        }

        public int WorkerCount()
        {
            return workers_.Length;
        }

        public int QueueCapacity()
        {
            return queueCapacity_;
        }

        public int WorkerQueueCount()
        {
            return workers_.Length;
        }

        public bool WorkStealingEnabled()
        {
            return workStealing_;
        }

        public int StealCount()
        {
            gate_.Enter();
            int result = stealCount_;
            gate_.Exit();
            return result;
        }

        // The delegate is borrowed until it runs, matching Thread(ThreadStart). Callers keep it
        // alive through WaitIdle/Shutdown. Ordinary submissions are distributed round-robin,
        // skipping queues that are currently full.
        public bool Queue(ThreadStart work)
        {
            gate_.Enter();
            if (stopping_)
            {
                gate_.Exit();
                return false;
            }

            int checkedQueues = 0;
            int target = nextQueue_;
            while (checkedQueues < workers_.Length && counts_[target] == queueCapacity_)
            {
                target = target + 1;
                if (target == workers_.Length) { target = 0; }
                checkedQueues = checkedQueues + 1;
            }
            if (checkedQueues == workers_.Length)
            {
                gate_.Exit();
                return false;
            }

            EnqueueLocked(target, work);
            nextQueue_ = target + 1;
            if (nextQueue_ == workers_.Length) { nextQueue_ = 0; }
            gate_.PulseAll();
            gate_.Exit();
            return true;
        }

        // Directed submission is useful for affinity-sensitive work and makes each worker queue
        // an explicit API surface. A worker never consumes another queue until item 375 enables
        // work stealing.
        public bool QueueOnWorker(int workerIndex, ThreadStart work)
        {
            if (workerIndex < 0 || workerIndex >= workers_.Length) { return false; }
            gate_.Enter();
            if (stopping_ || counts_[workerIndex] == queueCapacity_)
            {
                gate_.Exit();
                return false;
            }
            EnqueueLocked(workerIndex, work);
            gate_.PulseAll();
            gate_.Exit();
            return true;
        }

        private void EnqueueLocked(int workerIndex, ThreadStart work)
        {
            int tail = heads_[workerIndex] + counts_[workerIndex];
            if (tail >= queueCapacity_) { tail = tail - queueCapacity_; }
            queues_[workerIndex * queueCapacity_ + tail] = work;
            counts_[workerIndex] = counts_[workerIndex] + 1;
            pending_ = pending_ + 1;
        }

        public void WaitIdle()
        {
            gate_.Enter();
            while (pending_ != 0)
            {
                gate_.Wait(-1);
            }
            gate_.Exit();
        }

        public void Shutdown()
        {
            gate_.Enter();
            stopping_ = true;
            gate_.PulseAll();
            gate_.Exit();

            int i = 0;
            while (i < workers_.Length)
            {
                workers_[i].Join();
                i = i + 1;
            }
        }

        private void WorkerLoop()
        {
            gate_.Enter();
            int workerIndex = startedWorkers_;
            startedWorkers_ = startedWorkers_ + 1;
            gate_.Exit();

            while (true)
            {
                gate_.Enter();
                int source = FindWorkQueueLocked(workerIndex);
                while (source < 0 && !stopping_)
                {
                    gate_.Wait(-1);
                    source = FindWorkQueueLocked(workerIndex);
                }
                if (source < 0 && stopping_)
                {
                    gate_.Exit();
                    return;
                }

                int slot = 0;
                if (source == workerIndex)
                {
                    slot = source * queueCapacity_ + heads_[source];
                    heads_[source] = heads_[source] + 1;
                    if (heads_[source] == queueCapacity_) { heads_[source] = 0; }
                }
                else
                {
                    int tail = heads_[source] + counts_[source] - 1;
                    if (tail >= queueCapacity_) { tail = tail - queueCapacity_; }
                    slot = source * queueCapacity_ + tail;
                    stealCount_ = stealCount_ + 1;
                }
                ThreadStart work = queues_[slot];
                counts_[source] = counts_[source] - 1;
                gate_.Exit();

                work();

                gate_.Enter();
                pending_ = pending_ - 1;
                if (pending_ == 0) { gate_.PulseAll(); }
                gate_.Exit();
            }
        }

        private int FindWorkQueueLocked(int workerIndex)
        {
            if (counts_[workerIndex] != 0) { return workerIndex; }
            if (!workStealing_) { return -1; }

            int checkedQueues = 1;
            int source = workerIndex + 1;
            if (source == workers_.Length) { source = 0; }
            while (checkedQueues < workers_.Length)
            {
                if (counts_[source] != 0) { return source; }
                source = source + 1;
                if (source == workers_.Length) { source = 0; }
                checkedQueues = checkedQueues + 1;
            }
            return -1;
        }

        ~ThreadPool()
        {
            Shutdown();
            int i = 0;
            while (i < workers_.Length)
            {
                delete workers_[i];
                i = i + 1;
            }
            delete[] workers_;
            delete[] queues_;
            delete[] heads_;
            delete[] counts_;
        }
    }
}
