namespace NativeSharp.Core.Threading
{
    // Explicit hooks supplied by the control-block owner. ReferenceCounts never discovers a
    // destructor, allocator, or collector by itself.
    public delegate void ReferenceCountHook();

    public enum ReferenceRelease
    {
        Invalid = -1,
        Retained = 0,
        Final = 1
    }

    // Embeddable strong/weak reference-count state for Rc/Arc-style control blocks. The struct
    // itself does not allocate. weak_ includes the conventional implicit weak owner held while
    // strong_ is non-zero, so the control block cannot disappear before payload destruction.
    public struct ReferenceCounts
    {
        private long strong_;
        private long weak_;

        public ReferenceCounts(long initialStrong)
        {
            if (initialStrong > 0)
            {
                strong_ = initialStrong;
                weak_ = 1;
            }
            else
            {
                strong_ = 0;
                weak_ = 0;
            }
        }

        public bool IsValid()
        {
            return Interlocked.Load(ref strong_, MemoryOrder.Acquire) > 0;
        }

        public long StrongCount()
        {
            return Interlocked.Load(ref strong_, MemoryOrder.Acquire);
        }

        public long WeakCount()
        {
            long weak = Interlocked.Load(ref weak_, MemoryOrder.Acquire);
            long strong = Interlocked.Load(ref strong_, MemoryOrder.Relaxed);
            return strong > 0 ? weak - 1 : weak;
        }

        public bool TryRetainStrong()
        {
            while (true)
            {
                long current = Interlocked.Load(ref strong_, MemoryOrder.Relaxed);
                if (current <= 0 || current == 9223372036854775807l)
                {
                    return false;
                }
                if (Interlocked.CompareExchange(
                        ref strong_, current + 1, current,
                        MemoryOrder.Relaxed, MemoryOrder.Relaxed) == current)
                {
                    return true;
                }
            }
        }

        public bool TryRetainWeak()
        {
            while (true)
            {
                long current = Interlocked.Load(ref weak_, MemoryOrder.Relaxed);
                if (current <= 0 || current == 9223372036854775807l)
                {
                    return false;
                }
                if (Interlocked.CompareExchange(
                        ref weak_, current + 1, current,
                        MemoryOrder.Relaxed, MemoryOrder.Relaxed) == current)
                {
                    return true;
                }
            }
        }

        public ReferenceRelease ReleaseStrong()
        {
            while (true)
            {
                long current = Interlocked.Load(ref strong_, MemoryOrder.Relaxed);
                if (current <= 0)
                {
                    return ReferenceRelease.Invalid;
                }
                long next = current - 1;
                if (Interlocked.CompareExchange(
                        ref strong_, next, current,
                        MemoryOrder.Release, MemoryOrder.Relaxed) != current)
                {
                    continue;
                }
                if (next != 0)
                {
                    return ReferenceRelease.Retained;
                }
                AtomicFence.Thread(MemoryOrder.Acquire);
                return ReferenceRelease.Final;
            }
        }

        public ReferenceRelease ReleaseWeak()
        {
            while (true)
            {
                long current = Interlocked.Load(ref weak_, MemoryOrder.Relaxed);
                if (current <= 0)
                {
                    return ReferenceRelease.Invalid;
                }
                long next = current - 1;
                if (Interlocked.CompareExchange(
                        ref weak_, next, current,
                        MemoryOrder.Release, MemoryOrder.Relaxed) != current)
                {
                    continue;
                }
                if (next != 0)
                {
                    return ReferenceRelease.Retained;
                }
                AtomicFence.Thread(MemoryOrder.Acquire);
                return ReferenceRelease.Final;
            }
        }

        public ReferenceRelease ReleaseStrongAndDestroy(
            ReferenceCountHook destroyHook,
            ReferenceCountHook deallocateHook)
        {
            ReferenceRelease released = ReleaseStrong();
            if (released != ReferenceRelease.Final)
            {
                return released;
            }
            destroyHook();
            ReferenceRelease weakReleased = ReleaseWeak();
            if (weakReleased == ReferenceRelease.Final)
            {
                deallocateHook();
            }
            return ReferenceRelease.Final;
        }

        public ReferenceRelease ReleaseWeakAndDeallocate(ReferenceCountHook deallocateHook)
        {
            ReferenceRelease released = ReleaseWeak();
            if (released == ReferenceRelease.Final)
            {
                deallocateHook();
            }
            return released;
        }
    }
}
